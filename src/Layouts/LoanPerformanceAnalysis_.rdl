  <Code>Public Function GetSectionColor(ByVal sectionNo As Object) As String
    If sectionNo Is Nothing Then Return "White"

    Select Case CInt(sectionNo)
        Case 1
            Return "#6FA8DC" ' Loan Balance
        Case 2
            Return "#176B24" ' Principal Arrears + Interest
        Case 3
            Return "#C7EAF7" ' No of Loans
        Case 4
            Return "#F4C7AB" ' PAR
        Case Else
            Return "White"
    End Select
End Function

Public Function GetSummaryColor(ByVal rowNo As Object) As String
    If rowNo Is Nothing Then Return "White"

    Select Case CInt(rowNo)
        Case 1, 3
            Return "Yellow"
        Case 2
            Return "#DDEBF7"
        Case Else
            Return "White"
    End Select
End Function

Public Function GetAlternatingColor(ByVal rowNo As Object) As String
    If rowNo Is Nothing Then Return "White"

    If CInt(rowNo) Mod 2 = 0 Then
        Return "#F2F2F2" ' Light gray
    Else
        Return "White"
    End If
End Function</Code>
