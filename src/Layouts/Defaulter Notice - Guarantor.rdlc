  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="Tablix1">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>2.34333in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>2.34333in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>2.34333in</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>5.14458in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Dear </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!Name.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>,

RE: LOAN RECOVERY NOTICE FOR </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!MemberName.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>.

We refer to the loan of </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!MemberName.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> of which you are a guarantor. The said loan has been under default for </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!SASRA_Days_Arrears.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> days now. We have had several communications with the members over the same to push for regularization of payments. Unfortunately, the scheduled payments have not been regularized and the loan account remains in default.

The facility issued was </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!LoanProductTypeName.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value xml:space="preserve"> </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!LoanNo.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> of Ksh.</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!ApprovedAmount.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> disbursed on </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!DisbursementDate.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <Format>d</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> where you had guaranteed Ksh.</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!Amount_Guaranteed.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> and the outstanding loan balance to date is Ksh.</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!TotalOutstandingBalance.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> with arrears of Ksh.</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!Total_Arrears.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>. You are currently liable for Ksh.</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!Current_Committed.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>

The purpose of this letter is to draw your attention to compel </Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!MemberName.Value</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> to pay the loan arrears and to notify you that we shall commence recovery process from you as the loan guarantor if the facility remains unregularized in next THIRTY (30) days from the date of this notice.

Note that this is our last resort and would appreciate if the payment is done within this period to regularize the account and have a solid commitment from the loanee to clear the outstanding balance as scheduled.
</Value>
                                  <Style>
                                    <FontFamily>Maiandra GD</FontFamily>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox2</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>3</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell />
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
