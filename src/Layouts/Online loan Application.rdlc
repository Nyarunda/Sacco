          <Rectangle Name="Rectangle3">
            <ReportItems>
              <Textbox Name="Textbox3">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">A. TERMS AND CONDITIONS</Value>
                        <Style>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <TextDecoration>None</TextDecoration>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.1 Application must be made on the official loan form fully completed and appropriately signed by both the loanee and guarantors in their own handwriting </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.2 The applicant is required to attach original pay slip (not more than two months old to the date of application). </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.3 Loans are granted in accordance with the loan policy and lending conditions existing at the time of application. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.4 For a member to qualify for loan consideration, he/she must have contributed deposits for a minimum period of six months, subject to the loan policy in force. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.5 Any amount of money deposited by a member either in cash or by cheque to boost deposits shall wait for three months before that amount can be used to secure a loan. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.6 A member whose deposit contributions have fallen off the payroll but has continued repaying his/her loan and is in need of a new loan will be required to update his/her deposits account by repaying in cash or authorize an offset from loan of an equivalent amount of the areas. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.7 A member who desires an additional loan though he has not cleared the previous loan will be allowed to get an advance from the FOSA to clear the outstanding loan to qualify for a new loan. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.8 Guarantors who must be members of the Society shall not guarantee more than six times their deposits. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.9 Interest on back office deposit for members with star and maisha loan will be capitalized. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.10 The type of loan applied and repayment period shall be clearly indicated by the applicant. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.11 The interest rates shall be determined by the Board of Directors from time to time. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.12 All loans shall attract an insurance fee of 2% and process fee of 1% of the amount approved and recovered up-front. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.13 The amount applied for shall be fully covered by the loanees and guarantors’ deposits. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.14 Minimum share contribution for those with loans shall be determined by the share banding on the amount approved.</Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>Textbox3</rd:DefaultName>
                <Left>0.00611in</Left>
                <Height>4.76041in</Height>
                <Width>7.5579in</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="Textbox6">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.15 A dormant member shall not be considered for any loan. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.16 Minimum deposit contribution for members without loans will be Kshs. 3000.00 per month subject to change from time to time. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.17 No member will be allowed to suffer total deduction including loan repayment in excess of two thirds of the basic salary and permanent allowances.</Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.18 Members can take a second loan other than emergency/school fees in addition to existing loan without necessarily clearing the outstanding loan subject to ability to repay. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.19 Loans shall only be credit to member’s FOSA account </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.20 If a member decides to cancel his/her loan application after the process has been finalized, a cancellation fee of Kshs. 1,000/= shall be charged in addition to the processing fee. </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value EvaluationMode="Auto">1.21 Any alteration on the loan form may cause disqualification.</Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Maiandra GD</FontFamily>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>Textbox6</rd:DefaultName>
                <Top>7.07985in</Top>
                <Left>0.01222in</Left>
                <Height>2.16665in</Height>
                <Width>7.56401in</Width>
