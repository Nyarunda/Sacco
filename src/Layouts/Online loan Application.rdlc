              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">D.TYPE OF LOAN AND PERIOD</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!LoanTypeDescription.Value, "DataSet_Result") + ", " + Str(First(Fields!Instalments.Value, "DataSet_Result")) + " Months"</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto" />
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">E. PURPOSE FOR WHICH LOAN IS REQUIRED</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!PurposeofLoan.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto" />
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">F. SECURITY</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">In consideration of the society granting me the above loan or less as may be approved, I pledge the under listed as security for the loan repayment:</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">   1. My current and future salary                     2. My deposits with the Sacco                             3. Guarantors Deposits
   4. Terminal Benefits from my employer       5. Others (Specify for consideration)……………………………………</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto" />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">G. DECLARATION</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">I hereby declare as follows: - </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">That my present employer as well as my future employers have authority to deduct from my salary every month such a sum of money consisting of principal loan repayment and interest as may be determined by Wanandege Sacco Society Limited until the loan is repaid in full.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">That this authority is unconditional and may not be revoked during the life of the loan without express consent of Wanandege Co-operative Society as well as guarantors. </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">That the foregoing particulars are true to the best of my knowledge and belief and agree to abide by the Society bylaws, loan policy and any variation by the Credit Committee in respect of amount approved. </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">I am aware that Wanandege Sacco Limited shares member’s credit information which includes positive and negative information with TransUnion Credit Reference Bureau. In the event of loan default, I authorize the Sacco to forward my name to the CRB and I am aware of the attendant consequences as governed by CRB Regulations. </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">I will abide by the Terms and Conditions governing this loan as may be approved by the Board of Directors and acknowledge that they are subject to change from time to time.  </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">I am aware that this Agreement shall be governed by and shall be construed in accordance with Kenyan Law.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">Wanandege Sacco Limited is the custodian of your data in compliance with Data Protection Act, 2019. The SACCO may disclose your Personal Data to 3rd Parties in good faith. This may be necessitated by but not limited to; legal obligations, loan recovery and IT Systems service providers contracted to work for the Sacco. By submitting this form, you are consenting to the above.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto" />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">I …</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!MemberNames.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
