              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">Note 1.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto"> Guarantors are advised to read all the information supplied in this form by applicant and the terms and conditions contained herein in order to understand the full implication of this part. </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">Note 2.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto"> Guarantors to fill their details in the table below in their own underwriting and should sign after the Application has indicated the amount applied and guaranteed both in figures and in words. </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">1. Amount of loan guaranteed Kshs. …</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
