          </Tablix>
          <Textbox Name="Textbox1">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">B. APPLICANT PARTICULARS</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">Please attach the following documents </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">  1. Copies of last two months’ payslips                2. Copy of your National ID card or passport </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">  3. Supporting documents where necessary          4. Letter of appointment if on contract.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox1</rd:DefaultName>
            <Top>10.76214in</Top>
            <Left>0.31094in</Left>
            <Height>0.74182in</Height>
            <Width>7.564in</Width>
            <ZIndex>16</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="Textbox18">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">C. LOAN REQUIRED</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto" />
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">I …</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!MemberNames.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">... hereby apply for a loan of Kshs. </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!LoanAmount.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Format>f2</Format>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">… (amount in words)…</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!LoanAmountText.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">…. For a period of …</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!Instalments.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">... months to be repaid in instalments of Kshs. ……………………….each month commencing on (Date) ……………. Month ………… Year……………..</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto" />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
