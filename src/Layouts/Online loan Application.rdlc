                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">…hereby confirm that I have read the above terms and conditions and hereby signify my acceptance of terms and conditions.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
