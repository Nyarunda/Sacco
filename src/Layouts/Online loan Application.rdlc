                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!TotalGuaranteed.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Maiandra GD</FontFamily>
