    local procedure SendMemberRejoiningEmail(Member: Record Members)
    var
        Email: Codeunit Email;
        EmailMsg: Codeunit "Email Message";
        Sky: Codeunit "Sky MBanking";
        Body: Text;
        CompanyInfo: Record "Company Information";
        DropOffDetails: Text;
        EmailDetails: Text;
        FirstName: Text[100];
        Subject: Text[250];
        WhatsAppDetails: Text;
    begin
        if not ValidEmailAddress(Member."E-Mail") then
            exit;

        if CompanyInfo.Get() then begin
            DropOffDetails := CompanyInfo.Address;
            if CompanyInfo."Address 2" <> '' then
                DropOffDetails += ', ' + CompanyInfo."Address 2";
            if CompanyInfo.City <> '' then
                DropOffDetails += ', ' + CompanyInfo.City;
            if CompanyInfo."Post Code" <> '' then
                DropOffDetails += ', ' + CompanyInfo."Post Code";

            EmailDetails := CompanyInfo."E-Mail";
            WhatsAppDetails := CompanyInfo."Phone No.";
        end;

        FirstName := Sky.FirstName(Member.Name);
        if FirstName = '' then
            FirstName := Member.Name;

        Subject := 'Membership Rejoining Accepted';
        Body :=
            'Dear ' + FirstName + ',<br/><br/>' +
            'We are happy to inform you that your application for rejoining the Sacco has been accepted. You may therefore continue remitting your contributions via the Bank Account and Mpesa Details attached.<br/><br/>' +
            'Remittance advices must be sent to the Sacco Office using any of the following ways: -<br/><br/>';

        if DropOffDetails <> '' then
            Body += '<b>Drop Off:</b> ' + DropOffDetails + '<br/><br/>';
        if EmailDetails <> '' then
            Body += '<b>Or Emailed To:</b> ' + EmailDetails + '<br/><br/>';
        if WhatsAppDetails <> '' then
            Body += '<b>Or through WhatsApp:</b> ' + WhatsAppDetails + '<br/><br/>';

        Body +=
            'When depositing, always indicate your name and membership number ' + Member."No." + ' on the deposit slip and keep a copy of the same. You can view your account statement online through either of our internet banking channels.';

        EmailMsg.Create(Member."E-Mail", Subject, Body, true);
        if not TrySendEmail(Email, EmailMsg) then
            exit;
    end;

