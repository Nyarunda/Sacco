    local procedure InItRecType(Cust: Record Customer; Savings: Record "Savings Accounts"; Loans: Record Loans; Type: Option LOANS,CUSTOMER,SAVINGS)
    var
        RecType: Record "Payment & Receipt Types";
    begin

        case Type of
            Type::CUSTOMER:
                begin
                    if RecType.Get(Cust."Customer Posting Group") then begin
                        RecType."Default Grouping" := Cust."Customer Posting Group";
                        RecType."Account Type" := RecType."Account Type"::Customer;
                        RecType.Modify();
                    end else begin
                        RecType.Init();
                        RecType.Code := Cust."Customer Posting Group";
                        RecType.Description := Cust."Customer Posting Group";
                        RecType."Account Type" := RecType."Account Type"::Customer;
                        RecType."Default Grouping" := Cust."Customer Posting Group";
                        RecType.Type := RecType.Type::Receipt;
                        RecType.Insert();
                    end;
                end;
            Type::SAVINGS:
                begin
                    if RecType.Get(Savings."Product Type") then begin
                        RecType."Default Grouping" := Savings."Customer Posting Group";
                        RecType."Account Type" := RecType."Account Type"::Savings;
                        RecType.Modify();
                    end else begin
                        RecType.Init();
                        RecType.Code := Savings."Product Type";
                        RecType.Description := Savings."Product Name";
                        RecType."Account Type" := RecType."Account Type"::Savings;
                        RecType."Default Grouping" := Savings."Customer Posting Group";
                        RecType.Type := RecType.Type::Receipt;
                        RecType.Insert();
                    end;
                end;
            Type::LOANS:
                begin
                    if not RecType.Get('LOANS') THEN begin

                        RecType.Init();
                        RecType.Code := 'LOANS';
                        RecType.Description := 'Loan Repayment';
                        RecType."Account Type" := RecType."Account Type"::Credit;
                        RecType.Type := RecType.Type::Receipt;
                        RecType.Insert();

                    end;
                end;

        end;
    end;

    procedure SuggestReceiptLines(RHeader: Record "Receipt Header")
    var
        Cust: Record Customer;
        RunBal: Decimal;
        DistAccount: Record "Savings Accounts";
        RLine: Record "Document Line";
        SaccoAct: Codeunit "Sacco Activities";
        Type: Option LOANS,CUSTOMER,SAVINGS,EXCESS;
        Savings: Record "Savings Accounts";
        LineCounter: Integer;
    begin

        RunBal := RHeader."Amount Recieved";


        if RHeader."Customer Type" = RHeader."Customer Type"::Customer then begin
            Cust.Reset();
            Cust.SetRange("No.", RHeader."Customer No.");
            if Cust.FindFirst() then begin
                InItRecType(Cust, Savings, Loans, Type::CUSTOMER);
                InsertReceiptLines(RHeader, Cust, RunBal, '', '', Type::CUSTOMER, LineCounter);
            end;
        end;

        InsertReceiptLines(RHeader, Cust, RunBal, '', '', Type::LOANS, LineCounter);

        InsertReceiptLines(RHeader, Cust, RunBal, '', '', Type::SAVINGS, LineCounter);

        if RunBal > 0 then
            InsertReceiptLines(RHeader, Cust, RunBal, '', '', Type::EXCESS, LineCounter);
    end;


    local procedure InsertReceiptLines(RHeader: Record "Receipt Header"; Cust: Record Customer; Var RunBal: Decimal; AccNo: Code[20]; LoanNo: Code[20]; Type: Option LOANS,CUSTOMER,SAVINGS,EXCESS; var LineCounter: Integer)
    var
        RLine: Record "Document line";
        ProdSetup: Record "Product Setup";
        Savings: Record "Savings Accounts";
        FosaAccount: Record "Savings Accounts";
        DateFilter: text[30];
        DedAmt: Decimal;
        ExciseDuty: Decimal;
        i: integer;
        Paid: boolean;
        AmtPaid: Decimal;
        j: integer;
        PrincipleDue: Decimal;
        PrincipleDuePerSchedule: Decimal;
        InterestDue: Decimal;
        PenaltyDue: Decimal;
        InsuranceDue: Decimal;
        MonthlyBalance: Decimal;
        DefAmt: Decimal;
        ArrearsDate: Date;
        LSchedule: Record "Loan Repayment Schedule";
        Members: Record Members;
        Narration: text;
        OpenBal: Decimal;
        RepayDate: Date;
        Instructions: Record "Dividend Instructions";
        PmtType: Record "Payment & Receipt Types";
        LoanExcess: decimal;
        SLedger: Record "Savings Ledger Entry";
        SharecapAcc: Record "Savings Accounts";
        DepositAccNo: Code[20];
        ExpectedAmt: Decimal;
        DaysDef: Integer;
        CheckDate: Date;
    begin

        RHeader.TestField("Posting Date");

        case Type of

            Type::CUSTOMER:
                begin
                    DedAmt := RHeader."Amount Recieved";

                    if (DedAmt > 0) and (RunBal > 0) then begin
                        if DedAmt > RunBal then
                            DedAmt := RunBal;

                        LineCounter += 1000;
                        Clear(RLine);
                        RLine.Init();
                        RLine."Header No." := RHeader."No.";
                        Rline."Posting Date" := RHeader."Posting Date";
                        RLine."Line No." := LineCounter;
                        RLine."Member No." := Cust."No.";
                        RLine.Validate(Type, Cust."Customer Posting Group");
                        RLine.Validate("Account No.", Cust."No.");
                        RLine.Validate(Amount, DedAmt);
                        RLine."External Doc." := RHeader."External Document No";
                        RLine.Description := RHeader.Narration;
                        RLine.Insert();

                        RunBal -= DedAmt;
                    end;
                end;

            Type::LOANS:
                begin
                    DedAmt := 0;
                    PrincipleDue := 0;
                    PrincipleDuePerSchedule := 0;
                    InterestDue := 0;
                    PenaltyDue := 0;
                    MonthlyBalance := 0;

                    Loans.Reset();
                    Loans.setcurrentkey("Recovery Priority");
                    Loans.SetRange("Member No.", RHeader."Customer No.");
                    Loans.setRange("Mobile Loan", false);
                    Loans.SetFilter("Total Outstanding Balance", '>0');
                    if Loans.FindSet() then begin
                        repeat
                            RepayDate := 0D;

                            if Loans."Schedule Start Date" <> 0D then
                                RepayDate := Loans."Schedule Start Date"
                            else if Loans."Repayment Start Date" <> 0D then
                                RepayDate := Loans."Repayment Start Date"
                            else if Loans."Disbursement Date" <> 0D then
                                RepayDate := Loans."Disbursement Date"
                            else
                                RepayDate := Loans."Application Date";

                            if RepayDate = 0D then
                                RepayDate := Today;

                            Loans."Repayment Day" := Date2DMY(RepayDate, 1);
                            Loans.Modify();
                        until Loans.Next() = 0;
                    end;

                    CheckDate := CalcDate('<-CM>', RHeader."Posting Date") - 1;

                    for j := 1 to 7 do begin

                        if j = 5 then
                            RecoverCurrentMonthDepositContribution(RHeader, Cust, RunBal, LineCounter);

                        Loans.Reset();
                        Loans.setcurrentkey("Recovery Priority", "Repayment Day");
                        Loans.SetAscending("Recovery Priority", true);
                        Loans.SetRange("Member No.", RHeader."Customer No.");
                        Loans.SetFilter("Total Outstanding Balance", '>0');

                        if j = 1 then
                            Loans.SetFilter("Outstanding Penalty", '>0')
                        else if j = 2 then
                            Loans.SetFilter("Outstanding Insurance", '>0')
                        else if j = 3 then
                            Loans.SetFilter("Outstanding Interest", '>0')
                        else if j = 4 then
                            Loans.SetFilter("Outstanding Principal", '>0')
                        else if j = 5 then
                            Loans.SetFilter("Outstanding Insurance", '>0')
                        else if j = 6 then
                            Loans.SetFilter("Outstanding Interest", '>0')
                        else if j = 7 then
                            Loans.SetFilter("Outstanding Principal", '>0');

                        if Loans.FindFirst() then begin
                            repeat

                                ProdSetup.Get(Loans."Loan Product Type");

                                if RunBal > 0 then begin

                                    if j = 1 then begin
                                        Loans.CalcFields("Outstanding Penalty");
                                        Loans."Outstanding Penalty" -= GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Penalty Paid");
                                        if Loans."Outstanding Penalty" < 0 then
                                            Loans."Outstanding Penalty" := 0;

                                        PenaltyDue := Loans."Outstanding Penalty";
                                        if PenaltyDue > RunBal then
                                            PenaltyDue := RunBal;

                                        //Narration := RHeader."No." + ' Penalty Repayment: ' + Loans."Loan No.";

                                        TransType := TransType::"Penalty Paid";
                                        RunBal -= PenaltyDue;

                                        if ProdSetup."USSD Product Name" <> '' then
                                            Narration := CopyStr(ProdSetup."USSD Product Name" + ':' + Format(TransType), 1, 100)
                                        else
                                            Narration := CopyStr(Loans."Loan Product Type Name" + ':' + Format(TransType), 1, 100);

                                        if PenaltyDue > 0 then begin
                                            UpsertReceiptLoanLine(RHeader, Loans, LineCounter, Narration, 0, 0, 0, PenaltyDue);
                                            PenaltyDue := 0;
                                        end;
                                    end;

                                    if j = 2 then begin
                                        Loans.CalcFields("Outstanding Insurance");

                                        InsuranceDue := GetInsuranceArrears(Loans."Loan No.", CheckDate) - GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Insurance Paid");
                                        if InsuranceDue < 0 then
                                            InsuranceDue := 0;

                                        if InsuranceDue > Loans."Outstanding Insurance" then
                                            InsuranceDue := Loans."Outstanding Insurance";

                                        if InsuranceDue > RunBal then
                                            InsuranceDue := RunBal;

                                        TransType := TransType::"Insurance Paid";
                                        RunBal -= InsuranceDue;

                                        if ProdSetup."USSD Product Name" <> '' then
                                            Narration := CopyStr(ProdSetup."USSD Product Name" + ':' + Format(TransType), 1, 100)
                                        else
                                            Narration := CopyStr(Loans."Loan Product Type Name" + ':' + Format(TransType), 1, 100);

                                        if InsuranceDue > 0 then begin
                                            UpsertReceiptLoanLine(RHeader, Loans, LineCounter, Narration, 0, 0, InsuranceDue, 0);
                                            insuranceDue := 0;
                                        end;
                                    end;

                                    if j = 3 then begin
                                        Loans.CalcFields("Outstanding Interest");

                                        InterestDue := GetInterestArrears(Loans."Loan No.", CheckDate) - GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Interest Paid");
                                        if InterestDue < 0 then
                                            InterestDue := 0;

                                        if InterestDue > Loans."Outstanding Interest" then
                                            InterestDue := Loans."Outstanding Interest";

                                        if InterestDue > RunBal then
                                            InterestDue := RunBal;

                                        TransType := TransType::"Interest Paid";
                                        RunBal -= InterestDue;

                                        if ProdSetup."USSD Product Name" <> '' then
                                            Narration := CopyStr(ProdSetup."USSD Product Name" + ':' + Format(TransType), 1, 100)
                                        else
                                            Narration := CopyStr(Loans."Loan Product Type Name" + ':' + Format(TransType), 1, 100);

                                        if InterestDue > 0 then begin
                                            UpsertReceiptLoanLine(RHeader, Loans, LineCounter, Narration, 0, InterestDue, 0, 0);
                                            interestDue := 0;
                                        end;
                                    end;

                                    if j = 4 then begin
                                        Loans.CalcFields("Outstanding Principal");

                                        GetDefaultedAmount(Loans."Loan No.", today, ExpectedAmt, AmtPaid, DefAmt, DaysDef, ArrearsDate, true, SaccoSetup."Arrears Grace Period");
                                        PrincipleDue := DefAmt - GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Principal Repayment");
                                        if PrincipleDue < 0 then
                                            PrincipleDue := 0;

                                        TransType := TransType::"Principal Repayment";

                                        if ProdSetup."USSD Product Name" <> '' then
                                            Narration := CopyStr(ProdSetup."USSD Product Name" + ':Principal Repayment', 1, 100)
                                        else
                                            Narration := CopyStr(Loans."Loan Product Type Name" + ':Principal Repayment', 1, 100);

                                        if PrincipleDue > Loans."Outstanding Principal" then
                                            PrincipleDue := Loans."Outstanding Principal";

                                        if PrincipleDue > RunBal then
                                            PrincipleDue := RunBal;

                                        RunBal -= PrincipleDue;

                                        if PrincipleDue > 0 then begin
                                            UpsertReceiptLoanLine(RHeader, Loans, LineCounter, Narration, PrincipleDue, 0, 0, 0);
                                            PrincipleDue := 0;
                                        end;
                                    end;

                                    if j = 5 then begin
                                        Loans.CalcFields("Outstanding Insurance");
                                        Loans."Outstanding Insurance" -= GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Insurance Paid");
                                        if Loans."Outstanding Insurance" < 0 then
                                            Loans."Outstanding Insurance" := 0;

                                        InsuranceDue := Loans."Outstanding Insurance";
                                        if InsuranceDue > RunBal then
                                            InsuranceDue := RunBal;

                                        TransType := TransType::"Insurance Paid";
                                        RunBal -= InsuranceDue;

                                        if ProdSetup."USSD Product Name" <> '' then
                                            Narration := CopyStr(ProdSetup."USSD Product Name" + ':' + Format(TransType), 1, 100)
                                        else
                                            Narration := CopyStr(Loans."Loan Product Type Name" + ':' + Format(TransType), 1, 100);

                                        if InsuranceDue > 0 then begin
                                            UpsertReceiptLoanLine(RHeader, Loans, LineCounter, Narration, 0, 0, InsuranceDue, 0);
                                            InsuranceDue := 0;
                                        end;
                                    end;

                                    if j = 6 then begin
                                        Loans.CalcFields("Outstanding Interest");
                                        Loans."Outstanding Interest" -= GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Interest Paid");
                                        if Loans."Outstanding Interest" < 0 then
                                            Loans."Outstanding Interest" := 0;

                                        InterestDue := Loans."Outstanding Interest";
                                        if InterestDue > RunBal then
                                            InterestDue := RunBal;

                                        TransType := TransType::"Interest Paid";
                                        RunBal -= InterestDue;

                                        if ProdSetup."USSD Product Name" <> '' then
                                            Narration := CopyStr(ProdSetup."USSD Product Name" + ':' + Format(TransType), 1, 100)
                                        else
                                            Narration := CopyStr(Loans."Loan Product Type Name" + ':' + Format(TransType), 1, 100);

                                        if InterestDue > 0 then begin
                                            UpsertReceiptLoanLine(RHeader, Loans, LineCounter, Narration, 0, InterestDue, 0, 0);
                                            InterestDue := 0;
                                        end;
                                    end;

                                    if j = 7 then begin
                                        Loans.CalcFields("Outstanding Principal");
                                        Loans."Outstanding Principal" -= GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Principal Repayment");
                                        Loans."Outstanding Principal" -= DedAmt;

                                        if Loans."Outstanding Principal" < 0 then
                                            Loans."Outstanding Principal" := 0;

                                        PrincipleDue := 0;
                                        PrincipleDuePerSchedule := 0;

                                        if Loans."Outstanding Principal" > 0 then begin

                                            LSchedule.Reset();
                                            LSchedule.SetRange("Loan No.", Loans."Loan No.");
                                            LSchedule.SetFilter("Repayment Date", '..%1', CalcDate('CM', RHeader."Posting Date"));
                                            if LSchedule.FindLast() then begin

                                                PrincipleDue := LSchedule."Monthly Principal";

                                                PrincipleDuePerSchedule := Loans."Outstanding Principal" - LSchedule."Loan Balance";
                                                if PrincipleDuePerSchedule < 0 then
                                                    PrincipleDuePerSchedule := 0;

                                                if PrincipleDue < PrincipleDuePerSchedule then
                                                    PrincipleDue := PrincipleDuePerSchedule;

                                                if Loans."Adjusted Repayment" > 0 then begin
                                                    PrincipleDue := Loans."Adjusted Repayment" - LSchedule."Monthly Interest";
                                                    if PrincipleDue < LSchedule."Monthly Principal" then
                                                        PrincipleDue := LSchedule."Monthly Principal";
                                                end;

                                            end else
                                                PrincipleDue := 0;

                                            TransType := TransType::"Principal Repayment";

                                            if ProdSetup."USSD Product Name" <> '' then
                                                Narration := CopyStr(ProdSetup."USSD Product Name" + ':' + Format(TransType), 1, 100)
                                            else
                                                Narration := CopyStr(Loans."Loan Product Type Name" + ':' + Format(TransType), 1, 100);
                                        end;

                                        if PrincipleDue > Loans."Outstanding Principal" then
                                            PrincipleDue := Loans."Outstanding Principal";

                                        if PrincipleDue > RunBal then
                                            PrincipleDue := RunBal;

                                        RunBal -= PrincipleDue;

                                        if PrincipleDue > 0 then begin
                                            UpsertReceiptLoanLine(RHeader, Loans, LineCounter, Narration, PrincipleDue, 0, 0, 0);
                                            PrincipleDue := 0;
                                        end;
                                    end;
                                end;
                            until Loans.Next() = 0;
                        end;
                    end;
                end;
            //Recovered on 12.08.2026 as requested to change
            Type::SAVINGS:
                begin

                end;

            Type::EXCESS:
                begin
                    // Pay Internal Loans
                    Instructions.Reset();
                    Instructions.SetCurrentKey(Priority);
                    Instructions.SetRange("Process Type", Instructions."Process Type"::"Excess-Receipt");
                    Instructions.SetRange("Member No.", RHeader."Customer No.");
                    Instructions.SetRange(Type, Instructions.Type::"Pay Internal Loan");
                    //Instructions.SetFilter(Amount, '>%1', 0);
                    if (Instructions.FindFirst()) and (RunBal > 0) then begin
                        repeat

                            if Instructions.Amount > 0 then
                                DefAmt := Instructions.Amount
                            else
                                DefAmt := RunBal;

                            if DefAmt > RunBal then
                                DefAmt := RunBal;

                            Loans.Reset();
                            Loans.SetCurrentKey("Disbursement Date");
                            Loans.SetAscending("Disbursement Date", true);
                            Loans.SetRange("Member No.", RHeader."Customer No.");
                            Loans.SetFilter("Total Outstanding Balance", '>0');
                            if Loans.FindSet() then
                                repeat
                                    if DefAmt > 0 then begin
                                        Loans.CalcFields("Outstanding Principal");
                                        LoanExcess := Loans."Outstanding Principal";
                                        LoanExcess -= GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Principal Repayment");
                                        if LoanExcess < 0 then
                                            LoanExcess := 0;
                                        if LoanExcess > DefAmt then
                                            LoanExcess := DefAmt;

                                        RLine.Reset();
                                        RLine.SetRange("Header No.", RHeader."No.");
                                        RLine.SetRange("Loan No.", Loans."Loan No.");
                                        RLine.SetRange("External Doc.", RHeader."External Document No");
                                        RLine.Setfilter("Principal Due", '>0');
                                        if RLine.FindFirst() then begin
                                            RLine."Principal Due" += LoanExcess;
                                            RLine.Amount += LoanExcess;
                                            RLine.Modify();
                                        end else begin
                                            if LoanExcess > 0 then begin
                                                LineCounter += 1000;
                                                Clear(RLine);
                                                RLine.Init();
                                                RLine."Header No." := RHeader."No.";
                                                RLine."Line No." := LineCounter;
                                                Rline."Posting Date" := RHeader."Posting Date";
                                                RLine."Member No." := Loans."Member No.";
                                                RLine.Type := 'LOANS';
                                                if PmtType.Get('LOANS') then
                                                    RLine."Account Type" := PmtType."Account Type";
                                                RLine."Account No." := Loans."Loan Account";
                                                RLine.Validate("Member No.", Loans."Member No.");
                                                RLine.Validate("Loan No.", Loans."Loan No.");
                                                RLine."Arrears" := 0;
                                                RLine."Principal Due" := LoanExcess;
                                                RLine.Amount := LoanExcess;
                                                RLine."External Doc." := RHeader."External Document No";
                                                RLine.Description := RHeader."No." + ' Loan Repayment';
                                                RLine.Insert();
                                            end;
                                        end;

                                        DefAmt -= LoanExcess;
                                        RunBal -= LoanExcess;
                                    end;
                                until (Loans.Next() = 0) or (DefAmt <= 0);
                        until Instructions.Next() = 0;
                    end;

                    // Pay Internal Savings
                    Instructions.Reset();
                    Instructions.SetCurrentKey(Priority);
                    Instructions.SetRange("Process Type", Instructions."Process Type"::"Excess-Receipt");
                    Instructions.SetRange("Member No.", RHeader."Customer No.");
                    Instructions.SetRange(Type, Instructions.Type::"Pay Internal Savings");
                    //Instructions.SetFilter(Amount, '>%1', 0);
                    if (Instructions.FindFirst()) and (RunBal > 0) then begin
                        repeat

                            if Instructions.Amount > 0 then
                                DefAmt := Instructions.Amount
                            else
                                DefAmt := RunBal;

                            if DefAmt > RunBal then
                                DefAmt := RunBal;

                            Savings.Reset();
                            Savings.SetRange("No.", Instructions."Account No.");
                            if Savings.FindFirst() then begin

                                Narration := CopyStr(Savings."Product Name", 1, 100);


                                RLine.Reset();
                                RLine.SetRange("Header No.", RHeader."No.");
                                RLine.SetRange("Account No.", Savings."No.");
                                RLine.SetRange("External Doc.", RHeader."External Document No");
                                if RLine.FindFirst() then begin
                                    RLine.Amount += DefAmt;
                                    RLine.Modify();
                                end else begin
                                    if DefAmt > 0 then begin
                                        LineCounter += 1000;
                                        Clear(RLine);
                                        RLine.Init();
                                        RLine."Header No." := RHeader."No.";
                                        RLine."Line No." := LineCounter;
                                        Rline."Posting Date" := RHeader."Posting Date";
                                        RLine."Member No." := Savings."Member No.";
                                        RLine.Type := Savings."Product Type";
                                        if PmtType.Get(Savings."Product Type") then
                                            RLine."Account Type" := PmtType."Account Type";
                                        RLine."Account No." := Savings."No.";
                                        RLine.Validate("Member No.", Savings."Member No.");
                                        RLine."Principal Due" := DefAmt;
                                        RLine.Amount := DefAmt;
                                        RLine.Description := Narration;
                                        RLine."Loan No." := '';
                                        RLine."External Doc." := RHeader."External Document No";
                                        RLine.Insert();
                                    end;
                                end;
                                RunBal -= DefAmt;
                            end;
                        until Instructions.Next() = 0;
                    end;

                    // Remaining balance - oldest outstanding loan principal
                    if RunBal > 0 then begin
                        Loans.Reset();
                        Loans.SetCurrentKey("Disbursement Date");
                        Loans.SetAscending("Disbursement Date", true);
                        Loans.SetRange("Member No.", RHeader."Customer No.");
                        Loans.SetFilter("Total Outstanding Balance", '>0');
                        if Loans.FindSet() then
                            repeat
                                if RunBal > 0 then begin
                                    Loans.CalcFields("Outstanding Principal");
                                    LoanExcess := Loans."Outstanding Principal";
                                    LoanExcess -= GetReceiptLoanCredits(RHeader."No.", Loans."Loan No.", TransType::"Principal Repayment");
                                    if LoanExcess < 0 then
                                        LoanExcess := 0;
                                    if LoanExcess > RunBal then
                                        LoanExcess := RunBal;

                                    if LoanExcess > 0 then begin

                                        Narration := CopyStr(Loans."Loan Product Type Name" + ':' + Format(' Loan Repayment'), 1, 100);

                                        RLine.Reset();
                                        RLine.SetRange("Header No.", RHeader."No.");
                                        RLine.SetRange("Loan No.", Loans."Loan No.");
                                        RLine.SetFilter("Principal Due", '>0');
                                        RLine.SetRange("External Doc.", RHeader."External Document No");
                                        RLine.Setfilter("Principal Due", '>0');
                                        if RLine.FindFirst() then begin
                                            RLine."Principal Due" += LoanExcess;
                                            RLine.Amount += LoanExcess;
                                            RLine.Modify();
                                        end else begin
                                            LineCounter += 1000;
                                            Clear(RLine);
                                            RLine.Init();
                                            RLine."Header No." := RHeader."No.";
                                            RLine."Line No." := LineCounter;
                                            Rline."Posting Date" := RHeader."Posting Date";
                                            RLine."Member No." := Loans."Member No.";
                                            RLine.Type := 'LOANS';
                                            if PmtType.Get('LOANS') then
                                                RLine."Account Type" := PmtType."Account Type";
                                            RLine."Account No." := Loans."Loan Account";
                                            RLine.Validate("Member No.", Loans."Member No.");
                                            RLine.Validate("Loan No.", Loans."Loan No.");
                                            RLine."Arrears" := 0;
                                            RLine."Principal Due" := LoanExcess;
                                            RLine.Amount := LoanExcess;
                                            RLine."External Doc." := RHeader."External Document No";
                                            RLine.Description := Narration;
                                            RLine.Insert();
                                        end;

                                        RunBal -= LoanExcess;
                                    end;
                                end;
                            until (Loans.Next() = 0) or (RunBal <= 0);
                    end;

                    // Remaining balance - deposit contribution
                    if RunBal > 0 then begin
                        DepositAccNo := '';
                        Clear(Savings);
                        Savings.Reset();
                        Savings.SetRange("Member No.", RHeader."Customer No.");
                        Savings.SetFilter(Savings."Product Category", '%1', Savings."Product Category"::"Deposit Contribution");
                        if Savings.FindFirst() then
                            DepositAccNo := Savings."No."
                        else
                            DepositAccNo := Legacy.GetDepositAccounts(RHeader."Customer No.");

                        if DepositAccNo = '' then
                            Error('Member %1 has %2 remaining after loan allocation, but no deposit contribution account was found.',
                                RHeader."Customer No.", RunBal);

                        Savings.Get(DepositAccNo);
                        InItRecType(Cust, Savings, Loans, Type::SAVINGS);

                        Narration := CopyStr(Savings."Product Name", 1, 100);

                        RLine.Reset();
                        RLine.SetRange("Header No.", RHeader."No.");
                        RLine.SetRange("Account No.", Savings."No.");
                        RLine.SetRange("External Doc.", RHeader."External Document No");
                        if RLine.FindFirst() then begin
                            RLine.Validate(Amount, RLine.Amount + RunBal);
                            RLine.Modify();
                        end else begin
                            LineCounter += 1000;
                            Clear(RLine);
                            RLine.Init();
                            RLine."Header No." := RHeader."No.";
                            RLine."Line No." := LineCounter;
                            Rline."Posting Date" := RHeader."Posting Date";
                            RLine."Member No." := Savings."Member No.";
                            RLine.Type := Savings."Product Type";
                            if PmtType.Get(Savings."Product Type") then
                                RLine."Account Type" := PmtType."Account Type";
                            RLine."Account No." := Savings."No.";
                            RLine.Validate("Member No.", Savings."Member No.");
                            RLine.Validate(Type, Savings."Product Type");
                            RLine.Validate(Amount, RunBal);
                            RLine.Description := Narration;
                            RLine."Loan No." := '';
                            RLine."External Doc." := RHeader."External Document No";
                            RLine.Insert();
                        end;

                        RunBal := 0;
                    end;
                end;
        end;
    end;

    local procedure GetReceiptLoanCredits(HeaderNo: Code[20]; LoanNo: Code[20]; TransType: Enum "Transaction Type Enum") Amt: Decimal
    var
        Lines: Record "Document Line";
    begin
        Lines.Reset();
        Lines.SetRange("Header No.", HeaderNo);
        Lines.SetRange("Loan No.", LoanNo);
        if Lines.findfirst() then;

        case TransType of
            TransType::"Interest Paid":
                begin

                    begin
                        Lines.calcsums("Interest Due");
                        Lines.CalcSums("Interest Arrears");
                        Amt := Lines."Interest Due" + Lines."Interest Arrears";
                    end;
                end;
            TransType::"Principal Repayment":
                begin

                    begin
                        Lines.calcsums(Arrears);
                        Lines.calcsums("Principal Due");
                        Amt := Lines."Principal Due" + Lines.Arrears;
                    end;
                end;
            TransType::"Penalty Paid":
                begin

                    begin
                        Lines.calcsums("Penalty Due");
                        Amt := Lines."Penalty Due";
                    end;
                end;
            TransType::"Insurance Paid":
                begin
                    Lines.CalcSums("Insurance Due");
                    Amt := Lines."Insurance Due";
                end;
        end;
    end;

    local procedure RecoverCurrentMonthDepositContribution(RHeader: Record "Receipt Header"; Cust: Record Customer; var RunBal: Decimal; var LineCounter: Integer)
    var
        Savings: Record "Savings Accounts";
        FosaAccount: Record "Savings Accounts";
        RLine: Record "Document Line";
        PmtType: Record "Payment & Receipt Types";
        DepositAccNo: Code[20];
        DedAmt: Decimal;
        CurrentMonthDeposits: Decimal;
        ExistingReceiptDeposit: Decimal;
        OpenBal: Decimal;
        Narration: Text;
        ProdSetup: Record "Product Setup";
        Members: Record Members;
        MonthlyBalance: Decimal;
        ExciseDuty: Decimal;
        SharecapAcc: Record "Savings Accounts";
        Loans: Record Loans;
        Type: Option LOANS,CUSTOMER,SAVINGS,EXCESS;
        Paid: Boolean;
    begin
        if RunBal <= 0 then
            exit;

        DepositAccNo := '';
        ProdSetup.Reset();
        ProdSetup.setcurrentkey("Recovery Priority");
        ProdSetup.SetRange("Product Class", ProdSetup."Product Class"::Savings);
        if ProdSetup.FindFirst() then begin
            repeat
                DedAmt := 0;
                if ProdSetup."Mandatory Contribution" > 0 then
                    DedAmt := ProdSetup."Mandatory Contribution";

                Savings.Reset();
                Savings.SetRange("Member No.", RHeader."Customer No.");
                Savings.SetRange("Product Type", ProdSetup."Product ID");
                if Savings.FindFirst() then begin
                    Members.Get(Savings."Member No.");
                    repeat
                        if RunBal > 0 then begin

                            if Savings."Monthly Contribution" > DedAmt then
                                DedAmt := Savings."Monthly Contribution";

                            if DedAmt > 0 then begin
                                OpenBal := 0;
                                if SaccoSetup."Go Live Date" >= CalcDate('-CM', RHeader."Posting Date") then begin
                                    if SaccoSetup."Go Live Date" <= CalcDate('CM', RHeader."Posting Date") then begin
                                        FosaAccount.Reset();
                                        FosaAccount.SetRange("No.", Savings."No.");
                                        FosaAccount.SetFilter("Date Filter", '%1', SaccoSetup."Go Live Date");
                                        if FosaAccount.FindFirst() then begin
                                            FosaAccount.CalcFields("Balance (LCY)");
                                            OpenBal := FosaAccount."Balance (LCY)";
                                        end;
                                    end
                                end;

                                FosaAccount.Reset();
                                FosaAccount.SetRange("No.", Savings."No.");
                                FosaAccount.SetRange("Date Filter", CalcDate('-CM', RHeader."Posting Date"), CalcDate('CM', RHeader."Posting Date"));
                                if FosaAccount.FindFirst() then begin
                                    FosaAccount.CalcFields("Balance (LCY)");
                                    MonthlyBalance := FosaAccount."Balance (LCY)" - OpenBal;
                                    DedAmt := DedAmt - MonthlyBalance;
                                    if DedAmt < 0 then
                                        DedAmt := 0;
                                end;

                                if ProdSetup."Maximum Balance" > 0 then begin
                                    FosaAccount.Reset();
                                    FosaAccount.SetRange("No.", Savings."No.");
                                    if FosaAccount.FindFirst() then begin
                                        FosaAccount.CalcFields("Balance (LCY)");
                                        if DedAmt + FosaAccount."Balance (LCY)" > ProdSetup."Maximum Balance" then
                                            DedAmt := ProdSetup."Maximum Balance" - FosaAccount."Balance (LCY)";
                                        if DedAmt < 0 then
                                            DedAmt := 0;
                                    end;
                                end;

                                if Savings."Product Category" = Savings."Product Category"::"Registration Fee" then begin
                                    ProdSetup.TestField("Registration Start Date");
                                    if Members."Registration Date" = 0D then
                                        DedAmt := 0
                                    else
                                        if Members."Registration Date" <= ProdSetup."Registration Start Date" then begin
                                            FosaAccount.Reset();
                                            FosaAccount.SetRange("No.", Savings."No.");
                                            if FosaAccount.FindFirst() then
                                                DedAmt := 0;
                                        end;

                                    // Excise duty line for Registration Fee
                                    if DedAmt > 0 then begin
                                        SaccoSetup.get();
                                        ExciseDuty := Round(DedAmt * SaccoSetup."Excise Duty (%)" / 100, 0.01, '=');
                                        Narration := CopyStr(Savings.name + ' : ' + Savings."Member No." + '-Excise Duty on Registration Fee', 1, 100);

                                        if ExciseDuty > RunBal then
                                            ExciseDuty := RunBal;

                                        if ExciseDuty > 0 then begin
                                            LineCounter += 1000;
                                            Clear(RLine);
                                            RLine.Init();
                                            RLine."Header No." := RHeader."No.";
                                            RLine."Line No." := LineCounter;
                                            Rline."Posting Date" := RHeader."Posting Date";
                                            RLine."Member No." := Savings."Member No.";
                                            RLine.Type := 'GLAC';
                                            RLine."Account Type" := RLine."Account Type"::"G/L Account";
                                            RLine."Account No." := SaccoSetup."Excise Duty GL";
                                            RLine.Validate("Member No.", Savings."Member No.");
                                            RLine.Validate(Amount, ExciseDuty);
                                            RLine.Description := Narration;
                                            RLine."Loan No." := '';
                                            RLine."External Doc." := RHeader."External Document No";
                                            RLine.Insert();
                                            RunBal -= ExciseDuty;
                                        end;
                                    end;
                                end;

                                if DedAmt > RunBal then
                                    DedAmt := RunBal;

                                if Savings."Product Category" = Savings."Product Category"::"Share Capital" then begin
                                    SharecapAcc.Reset();
                                    SharecapAcc.SetRange("No.", Savings."No.");
                                    if SharecapAcc.FindFirst() then begin
                                        SharecapAcc.CalcFields("Balance (LCY)");
                                        if SharecapAcc."Balance (LCY)" >= ProdSetup."Maximum Balance" then
                                            DedAmt := 0;
                                    end;
                                end;

                                if Savings."Product Category" = Savings."Product Category"::"Deposit Contribution" then begin
                                    DedAmt := 0;

                                    /* DedAmt := GetMonthlyDepositAmount(RHeader."Customer No.");
                                    if DedAmt = 0 then */
                                    DedAmt := Savings."Monthly Contribution";
                                end;
                            end;

                            if DedAmt < 0 then
                                DedAmt := 0;

                            RLine.Reset();
                            RLine.SetRange("Header No.", RHeader."No.");
                            RLine.SetRange("Account No.", Savings."No.");
                            RLine.SetRange("External Doc.", RHeader."External Document No");
                            if RLine.FindFirst() then begin
                                RLine.CalcSums(Amount);
                                DedAmt -= RLine.Amount;
                            end;

                            if DedAmt < 0 then
                                DedAmt := 0;

                            if DedAmt > RunBal then
                                DedAmt := RunBal;

                            FosaAccount.Reset();
                            FosaAccount.SetRange("No.", Savings."No.");
                            FosaAccount.SetRange("Date Filter", CalcDate('-CM', RHeader."Posting Date"), CalcDate('CM', RHeader."Posting Date"));
                            //FosaAccount.SetFilter("Balance (LCY)", '>0');
                            if FosaAccount.FindFirst() then begin
                                FosaAccount.CalcFields("Balance (LCY)");
                                if FosaAccount."Balance (LCY)" > 0 then
                                    DedAmt := DedAmt - FosaAccount."Balance (LCY)";
                            end;

                            // Main savings contribution line
                            if DedAmt > 0 then begin
                                InItRecType(Cust, Savings, Loans, Type::SAVINGS);
                                Narration := CopyStr(Savings."Product Name", 1, 100);

                                LineCounter += 1000;
                                Clear(RLine);
                                RLine.Init();
                                RLine."Line No." := LineCounter;
                                Rline."Posting Date" := RHeader."Posting Date";
                                RLine."Header No." := RHeader."No.";
                                RLine."Member No." := Savings."Member No.";
                                RLine.Type := Savings."Product Type";
                                if PmtType.Get(Savings."Product Type") then
                                    RLine."Account Type" := PmtType."Account Type";
                                RLine."Account No." := Savings."No.";
                                RLine.Validate("Member No.", Savings."Member No.");
                                RLine.Validate(Type, Savings."Product Type");
                                RLine.Validate(Amount, DedAmt);
                                RLine.Description := Narration;
                                RLine."Loan No." := '';
                                RLine."External Doc." := RHeader."External Document No";
                                if not Paid then begin
                                    RLine.Insert();
                                    RunBal -= DedAmt;
                                end;
                            end;
                        end;
                    until Savings.Next() = 0;
                end;
            until ProdSetup.Next() = 0;
        end;



    end;

    local procedure UpsertReceiptLoanLine(RHeader: Record "Receipt Header"; LoanRec: Record Loans; var LineCounter: Integer; Narration: Text; PrincipalDue: Decimal; InterestDue: Decimal; InsuranceDue: Decimal; PenaltyDue: Decimal)
    var
        RLine: Record "Document Line";
        PmtType: Record "Payment & Receipt Types";
    begin
        RLine.Reset();
        RLine.SetRange("Header No.", RHeader."No.");
        RLine.SetRange("Loan No.", LoanRec."Loan No.");
        RLine.SetRange("External Doc.", RHeader."External Document No");
        RLine.SetRange(Description, Narration);
        if RLine.FindFirst() then begin
            Rline."Posting Date" := RHeader."Posting Date";
            if PenaltyDue > 0 then
                RLine.Validate("Penalty Due", RLine."Penalty Due" + PenaltyDue);
            if InsuranceDue > 0 then
                RLine.Validate("Insurance Due", RLine."Insurance Due" + InsuranceDue);
            if InterestDue > 0 then
                RLine.Validate("Interest Due", RLine."Interest Due" + InterestDue);
            if PrincipalDue > 0 then
                RLine.Validate("Principal Due", RLine."Principal Due" + PrincipalDue);
            RLine.Validate(Amount, RLine.Amount + PrincipalDue + InterestDue + InsuranceDue + PenaltyDue);
            RLine.Modify();
        end else begin
            LineCounter += 1000;
            Clear(RLine);
            RLine.Init();
            RLine."Header No." := RHeader."No.";
            RLine."Line No." := LineCounter;
            RLine."Member No." := LoanRec."Member No.";
            RLine.Type := 'LOANS';
            if PmtType.Get('LOANS') then
                RLine."Account Type" := PmtType."Account Type";
            RLine."Account No." := LoanRec."Loan Account";
            RLine.Validate("Member No.", LoanRec."Member No.");
            RLine.Validate("Loan No.", LoanRec."Loan No.");
            if PenaltyDue > 0 then
                RLine.Validate("Penalty Due", PenaltyDue);
            if InsuranceDue > 0 then
                RLine.Validate("Insurance Due", InsuranceDue);
            if InterestDue > 0 then
                RLine.Validate("Interest Due", InterestDue);
            if PrincipalDue > 0 then
                RLine.Validate("Principal Due", PrincipalDue);

            RLine.Validate(Amount, PrincipalDue + InterestDue + InsuranceDue + PenaltyDue);
            RLine."External Doc." := RHeader."External Document No";
            Rline."Posting Date" := RHeader."Posting Date";
            RLine.Description := Narration;
            RLine.Insert();
        end;
    end;

