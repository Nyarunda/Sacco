                //end;
                if SalLines."Account Not Found" = false then begin
                    MemberNo := '';
                    Salaccno := '';

                    MemberNo := SalLines."Member No.";
                    Salaccno := SalLines."Account No.";
                    RunBal := SalLines.Amount;
                    if SalHeaD."Income Type" = SalHeaD."Income Type"::PloughBack then begin

                        if Account.Get(SalLines."Account No.") then begin

                            UserSetup.TestField("Global Dimension 2 Code");

                            DActivity2 := Account."Global Dimension 1 Code";
                            if SalHeaD."Process Type" = SalHeaD."process type"::"General Process" then begin
                                Account.TestField("Global Dimension 2 Code");
                                DBranch2 := Account."Global Dimension 2 Code";
                            end;
                            if SalHeaD."Process Type" = SalHeaD."process type"::"Branch Process" then
                                DBranch2 := UserSetup."Global Dimension 2 Code";

                            if DBranch2 = '' then
                                Error('Branch Code Must have a value');
                            //Check Account Bal
                            AvailableBal := MemberActivities.GetAccountBalance(Account."No.");

                            if SalLines.Amount > AvailableBal then
                                RunBal := AvailableBal;

                            if RunBal < 0 then
                                RunBal := 0;

                            SalaryBufferInsert(RunBal, MemberNo, SalHeaD.no, DocNo, PDate, Accttype::Savings, SalLines."Account No.", PostingRemarks,
                                    Balaccttype::"G/L Account", '', RunBal, ExtDocNo, '', Transtype::" ", DActivity2, DBranch2, EntryType::" ");

                            //SaccoSetup.TESTFIELD("Income Control Account");

                            if SalHeaD."Plough Back Type" = SalHeaD."Plough Back Type"::Deposits then
                                Acc := Legacy.GetDepositAccounts(Account."Member No.");

                            if SalHeaD."Plough Back Type" = SalHeaD."Plough Back Type"::"Share Capital" then
                                Acc := Legacy.GetShareCapitalAccount(Account."Member No.");

                            SalaryBufferInsert(RunBal, MemberNo, SalHeaD.no, DocNo, PDate, SalHeaD."Account Type"::Savings, Acc, CopyStr(SalLines.Name + '-' + PostingRemarks, 1, 100),
                                    Balaccttype::"G/L Account", '', -RunBal, ExtDocNo, '', Transtype::" ", DActivity2, DBranch2, EntryType::" ");



                            //MemberActivities.GetGeneralChargeAmount("Destination Transaction Type", SalLines.Amount, ChargeAmt, ChargeDuty, ChargeAcctType, ChargeAcct);

                            ChargesLines.reset();
                            ChargesLines.SetRange("Transaction Type", SalHeaD."Destination Transaction Type");
                            if ChargesLines.FindSet() then
                                repeat
                                    MemberActivities.GetLineChargeAmount(SalHeaD."Destination Transaction Type", RunBal, ChargeAmt,
                                    ChargeDuty, ChargeAcctType, ChargeAcct, ChargesLines.Description);

                                    SalaryBufferInsert(RunBal, MemberNo, SalHeaD.no, DocNo, PDate, Accttype::Savings, Acc, ChargesLines.Description,
                                        Balaccttype::"G/L Account", ChargeAcct, -ChargeAmt, ExtDocNo, '', Transtype::" ", DActivity2, DBranch2, EntryType::" ");


                                until ChargesLines.next = 0;


                            if RunBal < 0 then
                                RunBal := 0;

                            NetAmount := RunBal;


                            if SalLines."Member No." <> '' then begin

                            end;
                        end;
                    end;
                end;

                //if not PostLinebyLine then begin
                dWindow.Update(3, CurrentRecordNo);
                dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));
            //end;
            until SalLines.Next = 0;
        end;



        SalDed.Reset();
        SalDed.SetRange("Salary Header No.", SalHeaD.no);
        SalDed.SetRange("Amount Paid", 0);
        SalDed.SetRange(Variance, 0);
        if SalDed.findfirst then begin
            repeat
                SalDed.Variance := SalDed."Expected Amount" - SalDed."Amount Paid";
                SalDed.Modify();
            until SalDed.Next() = 0;
        end;

        //if not PostLinebyLine then begin
        dWindow.Close;
        //end;

        //TestBatch := IncStr(TestBatch);
        //end;
        Message('Posting Buffer Generated');

    end;

    procedure GenerateP2FSalaryDeductions(SalHeaD: Record "Salary Header"; ParMemberNo: Code[20])
    var
        SalLines: Record "Salary Lines";
        UserSetup: Record "User Setup";
