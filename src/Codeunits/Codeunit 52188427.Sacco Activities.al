        LoanCharge: Record "Loan Charges";
        RT: Enum "Email Recipient Type";
        LoanLogs: Record "Email Logs Notifications";
        Base64: Text;
        FileName: Text;
        FilePath: Text;
        VarTempBlob: Codeunit "Temp Blob";
        B64: Codeunit Base64;
        IStream: InStream;
        OStream: OutStream;
        VarVariant: Variant;
        RecRef: RecordRef;
        TheRecordID: RecordID;
        HasTopUp: Boolean;
        TopUpCommission: Decimal;
        ProcessingFee: Decimal;
    begin
        String := '';
        FullString := '';
        SalutationTxt := '';
        RegardsTxt := '';
        Receiver := '';
        Msg := '';

        LoanLogs.Reset();
        LoanLogs.SetRange("Sent", false);
        if LoanNo <> '' then
            LoanLogs.SetRange("Loan No.", LoanNo);
        LoanLogs.SetFilter(Source, '%1|%2', LoanLogs.Source::Guarantor, LoanLogs.Source::"Loan Application");
        if LoanLogs.FindSet() then
            repeat
                Clear(RecRef);
                Clear(TheRecordID);

                SaccoSetup.Get();
                if Loans.Get(LoanLogs."Loan No.") then begin

                    Member.Get(Loans."Member No.");
                    TheRecordID := Loans.RecordId;
                    RecRef.Open(TheRecordID.TableNo);
                    RecRef.Get(TheRecordID);
                    RecRef.SetRecFilter();
                    VarVariant := RecRef;

                    if LoanLogs.Source = LoanLogs.Source::Guarantor then
                        if Member.Get(LoanLogs."Guarantor No.") then;

                    if SaccoActivities.ValidEmailAddress(Member."E-Mail") then begin

                        ProductSetup.Get(Loans."Loan Product Type");

                        String := SelectStr(1, Member.Name);
                        SalutationTxt := 'Dear' + ' ' + String + ',';
                        RegardsTxt := 'Kind Regards';
                        Receiver := Member."E-Mail";

                        EmailMessage.Create(Receiver, SalutationTxt, LoanLogs.Msg, true);

                        //if 

                        if LoanLogs.Source = LoanLogs.Source::"Loan Application" then begin

                            /* Attach Loan Schedule */
                            Clear(VarTempBlob);
                            VarTempBlob.CreateOutStream(OStream);
                            Report.SaveAs(Report::"Loan Repayment Schedule", '', ReportFormat::Pdf, OStream, RecRef);
                            VarTempBlob.CreateInStream(IStream);
                            Base64 := B64.StreamToBase64String(IStream);
                            if Base64 <> '' then
                                EmailMessage.AddAttachment(Loans."Member No." + '-Loan Schedule.pdf', 'application/pdf', Base64);

                            /* Attach Disbursement Letter - conditional */
                            Clear(VarTempBlob);
                            VarTempBlob.CreateOutStream(OStream);

                            LoanTopUp.Reset();
                            LoanTopUp.SetRange("Loan No.", Loans."Loan No.");
                            LoanTopUp.SetFilter("Total Top Up", '>0');
                            HasTopUp := LoanTopUp.FindSet();
                            TopUpCommission := 0;
                            if HasTopUp then
                                repeat
                                    TopUpCommission += LoanTopUp.Commision;
                                until LoanTopUp.Next() = 0;

                            LoanCharge.Reset();
                            LoanCharge.SetRange("Loan No.", Loans."Loan No.");
                            LoanCharge.SetRange("Charge Code", 'PFEE');
                            ProcessingFee := 0;
                            if LoanCharge.FindSet() then
                                repeat
                                    ProcessingFee += LoanCharge.Amount;
                                until LoanCharge.Next() = 0;

                            if HasTopUp then begin
                                if (TopUpCommission = 0) and (ProcessingFee = 0) then
                                    Report.SaveAs(Report::"Top Up Disbursement No Charge", '', ReportFormat::Pdf, OStream, RecRef)
                                else
                                    Report.SaveAs(Report::"Top Up Disbursement Letter", '', ReportFormat::Pdf, OStream, RecRef);
                            end else
                                if Loans."Type of Disbursement" = Loans."Type of Disbursement"::"Partial Disbursement" then
                                    Report.SaveAs(Report::"Partial Disbursement Letter", '', ReportFormat::Pdf, OStream, RecRef)
                                else
                                    if ProcessingFee = 0 then
                                        Report.SaveAs(Report::"Loan Disbur. Without Charges", '', ReportFormat::Pdf, OStream, RecRef)
                                    else
                                        Report.SaveAs(Report::"Loan Disbursement letter", '', ReportFormat::Pdf, OStream, RecRef);

                            VarTempBlob.CreateInStream(IStream);
                            Base64 := B64.StreamToBase64String(IStream);
                            if Base64 <> '' then
                                EmailMessage.AddAttachment(Loans."Member No." + '-Loan Disbursement.pdf', 'application/pdf', Base64);

                            /* Attach Lawyer Clearance if exists */
                            if HasLawyerClearance(Loans."Loan No.") then begin
                                Clear(VarTempBlob);
                                VarTempBlob.CreateOutStream(OStream);
                                Report.SaveAs(Report::"Lawyer Clearance Letter", '', ReportFormat::Pdf, OStream, RecRef);
                                VarTempBlob.CreateInStream(IStream);
                                Base64 := B64.StreamToBase64String(IStream);
                                if Base64 <> '' then
                                    EmailMessage.AddAttachment(Loans."Member No." + '-Lawyer Clearance.pdf', 'application/pdf', Base64);
                            end;

                            if SaccoActivities.ValidEmailAddress(SaccoSetup."Credit Email") then
                                EmailMessage.AddRecipient(RT::Cc, SaccoSetup."Credit Email");

                        end;

                        //if not TrySendEmail(Email, EmailMessage) then
                        //   exit;
                        Email.Send(EmailMessage);

                        LoanLogs.Sent := true;
                        LoanLogs.Modify();
                        Commit();

                    end;
                end;
            until LoanLogs.Next() = 0;
    end;

