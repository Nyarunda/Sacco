        SavingsAccount: Record "Savings Accounts";
        Body: Text;
        FirstName: Text;
        MessageText: Text;
        SaccoName: Text;
        Year: Integer;
    begin
        SaccoName := GetCompanyNameForNotifications();
        Year := Date2DMY(SavingsInterestHeader."Posting Date", 3);
