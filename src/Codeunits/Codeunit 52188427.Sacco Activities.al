    procedure ChargeStatementFee(MemberNo: Code[20])
    var
        NoOfPages: Integer;
        ChargesLines: Record "Transaction Charges Lines";

        MemberActivities: Codeunit "Member Activities";

        ChargeAcctType: Enum "Gen. Journal Account Type";
        SaccoSetup: Record "Sacco Setup";
        SaccoActivities: Codeunit "Sacco Activities";
        ChargeAmt: Decimal;
        ChargeDuty: Decimal;
        ChargeAcct: Code[20];

        JTemplate: Code[10];
        JBatch: Code[10];

        TType: Enum "Transaction Type Enum";

        RunBal: Decimal;

        AccBal: Decimal;

        BankingUserSetup: Record "Banking User Setup";

        ProdSetup: Record "Product Setup";
        Acc: Record "Savings Accounts";
        Legacy: Codeunit Legacy;
        DimID: integer;
    begin
        Acc.Get(Legacy.GetOrdinaryAccount(MemberNo));

        BankingUserSetup.Get(UserId);
        BankingUserSetup.TestField("Cashier Journal Template");
        BankingUserSetup.TestField("Cashier Journal Batch");
        JTemplate := BankingUserSetup."Cashier Journal Template";
        JBatch := BankingUserSetup."Cashier Journal Batch";

        AccBal := SaccoActivities.GetAccountBalance(Acc."No.");
        ProdSetup.Get(Acc."Product Type");
        ProdSetup.TestField("Statement Charge");
        ChargesLines.reset();
        ChargesLines.SetRange("Transaction Type", ProdSetup."Statement Charge");
        if ChargesLines.FindSet() then begin
            SaccoActivities.JournalInit(JTemplate, JBatch);
            UserSetup.Get(UserId);
            DimID := UserSetup."Dimension Set ID";
            SaccoSetup.Get();
            //repeat

            MemberActivities.GetLineChargeAmount(ProdSetup."Statement Charge", 0, ChargeAmt, ChargeDuty, ChargeAcctType, ChargeAcct, ChargesLines.Description);

            AccBal -= (ChargeAmt + ChargeDuty);
            if AccBal < 0 then Error('The transaction will lead to overdrawing of Acc. %1', Acc."No.");

            SaccoActivities.JournalInsert(Jtemplate, JBatch, 'STMT-CHARGE', Today, ChargeAcctType::Savings, Acc."No.", ChargesLines.Description,
                                            ChargeAcctType, ChargeAcct, ChargeAmt, Acc."No.", '', TType::" ",
                                            Acc."Global Dimension 1 Code", Acc."Global Dimension 2 Code", true, TChannel::" ", DimID);


            //Excise Duty

            SaccoSetup.TestField("Excise Duty GL");
            SaccoActivities.JournalInsert(Jtemplate, JBatch, 'STMT-CHARGE', Today, ChargeAcctType::Savings, Acc."No.", 'Excise Duty',
                                                ChargeAcctType::"G/L Account", SaccoSetup."Excise Duty GL", ChargeDuty, Acc."No.", '', TType::" ",
                                                Acc."Global Dimension 1 Code", Acc."Global Dimension 2 Code", true, TChannel::" ", DimID);


            //until ChargesLines.next = 0;

            SaccoActivities.JournalPost(JTemplate, JBatch);
            Message('The charge was successful');
        end;

    end;

    procedure GuarantorLoanOffset(DefLoanNo: Code[20]; SelectedOption: Integer; DRecovery: Record "Defaulter Loan Recovery")
    var
        Dim: array[2] of Code[20];
        AccNo: Code[20];
        ExtDoc: COde[20];
        PDate: Date;
        CurrentRecordNo: Integer;
        NoOfRecords: Integer;
        AvailShares: Decimal;
        JDebits: Decimal;
        LoanAllocation: Decimal;
        InterestAllocation: Decimal;
        AmtRec: Decimal;
        DedAmt: Decimal;
        Desc: Text[100];
        Memb: Record Members;
        Savings: Record "Savings Accounts";
        LGurantors: Record "Loan Security";
        DivPosting: Record "Defaulter Recovery Buffer";

    begin

        //Interest
        DivPosting.reset();
        DivPosting.setrange("Header No.", DRecovery."No.");
        if DivPosting.findfirst() then DivPosting.DeleteAll();

        DRecovery.TestField(Description);

        GetPaymentJournalTemplate(JTemplate, JBatch);

        //Principal
        Loans.RESET;
        IF DefLoanNo <> '' THEN
            Loans.SETRANGE("Loan No.", DefLoanNo);
        IF SelectedOption = 1 THEN
            Loans.SETFILTER("Loans Category-SASRA", '%1|%2|%3|%4', Loans."Loans Category-SASRA"::Doubtful, Loans."Loans Category-SASRA"::Substandard, Loans."Loans Category-SASRA"::Loss, Loans."Loans Category-SASRA"::Watch)
        ELSE
            Loans.SetRange("Loans Category-SASRA", SelectedOption);
        Loans.Setfilter(Loans."Outstanding Principal", '>%1', 0);
        Loans.SetFilter("Total Guarantor Count", '>0');
        Loans.SetRange("Mobile Loan", false);
        Loans.SetRange("Exempt Recovery", false);
        Loans.SetAutoCalcFields("Outstanding Principal", "Principal Arrears", "Outstanding Interest", "Total Guaranteed");
        IF Loans.findset() THEN BEGIN

            dWindow.OPEN('Generating Buffer Guarantor Lines:     #1#########\'
                                + 'Accounts:             #2#########\'
                                + 'Counter:              #3#########\'
                                + 'Progress:             @4@@@@@@@@@\'
                                + 'Press Esc to abort');

            CurrentRecordNo := 0;
            NoOfRecords := Loans.COUNT;

            AvailShares := 0;

            REPEAT
                CurrentRecordNo += 1;

                dWindow.UPDATE(2, NoOfRecords);
                dWindow.UPDATE(3, CurrentRecordNo);
                dWindow.UPDATE(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));

                AmtRec := 0;
                LoanAllocation := 0;
                AvailShares := 0;
                ExtDoc := '';
                JDebits := 0;

                IF Memb.GET(Loans."Member No.") THEN
                    IF (Memb."Member Status" <> Memb."Member Status"::Deceased) THEN begin

                        LGurantors.RESET;
                        LGurantors.SETRANGE(LGurantors."Loan No.", Loans."Loan No.");
                        LGurantors.SETRANGE(LGurantors.Substituted, FALSE);
                        LGurantors.SETFILTER("Amount Guaranteed", '>0');
                        IF LGurantors.FINDSET THEN BEGIN

                            REPEAT

                                AmtRec := 0;
                                LoanAllocation := 0;
                                AvailShares := 0;
                                ExtDoc := '';
                                JDebits := 0;
                                AccNo := '';

                                Dim[1] := Memb."Global Dimension 1 Code";
                                Dim[2] := Memb."Global Dimension 2 Code";

                                Savings.Reset();
                                Savings.SetRange("Member No.", LGurantors."Account No.");
                                Savings.SetRange("Product Category", Savings."Product Category"::"Deposit Contribution");
                                Savings.Setfilter("Balance (LCY)", '>0');
                                Savings.SetAutoCalcFields("Balance (LCY)");
                                if Savings.findfirst then begin
                                    AvailShares := GetAccountBalance(Savings."No.");//Savings."Balance (LCY)"
                                    AccNo := Savings."No.";
                                end else begin
                                    Savings.Reset();
                                    Savings.SetRange("No.", LGurantors."Account No.");
                                    Savings.SetRange("Product Category", Savings."Product Category"::"Deposit Contribution");
                                    Savings.Setfilter("Balance (LCY)", '>0');
                                    Savings.SetAutoCalcFields("Balance (LCY)");
                                    if Savings.findfirst then begin
                                        AvailShares := GetAccountBalance(Savings."No.");//Savings."Balance (LCY)"
                                        AccNo := Savings."No.";
                                    end;
                                end;



                                if availShares <= 0 then
                                    AvailShares := GetAccountBalance(LGurantors."Account No.");//Savings."Balance (LCY)"


                                JDebits := GetJournalDebitsBuffer(DRecovery."No.", Jtemplate, JBatch, AcctType::Savings, Savings."No.");

                                AvailShares := AvailShares - JDebits;

                                DocNo := DRecovery."No.";
                                //PDate := TODAY;
                                PDate := today();
                                ExtDoc := Loans."Loan No.";

                                IF (Loans."Outstanding Principal" > 0) and (AvailShares > 0) THEN BEGIN
                                    ExtDoc := Memb."No.";

                                    LoanAllocation := (LGurantors."Amount Guaranteed" / Loans."Total Guaranteed") * Loans."Outstanding Principal";

                                    DedAmt := LoanAllocation;
                                    IF DedAmt > AvailShares THEN
                                        DedAmt := AvailShares;

                                    Desc := 'Guarantor Defaulter Recovery : ' + Loans."Loan No.";
                                    BufferlInsert(Jtemplate, JBatch, DocNo, PDate, Accttype::Credit, Loans."Loan Account", Desc,
                                            Balaccttype::"G/L Account", '', -DedAmt, ExtDoc, Loans."Loan No.", TransType::"Principal Repayment", Dim[1], Dim[2], true, TChannel::Offset, DRecovery."Dimension Set ID");


                                    AvailShares -= DedAmt;
                                    AmtRec += DedAmt;
                                    //Loans."Recovered Balance" += DedAmt;

                                    ExtDoc := LGurantors."Loan No.";
                                    IF AmtRec > 0 THEN begin
                                        BufferlInsert(Jtemplate, JBatch, DocNo, PDate, Accttype::Savings, AccNo, Desc,
                                                Balaccttype::"G/L Account", '', DedAmt, ExtDoc, '', TransType::" ", Dim[1], Dim[2], true, TChannel::Offset, DRecovery."Dimension Set ID");

                                        DedAmt := 0;


                                        Sms := '';

                                        /*Sms := 'Dear member, despite previous notices, you failed to update your loan account and the ' +
                                                          'balance will now been recovered from your share deposits. MAISHA BORA SACCO';

                                        if Memb."Mobile Phone No." <> '' then
                                            MemberActivities.SendSms(Source::"Loan defaulted", Memb."Mobile Phone No.", Sms, Memb."No.", Memb."No.", true, false);*/

                                    end;
                                end;


                                IF (Loans."Outstanding Interest" > 0) and (AvailShares > 0) THEN BEGIN

                                    ExtDoc := Memb."No.";

                                    LoanAllocation := (LGurantors."Amount Guaranteed" / Loans."Total Guaranteed") * Loans."Outstanding Interest";
                                    DedAmt := LoanAllocation;
                                    IF DedAmt > AvailShares THEN
                                        DedAmt := AvailShares;

                                    Desc := 'Guarantor Defaulter Recovery : ' + Loans."Loan No.";
                                    BufferlInsert(Jtemplate, JBatch, DocNo, PDate, Accttype::Credit, Loans."Loan Account", Desc,
                                            Balaccttype::"G/L Account", '', -DedAmt, ExtDoc, Loans."Loan No.", TransType::"Interest Paid", Dim[1], Dim[2], true, TChannel::Offset, DRecovery."Dimension Set ID");


                                    AvailShares -= DedAmt;
                                    AmtRec += DedAmt;
                                    //Loans."Recovered Balance" += DedAmt;

                                    ExtDoc := LGurantors."Loan No.";
                                    IF AmtRec > 0 THEN begin
                                        BufferlInsert(Jtemplate, JBatch, DocNo, PDate, Accttype::Savings, AccNo, Desc, Balaccttype::"G/L Account", '', DedAmt, ExtDoc,
                                         '', TransType::" ", Dim[1], Dim[2], true, TChannel::Offset, DRecovery."Dimension Set ID");

                                    end;

                                    DedAmt := 0;
                                end;


                            until LGurantors.Next() = 0;
                        end;
                    end;

            until Loans.next() = 0;

            dWindow.CLOSE;

        end;

    end;

    procedure PostDefRecReversals(DocNo: code[20])
    var
        DivPosting: Record "Defaulter Recovery Buffer";
        DivLines: Record "Defaulter Recovery Buffer";
        Memb: Record Members;
        Guarantor: Record Members;
        GuarantorName: Text[20];
        DefLines: Record "Defaulter Recovery Reversal";
        PDate: Date;
        loan_guarantor_sms: Label 'Dear %1, despite previous notices issued, %2 has failed to update the %3 Loan (%4) and by the virtue of you being the guarantor Ksh. %5 has been recovered from your deposits. For any concern contact the SACCO.';
    begin
        Jtemplate := 'GENERAL';
        JBatch := 'DEF-REVSL';


        IF NOT GenJournalBatch.GET(Jtemplate, JBatch) THEN BEGIN
            GenJournalBatch.INIT;
            GenJournalBatch."Journal Template Name" := Jtemplate;
            GenJournalBatch.Name := JBatch;
            GenJournalBatch.INSERT;
        END;

        JournalInit(Jtemplate, JBatch);

        UserSetup.GET(USERID);
        UserSetup.TestField("Dimension Set ID");

        DefLines.reset();
        if DefLines.FindFirst() then begin
            repeat

                DefLines.Variance := 0;
                DefLines."Amount Reversed" := 0;
                DefLines."Entry Found" := false;
                DefLines.Variance := 0;


                DivPosting.RESET;
                DivPosting.SETRANGE(Posted, true);
                DivPosting.setrange("Document No.", DocNo);
                DivPosting.SetRange("Account No.", DefLines."No.");
                IF DivPosting.FindFirst() THEN BEGIN
                    repeat
                        DefLines."Entry Found" := true;
                        DefLines."Amount Reversed" += DivPosting.amount;
                    until DivPosting.next = 0;
                end;

                DefLines.Variance := DefLines.Balance + DefLines."Amount Reversed";
                DefLines.modify;

                DivLines.RESET;
                DivLines.SETRANGE(Posted, true);
                DivLines.setrange("Document No.", DocNo);
                DivLines.SetRange("Account No.", DefLines."No.");
                IF DivLines.FIND('-') THEN BEGIN
                    repeat



                        ExtDocNo := '';
                        PDate := DMY2Date(31, 12, 2024);

                        if DivLines."Account Type" = DivLines."Account Type"::Credit then
                            TChannel := TChannel::Recovery
                        else begin

                            TChannel := TChannel::" ";
                        end;
                        JournalInsert(
                            Jtemplate,
                            JBatch,
                            DivLines."Document No.",
                            PDate,
                            DivLines."Account Type",
                            DivLines."Account No.",
                            DivLines.Description,
                            DivLines."Bal. Account Type",
                            DivLines."Bal. Account No.",
                            DivLines.Amount * -1,
                            ExtDocNo,
                            DivLines."Loan No",
                            DivLines."Transaction Type",
                            DivLines."Shortcut Dimension 1 Code",
                            DivLines."Shortcut Dimension 2 Code",
                            TRUE,
                            TChannel,
                            UserSetup."Dimension Set ID"
                        );





                        DivPosting.RESET;
                        DivPosting.SETRANGE(Posted, true);
                        DivPosting.SetRange("Account Type", DivPosting."account type"::Credit);
                        DivPosting.setrange("Document No.", DocNo);
                        DivPosting.SetRange(Description, DivLines.Description);
                        DivPosting.SetRange(Amount, DivLines.Amount * -1);
                        IF DivPosting.FIND('-') THEN BEGIN
                            //REPEAT

                            ExtDocNo := '';

                            if DivPosting."Account Type" = DivPosting."Account Type"::Credit then
                                TChannel := TChannel::Recovery
                            else begin

                                TChannel := TChannel::" ";
                            end;
                            JournalInsert(
                                Jtemplate,
                                JBatch,
                                DivPosting."Document No.",
                                PDate,
                                DivPosting."Account Type",
                                DivPosting."Account No.",
                                DivPosting.Description,
                                DivPosting."Bal. Account Type",
                                DivPosting."Bal. Account No.",
                                DivPosting.Amount * -1,
                                ExtDocNo,
                                DivPosting."Loan No",
                                DivPosting."Transaction Type",
                                DivPosting."Shortcut Dimension 1 Code",
                                DivPosting."Shortcut Dimension 2 Code",
                                TRUE,
                                TChannel,
                                UserSetup."Dimension Set ID"
                            );


                            //UNTIL DivPosting.Next() = 0;

                        END;

                    until DivLines.next = 0;
                end;
                DefLines.Modify();
            until DefLines.next() = 0;
        end;



        Message('%1\%2', Jtemplate, JBatch);

    end;

    procedure PostBUfferLines(DocNo: code[20]; JTransfer: Boolean)
    var
        DivPosting: Record "Defaulter Recovery Buffer";
        Memb: Record Members;
        Guarantor: Record Members;
        GuarantorName: Text[20];
        loan_guarantor_sms: Label 'Dear %1, despite previous notices issued, %2 has failed to update the %3 Loan (%4) and by the virtue of you being the guarantor Ksh. %5 has been recovered from your deposits. For any concern contact the SACCO.';
    begin
        Jtemplate := 'GENERAL';
        JBatch := 'DEFAULTER';


        IF NOT GenJournalBatch.GET(Jtemplate, JBatch) THEN BEGIN
            GenJournalBatch.INIT;
            GenJournalBatch."Journal Template Name" := Jtemplate;
            GenJournalBatch.Name := JBatch;
            GenJournalBatch.INSERT;
        END;

        IF NOT JTransfer THEN BEGIN
            JournalInit(Jtemplate, JBatch);
        END;

        UserSetup.GET(USERID);
        UserSetup.TestField("Dimension Set ID");

        DivPosting.RESET;
        DivPosting.SETRANGE(Posted, FALSE);
        DivPosting.setrange("Document No.", DocNo);
        IF DivPosting.FIND('-') THEN BEGIN

            REPEAT

                IF NOT JTransfer THEN BEGIN

                    IF (DivPosting."Buffer Source" = DivPosting."Buffer Source"::Defaulter) THEN
                        IF DivPosting."Loan No" <> '' THEN BEGIN
                            IF Loans.GET(DivPosting."Loan No") THEN BEGIN

                                IF Memb.GET(Loans."Member No.") THEN BEGIN
                                    IF NOT Memb."Mobile Blacklisted" THEN BEGIN
                                        Memb."Mobile Blacklisted" := TRUE;
                                        Memb.MODIFY;
                                    END;

                                    IF NOT Memb."Is Defaulter" THEN BEGIN
                                        Memb."Is Defaulter" := TRUE;
                                        Memb.MODIFY;
                                    END;

                                    Sms := '';

                                    Sms := 'Dear ' + Memb.Name + ', despite previous notices, you failed to update your ' + Loans."Loan Product Type Name" + ' account and the ' +
                                                              'balance will now been recovered from your share deposits. MAISHA BORA SACCO';

                                    if Memb."Mobile Phone No." <> '' then
                                        MemberActivities.SendSms(Source::"Loan defaulted", Memb."Mobile Phone No.", Sms, Memb."No.", Memb."No.", true, false);

                                    IF NOT Loans.Defaulted THEN BEGIN
                                        Loans.Defaulted := TRUE;
                                        Loans.MODIFY;
                                    END;

                                END;
                            END;
                        END;

                    IF (DivPosting."Buffer Source" = DivPosting."Buffer Source"::Guarantor) THEN BEGIN
                        IF Memb.GET(DivPosting."Account No.") THEN BEGIN

                            IF Guarantor.GET(DivPosting."Account No.") THEN BEGIN

                                GuarantorName := MemberActivities.FirstName(Memb.Name);
                                IF Loans.GET(DivPosting."Loan No") THEN BEGIN

                                    Sms := '';

                                    Sms := COPYSTR(STRSUBSTNO(loan_guarantor_sms, GuarantorName, GuarantorName, Loans."Loan Product Type Name", Loans."Loan No.", DivPosting.Amount), 1, 250);


                                    IF NOT Loans.Defaulted THEN BEGIN
                                        Loans.Defaulted := TRUE;
                                        Loans.MODIFY;
                                    END;
                                    IF Memb.GET(Loans."Member No.") THEN BEGIN
                                        IF NOT Memb."Is Defaulter" THEN BEGIN
                                            Memb."Is Defaulter" := TRUE;
                                            Memb.MODIFY;
                                        END;
                                    END;

                                END;
                            END;

                        END;
                    END;

                END;

                ExtDocNo := '';

                if DivPosting."Account Type" = DivPosting."Account Type"::Credit then
                    TChannel := TChannel::Recovery
                else
                    TChannel := TChannel::" ";

                JournalInsert(
                    Jtemplate,
                    JBatch,
                    DivPosting."Document No.",
                    DivPosting."Posting Date",
                    DivPosting."Account Type",
                    DivPosting."Account No.",
                    DivPosting.Description,
                    DivPosting."Bal. Account Type",
                    DivPosting."Bal. Account No.",
                    DivPosting.Amount,
                    ExtDocNo,
                    DivPosting."Loan No",
                    DivPosting."Transaction Type",
                    DivPosting."Shortcut Dimension 1 Code",
                    DivPosting."Shortcut Dimension 2 Code",
                    TRUE,
                    TChannel,
                    UserSetup."Dimension Set ID"
                );


                IF NOT JTransfer THEN BEGIN
                    DivPosting.Posted := TRUE;
                    DivPosting.MODIFY;
                END;

            UNTIL DivPosting.Next() = 0;

        END;

        IF NOT JTransfer THEN BEGIN
            JournalPost(Jtemplate, JBatch);
        END;
    end;

    procedure GeneratePenalty(LoanNo: Code[20]; AsAt: Date)
    var
        Loans: Record Loans;
        Due: Decimal;
        PenaltyAmt: Decimal;
        IssuedDateFilter: Text[20];
        SaccoSetup: Record "Sacco Setup";
        ProductSet: Record "Product Setup";
    begin
        Due := 0;
        PenaltyAmt := 0;
        SaccoSetup.testfield("Days for Checkoff");
        IssuedDateFilter := '..' + FORMAT(CALCDATE(SaccoSetup."Days for Checkoff", CALCDATE('-CM', AsAt)));

        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Disbursement Date", IssuedDateFilter);
        Loans.SetFilter("Date Filter", '..%1', AsAt);
        Loans.SetFilter("Loan Product Type", '<>L43');
        Loans.SetFilter("Principal Arrears", '>0');
        if Loans.FindFirst() then begin
            Loans.CalcFields("Principal Arrears");
            Due := Loans."Interest Due";
        end;

        IF Due > 0 THEN begin
            ProductSet.Get(Loans."Loan Product Type");
            ProductSet.TestField("Penalty Percentage");
            PenaltyAmt := Due * ProductSet."Penalty Percentage" * 0.01;
            IF PenaltyAmt > 0 THEN BEGIN

            end;
        end;

    end;

    procedure Post_Vote(var VoteTransfer: Record "Vote Transfer")
    var
        EntryNo: Integer;
        BudgetEntry: Record "G/L Budget Entry";
    begin

        VoteTransfer.TESTFIELD(Date);
        VoteTransfer.TESTFIELD("Budget Name");
        VoteTransfer.TESTFIELD(Amount);
        VoteTransfer.TESTFIELD("Source Vote");
        VoteTransfer.TESTFIELD("Destination Vote");

        IF BudgetEntry.FINDLAST() THEN BEGIN
            EntryNo := BudgetEntry."Entry No.";
        END;

        //.........Post Reducing Vote
        EntryNo := EntryNo + 1;

        BudgetEntry.INIT;
        BudgetEntry."Entry No." := EntryNo;
        BudgetEntry."Budget Name" := VoteTransfer."Budget Name";
        BudgetEntry."G/L Account No." := VoteTransfer."Source Vote";
        BudgetEntry.Date := VoteTransfer.Date;
        BudgetEntry."Global Dimension 1 Code" := VoteTransfer."Source Dimmension 1";
        BudgetEntry."Global Dimension 2 Code" := VoteTransfer."Source Dimmension 2";
        BudgetEntry."Budget Dimension 1 Code" := VoteTransfer."Source Dimension 2";
        BudgetEntry.Amount := -VoteTransfer.Amount;
        BudgetEntry.Description := VoteTransfer.Remarks;
        BudgetEntry."User ID" := USERID;
        BudgetEntry.INSERT(TRUE);

        //.........Post Incresing Vote

        EntryNo := EntryNo + 1;
        BudgetEntry.INIT;
        BudgetEntry."Entry No." := EntryNo;
        BudgetEntry."Budget Name" := VoteTransfer."Budget Name";
        BudgetEntry."G/L Account No." := VoteTransfer."Destination Vote";
        BudgetEntry.Date := VoteTransfer.Date;
        BudgetEntry."Global Dimension 1 Code" := VoteTransfer."Destination Dimmension 1";
        BudgetEntry."Global Dimension 2 Code" := VoteTransfer."Destination Dimmension 2";
        BudgetEntry."Budget Dimension 1 Code" := VoteTransfer."Destination Dimension 2";
        BudgetEntry.Amount := VoteTransfer.Amount;
        BudgetEntry.Description := VoteTransfer.Remarks;
        BudgetEntry."User ID" := USERID;
        BudgetEntry.INSERT(TRUE);

        VoteTransfer.Posted := TRUE;
        VoteTransfer."Posted Date" := TODAY;
        VoteTransfer."Posted By" := USERID;


        VoteTransfer.MODIFY;
        MESSAGE('Vote Transfered Successfully');
    end;

