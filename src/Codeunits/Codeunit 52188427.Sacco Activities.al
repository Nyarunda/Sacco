        IF Loans.FindSet() then begin

            dWindow.OPEN('Generating Buffer Interest Lines:     #1#########\'
                                + 'Accounts:             #2#########\'
                                + 'Counter:              #3#########\'
                                + 'Progress:             @4@@@@@@@@@\'
                                + 'Press Esc to abort');

            CurrentRecordNo := 0;
