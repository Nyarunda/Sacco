    local procedure BuildLoanDisbursementEmailBody(Loans: Record Loans; Member: Record Members; ProductName: Text; RepaymentAmt: Decimal; FirstRepaymentDate: Date): Text
    var
        BankAccounts: Record "HR Employee Bank Accounts";
        ChequeAmount: Decimal;
        MobileMoneyAmount: Decimal;
        EFTAmount: Decimal;
        RTGSAmount: Decimal;
        OtherAmount: Decimal;
        DisbursementDetails: Text;
        FirstName: Text;
        TransferText: Text;
        FirstRepaymentText: Text;
    begin
        BankAccounts.Reset();
        BankAccounts.SetRange("Loan No.", Loans."Loan No.");
        if BankAccounts.FindSet() then
            repeat
                case BankAccounts."Mode of Disbursement" of
                    BankAccounts."Mode of Disbursement"::Cheque:
                        ChequeAmount += BankAccounts."Amount to Transfer";
                    BankAccounts."Mode of Disbursement"::"Mobile Money":
                        MobileMoneyAmount += BankAccounts."Amount to Transfer";
                    BankAccounts."Mode of Disbursement"::EFT:
                        EFTAmount += BankAccounts."Amount to Transfer";
                    BankAccounts."Mode of Disbursement"::RTGS:
                        RTGSAmount += BankAccounts."Amount to Transfer";
                    else
                        OtherAmount += BankAccounts."Amount to Transfer";
                end;
            until BankAccounts.Next() = 0;

        if RTGSAmount > 0 then
            DisbursementDetails += StrSubstNo('<br>RTGS: KES %1', FormatNotificationAmount(RTGSAmount));
        if EFTAmount > 0 then
            DisbursementDetails += StrSubstNo('<br>EFT: KES %1', FormatNotificationAmount(EFTAmount));
        if MobileMoneyAmount > 0 then
            DisbursementDetails += StrSubstNo('<br>Mobile Money: KES %1', FormatNotificationAmount(MobileMoneyAmount));
        if ChequeAmount > 0 then
            DisbursementDetails += StrSubstNo('<br>Cheque: KES %1', FormatNotificationAmount(ChequeAmount));
        if OtherAmount > 0 then
            DisbursementDetails += StrSubstNo('<br>Other disbursement: KES %1', FormatNotificationAmount(OtherAmount));
        if DisbursementDetails = '' then
            DisbursementDetails := StrSubstNo('<br>Disbursement method: %1', Format(Loans."Mode of Disbursement"));

        if RTGSAmount > 0 then begin
            TransferText := 'We have successfully transferred the funds to the bank account details you provided.';
            TransferText += ' Please present the attached letter to your banker to access the RTGS funds.';
        end else
            if (EFTAmount > 0) or (MobileMoneyAmount > 0) then
                TransferText := 'We have successfully transferred the funds using the disbursement details you provided.'
            else
                TransferText := 'Your loan disbursement has been processed using the selected disbursement method.';

        FirstName := Member."First Name";
        if FirstName = '' then
            FirstName := Member.Name;

        if FirstRepaymentDate <> 0D then
            FirstRepaymentText := StrSubstNo(
                'Kindly note that your first repayment of KES %1 is due on or before <b>%2</b>, as shown in the attached repayment schedule.',
                FormatNotificationAmount(RepaymentAmt),
                Format(FirstRepaymentDate, 0, '<Day,2> <Month Text> <Year4>'))
        else
            FirstRepaymentText := StrSubstNo(
                'Kindly note that your first repayment of KES %1 is due as shown in the attached repayment schedule.',
                FormatNotificationAmount(RepaymentAmt));

        exit(StrSubstNo(
            'Dear %1,<br><br>I hope you are keeping well.<br>Attached please find your %2 loan documents.<br><br>%3<br><br>Disbursement allocations recorded for your loan:%4<br><br>%5<br><br>You may use our bank or M-Pesa details to submit your repayments. Please ensure each repayment reflects on our side by the end of the month to keep your account up to date.<br><br>Best Regards,<br>United Women SACCO',
            FirstName,
            ProductName,
            TransferText,
            DisbursementDetails,
            FirstRepaymentText));
    end;

    local procedure BuildPartialDisbursementEmailBody(Loans: Record Loans; Member: Record Members): Text
    var
        LoanSchedule: Record "Loan Repayment Schedule";
        MonthStartDate: Date;
        MonthEndDate: Date;
        CurrentInstallment: Decimal;
        NextRepaymentDate: Date;
        FirstName: Text;
        MessageBody: Text;
    begin
        MonthStartDate := CalcDate('<-CM>', Today);
        MonthEndDate := CalcDate('<CM>', Today);
        CurrentInstallment := Loans.Repayment;

        LoanSchedule.Reset();
        LoanSchedule.SetRange("Loan No.", Loans."Loan No.");
        LoanSchedule.SetRange("Repayment Date", MonthStartDate, MonthEndDate);
        LoanSchedule.SetCurrentKey("Loan No.", "Repayment Date", "Member No.");
        if LoanSchedule.FindFirst() then
            CurrentInstallment := LoanSchedule."Monthly Repayment";

        LoanSchedule.Reset();
        LoanSchedule.SetRange("Loan No.", Loans."Loan No.");
        LoanSchedule.SetFilter("Repayment Date", '>%1', MonthEndDate);
        LoanSchedule.SetCurrentKey("Loan No.", "Repayment Date", "Member No.");
        if LoanSchedule.FindFirst() then
            NextRepaymentDate := LoanSchedule."Repayment Date";

        FirstName := Member."First Name";
        if FirstName = '' then
            FirstName := Member.Name;

        MessageBody := StrSubstNo(
            'Dear %1,<br><br>I hope you are keeping well. Attached please find your loan documents.<br><br>',
            FirstName);
        if CurrentInstallment > 0 then
            MessageBody += StrSubstNo(
                'Please note that you are required to pay <b>KES %1</b>, being the <b>%2</b> instalment for your ongoing loan, on or before <b>%3</b>.<br><br>',
                FormatNotificationAmount(CurrentInstallment),
                Format(Today, 0, '<Month Text> <Year4>'),
                Format(MonthEndDate, 0, '<Day,2> <Month Text> <Year4>'));

        if NextRepaymentDate <> 0D then
            MessageBody += StrSubstNo(
                'The first repayment for the total amount disbursed is due on or before <b>%1</b>, as shown in the attached repayment schedule.<br><br>',
                Format(NextRepaymentDate, 0, '<Day,2> <Month Text> <Year4>'))
        else
            MessageBody += 'The first repayment for the total amount disbursed is due as shown in the attached repayment schedule.<br><br>';

        MessageBody += 'You may use our bank or M-Pesa details to submit your repayments. Please ensure each repayment reflects on our side by the end of the month to keep your account up to date.<br><br>Best Regards,<br>United Women SACCO';
        exit(MessageBody);
    end;


