        Paid: Decimal;
    begin
        Due := 0;
        Paid := 0;
        IntArrears := 0;

        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Date Filter", '..%1', AsAt);
        if Loans.FindFirst() then begin
            Loans.CalcFields("Interest Due");
            Due := Loans."Interest Due";
        end;

        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Date Filter", '..%1', PaymentDate);
        if Loans.FindFirst() then begin
            Loans.CalcFields("Interest Paid");
            Paid := Loans."Interest Paid";
        end;

        IntArrears := Due - Paid;

        if IntArrears < 0 then
            IntArrears := 0;


    end;

    procedure GetPrincipalArrearsPerDate(LoanNo: Code[20]; AsAt: Date; PaymentDate: Date) PrincipalArrears: Decimal;
    var
        Loans: Record Loans;
        LSchedule: Record "Loan Repayment Schedule";
        ExpAmt: Decimal;
        Paid: Decimal;
    begin
        ExpAmt := 0;
        Paid := 0;
        PrincipalArrears := 0;

        LSchedule.Reset();
        LSchedule.SetRange("Loan No.", LoanNo);
        LSchedule.SetFilter("Repayment Date", '..%1', AsAt);
        if LSchedule.FindFirst() then begin
            ExpAmt := LSchedule."Loan Balance";
        end;

        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Date Filter", '..%1', PaymentDate);
        if Loans.FindFirst() then begin
            Loans.CalcFields("Principal Paid");
            Paid := Loans."Principal Paid";
        end;

        PrincipalArrears := ExpAmt - Paid;

        if PrincipalArrears < 0 then
            PrincipalArrears := 0;


    end;

    procedure RecoverBenevolentFromDeposits(MembNo: Code[20]; PDate: Date; DActivity2: Code[20]; DBranch2: Code[20]; Jtemplate: Code[20]; Jbatch: Code[20])
    var
        AcctNo: Code[20];
        Desc: Text;
        DateFilter: Text[20];
        YearStart: Date;
        TestReg: Date;
        Amt: Decimal;
        InsurancePaid: Decimal;
        BenAmount: Decimal;
        ExpectedInsurance: Decimal;
        Member: Record Members;
        BenevolAcc: Record "Savings Accounts";
        DepositAcc: Record "Savings Accounts";
        CurMonthDeposits: Record "Savings Accounts";
        Setup: Record "User Setup";
        RunBal: Decimal;
    begin

        Setup.Get(USERID);
        Setup.TestField("Dimension Set ID");
        ExpectedInsurance := 0;
        Amt := 0;
        InsurancePaid := 0;


        DateFilter := FORMAT(YearStart) + '..' + FORMAT(PDate);
        if Member.Get(MembNo) then begin
            DepositAcc.Reset();
            DepositAcc.SetRange("Member No.", MembNo);
            DepositAcc.setfilter("Balance (LCY)", '>0');
            DepositAcc.setrange("Product Category", DepositAcc."Product Category"::"Deposit Contribution");
            //DepositAcc.SetFilter("Date Filter", '..%1', PDate);
            DepositAcc.SetAutoCalcFields("Balance (LCY)");
            if DepositAcc.FindFirst then begin

                BenevolAcc.Reset();
                BenevolAcc.SetRange("Member No.", MembNo);
                BenevolAcc.setfilter("Date Filter", DateFilter);
                BenevolAcc.setrange("Product Category", BenevolAcc."Product Category"::"Benevolent Fund");
                BenevolAcc.SetAutoCalcFields("Balance (LCY)");
                if BenevolAcc.FindFirst then begin

                    YearStart := CALCDATE('-CY', PDate);
                    TestReg := CALCDATE('1M', YearStart);
                    RunBal := 0;

                    ExpectedInsurance := 0;
                    IF Member."Registration Date" >= TestReg THEN
                        ExpectedInsurance := ((DATE2DMY(PDate, 2) - DATE2DMY(Member."Registration Date", 2)) + 1) * BenevolAcc."Monthly Contribution"
                    else begin
                        ExpectedInsurance := ((DATE2DMY(PDate, 2) - DATE2DMY(YearStart, 2)) + 1) * BenevolAcc."Monthly Contribution";
                    end;

                    InsurancePaid := BenevolAcc."Balance (LCY)";
                    Amt := ExpectedInsurance - InsurancePaid;

                    CurMonthDeposits.Reset();
                    CurMonthDeposits.SetRange("No.", DepositAcc."No.");
                    CurMonthDeposits.SetFilter("Date Filter", '%1..%2', CalcDate('-CM', Today), CalcDate('CM', Today));
                    CurMonthDeposits.SetAutoCalcFields("Balance (LCY)");
                    if CurMonthDeposits.FindFirst() then;

                    RunBal := DepositAcc."Balance (LCY)" - CurMonthDeposits."Balance (LCY)";
                    if RunBal < 0 then
                        RunBal := 0;

                    if Amt > RunBal then
                        Amt := RunBal;

                    if Amt < 0 then
                        Amt := 0;

                    DocNo := 'DB-' + FORMAT(DATE2DMY(PDate, 2)) + '-' + FORMAT(DATE2DMY(PDate, 3));

                    Desc := MembNo + ' GFE Recovery for ' + FORMAT(PDate, 0, '<Month Text>');

                    if Amt > 0 then begin


                        //JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType::Savings, DepositAcc."No.", Desc, BalAcctType, BalAcctNo, Amt, ExtDocNo, LoanNo, TransType, DActivity2, DBranch2, true, TChannel::Benevolent, Setup."Dimension Set ID");

                        //JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType::Savings, BenevolAcc."No.", Desc, BalAcctType, BalAcctNo, -Amt, ExtDocNo, LoanNo, TransType, DActivity2, DBranch2, true, TChannel::Benevolent, Setup."Dimension Set ID");

                        InsertToMonthlyBuffer(Jtemplate, Jbatch, DocNo, PDate, AcctType::Savings, DepositAcc."No.", Desc, BalAcctType, BalAcctNo, Amt, ExtDocNo, LoanNo, TransType, DActivity2, DBranch2, true, TChannel::Benevolent, Setup."Dimension Set ID");

                        InsertToMonthlyBuffer(Jtemplate, Jbatch, DocNo, PDate, AcctType::Savings, BenevolAcc."No.", Desc, BalAcctType, BalAcctNo, -Amt, ExtDocNo, LoanNo, TransType, DActivity2, DBranch2, true, TChannel::Benevolent, Setup."Dimension Set ID");

                        //JournalPost(JTemplate, JBatch);

                        //Message('Recovered Successfully');
                    end
                end;
            end;
        end;
    end;


    procedure RecoverMobileLoan(LoanNo: Code[20])
    var
        Loans: Record Loans;
        Transactiontype: Enum "Transaction Type Enum";
        SavingsAccounts: Record "Savings Accounts";
        Memb: Record Members;
        JTemplate: Code[20];
        JBatch: Code[20];
        DocNo: Code[20];
        ExtDocNo: Code[35];
        Desc: Text[100];
        Dim1: Code[20];
        Dim2: Code[20];
        DimID: Integer;
        PDate: Date;
        AvailShares: Decimal;
        JDebits: Decimal;
        JnlAmt: Decimal;
        AmtRec: Decimal;
    begin
        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetRange("Loan Product Type", 'L30');
        Loans.SetFilter("Total Outstanding Balance", '>%1', 0);
        Loans.SetFilter("Completion Date", '<=%1', CalcDate('<-8D>', Today));

        Loans.SetAutoCalcFields(
            "Outstanding Penalty",
            "Outstanding Interest",
            "Outstanding Principal",
            "Total Outstanding Balance");

        if Loans.FindSet() then begin

            repeat

                AmtRec := 0;
                AvailShares := 0;
                ExtDocNo := '';
                JDebits := 0;

                UserSetup.Get(UserId);
                UserSetup.TestField("CashRec Journal Template");
                UserSetup.TestField("CashRec Journal Batch");
                UserSetup.Testfield("Dimension set ID");


                Jtemplate := UserSetup."CashRec Journal Template";
                JBatch := UserSetup."CashRec Journal Batch";

                JournalInit(Jtemplate, JBatch);

                //Get Deposit Account
                SavingsAccounts.Reset();
                SavingsAccounts.SetRange("Member No.", Loans."Member No.");
                SavingsAccounts.SetRange(
                    "Product Category",
                    SavingsAccounts."Product Category"::"Deposit Contribution");

                SavingsAccounts.SetFilter("Balance (LCY)", '>%1', 0);
                SavingsAccounts.SetAutoCalcFields("Balance (LCY)");

                if SavingsAccounts.FindFirst() then
                    AvailShares := GetAccountBalance(SavingsAccounts."No.");

                if (Memb.Get(Loans."Member No.")) and (AvailShares > 0) then
                    if Memb."Member Status" <> Memb."Member Status"::Deceased then begin

                        Dim1 := Memb."Global Dimension 1 Code";
                        Dim2 := Memb."Global Dimension 2 Code";

                        JDebits :=
                            GetJournalDebitsBuffer(
                                DocNo,
                                JTemplate,
                                JBatch,
                                Accttype::Savings,
                                SavingsAccounts."No.");

                        AvailShares -= JDebits;

                        if AvailShares < 0 then
                            AvailShares := 0;

                        DocNo := CopyStr(Format(Today, 0, '<Year4><Month,2><Day,2>') + '-DEFRECOVERY', 1, MaxStrLen(DocNo));
                        PDate := Today;
                        ExtDocNo := Memb."No.";

                        //=================================================
                        // 1. PENALTY
                        //=================================================
                        if (Loans."Outstanding Penalty" > 0) and (AvailShares > 0) then begin

                            JnlAmt := Loans."Outstanding Penalty";

                            if JnlAmt > AvailShares then
                                JnlAmt := AvailShares;

                            if JnlAmt > 0 then begin

                                Desc := 'Penalty Recovery : ' + Loans."Loan No.";

                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    Pdate,
                                    Accttype::Credit,
                                    Loans."Loan Account",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    -JnlAmt,
                                    ExtDocNo,
                                    Loans."Loan No.",
                                    Transactiontype::"Penalty Paid",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Recovery,
                                    DimID);

                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    Pdate,
                                    Accttype::Savings,
                                    SavingsAccounts."No.",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    JnlAmt,
                                    ExtDocNo,
                                    '',
                                    Transactiontype::" ",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Recovery,
                                    DimID);

                                AvailShares -= JnlAmt;
                                AmtRec += JnlAmt;
                            end;
                        end;

                        //=================================================
                        // 2. INTEREST
                        //=================================================
                        if (Loans."Outstanding Interest" > 0) and (AvailShares > 0) then begin

                            JnlAmt := Loans."Outstanding Interest";

                            if JnlAmt > AvailShares then
                                JnlAmt := AvailShares;

                            if JnlAmt > 0 then begin

                                Desc := 'Interest Recovery : ' + Loans."Loan No.";

                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    Pdate,
                                    Accttype::Credit,
                                    Loans."Loan Account",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    -JnlAmt,
                                    ExtDocNo,
                                    Loans."Loan No.",
                                    Transactiontype::"Interest Paid",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Recovery,
                                    DimID);

                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    Pdate,
                                    Accttype::Savings,
                                    SavingsAccounts."No.",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    JnlAmt,
                                    ExtDocNo,
                                    '',
                                    Transactiontype::" ",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Recovery,
                                    DimID);

                                AvailShares -= JnlAmt;
                                AmtRec += JnlAmt;
                            end;
                        end;

                        //=================================================
                        // 3. PRINCIPAL
                        //=================================================
                        if (Loans."Outstanding Principal" > 0) and (AvailShares > 0) then begin

                            JnlAmt := Loans."Outstanding Principal";

                            if JnlAmt > AvailShares then
                                JnlAmt := AvailShares;

                            if JnlAmt > 0 then begin

                                Desc := 'Principal Recovery : ' + Loans."Loan No.";

                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    Pdate,
                                    Accttype::Credit,
                                    Loans."Loan Account",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    -JnlAmt,
                                    ExtDocNo,
                                    Loans."Loan No.",
                                    Transactiontype::"Principal Repayment",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Recovery,
                                    DimID);

                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    Pdate,
                                    Accttype::Savings,
                                    SavingsAccounts."No.",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    JnlAmt,
                                    ExtDocNo,
                                    '',
                                    Transactiontype::" ",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Recovery,
                                    DimID);

                                AvailShares -= JnlAmt;
                                AmtRec += JnlAmt;
                            end;
                        end;


                        JournalPost(Jtemplate, JBatch);

                    end;

            until Loans.Next() = 0;

        end;
    end;

    procedure DefaulterMcashLoansLoanOffset(DocumentNo: Code[20]; LoanNo: Code[20])
