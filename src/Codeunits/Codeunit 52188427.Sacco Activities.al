                        //    dueDate := Today;

                        LSchedule.Reset();
                        LSchedule.SetRange("Loan No.", Loans."Loan No.");
                        LSchedule.SetRange("Repayment Date", CalcDate('-CM', Today), CalcDate('CM', Today));
                        if LSchedule.FindLast() then begin

                            case LReminderSetup."Reminder Type" of

                                LReminderSetup."Reminder Type"::"Before Due Date":
                                    begin
                                        if (CalcDate(format('-' + format(LReminderSetup."Loan Reminder Days")), LSchedule."Repayment Date") <> Today) then
                                            Skip := true
                                        else
                                            Skip := false;
                                    end;
                                LReminderSetup."Reminder Type"::"On Due Date":
                                    begin
                                        if Today <> LSchedule."Repayment Date" then
                                            Skip := true
                                        else
                                            Skip := false;
                                    end;
                                LReminderSetup."Reminder Type"::"After Due Date":
                                    begin
                                        if Today <> calcdate(format(LReminderSetup."Loan reminder Days"), LSchedule."Repayment Date") then
                                            Skip := true
                                        else
                                            Skip := false;
                                    end;
                            end;

                            DueDate := LSchedule."Repayment Date";

                        end;
                        /*else begin

                            D := Date2DMY(Loans."Repayment Start Date", 1);
                            M := Date2DMY(Today, 2);
                            Y := Date2DMY(Today, 3);

                            DueDate := DMY2Date(D, M, Y);

                            case LReminderSetup."Reminder Type" of

                                LReminderSetup."Reminder Type"::"Before Due Date":
                                    begin
                                        if (CalcDate(format('-' + format(LReminderSetup."Loan Reminder Days")), DueDate) <> Today) then
                                            Skip := true
                                    end;
                                LReminderSetup."Reminder Type"::"On Due Date":
                                    begin
                                        if Today <> DueDate then
                                            Skip := true
                                    end;
                                LReminderSetup."Reminder Type"::"After Due Date":
                                    begin
                                        if Today <> calcdate(format(LReminderSetup."Loan reminder Days"), DueDate) then
                                            Skip := true
                                    end;
                            end;

                        end;*/


                        ReminderLogs.Reset();
                        ReminderLogs.SetRange("Loan No", Loans."Loan No.");
                        ReminderLogs.SetRange(Type, LReminderSetup."Reminder Type");
                        ReminderLogs.SetRange("Date Sent", Today);
                        if ReminderLogs.FindFirst() then
                            Skip := true;

                        ReminderLogs.Reset();
                        ReminderLogs.SetRange("Loan No", Loans."Loan No.");
                        ReminderLogs.SetRange("Date Sent", Today);
                        if ReminderLogs.FindFirst() then
                            Skip := true;

                        if not skip then begin

                            LoanApp.reset();
                            LoanApp.SetRange("Loan No.", Loans."Loan No.");
                            LoanApp.SetRange("Date Filter", CalcDate('-CM', Today), CalcDate('CM', Today));
                            LoanApp.SetAutoCalcFields("Principal Paid");
                            if LoanApp.findfirst() then begin
                                PrincipalPaid := LoanApp."Principal Paid";
                                if PrincipalPaid < 0 then
                                    PrincipalPaid := 0
                            end;

                            LBal += Loans."Outstanding Principal";

                            CurrPrincipalRep := Loans."Loan Principle Repayment";
                            if CurrPrincipalRep < 0 then
                                CurrPrincipalRep := 0;

                            AsAt := CalcDate('CM', today);

                            SaccoActivities.GetDefaultedAmount(Loans."Loan No.", AsAt, ExpectedAmt, AmtPaid, DefAmount, DaysInArrear, ArrearsDate, true, GracePeriod);

                            if DefAMount < 0 then
                                DefAmount := 0;

                            if DefAmount > Loans."Outstanding Principal" then
                                DefAmount := Loans."Outstanding Principal";


                            MonthlyRep := ROUND(Loans."Outstanding Interest") + DefAmount + LSchedule."Monthly Interest" + LSchedule."Monthly Principal";


                            MonthlyRep := ROUND(MonthlyRep);
                            IF MonthlyRep <= 0 THEN
                                MonthlyRep := 0;

                            if MonthlyRep > 0 Then begin

                                Members.get(Loans."Member No.");
                                Month := FORMAT(Today, 0, '<Month Text>');
                                Desc := Product."USSD Product Name";
                                if desc = '' then
                                    Desc := Product.Description;

                                if dueDate = Today then begin
                                    DueDateStr := 'Today';
                                    Msg := 'Dear ' + Sky.FirstName(Members.Name) + ', Your ' + Month + ' ' + StrSubstNo('%1(%2) Loan repayment is KES.' + FORMAT(Loans.Repayment) + ' with a remaining payment of KES %3 is due %4',
                                    Desc, Loans."Loan No.", format(MonthlyRep), DueDateStr) + '.';
                                end
                                else begin
                                    DueDateStr := format(DueDate);
                                    Msg := 'Dear ' + Sky.FirstName(Members.Name) + ', Your ' + Month + ' ' + StrSubstNo('%1(%2) Loan repayment is KES.' + FORMAT(Loans.Repayment) + ' with a remaining payment of KES %3 is due by %4',
                                    Desc, Loans."Loan No.", format(MonthlyRep), DueDateStr) + '.';
                                end;

                                MemberActivities.SendSms(Smssource::"Loan Reminder", Members."Mobile Phone No.", Msg, Members."No.", Loans."Disbursement Account No", true, false);
                                Commit;

                                ReminderLogs.Reset();
                                if ReminderLogs.findlast() then
                                    i := ReminderLogs."Entry No" + 1;

                                ReminderLogs.Init();
                                ReminderLogs."Loan No" := Loans."Loan No.";
                                ReminderLogs."Entry No" := i;
                                ReminderLogs."Date Sent" := today;
                                ReminderLogs.Type := LReminderSetup."Reminder Type";
                                ReminderLogs.Insert();

                            end;
                        end;
                    end;
                until LReminderSetup.Next() = 0;
        end;
    end;

    procedure LoanChangesFn(LoanChanges: Record "Loan Changes")
    var
        Loans: Record Loans;
        RSchedule: Record "Loan Repayment Schedule";
        LastCount: Integer;
        InPeriod: DateFormula;
        QCounter: Integer;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        InitialInstal: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        RepayCode: Code[10];
        LoanSch: Record "Loan Repayment Schedule";
        LRepayment: Decimal;
        ProductType: Record "Product Setup";
        PCharges: Record "Loan Product Charges.";
        Amt: Decimal;
        SaccoSetup: Record "Sacco Setup";
        NewLoans: Record Loans;
        Members: Record Members;
        BUser: Record "User Setup";
        StaggeredLines: Record "Staggered Lines.";
        ChargeCode: Code[20];
        Value: Decimal;
        ChargeAmt: Decimal;
        ChargeDuty: Decimal;
        ChargeAcctType: Enum "Gen. Journal Account Type";
        ChargeAcct: Code[20];
        Counter: Integer;
        Lines: Integer;
        Desc: Text;
        TCharges: Decimal;
        LoanType: Record "Product Setup";
        LoanSecurity: Record "Loan Security";
        NewLoanSecurity: Record "Loan Security";

        CustLedger: Record "Credit Ledger Entry";
        GLedger: Record "G/L Entry";
        DimID: Integer;
        LSchedule: Record "Loan Repayment Schedule";

    begin
        if Loans.Get(LoanChanges."Loan No.") then begin

            DimID := 0;
            DimID := LoanChanges."Dimension Set ID";


            if LoanChanges."Type of Change" = LoanChanges."type of change"::"Update Product Type" then begin


                LoanType.get(LoanChanges."New Loan Product Type");
                Loans."Loan Product Type" := LoanType."Product ID";
                Loans."Loan Product Type Name" := LoanType.Description;
                Loans."Annual Interest %" := LoanType."Interest Rate (Min.)";
                Loans."Interest Calculation Method" := LoanType."Interest Calculation Method";
                Loans.Source := LoanType."Loan Source";

                Loans.Installments := LoanType."Default Installments";
                Loans."Repayment Frequency" := LoanType."Repayment Frequency";
                InterestRate := Loans."Annual Interest %";
                RepayPeriod := Loans.Installments;
                LBalance := Loans."Approved Amount";
                LoanAmount := Loans."Approved Amount";


                if Loans."Annual Interest %" > 0 then begin
                    if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then begin
                        Loans.TestField("Annual Interest %");
                        Loans.TestField(Installments);

                        TotalMRepay := ROUND((InterestRate / 12 / 100) / (1 - Power((1 + (InterestRate / 12 / 100)), -RepayPeriod)) * LoanAmount, 1, '>');
                        LInterest := ROUND(LBalance / 100 / 12 * InterestRate, 0.05, '>');

                        Loans.Repayment := TotalMRepay;
                        LPrincipal := TotalMRepay - LInterest;
                        Loans."Loan Principle Repayment" := LPrincipal;
                        Loans."Loan Interest Repayment" := LInterest;
                        Loans.Repayment := TotalMRepay;

                    end;

                    if Loans."Interest Calculation Method" = Loans."interest calculation method"::"Straight Line" then begin
                        Loans.TestField(Installments);
                        LPrincipal := ROUND(LoanAmount / RepayPeriod, 1, '>');
                        LInterest := ROUND((InterestRate / 12 / 100) * LoanAmount, 1, '>');
                        Loans.Repayment := LPrincipal + LInterest;
                        Loans."Loan Principle Repayment" := LPrincipal;
                        Loans."Loan Interest Repayment" := LInterest;
                    end;

                    if Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Balance" then begin
                        Loans.TestField(Installments);
                        LPrincipal := ROUND(LoanAmount / RepayPeriod, 1, '>');
                        LInterest := ROUND((InterestRate / 12 / 100) * LBalance, 1, '>');
                        Loans.Repayment := LPrincipal + LInterest;
                        Loans."Loan Principle Repayment" := LPrincipal;
                        Loans."Loan Interest Repayment" := LInterest;
                    end;

                    if Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Flat" then begin
                        Loans.TestField(Installments);
                        //TotalMRepay:=ROUND((InterestRate/12/100) / (1 - POWER((1 + (InterestRate/12/100)),- RepayPeriod)) * LoanAmount,1,'>');
                        LPrincipal := ROUND(LoanAmount / RepayPeriod, 1.0, '>');
                        //AmortisedInt:=TotalMRepay*Installments-"Approved Amount";
                        LInterest := ROUND(((LoanAmount * InterestRate / 12 / 100) + (LPrincipal * InterestRate / 12 / 100)) / 2, 1.0, '>');
                        //LInterest:=AmortisedInt/Installments;
                        Loans.Repayment := LPrincipal + LInterest;
                        Loans."Loan Principle Repayment" := LPrincipal;
                        Loans."Loan Interest Repayment" := LInterest;
                    end;
                end;
                Loans.Modify();


                CustLedger.Reset();
                CustLedger.setrange("Loan No.", Loans."Loan No.");
                if CustLedger.FindFirst() then begin
                    repeat
                        CustLedger.calcfields(Amount);

                        if (CustLedger."Transaction Type" = CustLedger."Transaction Type"::"Loan Disbursement") or (CustLedger."Transaction Type" = CustLedger."Transaction Type"::"Principal Repayment") then begin
                            GLedger.Reset();
                            GLedger.SetRange("Transaction No.", CustLedger."Transaction No.");
                            GLedger.SetRange("Entry No.", CustLedger."Entry No.");
                            GLedger.SetRange("Amount", CustLedger.Amount);
                            if GLedger.FindFirst() then begin
                                if LoanType."Loan Account [G/L]" <> '' then begin
                                    GLedger."G/L Account No." := LoanType."Loan Account [G/L]";
                                    GLedger.Modify();
                                end;
                            end;
                        end;

                        IF (CustLedger."Transaction Type" = CustLedger."Transaction Type"::"Interest Paid") or (CustLedger."Transaction Type" = CustLedger."Transaction Type"::"Interest Due") then begin
                            GLedger.Reset();
                            GLedger.SetRange("Transaction No.", CustLedger."Transaction No.");
                            GLedger.SetRange("Entry No.", CustLedger."Entry No.");
                            if GLedger.FindFirst() then begin
                                if LoanType."Loan Account [G/L]" <> '' then begin
                                    GLedger."G/L Account No." := LoanType."Loan Account [G/L]";
                                    GLedger.Modify();
                                end;
                            end;
                        end;

                    until CustLedger.next = 0;
                end;
                LoanChanges.Processed := true;
                LoanChanges."Rescheduling Date" := Today;
                LoanChanges.Modify;



            end else
                if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
                    LoanChanges.TestField("Loan Moratorium Start Date");
                    LoanChanges.TestField("Loan Moratorium End Date");

                    if LoanChanges."Loan Moratorium End Date" < LoanChanges."Loan Moratorium Start Date" then
                        Error('Moratorium End Date cannot be before Moratorium Start Date.');

                    Loans."Loan Moratorium Start Date" := LoanChanges."Loan Moratorium Start Date";
                    Loans."Loan Moratorium End Date" := LoanChanges."Loan Moratorium End Date";
                    Loans.Modify();

                    GenerateLoanChangeRepaymentSchedule(LoanChanges, Loans."Loan No.", false);

                    LoanChanges.Processed := true;
                    LoanChanges."Rescheduling Date" := Today;
                    LoanChanges.Modify();
                end else
                    if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Manage Interest Penalty Insurance" then
                        ApplyLoanChargeControl(LoanChanges, Loans)
                    else
                        if LoanChanges."Type of Change" = LoanChanges."type of change"::"Debt Collector" then begin
                            Loans."Debt Coll. Date" := Today;
                            LoanChanges."Debt Coll. Date" := Today;
                            Loans."Debt Coll. Def Amount" := LoanChanges."Debt Coll. Def Amount";
                            Loans."Debt Collector Type" := LoanChanges."Debt Collector Type";
                            Loans."Debt Collector" := LoanChanges."Debt Collector";
                            Loans."Debt Collector Name" := LoanChanges."Debt Collector Name";
                            Loans.Modify;

                            LoanChanges.Processed := true;
                            LoanChanges.Modify;
                        end else
                            if LoanChanges."Type of Change" = LoanChanges."type of change"::"Stop Interest" then begin
                                Loans."Int Stop Date" := LoanChanges."Rescheduling Date";
                                Loans."Stop Interest Due" := true;
                                Loans.Modify;

                                LoanChanges.Processed := true;
                                LoanChanges.Modify;
                            end else
                                if LoanChanges."Type of Change" = LoanChanges."type of change"::"Stop Insurance" then begin
                                    Loans."Int Stop Date" := LoanChanges."Rescheduling Date";
                                    Loans."Stop Insurance" := true;
                                    Loans.Modify;

                                    LoanChanges.Processed := true;
                                    LoanChanges.Modify;
                                end else
                                    if LoanChanges."Type of Change" = LoanChanges."type of change"::"Exempt Recovery" then begin
                                        Loans."Exempt Recovery" := LoanChanges."Exempt Recovery";
                                        Loans.Modify;

                                        LoanChanges.Processed := true;
                                        LoanChanges.Modify;
                                    end
                                    else
                                        if LoanChanges."Type of Change" = LoanChanges."type of change"::"Stop Interest and Penalty" then begin
                                            Loans."Int Stop Date" := LoanChanges."Rescheduling Date";
                                            Loans."Stop Interest Due" := true;
                                            Loans."Stop Penalty" := true;
                                            Loans.Modify;

                                            LoanChanges.Processed := true;
                                            LoanChanges.Modify;
                                        end else
                                            if LoanChanges."Type of Change" = LoanChanges."type of change"::"Stop Interest & Penalty & Insurance" then begin
                                                Loans."Int Stop Date" := LoanChanges."Rescheduling Date";
                                                Loans."Stop Interest Due" := true;
                                                Loans."Stop Insurance" := true;
                                                Loans."Stop Penalty" := true;
                                                Loans.Modify;

                                                LoanChanges.Processed := true;
                                                LoanChanges.Modify;
                                            end
                                            else
                                                if LoanChanges."Type of Change" = LoanChanges."type of change"::"Update Account Manager" then begin
                                                    LoanChanges.TestField("New Account Manager");
                                                    Loans."Loan Officer" := LoanChanges."New Account Manager";
                                                    Loans.Modify();
                                                    LoanChanges.Processed := true;
                                                    LoanChanges.Modify();
                                                end
                                                else
                                                    if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then begin
                                                        //get the loan repayment schedule
                                                        LSchedule.Reset();
                                                        LSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
                                                        if not LSchedule.FindSet(true) then
                                                            Error('No repayment schedule exists for loan %1.', LoanChanges."Loan No.");

                                                        repeat
                                                            LSchedule."Monthly Repayment" := GetMonthlyRepaymentAfterDepositChange(
                                                                LSchedule."Monthly Repayment",
                                                                LSchedule."Deposit Amount",
                                                                LoanChanges."New Deposit Contribution");
                                                            LSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution";
                                                            LSchedule.Modify();
                                                        until LSchedule.Next() = 0;

                                                        Loans."Deposit COntribution" := LoanChanges."New Deposit Contribution";
                                                        Loans.Modify();

                                                        LoanChanges.Processed := true;
                                                        LoanChanges.Modify;

                                                    end
                                                    else
                                                        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::Insurance then begin
                                                            LoanChanges.TestField("Rescheduling Date");
                                                            LoanChanges.TestField("New Insurance Amount");

                                                            LSchedule.Reset();
                                                            LSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
                                                            //LSchedule.SetRange("Member No.", Loans."Member No.");
                                                            //LSchedule.SetFilter("Repayment Date", '>=%1', LoanChanges."Rescheduling Date");
                                                            if not LSchedule.FindSet(true) then
                                                                Error(
                                                                    'No repayment schedule was found for loan %1, member %2, from repayment date %3.',
                                                                    LoanChanges."Loan No.", Loans."Member No.", LoanChanges."Rescheduling Date");

                                                            repeat
                                                                LSchedule."Monthly Repayment" :=
                                                                    SmartRound(
                                                                        LSchedule."Monthly Repayment" -
                                                                        LSchedule."Insurance Contribution" +
                                                                        LoanChanges."New Insurance Amount");
                                                                LSchedule."Insurance Contribution" := LoanChanges."New Insurance Amount";
                                                                LSchedule.Modify();
                                                            until LSchedule.Next() = 0;

                                                            Loans."Total Insurance" := LoanChanges."New Insurance Amount";
                                                            Loans.Modify();

                                                            LoanChanges.Processed := true;
                                                            LoanChanges.Modify();
                                                        end

                                                        else
                                                            if LoanChanges."Type of Change" = LoanChanges."type of change"::"Interest Calculation Method" then begin
                                                                Loans."Interest Calculation Method" := LoanChanges."New Interest Calc. Method";
                                                                Loans."schedule start date" := LoanChanges."Schedule Start Date";
                                                                Loans.Modify;

                                                                GenerateLoanChangeRepaymentSchedule(LoanChanges, Loans."Loan No.", false);

                                                                LoanChanges.Processed := true;
                                                                LoanChanges.Modify;
                                                            end else
                                                                if LoanChanges."Type of Change" = LoanChanges."type of change"::"Loan Rescheduling" then begin

                                                                    BUser.Get(UserId);
                                                                    BUser.TestField("General Journal Template");
                                                                    BUser.TestField("General Journal Batch");

                                                                    JTemplate := BUser."General Journal Template";
                                                                    JBatch := BUser."General Journal Batch";
                                                                    RSchedule.Reset;
                                                                    RSchedule.SetRange("Loan No.", LoanChanges."No.");
                                                                    if not RSchedule.FindFirst then begin
                                                                        LoanSch.Reset;
                                                                        LoanSch.SetRange("Loan No.", Loans."Loan No.");
                                                                        if LoanSch.FindFirst then begin
                                                                            repeat
                                                                                RSchedule.Init;
                                                                                RSchedule."Loan No." := LoanChanges."No.";
                                                                                RSchedule."Repayment Date" := LoanSch."Repayment Date";
                                                                                RSchedule."Monthly Appraisal" := LoanSch."Monthly Appraisal";
                                                                                RSchedule."Monthly Interest" := SaccoActivities.smartround(LoanSch."Monthly Interest");
                                                                                RSchedule."Monthly Principal" := SaccoActivities.smartround(LoanSch."Monthly Principal");
                                                                                RSchedule."Monthly Repayment" := SaccoActivities.smartround(LoanSch."Monthly Repayment");
                                                                                RSchedule."Insurance Contribution" := LoanSch."Insurance Contribution";
                                                                                RSchedule."Line No." := LoanSch."Line No.";
                                                                                RSchedule."Loan Amount" := LoanSch."Loan Amount";
                                                                                RSchedule."Loan Balance" := LoanSch."Loan Balance";
                                                                                RSchedule.Insert;
                                                                            until LoanSch.Next = 0;
                                                                        end;
                                                                    end;


                                                                    JournalInit(JTemplate, JBatch);
                                                                    SaccoSetup.Get;


                                                                    if LoanChanges."Type of Change" = LoanChanges."type of change"::"Loan Rescheduling" then begin

                                                                        if LoanChanges."Rescheduling Type" = LoanChanges."rescheduling type"::"Create New Loan" then begin

                                                                            Loans.CalcFields("Outstanding Interest", "Outstanding Principal", "Outstanding Appraisal", "Outstanding Penalty", "Total Outstanding Balance");
                                                                            Members.Get(Loans."Member No.");

                                                                            NewLoans.Init;
                                                                            NewLoans."Loan No." := '';
                                                                            NewLoans."Member No." := Members."No.";
                                                                            NewLoans."Member Name" := Members.Name;
                                                                            NewLoans."Staff No" := Members."Payroll/Staff No.";
                                                                            NewLoans."Employer Code" := Members."Employer Code";
                                                                            NewLoans."Application Date" := Today;
                                                                            NewLoans."Loan Product Type" := Loans."Loan Product Type";
                                                                            NewLoans."Loan Product Type Name" := Loans."Loan Product Type Name";
                                                                            //NewLoans."Grace Period":=Loans."Grace Period";
                                                                            NewLoans."Annual Interest %" := Loans."Annual Interest %";
                                                                            NewLoans."Interest Calculation Method" := Loans."Interest Calculation Method";
                                                                            NewLoans.Source := Loans.Source;
                                                                            NewLoans.Installments := LoanChanges."New Installments";
                                                                            NewLoans."Repayment Frequency" := Loans."Repayment Frequency";
                                                                            NewLoans."Repay Mode" := Loans."Repay Mode";
                                                                            NewLoans."Recovery Priority" := Loans."Recovery Priority";
                                                                            NewLoans."Requested Amount" := LoanChanges."New Loan Amount";//+LoanChanges.Charges;
                                                                            NewLoans."Approved Amount" := LoanChanges."New Loan Amount";//+LoanChanges.Charges;
                                                                            NewLoans.Validate(NewLoans."Approved Amount");
                                                                            NewLoans.Status := NewLoans.Status::Approved;
                                                                            NewLoans."Disbursement Date" := Today;
                                                                            NewLoans.Validate("Disbursement Date");
                                                                            if LoanChanges."Repayment Start Date" <> 0D then begin
                                                                                NewLoans."Repayment Start Date" := LoanChanges."Repayment Start Date";
                                                                                NewLoans."Schedule Start Date" := LoanChanges."Repayment Start Date";
                                                                            end;
                                                                            NewLoans."Disbursement Account No" := Loans."Disbursement Account No";
                                                                            NewLoans.TestField("Disbursement Account No");
                                                                            NewLoans.Installments := LoanChanges."New Installments";

                                                                            NewLoans."Last Advice Date" := Today;

                                                                            NewLoans."Advice Type" := NewLoans."Advice Type"::"New Loan";
                                                                            NewLoans.Insert(true);

                                                                            LoanSecurity.Reset;
                                                                            LoanSecurity.SetRange("Loan No.", Loans."Loan No.");
                                                                            if LoanSecurity.FindFirst then begin
                                                                                repeat
                                                                                    NewLoanSecurity.Init;
                                                                                    NewLoanSecurity.TransferFields(LoanSecurity);
                                                                                    NewLoanSecurity."Loan No." := NewLoans."Loan No.";
                                                                                    NewLoanSecurity.Insert;
                                                                                until LoanSecurity.Next = 0;
                                                                            end;
                                                                            JournalInsert(JTemplate, JBatch, LoanChanges."No.", Today, Accttype::Savings, NewLoans."Disbursement Account No", 'Loan ' + Format(LoanChanges."Charge Type"),
                                                                            Accttype::"G/L Account", '', -(Loans."Total Outstanding Balance" + LoanChanges.Charges), '', NewLoans."Loan No.", Transtype::" ", Loans."Global Dimension 1 Code", Loans."Booking Branch", true, TChannel::"Loan Changes", DimID);

                                                                            JournalInsert(JTemplate, JBatch, LoanChanges."No.", Today, Accttype::Credit, NewLoans."Loan Account", 'Loan ' + Format(LoanChanges."Charge Type"),
                                                                            Accttype::"G/L Account", '', Loans."Total Outstanding Balance" + LoanChanges.Charges, '', NewLoans."Loan No.", Transtype::"Loan Disbursement", Loans."Global Dimension 1 Code", Loans."Booking Branch", true, TChannel::"Loan Changes", DimID);

                                                                            JournalInsert(JTemplate, JBatch, LoanChanges."No.", Today, Accttype::Savings, NewLoans."Disbursement Account No", 'Loan ' + Format(LoanChanges."Charge Type") + ': Loan Clearance - ' + LoanChanges."Loan No.",
                                                                            Accttype::"G/L Account", '', Loans."Total Outstanding Balance", '', NewLoans."Loan No.", Transtype::" ", Loans."Global Dimension 1 Code", Loans."Booking Branch", true, TChannel::"Loan Changes", DimID);


                                                                            if Loans."Outstanding Interest" < 0 then
                                                                                Loans."Outstanding Interest" := 0;

                                                                            JournalInsert(JTemplate, JBatch, LoanChanges."No.", Today, Accttype::Credit, Loans."Loan Account", 'Cleared By ' + Format(LoanChanges."Charge Type"),
                                                                            Accttype::"G/L Account", '', -Loans."Outstanding Principal", '', Loans."Loan No.", Transtype::"Principal Repayment", Loans."Global Dimension 1 Code", Loans."Booking Branch", true, TChannel::"Loan Changes", DimID);

                                                                            JournalInsert(JTemplate, JBatch, LoanChanges."No.", Today, Accttype::Credit, Loans."Loan Account", 'Cleared By ' + Format(LoanChanges."Charge Type"),
                                                                            Accttype::"G/L Account", '', -Loans."Outstanding Interest", '', Loans."Loan No.", Transtype::"Interest Paid", Loans."Global Dimension 1 Code", Loans."Booking Branch", true, TChannel::"Loan Changes", DimID);

                                                                            JournalInsert(JTemplate, JBatch, LoanChanges."No.", Today, Accttype::Credit, Loans."Loan Account", 'Cleared By ' + Format(LoanChanges."Charge Type"),
                                                                            Accttype::"G/L Account", '', -Loans."Outstanding Penalty", '', Loans."Loan No.", Transtype::"Penalty Paid", Loans."Global Dimension 1 Code", Loans."Booking Branch", true, TChannel::"Loan Changes", DimID);

