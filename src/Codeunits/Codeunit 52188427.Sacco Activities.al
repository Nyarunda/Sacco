    procedure PostReceipt(ReceiptNo: Code[20]; PreviewPost: Boolean)
    var
        RcptBufLines: Record "Receipt Buffer Lines";
        BankLedger: Record "Bank Account Ledger Entry";
        ReceiptHeader: Record "Receipt Header";
    begin
        RcptBufLines.Reset();
        RcptBufLines.SetRange("Batch No", ReceiptNo);
        RcptBufLines.SetRange("Member Found", true);
        if not RcptBufLines.IsEmpty() then begin
            ValidateBulkReceiptBufferAgainstDocumentLines(ReceiptNo);
            PostBulkReceipt(ReceiptNo, PreviewPost)
        end else begin
            // Check if single receipt has already been posted in bank ledger.
            BankLedger.Reset();
            BankLedger.SetRange("Document No.", ReceiptNo);
            BankLedger.SetRange(Reversed, false);
            if not BankLedger.IsEmpty() then begin
                ReceiptHeader.Reset();
                ReceiptHeader.SetRange("No.", ReceiptNo);
                ReceiptHeader.SetRange(Posted, false);

                if ReceiptHeader.FindFirst() then begin
                    ReceiptHeader.Posted := true;
                    ReceiptHeader."Posted By" := UserId;
                    ReceiptHeader.Modify(true);
                end;

                exit;
            end;

            PostSingleReceipt(ReceiptNo, PreviewPost);
        end;

    end;

    local procedure ValidateBulkReceiptBufferAgainstDocumentLines(ReceiptNo: Code[20])
    var
        ReceiptHeader: Record "Receipt Header";
        RcptBufLines: Record "Receipt Buffer Lines";
        RcptBufTxnLines: Record "Receipt Buffer Lines";
        DocLine: Record "Document Line";
        LastMemberNo: Code[20];
        LastTransactionNo: Code[20];
        BufferAmount: Decimal;
        DocumentLineAmount: Decimal;
    begin
        if ReceiptHeader.Get(ReceiptNo) then begin
            ReceiptHeader.CalcFields("Total Receipt Buffer Amount", "Total Document Line Amount");
            if Round(ReceiptHeader."Total Receipt Buffer Amount", 0.01, '=') <> Round(ReceiptHeader."Total Document Line Amount", 0.01, '=') then
                Message(
                    'Bulk receipt validation failed for receipt %1. Total imported receipt buffer amount is %2 but total generated document line amount is %3.',
                    ReceiptNo,
                    ReceiptHeader."Total Receipt Buffer Amount",
                    ReceiptHeader."Total Document Line Amount");
        end;

        RcptBufLines.Reset();
        RcptBufLines.SetCurrentKey("Batch No", "Member No", "Transaction No.");
        RcptBufLines.SetRange("Batch No", ReceiptNo);
        RcptBufLines.SetRange("Member Found", true);
        if not RcptBufLines.FindSet() then
            exit;

        repeat
            if (RcptBufLines."Member No" <> LastMemberNo) or (RcptBufLines."Transaction No." <> LastTransactionNo) then begin
                LastMemberNo := RcptBufLines."Member No";
                LastTransactionNo := RcptBufLines."Transaction No.";
                BufferAmount := 0;
                DocumentLineAmount := 0;

                if ReceiptHeader.Get(ReceiptNo) then begin
                    ReceiptHeader.SetRange("External Doc. Filter", RcptBufLines."Transaction No.");
                    ReceiptHeader.CalcFields("Buffer Amount by Ext. Doc.", "Doc. Line Amount by Ext. Doc.");
                    BufferAmount := ReceiptHeader."Buffer Amount by Ext. Doc.";
                    DocumentLineAmount := ReceiptHeader."Doc. Line Amount by Ext. Doc.";
                end;

                if Round(BufferAmount, 0.01, '=') <> Round(DocumentLineAmount, 0.01, '=') then
                    Message(
                        'Bulk receipt validation failed for receipt %1, member %2, transaction no. %3. Imported buffer amount is %4 but generated document line amount is %5.',
                        ReceiptNo,
                        RcptBufLines."Member No",
                        RcptBufLines."Transaction No.",
                        BufferAmount,
                        DocumentLineAmount);
            end;
        until RcptBufLines.Next() = 0;
    end;

    // SINGLE - your current PostReceipt completely untouched, just renamed
    procedure PostSingleReceipt(ReceiptNo: Code[20]; PreviewPost: Boolean)
    var
        ReceiptHeader: Record "Receipt Header";
        DocLine: Record "Document Line";
        GenJournalLine: Record "Gen. Journal Line";
        RunBal: Decimal;
        PrAmt: Decimal;
        IntAmt: Decimal;
        PenaltyAmt: Decimal;
        AppraisalAmt: Decimal;
        SaccoActivities: Codeunit "Sacco Activities";
        ExpectedBal: Decimal;
        CurrentBal: Decimal;
        DaysInArrear: Integer;
        ArrearsDate: Date;
        PrincipalArrears: Decimal;
        DedAmt: Decimal;
        IntArrears: Decimal;
        DisbtributionAcc: Code[20];
        Desc: Text;
        PDate: Date;
        ProductSetup: Record "Product Setup";
        PowerEvents: Codeunit "UW Power Automate Bus. Events";
    begin
        if ReceiptHeader.Get(ReceiptNo) then begin
            ReceiptHeader.TestField(Posted, false);
            ReceiptHeader.TestField("Posting Date");
            ReceiptHeader.TestField(Narration);

            if ReceiptHeader."Process Type" = ReceiptHeader."Process Type"::Single then
                if (ReceiptHeader."Pay Mode" = ReceiptHeader."pay mode"::Cheque) or
                   (ReceiptHeader."Pay Mode" = ReceiptHeader."pay mode"::"Deposit Slip") then
                    ReceiptHeader.TestField("Cheque No.");

            ReceiptHeader.CalcFields("Total Amount");
            if ReceiptHeader."Total Amount" <> ReceiptHeader."Amount Recieved" then
                Error('Amount Received MUST be equal to total line amount');

            JTemplate := '';
            JBatch := '';
            LoanNo := '';
            GetReceiptJournalTemplate(JTemplate, JBatch);
            JournalInit(JTemplate, JBatch);

            Desc := ReceiptHeader."Bank Code" + ':' + ReceiptHeader."Customer No." + ':' + ReceiptHeader."Member Name";
            DisbtributionAcc := GetDistributionAccount(ReceiptHeader."Customer No.");

            DetailedJournalInsert(
                JTemplate, JBatch,
                ReceiptHeader."No.",
                ReceiptHeader."Posting Date",
                Accttype::"Bank Account",
                ReceiptHeader."Bank Code",
                Desc,
                Balaccttype::Savings,
                DisbtributionAcc,
                ReceiptHeader."Amount Recieved",
                ReceiptHeader."External Document No",
                LoanNo,
                Transtype::" ",
                ReceiptHeader."Global Dimension 1 Code",
                ReceiptHeader."Global Dimension 2 Code",
                true,
                DocType,
                ReceiptHeader."Document Date",
                '',
                AppliesToDocType, AppliesToDocNo, AppliesToID, DimensionSetID
            );

            DocLine.Reset();
            DocLine.SetRange("Header No.", ReceiptHeader."No.");
            if DocLine.FindFirst() then begin
                repeat
                    IntArrears := 0;
                    DedAmt := 0;
                    PrincipalArrears := 0;
                    ExpectedBal := 0;
                    CurrentBal := 0;

                    DocLine.TestField("Account No.");
                    DocLine.TestField(Amount);
                    DocLine.TestField(Description);

                    DisbtributionAcc := GetDistributionAccount(ReceiptHeader."Customer No.");

                    if DocLine."Account Type" = DocLine."account type"::Credit then begin
                        DocLine.TestField("Loan No.");
                        Loans.Reset();
                        Loans.SetRange("Loan No.", DocLine."Loan No.");
                        if Loans.FindFirst() then begin

                            ProductSetup.Get(Loans."Loan Product Type");

                            RunBal := DocLine.Amount;
                            Loans.CalcFields("Outstanding Appraisal", "Outstanding Interest", "Outstanding Insurance", "Outstanding Penalty", "Outstanding Principal");

                            if (Loans."Outstanding Penalty" > 0) and (Docline."Penalty Due" > 0) then begin
                                PenaltyAmt := Loans."Outstanding Penalty";
                                if PenaltyAmt > RunBal then
                                    PenaltyAmt := RunBal;

                                if ProductSetup."USSD Product Name" <> '' then
                                    Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Penalty Paid'), 1, 100)
                                else
                                    Desc := CopyStr(Loans."Loan Product Type Name" + ':' + Format('Penalty Paid'), 1, 100);

                                DetailedJournalInsert(
                                    JTemplate, JBatch,
                                    ReceiptHeader."No.",
                                    ReceiptHeader."Posting Date",
                                    Accttype::Savings, DisbtributionAcc,
                                    Desc,
                                    DocLine."Account Type", DocLine."Account No.",
                                    PenaltyAmt, DocLine."External Doc.", DocLine."Loan No.",
                                    DocLine."transaction type"::"Penalty Paid",
                                    DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                    true, DocLine."Document Type", ReceiptHeader."Document Date", '',
                                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                    DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                );
                                RunBal -= PenaltyAmt;
                            end;

                            if Loans."Outstanding Appraisal" > 0 then begin
                                AppraisalAmt := Loans."Outstanding Appraisal";
                                if AppraisalAmt > RunBal then
                                    AppraisalAmt := RunBal;

                                if ProductSetup."USSD Product Name" <> '' then
                                    Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Appraisal Paid'), 1, 100)
                                else
                                    Desc := CopyStr(Loans."Loan Product Type Name" + ':' + Format('Appraisal Paid'), 1, 100);

                                DetailedJournalInsert(
                                    JTemplate, JBatch,
                                    ReceiptHeader."No.",
                                    ReceiptHeader."Posting Date",
                                    Accttype::Savings, DisbtributionAcc,
                                    Desc,
                                    DocLine."Account Type", DocLine."Account No.",
                                    AppraisalAmt, DocLine."External Doc.", DocLine."Loan No.",
                                    DocLine."transaction type"::"Appraisal Paid",
                                    DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                    true, DocLine."Document Type", ReceiptHeader."Document Date", '',
                                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                    DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                );
                                RunBal -= AppraisalAmt;
                            end;

                            if (DocLine."Insurance Due" > 0) and (Loans."Outstanding Insurance" > 0) then begin
                                if DocLine."Insurance Due" > Loans."Outstanding Insurance" then
                                    DocLine."Insurance Due" := Loans."Outstanding Insurance";
                                IntAmt := DocLine."Insurance Due";
                                if IntAmt > RunBal then
                                    IntAmt := RunBal;


                                if ProductSetup."USSD Product Name" <> '' then
                                    Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Insurance Paid'), 1, 100)
                                else
                                    Desc := CopyStr(Loans."Loan Product Type Name" + ':' + Format('Insurance Paid'), 1, 100);

                                DetailedJournalInsert(
                                    JTemplate, JBatch,
                                    ReceiptHeader."No.",
                                    ReceiptHeader."Posting Date",
                                    Accttype::Savings, DisbtributionAcc,
                                    Desc,
                                        DocLine."Account Type", DocLine."Account No.",
                                    IntAmt, DocLine."External Doc.", DocLine."Loan No.",
                                    DocLine."transaction type"::"Insurance Paid",
                                    DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                    true, DocLine."Document Type", ReceiptHeader."Document Date", '',
                                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                    DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                );
                                RunBal -= IntAmt;
                            end;

                            if (DocLine."Interest Due" > 0) and (Loans."Outstanding Interest" > 0) then begin
                                if DocLine."Interest Due" > Loans."Outstanding Interest" then
                                    DocLine."Interest Due" := Loans."Outstanding Interest";
                                IntAmt := DocLine."Interest Due";
                                if IntAmt > RunBal then
                                    IntAmt := RunBal;

                                if ProductSetup."USSD Product Name" <> '' then
                                    Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Interest Paid'), 1, 100)
                                else
                                    Desc := CopyStr(Loans."Loan Product Type Name" + ':' + Format('Interest Paid'), 1, 100);

                                DetailedJournalInsert(
                                    JTemplate, JBatch,
                                    ReceiptHeader."No.",
                                    ReceiptHeader."Posting Date",
                                    Accttype::Savings, DisbtributionAcc,
                                    Desc,
                                    DocLine."Account Type", DocLine."Account No.",
                                    IntAmt, DocLine."External Doc.", DocLine."Loan No.",
                                    DocLine."transaction type"::"Interest Paid",
                                    DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                    true, DocLine."Document Type", ReceiptHeader."Document Date", '',
                                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                    DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                );
                                RunBal -= IntAmt;
                            end;

                            if (RunBal > 0) and (DocLine."Principal Due" > 0) then begin
                                if DocLine."Principal Due" > Loans."Outstanding Principal" then
                                    DocLine."Principal Due" := Loans."Outstanding Principal";
                                PrAmt := DocLine."Principal Due";

                                if ProductSetup."USSD Product Name" <> '' then
                                    Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Principal Paid'), 1, 100)
                                else
                                    Desc := CopyStr(Loans."Loan Product Type Name" + ':' + Format('Principal Paid'), 1, 100);

                                DetailedJournalInsert(
                                    JTemplate, JBatch,
                                    ReceiptHeader."No.",
                                    ReceiptHeader."Posting Date",
                                    Accttype::Savings, DisbtributionAcc,
                                    Desc,
                                    DocLine."Account Type", DocLine."Account No.",
                                    PrAmt, DocLine."External Doc.", DocLine."Loan No.",
                                    DocLine."transaction type"::"Principal Repayment",
                                    DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                    true, DocLine."Document Type", ReceiptHeader."Document Date", '',
                                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                    DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                );
                                RunBal -= PrAmt;
                            end;
                        end;
                    end else begin
                        if DocLine.Description <> '' then
                            Desc := DocLine.Description
                        else
                            Desc := CopyStr(DocLine."Member No." + ':' + DocLine.Name, 1, 100);
                        DetailedJournalInsert(
                            JTemplate, JBatch,
                            ReceiptHeader."No.",
                            ReceiptHeader."Posting Date",
                            DocLine."Account Type", DocLine."Account No.",
                            Desc,
                            Balaccttype::Savings, DisbtributionAcc,
                            DocLine.Amount * -1,
                            DocLine."External Doc.",
                            DocLine."Loan No.", DocLine."Transaction Type",
                            DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                            true, DocLine."Document Type", ReceiptHeader."Document Date", '',
                            DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                            DocLine."Applies-to ID", DocLine."Dimension Set ID"
                        );
                    end;

                until DocLine.Next() = 0;

                if PreviewPost then begin

                    ReceiptHeader.Posted := true;
                    ReceiptHeader."Date Posted" := Today;
                    ReceiptHeader."Time Posted" := Time;
                    ReceiptHeader."Posted By" := UserId;
                    ReceiptHeader.Modify();

                    GenJournalLine.Reset();
                    GenJournalLine.SetRange("Journal Template Name", JTemplate);
                    GenJournalLine.SetRange("Journal Batch Name", JBatch);
                    If GenJournalLine.FindFirst() then begin
                        GenJournalLine.Receipt := true;
                        GenJournalLine.Modify();
                        Commit();

                        Page.Run(Page::"Cash Receipt Journal", GenJournalLine);
                    end;

                end else begin
                    JournalPost(JTemplate, JBatch);

                    if not ReceiptPreviewMode then begin
                        ReceiptHeader.Posted := true;
                        ReceiptHeader."Date Posted" := Today;
                        ReceiptHeader."Time Posted" := Time;
                        ReceiptHeader."Posted By" := UserId;
                        ReceiptHeader.Modify();
                        if not ReceiptHeader."Dont Send SMS" then
                            SendReceiptNotifications(ReceiptHeader);
                        Message('Receipt Posted Successfully');
                    end else
                        Message('Receipt posting preview completed. No entries were posted.');
                end;
            end;
        end;
    end;

    // BULK - built fresh, one member at a time
    // For each member: Bank DR / Distribution CR then Distribution DR / Savings/Loan CR
    procedure PostBulkReceipt(ReceiptNo: Code[20]; PreviewPost: Boolean)
    var
        ReceiptHeader: Record "Receipt Header";
        RcptBufLines: Record "Receipt Buffer Lines";
        RcptBufTxnLines: Record "Receipt Buffer Lines";
        DocLine: Record "Document Line";
        RunBal: Decimal;
        PrAmt: Decimal;
        IntAmt: Decimal;
        PenaltyAmt: Decimal;
        AppraisalAmt: Decimal;
        DedAmt: Decimal;
        IntArrears: Decimal;
        DisbtributionAcc: Code[20];
        Desc: Text;
        Window: Dialog;
        Counter: Integer;
        Total: Integer;
        PDate: Date;
        ProcessingLbl: Label 'Posting Members... #2########## @1@@@@@@@@@@@@@@@@';
        LastMemberNo: Code[20];
        LastTransactionNo: Code[20];
        MemberTxnAmount: Decimal;
        GenJournalLine: Record "Gen. Journal Line";
        ProductSetup: Record "Product Setup";
        PowerEvents: Codeunit "UW Power Automate Bus. Events";
    begin
        if not ReceiptHeader.Get(ReceiptNo) then
            exit;

        ReceiptHeader.TestField(Posted, false);
        ReceiptHeader.TestField("Posting Date");
        ReceiptHeader.TestField(Narration);
        ReceiptHeader.TestField("Bank Code");

        if (ReceiptHeader."Pay Mode" = ReceiptHeader."pay mode"::Cheque) or
           (ReceiptHeader."Pay Mode" = ReceiptHeader."pay mode"::"Deposit Slip") then
            ReceiptHeader.TestField("Cheque No.");

        ReceiptHeader.CalcFields("Total Amount");
        if ReceiptHeader."Total Amount" <> ReceiptHeader."Amount Recieved" then
            Error('Amount Received MUST be equal to total line amount');

        JTemplate := '';
        JBatch := '';
        LoanNo := '';
        GetReceiptJournalTemplate(JTemplate, JBatch);
        JournalInit(JTemplate, JBatch);

        // Get buffer lines
        RcptBufLines.Reset();
        RcptBufLines.SetCurrentKey("Batch No", "Member No", "Transaction No.");
        RcptBufLines.SetRange("Batch No", ReceiptHeader."No.");
        RcptBufLines.SetRange("Member Found", true);
        if RcptBufLines.FindSet() then
            repeat
                if not BulkReceiptGroupAlreadyPosted(ReceiptHeader."No.", RcptBufLines."Member No", RcptBufLines."Transaction No.") then
                    Total += 1;
            until RcptBufLines.Next() = 0;
        if Total = 0 then begin
            ReceiptHeader.Posted := true;
            ReceiptHeader."Date Posted" := Today;
            ReceiptHeader."Time Posted" := Time;
            ReceiptHeader."Posted By" := UserId;
            ReceiptHeader.Modify();
            Message('Receipt %1 has no unposted bulk receipt lines. The receipt has been marked as posted.', ReceiptHeader."No.");
            exit;
        end;
        Window.Open(ProcessingLbl);

        RcptBufLines.Reset();
        RcptBufLines.SetCurrentKey("Batch No", "Member No", "Transaction No.");
        RcptBufLines.SetRange("Batch No", ReceiptHeader."No.");
        RcptBufLines.SetRange("Member Found", true);
        if RcptBufLines.FindSet() then
            repeat
                if (RcptBufLines."Member No" <> LastMemberNo) or (RcptBufLines."Transaction No." <> LastTransactionNo) then begin
                    LastMemberNo := RcptBufLines."Member No";
                    LastTransactionNo := RcptBufLines."Transaction No.";
                    MemberTxnAmount := 0;

                    RcptBufTxnLines.Reset();
                    RcptBufTxnLines.SetRange("Batch No", ReceiptHeader."No.");
                    RcptBufTxnLines.SetRange("Member Found", true);
                    RcptBufTxnLines.SetRange("Member No", RcptBufLines."Member No");
                    RcptBufTxnLines.SetRange("Transaction No.", RcptBufLines."Transaction No.");
                    if RcptBufTxnLines.FindSet() then
                        repeat
                            MemberTxnAmount += RcptBufTxnLines.Amount;
                        until RcptBufTxnLines.Next() = 0;

                    Counter += 1;
                    Window.Update(1, Round(Counter / Total * 10000, 1));
                    Window.Update(2, RcptBufLines."Member No");

                    if BulkReceiptGroupAlreadyPosted(ReceiptHeader."No.", RcptBufLines."Member No", RcptBufLines."Transaction No.") then
                        MarkBulkReceiptGroupAsPosted(ReceiptHeader."No.", RcptBufLines."Member No", RcptBufLines."Transaction No.")
                    else begin
                        DisbtributionAcc := GetDistributionAccount(RcptBufLines."Member No");
                        Desc := RcptBufLines."Member No" + ':' + RcptBufLines.Name;

                        PDate := 0D;
                        DocLine.Reset();
                        DocLine.SetCurrentKey("Entry No.");
                        DocLine.SetRange("Header No.", ReceiptHeader."No.");
                        DocLine.SetRange("Member No.", RcptBufLines."Member No");
                        DocLine.SetRange("External Doc.", RcptBufLines."Transaction No.");
                        if DocLine.FindFirst() then
                            PDate := DocLine."Posting Date"
                        else
                            PDate := ReceiptHeader."Posting Date";

                        // STEP 1 - Bank entry per member transaction
                        DetailedJournalInsert(
                            JTemplate, JBatch,
                            ReceiptHeader."No.",
                            PDate,
                            Accttype::"Bank Account",
                            ReceiptHeader."Bank Code",
                            Desc,
                            Balaccttype::"G/L Account",
                            '',
                            MemberTxnAmount,
                            RcptBufLines."Transaction No.",
                            LoanNo,
                            Transtype::" ",
                            ReceiptHeader."Global Dimension 1 Code",
                            ReceiptHeader."Global Dimension 2 Code",
                            true,
                            DocType,
                            PDate,
                            '',
                            AppliesToDocType, AppliesToDocNo, AppliesToID, DimensionSetID
                        );

                        // STEP 2 - Bank entry per member transaction
                        Desc := 'Deposit Contribution';
                        DetailedJournalInsert(
                            JTemplate, JBatch,
                            ReceiptHeader."No.",
                            PDate,
                            Accttype::Savings,
                            DisbtributionAcc,
                            Desc,
                            Balaccttype::"G/L Account",
                            '',
                            -MemberTxnAmount,
                            RcptBufLines."Transaction No.",
                            LoanNo,
                            Transtype::" ",
                            ReceiptHeader."Global Dimension 1 Code",
                            ReceiptHeader."Global Dimension 2 Code",
                            true,
                            DocType,
                            PDate,
                            '',
                            AppliesToDocType, AppliesToDocNo, AppliesToID, DimensionSetID
                        );

                        // STEP 2 - DocLines for this member transaction only
                        DocLine.Reset();
                        DocLine.SetCurrentKey("Entry No.");
                        DocLine.SetRange("Header No.", ReceiptHeader."No.");
                        DocLine.SetRange("Member No.", RcptBufLines."Member No");
                        DocLine.SetRange("External Doc.", RcptBufLines."Transaction No.");
                        if DocLine.FindSet() then
                            repeat
                                DocLine.TestField("Account No.");
                                DocLine.TestField(Amount);
                                DocLine.TestField(Description);
                                PDate := DocLine."Posting Date";

                                if DocLine."Account Type" = DocLine."account type"::Credit then begin
                                    DocLine.TestField("Loan No.");
                                    Loans.Reset();
                                    Loans.SetRange("Loan No.", DocLine."Loan No.");
                                    if Loans.FindFirst() then begin

                                        if ProductSetup.Get(Loans."Loan Product Type") then;

                                        RunBal := DocLine.Amount;
                                        Loans.CalcFields("Outstanding Appraisal", "Outstanding Interest", "Outstanding Insurance", "Outstanding Penalty", "Outstanding Principal");
                                        if DocLine."Penalty Due" > 0 then begin
                                            Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Penalty Paid'), 1);
                                            if Loans."Outstanding Penalty" > 0 then begin
                                                PenaltyAmt := Loans."Outstanding Penalty";
                                                if PenaltyAmt > RunBal then
                                                    PenaltyAmt := RunBal;

                                                DetailedJournalInsert(
                                                    JTemplate, JBatch,
                                                    ReceiptHeader."No.",
                                                    PDate,
                                                    Accttype::Savings, DisbtributionAcc,
                                                    Desc,
                                                    DocLine."Account Type", DocLine."Account No.",
                                                    PenaltyAmt, DocLine."External Doc.", DocLine."Loan No.",
                                                    DocLine."transaction type"::"Penalty Paid",
                                                    DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                                    true, DocLine."Document Type", PDate, '',
                                                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                                    DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                                );
                                                RunBal -= PenaltyAmt;
                                            end;
                                        end;

                                        if Loans."Outstanding Appraisal" > 0 then begin
                                            AppraisalAmt := Loans."Outstanding Appraisal";
                                            if AppraisalAmt > RunBal then
                                                AppraisalAmt := RunBal;
                                            Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Appraisal Paid'), 1);
                                            DetailedJournalInsert(
                                                JTemplate, JBatch,
                                                ReceiptHeader."No.",
                                                PDate,
                                                Accttype::Savings, DisbtributionAcc,
                                                Desc,
                                                DocLine."Account Type", DocLine."Account No.",
                                                AppraisalAmt, DocLine."External Doc.", DocLine."Loan No.",
                                                DocLine."transaction type"::"Appraisal Paid",
                                                DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                                true, DocLine."Document Type", PDate, '',
                                                DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                                DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                            );
                                            RunBal -= AppraisalAmt;
                                        end;

                                        if DocLine."Insurance Due" > 0 then begin
                                            if DocLine."Insurance Due" > Loans."Outstanding Insurance" then
                                                DocLine."Insurance Due" := Loans."Outstanding Insurance";
                                            IntAmt := DocLine."Insurance Due";
                                            if IntAmt > RunBal then
                                                IntAmt := RunBal;

                                            Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Insurance Paid'), 1);
                                            DetailedJournalInsert(
                                                JTemplate, JBatch,
                                                ReceiptHeader."No.",
                                                PDate,
                                                Accttype::Savings, DisbtributionAcc,
                                                Desc,
                                                DocLine."Account Type", DocLine."Account No.",
                                                IntAmt, DocLine."External Doc.", DocLine."Loan No.",
                                                DocLine."transaction type"::"Insurance Paid",
                                                DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                                true, DocLine."Document Type", PDate, '',
                                                DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                                DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                            );
                                            RunBal -= IntAmt;
                                        end;

                                        if DocLine."Interest Due" > 0 then begin
                                            if DocLine."Interest Due" > Loans."Outstanding Interest" then
                                                DocLine."Interest Due" := Loans."Outstanding Interest";
                                            IntAmt := DocLine."Interest Due";
                                            if IntAmt > RunBal then
                                                IntAmt := RunBal;

                                            Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Interest Paid'), 1);
                                            DetailedJournalInsert(
                                                JTemplate, JBatch,
                                                ReceiptHeader."No.",
                                                PDate,
                                                Accttype::Savings, DisbtributionAcc,
                                                Desc,
                                                DocLine."Account Type", DocLine."Account No.",
                                                IntAmt, DocLine."External Doc.", DocLine."Loan No.",
                                                DocLine."transaction type"::"Interest Paid",
                                                DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                                true, DocLine."Document Type", PDate, '',
                                                DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                                DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                            );
                                            RunBal -= IntAmt;
                                        end;

                                        if (RunBal > 0) and (DocLine."Principal Due" > 0) then begin
                                            if DocLine."Principal Due" > Loans."Outstanding Principal" then
                                                DocLine."Principal Due" := Loans."Outstanding Principal";
                                            PrAmt := DocLine."Principal Due";

                                            Desc := CopyStr(ProductSetup."USSD Product Name" + ':' + Format('Principal Repayment'), 1);
                                            DetailedJournalInsert(
                                                JTemplate, JBatch,
                                                ReceiptHeader."No.",
                                                PDate,
                                                Accttype::Savings, DisbtributionAcc,
                                                Desc,
                                                DocLine."Account Type", DocLine."Account No.",
                                                PrAmt, DocLine."External Doc.", DocLine."Loan No.",
                                                DocLine."transaction type"::"Principal Repayment",
                                                DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                                true, DocLine."Document Type", PDate, '',
                                                DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                                DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                            );
                                            RunBal -= PrAmt;
                                        end;
                                    end;
                                end else begin
                                    // Non-credit lines - Savings, Excess
                                    Desc := CopyStr(DocLine.Description, 1, 100);

                                    DetailedJournalInsert(
                                        JTemplate, JBatch,
                                        ReceiptHeader."No.",
                                        PDate,
                                        Accttype::Savings, 
                                        DisbtributionAcc,
                                        Desc,
                                        Balaccttype::"G/L Account", 
                                        '',
                                        DocLine.Amount,
                                        DocLine."External Doc.",
                                        DocLine."Loan No.", DocLine."Transaction Type",
                                        DocLine."Shortcut Dimension 1 Code", DocLine."Shortcut Dimension 2 Code",
                                        true, DocLine."Document Type", PDate, '',
                                        DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.",
                                        DocLine."Applies-to ID", DocLine."Dimension Set ID"
                                    );

                                    DetailedJournalInsert(
                                        JTemplate, JBatch,
                                        ReceiptHeader."No.",
                                        PDate,
                                        DocLine."Account Type", 
                                        DocLine."Account No.",
                                        Desc,
                                        Balaccttype::"G/L Account",
                                        '',
                                        DocLine.Amount * -1,
                                        DocLine."External Doc.",
                                        DocLine."Loan No.", 
                                        DocLine."Transaction Type",
                                        DocLine."Shortcut Dimension 1 Code",
                                        DocLine."Shortcut Dimension 2 Code",
                                        true, 
                                        DocLine."Document Type",
                                         PDate, '',
                                        DocLine."Applies-to Doc. Type",
                                        DocLine."Applies-to Doc. No.",
                                        DocLine."Applies-to ID",
                                        DocLine."Dimension Set ID"
                                    );
                                    

                                end;

                            until DocLine.Next() = 0;
                        if not previewpost then begin
                            JournalPost(JTemplate, JBatch); //post line by line to avoid locks and to have better visibility of the posting process in case of errors. Also allows partial posting in case of issues with some members' transactions
                            MarkBulkReceiptGroupAsPosted(ReceiptHeader."No.", RcptBufLines."Member No", RcptBufLines."Transaction No.");
                        end;
                    end;
                end;

            until RcptBufLines.Next() = 0;

        Window.Close();

        if previewpost then begin
            ReceiptHeader.Posted := true;
            ReceiptHeader."Date Posted" := Today;
            ReceiptHeader."Time Posted" := Time;
            ReceiptHeader."Posted By" := UserId;
            ReceiptHeader.Modify();

            GenJournalLine.Reset();
            GenJournalLine.SetRange("Journal Template Name", JTemplate);
            GenJournalLine.SetRange("Journal Batch Name", JBatch);
            if GenJournalLine.FindFirst() then begin
                GenJournalLine.Receipt := true;
                GenJournalLine.Modify();
                Commit();

                Page.Run(Page::"Cash Receipt Journal", GenJournalLine);
            end

        end else begin

            ReceiptHeader.Posted := true;
            ReceiptHeader."Date Posted" := Today;
            ReceiptHeader."Time Posted" := Time;
            ReceiptHeader."Posted By" := UserId;
            ReceiptHeader.Modify();
            Commit();

            if not ReceiptHeader."Dont Send SMS" then
                SendReceiptNotifications(ReceiptHeader);

            Message('Receipt Posted Successfully');
        end;
    end;

    procedure PostGLReceiptBufferLines(ReceiptNo: Code[20]; PreviewPost: Boolean)
    var
        ReceiptHeader: Record "Receipt Header";
        DocLine: Record "Document Line";
        Desc: Text[100];
        PowerEvents: Codeunit "UW Power Automate Bus. Events";
    begin
        if not ReceiptHeader.Get(ReceiptNo) then
            exit;

        ReceiptHeader.TestField(Posted, false);
        ReceiptHeader.TestField("Posting Date");
        ReceiptHeader.TestField(Narration);
        ReceiptHeader.TestField("Bank Code");

        JTemplate := '';
        JBatch := '';
        GetReceiptJournalTemplate(JTemplate, JBatch);
        JournalInit(JTemplate, JBatch);

        //TransferGLReceiptBufferLinesToReceiptLines(ReceiptHeader);

        DocLine.Reset();
        DocLine.SetRange("Header No.", ReceiptHeader."No.");
        DocLine.SetRange("Account Type", DocLine."Account Type"::"G/L Account");
        DocLine.SetRange(Type, 'G/L Account');
        DocLine.SetRange(Posted, false);
        if not DocLine.FindSet(true) then begin
            Message('Receipt %1 has no unposted G/L receipt buffer lines.', ReceiptHeader."No.");
            exit;
        end;

        repeat
            DocLine.TestField("Account No.");
            DocLine.TestField(Amount);
            DocLine.TestField("External Doc.");

            if not GLReceiptLineAlreadyPosted(DocLine) then begin
                Desc := CopyStr(DocLine.Description, 1, MaxStrLen(Desc));
                if Desc = '' then
                    Desc := CopyStr(DocLine."Account No.", 1, MaxStrLen(Desc));

                DetailedJournalInsert(
                    JTemplate, JBatch,
                    ReceiptHeader."No.",
                    DocLine."Posting Date",
                    Accttype::"Bank Account",
                    ReceiptHeader."Bank Code",
                    Desc,
                    Balaccttype::"G/L Account",
                    '',
                    DocLine.Amount,
                    DocLine."External Doc.",
                    '',
                    Transtype::" ",
                    DocLine."Shortcut Dimension 1 Code",
                    DocLine."Shortcut Dimension 2 Code",
                    true,
                    DocLine."Document Type",
                    ReceiptHeader."Document Date",
                    '',
                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.", DocLine."Applies-to ID", DocLine."Dimension Set ID"
                );

                DetailedJournalInsert(
                    JTemplate, JBatch,
                    ReceiptHeader."No.",
                    DocLine."Posting Date",
                    Accttype::"G/L Account",
                    DocLine."Account No.",
                    Desc,
                    Balaccttype::"G/L Account",
                    '',
                    -DocLine.Amount,
                    DocLine."External Doc.",
                    '',
                    Transtype::" ",
                    DocLine."Shortcut Dimension 1 Code",
                    DocLine."Shortcut Dimension 2 Code",
                    true,
                    DocLine."Document Type",
                    ReceiptHeader."Document Date",
                    '',
                    DocLine."Applies-to Doc. Type", DocLine."Applies-to Doc. No.", DocLine."Applies-to ID", DocLine."Dimension Set ID"
                );

            end;

            if not PreviewPost then begin
                JournalPost(JTemplate, JBatch);
                MarkGLReceiptBufferLineAsPosted(DocLine);
                DocLine.Posted := true;
                DocLine.Modify();
            end;
        until DocLine.Next() = 0;


        if PreviewPost then
            Message('G/L receipt buffer preview completed. No entries were posted.')
        else begin
            ReceiptHeader.Posted := true;
            ReceiptHeader."Date Posted" := Today;
            ReceiptHeader."Time Posted" := Time;
            ReceiptHeader."Posted By" := UserId;
            ReceiptHeader.modify();
            /* PowerEvents.RaiseReceiptPosted(
                ReceiptHeader."No.",
                ReceiptHeader."Customer No.",
                ReceiptHeader."Member Name",
                ReceiptHeader."Amount Recieved",
                ReceiptHeader."Posting Date",
                ReceiptHeader."Responsibility Center"); */
            Message('G/L receipt buffer lines posted successfully for receipt %1.', ReceiptHeader."No.");

        end;
    end;

    procedure TransferGLReceiptBufferLinesToReceiptLines(ReceiptHeader: Record "Receipt Header")
    var
        RcptBufLines: Record "Receipt Buffer Lines";
        DocLine: Record "Document Line";
        GLAccount: Record "G/L Account";
        LineNo: Integer;
    begin
        RcptBufLines.Reset();
        RcptBufLines.SetRange("Batch No", ReceiptHeader."No.");
        RcptBufLines.SetRange(Type, RcptBufLines.Type::"G/L Account");
        RcptBufLines.SetRange(Posted, false);
        if not RcptBufLines.FindSet() then
            exit;

        LineNo := GetNextReceiptDocumentLineNo(ReceiptHeader."No.");
        repeat
            RcptBufLines.TestField("G/L Account No.");
            RcptBufLines.TestField(Amount);
            RcptBufLines.TestField("Transaction No.");

            GLAccount.Get(RcptBufLines."G/L Account No.");
            GLAccount.TestField("Account Type", GLAccount."Account Type"::Posting);
            GLAccount.TestField(Blocked, false);
            GLAccount.TestField("Direct Posting", true);

            //if not GLReceiptBufferDocumentLineExists(RcptBufLines) then begin
            DocLine.Init();
            DocLine."Header No." := ReceiptHeader."No.";
            DocLine."Line No." := LineNo;
            DocLine."Entry No." := LineNo;
            DocLine.Validate("Account Type", DocLine."Account Type"::"G/L Account");
            DocLine.Validate("Account No.", RcptBufLines."G/L Account No.");
            DocLine."Posting Date" := ReceiptHeader."Posting Date";
            DocLine."Document Type" := DocType;
            DocLine.Description := CopyStr(RcptBufLines.Name, 1, MaxStrLen(DocLine.Description));
            if DocLine.Description = '' then
                DocLine.Description := CopyStr(GLAccount.Name, 1, MaxStrLen(DocLine.Description));
            DocLine."External Doc." := RcptBufLines."Transaction No.";
            DocLine.Type := 'G/L Account';
            DocLine."Shortcut Dimension 1 Code" := ReceiptHeader."Global Dimension 1 Code";
            DocLine."Shortcut Dimension 2 Code" := ReceiptHeader."Global Dimension 2 Code";
            DocLine."Dimension Set ID" := ReceiptHeader."Dimension Set ID";
            DocLine.Validate(Amount, RcptBufLines.Amount);
            DocLine.Insert(true);
            LineNo += 10000;
        //end;
        until RcptBufLines.Next() = 0;
    end;

    procedure SuggestNonMemberReceiptLinesFromBuffer(RHeader: Record "Receipt Header")
    var
        ReceiptHeader: Record "Receipt Header";
        DocLine: Record "Document Line";
        BeforeCount: Integer;
        AfterCount: Integer;
    begin
        if ReceiptHeader.Get(RHeader."No.") then
            RHeader := ReceiptHeader;

        RHeader.TestField("Amount Recieved");
        RHeader.TestField("Posting Date");
        RHeader.TestField(Posted, false);

        DeleteUnpostedNonMemberReceiptLines(RHeader."No.");

        DocLine.Reset();
        DocLine.SetRange("Header No.", RHeader."No.");
        DocLine.SetRange("Account Type", DocLine."Account Type"::"G/L Account");
        DocLine.SetRange(Type, 'G/L Account');
        BeforeCount := DocLine.Count();

        TransferGLReceiptBufferLinesToReceiptLines(RHeader);

        DocLine.Reset();
        DocLine.SetRange("Header No.", RHeader."No.");
        DocLine.SetRange("Account Type", DocLine."Account Type"::"G/L Account");
        DocLine.SetRange(Type, 'G/L Account');
        AfterCount := DocLine.Count();

        if AfterCount = BeforeCount then
            Message('No new non-member/G/L receipt lines were suggested for receipt %1.', RHeader."No.")
        else
            Message('%1 non-member/G/L receipt line(s) suggested for receipt %2.', AfterCount - BeforeCount, RHeader."No.");
    end;

    local procedure DeleteUnpostedNonMemberReceiptLines(ReceiptNo: Code[20])
    var
        DocLine: Record "Document Line";
    begin
        DocLine.Reset();
        DocLine.SetRange("Header No.", ReceiptNo);
        DocLine.SetRange("Account Type", DocLine."Account Type"::"G/L Account");
        DocLine.SetRange(Type, 'G/L Account');
        DocLine.SetRange(Posted, false);
        if DocLine.FindSet(true) then
            repeat
                DocLine.Delete(true);
            until DocLine.Next() = 0;
    end;

    local procedure GLReceiptLineAlreadyPosted(DocLine: Record "Document Line"): Boolean
    var
        GLEntry: Record "G/L Entry";
    begin
        GLEntry.Reset();
        GLEntry.SetRange("Document No.", DocLine."Header No.");
        GLEntry.SetRange("External Document No.", DocLine."External Doc.");
        GLEntry.SetRange("G/L Account No.", DocLine."Account No.");
        GLEntry.SetRange(Amount, -DocLine.Amount);
        exit(not GLEntry.IsEmpty());
    end;

    local procedure GLReceiptBufferDocumentLineExists(RcptBufLine: Record "Receipt Buffer Lines"): Boolean
    var
        DocLine: Record "Document Line";
    begin
        DocLine.Reset();
        DocLine.SetRange("Header No.", RcptBufLine."Batch No");
        DocLine.SetRange("Account Type", DocLine."Account Type"::"G/L Account");
        DocLine.SetRange("Account No.", RcptBufLine."G/L Account No.");
        DocLine.SetRange("External Doc.", RcptBufLine."Transaction No.");
        DocLine.SetRange(Type, 'G/L Account');
        exit(not DocLine.IsEmpty());
    end;

    local procedure MarkGLReceiptBufferLineAsPosted(DocLine: Record "Document Line")
    var
        RcptBufLine: Record "Receipt Buffer Lines";
    begin
        RcptBufLine.Reset();
        RcptBufLine.SetRange("Batch No", DocLine."Header No.");
        RcptBufLine.SetRange(Type, RcptBufLine.Type::"G/L Account");
        RcptBufLine.SetRange("G/L Account No.", DocLine."Account No.");
        RcptBufLine.SetRange("Transaction No.", DocLine."External Doc.");
        RcptBufLine.SetRange(Amount, DocLine.Amount);
        RcptBufLine.SetRange(Posted, false);
        if RcptBufLine.FindSet(true) then
            repeat
                RcptBufLine.Posted := true;
                RcptBufLine.Modify();
            until RcptBufLine.Next() = 0;
    end;

    local procedure GetNextReceiptDocumentLineNo(ReceiptNo: Code[20]): Integer
    var
        DocLine: Record "Document Line";
    begin
        DocLine.Reset();
        DocLine.SetRange("Header No.", ReceiptNo);
        if DocLine.FindLast() then
            exit(DocLine."Line No." + 10000);

        exit(10000);
    end;

    local procedure BulkReceiptGroupAlreadyPosted(ReceiptNo: Code[20]; MemberNo: Code[20]; TransactionNo: Code[20]): Boolean
    var
        GLEntry: Record "G/L Entry";
    begin
        GLEntry.Reset();
        GLEntry.SetRange("Document No.", ReceiptNo);
        GLEntry.SetRange("External Document No.", TransactionNo);
        GLEntry.SetRange("Member No.", MemberNo);
        //GLEntry.SetRange(Reversed, false);
        exit(not GLEntry.IsEmpty());
    end;

    local procedure DeleteUnpostedReceiptDistributionLines(ReceiptNo: Code[20])
    var
        DocLine: Record "Document Line";
    begin
        DocLine.Reset();
        DocLine.SetRange("Header No.", ReceiptNo);
        if DocLine.FindSet(true) then
            repeat
                if not BulkReceiptGroupAlreadyPosted(ReceiptNo, DocLine."Member No.", DocLine."External Doc.") then
                    DocLine.Delete(true);
            until DocLine.Next() = 0;
    end;

    local procedure CountUnpostedReceiptBufferGroups(ReceiptNo: Code[20]): Integer
    var
        RcptBufLines: Record "Receipt Buffer Lines";
        LastMemberNo: Code[20];
        LastTransactionNo: Code[20];
        GroupCount: Integer;
    begin
        RcptBufLines.Reset();
        RcptBufLines.SetCurrentKey("Batch No", "Member No", "Transaction No.");
        RcptBufLines.SetRange("Batch No", ReceiptNo);
        RcptBufLines.SetRange("Member Found", true);
        if RcptBufLines.FindSet() then
            repeat
                if (RcptBufLines."Member No" <> LastMemberNo) or (RcptBufLines."Transaction No." <> LastTransactionNo) then begin
                    LastMemberNo := RcptBufLines."Member No";
                    LastTransactionNo := RcptBufLines."Transaction No.";
                    if not BulkReceiptGroupAlreadyPosted(ReceiptNo, RcptBufLines."Member No", RcptBufLines."Transaction No.") then
                        GroupCount += 1;
                end;
            until RcptBufLines.Next() = 0;

        exit(GroupCount);
    end;

    local procedure MarkBulkReceiptGroupAsPosted(ReceiptNo: Code[20]; MemberNo: Code[20]; TransactionNo: Code[20])
    var
        RcptBufLines: Record "Receipt Buffer Lines";
        DocLine: Record "Document Line";
    begin
        RcptBufLines.Reset();
        RcptBufLines.SetRange("Batch No", ReceiptNo);
        RcptBufLines.SetRange("Member No", MemberNo);
        RcptBufLines.SetRange("Transaction No.", TransactionNo);
        RcptBufLines.SetRange(Posted, false);
        if RcptBufLines.FindSet(true) then
            repeat
                RcptBufLines.Posted := true;
                RcptBufLines.Modify();
            until RcptBufLines.Next() = 0;

        DocLine.Reset();
        DocLine.SetRange("Header No.", ReceiptNo);
        DocLine.SetRange("Member No.", MemberNo);
        DocLine.SetRange("External Doc.", TransactionNo);
        DocLine.SetRange(Posted, false);
        if DocLine.FindSet(true) then
            repeat
                DocLine.Posted := true;
                DocLine.Modify();
            until DocLine.Next() = 0;
    end;

    procedure PostPV(PVNo: Code[20])
    var
        PaymentHeader: Record "Payment Header";
        DocLine: Record "Document Line";
        BankAcc: Record "Bank Account";
        LnAmt: Decimal;
        PvaAmt: Decimal;
        OrdinaryChequeRegister: Record "Ordinary Cheque Register";
        //PmtRecType: Record "Payment & Receipt Types";
        PmtRecType: Record "Tariff Code";
        BUser: Record "Banking User Setup";
        ChargeAmount: decimal;
        DimID: Integer;
        MemberExit: Record "Member Exit";
        SA: Record "Savings Accounts";
        Member: Record "Members";
        PaymentNarration: Text;
        Vendor: record Vendor;

    begin

        PaymentHeader.Reset;
        PaymentHeader.SetRange("No.", PVNo);
        if PaymentHeader.FindFirst() then begin
            // TestField(Posted, false);
            UserSetup.Get(UserId);
            DimensionSetID := PaymentHeader."Dimension Set ID";
            if DimensionSetID = 0 then
                DimensionSetID := UserSetup."Dimension Set ID";

            PaymentHeader.TESTFIELD(Status, PaymentHeader.Status::Approved);
            PaymentHeader.TestField("Paying Bank Account");
            PaymentHeader.TestField("Pay Mode");
            PaymentHeader.TestField("Payment Release Date");
            PaymentHeader.TestField(Date);

            BUser.Reset();
            BUser.SetRange("User Name", UserId);
            BUser.SetRange(Type, BUser.Type::Cashier);
            if BUser.FindFirst() then begin
                PaymentHeader."Payment Release Date" := today;
            end;

            //if "Payment Release Date" <> Today then
            //  Error('Date is reading %1 kindly reset it to Today to proceed', Date);

            PaymentHeader.TestField("Payment Narration");
            if (PaymentHeader."Pay Mode" = PaymentHeader."pay mode"::Cheque) or (PaymentHeader."Pay Mode" = PaymentHeader."pay mode"::EFT) then begin
                PaymentHeader.TestField("Cheque No.");
            end;

            if PaymentHeader."Pay Mode" = PaymentHeader."pay mode"::Cash then begin

                BankAcc.Reset;
                BankAcc.SetRange(BankAcc."No.", PaymentHeader."Paying Bank Account");
                BankAcc.SetRange(BankAcc."Bank Type", BankAcc."bank type"::Cash);
                if BankAcc.FindFirst then begin
                    BankAcc.CalcFields(BankAcc.Balance);
                    PaymentHeader."Current Source A/C Bal." := BankAcc.Balance;
                    if (PaymentHeader."Current Source A/C Bal." - PaymentHeader."Total Net Amount") < 0 then begin
                        Error('The transaction will result in a negative balance in the BANK ACCOUNT. %1:%2', BankAcc."No.", BankAcc.Name);
                    end;
                end;
            end;

            PaymentHeader.CalcFields("Total Net Amount", "Total VAT Amount", "Total VAT Withholding Amount", "Total Witholding Tax Amount", "Total Payment Amount");
            PvaAmt := PaymentHeader."Total Net Amount" * -1;

            if PaymentHeader."Payment Type" = PaymentHeader."payment type"::Staff then
                PvaAmt := PaymentHeader."Total Payment Amount";

            if PaymentHeader."Payment Type" = PaymentHeader."payment type"::Board then
                PvaAmt := PaymentHeader."Total Payment Amount";

            if PaymentHeader."Payment Type" = PaymentHeader."payment type"::Member then
                PvaAmt := PaymentHeader."Total Payment Amount";


            OrdinaryChequeRegister.Reset;
            OrdinaryChequeRegister.SetRange("Ordinary Cheque No.", PaymentHeader."Cheque No.");
            if OrdinaryChequeRegister.FindFirst then begin
                OrdinaryChequeRegister.Issued := true;
                OrdinaryChequeRegister.Modify;
            end;

            JTemplate := '';
            JBatch := '';
            GetPaymentJournalTemplate(JTemplate, JBatch);

            LoanNo := '';
            JournalInit(JTemplate, JBatch);

            DocLine.Reset;
            DocLine.SetRange("Header No.", PaymentHeader."No.");
            if DocLine.FindFirst() then begin
                PaymentNarration := DocLine.Description;

                if DocLine."Member No." <> '' then
                    PaymentNarration := DocLine.Description + ' : ' + Docline."Member No." + ' : ' + DocLine."Member Name";
                if Docline."Account Type" = Docline."Account Type"::Vendor then begin
                    if Vendor.Get(Docline."Account No.") then;
                    PaymentNarration := DocLine.Description + ' : ' + Docline."Account No." + ' : ' + Vendor.name;
                end;

                if PaymentHeader."Pay Mode" <> PaymentHeader."pay mode"::Cash then
                    DocLine.Testfield("Transaction No.");
            end;


            //Net Amount
            DetailedJournalInsert(
                JTemplate,
                JBatch,
                PaymentHeader."No.",
                PaymentHeader."Payment Release Date",
                PaymentHeader."Paying Account Type",
                PaymentHeader."Paying Bank Account",
                PaymentNarration,
                Balaccttype::"G/L Account",
                '',
                PvaAmt,
                PaymentHeader."Cheque No.",
                LoanNo,
                Transtype::" ",
                PaymentHeader."Global Dimension 1 Code",
                PaymentHeader."Shortcut Dimension 2 Code",
                true,
                DocType,
                PaymentHeader.Date,
                '',
                AppliesToDocType,
                AppliesToDocNo,
                AppliesToID,
                DimensionSetID
                );


            DocLine.Reset;
            DocLine.SetRange("Header No.", PaymentHeader."No.");
            if DocLine.FindFirst then begin

                repeat
                    //if DocLine."Account Type" = DocLine."Account Type"::Vendor then
                    //  DocLine.TestField("Applies-to Doc. No.");
                    DocLine."Applies-to Doc. No." := copystr(DocLine."Applies-to Doc. No.", 1, 20);

                    DocLine.TestField("Account No.");
                    DocLine.TestField(Amount);
                    DocLine.TestField(Description);

                    if DocLine."Account Type" = DocLine."Account Type"::Vendor then begin
                        DocLine.TestField("Applies-to Doc. No.");
                        if DocLine."External Doc." <> '' then
                            DocLine."Vendor Invoice No." := DocLine."External Doc.";
                    end;

                    if SA.Get(Docline."Account No.") then;

                    if PmtRecType.Get(DocLine.Type) then;


                    if DocLine."Withholding VAT" > 0 then begin
                        PmtRecType.Get(DocLine."VAT Tax Code");
                        PmtRecType.TestField("Account No.");
                        //DocLine."VAT GL Account" := PmtRecType."VAT GL Account";
