    procedure PostNewSaccoJournal(JVNo: Code[20])
    var
        JnlLine: Record "Sacco Journal Line";
        JnlHeader: Record "Sacco Journal Header";
        Lines: Record "Gen. Journal Line";
        TempLines: Record "Gen. Journal Line" temporary;
        JBatches: Record "Gen. Journal Batch";
        i: Integer;
    begin
        JnlHeader.Get(JVNo);
        ValidateSaccoJournalBeforePosting(JnlHeader);
        CheckSaccoJournalForApproval(JnlHeader."Custom Journal Template", JnlHeader."Document No.");

        Lines.Reset();
        Lines.SetCurrentKey("Line No.");
        Lines.SetRange("Journal Template Name", JnlHeader."Custom Journal Template");
        Lines.Setrange("Journal Batch Name", JVNo);
        if not Lines.FindSet(true) then
            Error('There are no journal lines to post for document %1.', JVNo);

        repeat
            Lines.TestField("Shortcut Dimension 1 Code");
            Lines.TestField("Shortcut Dimension 2 Code");

            if Lines."Account Type" = Lines."Account Type"::Credit then begin
                Lines.TestField("Loan No.");
                Lines.TestField("Account No.");
                Lines.TestField("Transaction Type");
            end;

            if Lines."External Document No." = '' then
                Lines."External Document No." := JnlHeader."Document No.";
            Lines.Channel := TChannel::"Sacco Journal";
            Lines."System-Created Entry" := true;
            Lines.Modify(true);

            TempLines.Init();
            TempLines := Lines;
            TempLines.Insert();
        until Lines.Next() = 0;

        Commit();
        ClearLastError();
        if not TryPostSaccoJournalLines(Lines) then begin
            ResetFailedSaccoJournalPostingState(JVNo);
            Error(GetLastErrorText());
        end;

        JnlLine.Reset();
        if JnlLine.FindLast() then
            i := JnlLine."Line No.";

        if TempLines.FindSet() then
            repeat
                i += 1;
                JnlLine.Init();
                JnlLine."Batch No." := JVNo;
                JnlLine."Line No." := i;
                JnlLine."Document No." := TempLines."Document No.";
                JnlLine."Posting Date" := TempLines."Posting Date";
                JnlLine."Account Type" := TempLines."Account Type";
                JnlLine."Account No." := TempLines."Account No.";
                JnlLine.Description := TempLines.Description;
                JnlLine."Member No." := TempLines."Member No.";
                JnlLine."Bal. Account Type" := TempLines."Bal. Account Type";
                JnlLine."Bal. Account No." := TempLines."Bal. Account No.";
                JnlLine.Amount := TempLines.Amount;
                JnlLine.Validate(Amount);
                JnlLine."External Document No." := TempLines."External Document No.";
                JnlLine."Loan No" := TempLines."Loan No.";
                JnlLine."Transaction Type" := TempLines."Transaction Type";
                JnlLine."Shortcut Dimension 1 Code" := TempLines."Shortcut Dimension 1 Code";
                JnlLine."Shortcut Dimension 2 Code" := TempLines."Shortcut Dimension 2 Code";
                JnlLine."Dimension Set ID" := TempLines."Dimension Set ID";
                JnlLine.Posted := true;
                JnlLine.Insert();
            until TempLines.Next() = 0;

        JnlHeader.Posted := true;
        JnlHeader."Date Posted" := Today;
        JnlHeader.Modify();

        JBatches.Reset();
        JBatches.SetRange("Journal Template Name", JnlHeader."Custom Journal Template");
        JBatches.Setrange(Name, JVNo);
        if JBatches.FindFirst() then
            JBatches.Delete();

    end;

    [TryFunction]
    local procedure TryPostSaccoJournalLines(var Lines: Record "Gen. Journal Line")
    begin
        Lines.SendToPosting(Codeunit::"Gen. Jnl.-Post");
    end;

    local procedure ResetFailedSaccoJournalPostingState(JVNo: Code[20])
    var
        JnlHeader: Record "Sacco Journal Header";
        JnlLine: Record "Sacco Journal Line";
    begin
        if JnlHeader.Get(JVNo) then
            if JnlHeader.Posted or (JnlHeader."Date Posted" <> 0D) then begin
                JnlHeader.Posted := false;
                JnlHeader."Date Posted" := 0D;
                JnlHeader.Modify(true);
            end;

        JnlLine.Reset();
        JnlLine.SetRange("Batch No.", JVNo);
        if JnlLine.FindSet(true) then
            repeat
                if JnlLine.Posted then begin
                    JnlLine.Posted := false;
                    JnlLine.Modify(true);
                end;
            until JnlLine.Next() = 0;
    end;

    local procedure ValidateSaccoJournalBeforePosting(JnlHeader: Record "Sacco Journal Header")
    begin
        CheckSaccoJournalControls(JnlHeader."Custom Journal Template", JnlHeader."Document No.");
    end;

    procedure CheckSaccoJournalControls(JTemplate: Code[20]; JBatch: Code[20])
    var
        Lines: Record "Gen. Journal Line";
        BalanceLines: Record "Gen. Journal Line";
        PostedSaccoJournalLine: Record "Sacco Journal Line";
        GenJnlCheckLine: Codeunit "Gen. Jnl.-Check Line";
    begin
        if ClearSaccoJournalLinePostingNoSeries(JTemplate, JBatch) then
            Commit();

        Lines.Reset();
        Lines.SetCurrentKey("Line No.");
        Lines.SetRange("Journal Template Name", JTemplate);
        Lines.SetRange("Journal Batch Name", JBatch);
        if not Lines.FindSet() then
            Error('There are no journal lines to post for batch %1.', JBatch);

        repeat
            GenJnlCheckLine.RunCheck(Lines);

            PostedSaccoJournalLine.Reset();
            PostedSaccoJournalLine.SetRange("Document No.", Lines."Document No.");
            if PostedSaccoJournalLine.FindFirst() then
                Error('Document No. %1 has already been posted in Sacco Journal Line batch %2. Kindly use a different document no.', Lines."Document No.", PostedSaccoJournalLine."Batch No.");

        until Lines.Next() = 0;

        BalanceLines.Reset();
        BalanceLines.SetRange("Journal Template Name", JTemplate);
        BalanceLines.SetRange("Journal Batch Name", JBatch);
        BalanceLines.CalcSums("Amount (LCY)");
        if BalanceLines."Amount (LCY)" <> 0 then
            Error('Journal batch %1 is out of balance by %2.', JBatch, BalanceLines."Amount (LCY)");
    end;

    local procedure ClearSaccoJournalLinePostingNoSeries(JTemplate: Code[20]; JBatch: Code[20]): Boolean
    var
        Lines: Record "Gen. Journal Line";
        PostingNoSeriesCleared: Boolean;
    begin
        Lines.Reset();
        Lines.SetRange("Journal Template Name", JTemplate);
        Lines.SetRange("Journal Batch Name", JBatch);
        Lines.SetFilter("Posting No. Series", '<>%1', '');
        if Lines.FindSet(true) then
            repeat
                Lines."Posting No. Series" := '';
                Lines.Modify(true);
                PostingNoSeriesCleared := true;
            until Lines.Next() = 0;

        exit(PostingNoSeriesCleared);
    end;

    procedure CheckSaccoJournalForApproval(JTemplate: Code[20]; JBatch: Code[20])
    var
        PreviewErrorText: Text;
    begin
        CheckSaccoJournalControls(JTemplate, JBatch);
        Commit();

        ClearLastError();
        if not TryRunSilentSaccoJournalPreview(JTemplate, JBatch) then begin
            PreviewErrorText := GetLastErrorText();
            if PreviewErrorText = '' then
                PreviewErrorText := 'Posting preview failed. Kindly review the journal lines and try again.';
            Error(PreviewErrorText);
        end;
    end;

    [TryFunction]
    local procedure TryRunSilentSaccoJournalPreview(JTemplate: Code[20]; JBatch: Code[20])
    var
        Lines: Record "Gen. Journal Line";
        GenJnlPostNew: Codeunit "Gen. Jnl.-Post New";
    begin
        Lines.Reset();
        Lines.SetCurrentKey("Line No.");
        Lines.SetRange("Journal Template Name", JTemplate);
        Lines.SetRange("Journal Batch Name", JBatch);
        Lines.FindFirst();

        GenJnlPostNew.SilentPreview(Lines);
    end;

    local procedure ValidateSaccoJournalDimension(GlobalDimensionNo: Integer; DimensionValueCode: Code[20]; LineNo: Integer; DocumentNo: Code[20])
    var
        DimensionValue: Record "Dimension Value";
    begin
        DimensionValue.Reset();
        DimensionValue.SetRange("Global Dimension No.", GlobalDimensionNo);
        DimensionValue.SetRange(Code, DimensionValueCode);
        if not DimensionValue.FindFirst() then
            Error('Shortcut Dimension %1 value %2 does not exist on line %3, document %4.', GlobalDimensionNo, DimensionValueCode, LineNo, DocumentNo);

        if DimensionValue.Blocked then
            Error('Shortcut Dimension %1 value %2 is blocked on line %3, document %4.', GlobalDimensionNo, DimensionValueCode, LineNo, DocumentNo);
    end;

    local procedure ValidateSaccoJournalAccount(Line: Record "Gen. Journal Line"; IsBalancingAccount: Boolean)
    var
        GLAccount: Record "G/L Account";
        Customer: Record Customer;
        Vendor: Record Vendor;
        BankAccount: Record "Bank Account";
        FixedAsset: Record "Fixed Asset";
        ICPartner: Record "IC Partner";
        Employee: Record Employee;
        SavingsAccount: Record "Savings Accounts";
        CreditAccount: Record "Credit Accounts";
        AccountType: Enum "Gen. Journal Account Type";
        AccountNo: Code[20];
        AccountRole: Text[30];
    begin
        if IsBalancingAccount then begin
            AccountType := Line."Bal. Account Type";
            AccountNo := Line."Bal. Account No.";
            AccountRole := 'balancing account';
            if AccountNo = '' then
                exit;
        end else begin
            AccountType := Line."Account Type";
            AccountNo := Line."Account No.";
            AccountRole := 'account';
        end;

        case AccountType of
            AccountType::"G/L Account":
                begin
                    if not GLAccount.Get(AccountNo) then
                        Error('G/L %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if GLAccount."Account Type" <> GLAccount."Account Type"::Posting then
                        Error('G/L %1 %2 must be a posting account on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if GLAccount.Blocked then
                        Error('G/L %1 %2 is blocked on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if not GLAccount."Direct Posting" then
                        Error('G/L %1 %2 must allow direct posting on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                end;
            AccountType::Customer:
                begin
                    if not Customer.Get(AccountNo) then
                        Error('Customer %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if Customer.Blocked <> Customer.Blocked::" " then
                        Error('Customer %1 %2 is blocked on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    Customer.TestField("Customer Posting Group");
                end;
            AccountType::Vendor:
                begin
                    if not Vendor.Get(AccountNo) then
                        Error('Vendor %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if Vendor.Blocked <> Vendor.Blocked::" " then
                        Error('Vendor %1 %2 is blocked on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    Vendor.TestField("Vendor Posting Group");
                end;
            AccountType::"Bank Account":
                begin
                    if not BankAccount.Get(AccountNo) then
                        Error('Bank %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if BankAccount.Blocked then
                        Error('Bank %1 %2 is blocked on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    BankAccount.TestField("Bank Acc. Posting Group");
                end;
            AccountType::"Fixed Asset":
                begin
                    if not FixedAsset.Get(AccountNo) then
                        Error('Fixed asset %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if FixedAsset.Blocked then
                        Error('Fixed asset %1 %2 is blocked on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                end;
            AccountType::"IC Partner":
                if not ICPartner.Get(AccountNo) then
                    Error('IC Partner %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
            AccountType::Employee:
                if not Employee.Get(AccountNo) then
                    Error('Employee %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
            AccountType::Savings:
                begin
                    if not SavingsAccount.Get(AccountNo) then
                        Error('Savings %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if not (SavingsAccount.Status in [SavingsAccount.Status::Active, SavingsAccount.Status::Dormant]) then
                        Error('Savings %1 %2 has status %3 on line %4, document %5.', AccountRole, AccountNo, SavingsAccount.Status, Line."Line No.", Line."Document No.");
                    SavingsAccount.TestField("Customer Posting Group");
                    if (Line."Member No." <> '') and (SavingsAccount."Member No." <> Line."Member No.") then
                        Error('Savings %1 %2 belongs to member %3, not member %4 on line %5, document %6.', AccountRole, AccountNo, SavingsAccount."Member No.", Line."Member No.", Line."Line No.", Line."Document No.");
                end;
            AccountType::Credit:
                begin
                    if not CreditAccount.Get(AccountNo) then
                        Error('Credit %1 %2 does not exist on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    if CreditAccount.Blocked <> CreditAccount.Blocked::" " then
                        Error('Credit %1 %2 is blocked on line %3, document %4.', AccountRole, AccountNo, Line."Line No.", Line."Document No.");
                    CreditAccount.TestField("Customer Posting Group");
                    if (Line."Member No." <> '') and (CreditAccount."Member No." <> Line."Member No.") then
                        Error('Credit %1 %2 belongs to member %3, not member %4 on line %5, document %6.', AccountRole, AccountNo, CreditAccount."Member No.", Line."Member No.", Line."Line No.", Line."Document No.");
                end;
        end;
    end;

    local procedure ValidateSaccoJournalCreditLine(Line: Record "Gen. Journal Line")
    var
        Loan: Record Loans;
    begin
        if Line."Account Type" <> Line."Account Type"::Credit then
            exit;

        Line.TestField("Member No.");
        Line.TestField("Loan No.");
        Line.TestField("Transaction Type");

        if not Loan.Get(Line."Loan No.") then
            Error('Loan No. %1 does not exist on line %2, document %3.', Line."Loan No.", Line."Line No.", Line."Document No.");
        if Loan."Loan Account" <> Line."Account No." then
            Error('Loan No. %1 belongs to loan account %2, not account %3 on line %4, document %5.', Line."Loan No.", Loan."Loan Account", Line."Account No.", Line."Line No.", Line."Document No.");
        if Loan."Member No." <> Line."Member No." then
            Error('Loan No. %1 belongs to member %2, not member %3 on line %4, document %5.', Line."Loan No.", Loan."Member No.", Line."Member No.", Line."Line No.", Line."Document No.");
    end;

    procedure PostTreasuryTellerIssue(TreasuryTellerTransactions: Record "Treasury/Teller Transactions")
    var
        Text0004: label 'The money has already been issued.';
        BankingUser: Record "Banking User Setup";
        Text0005: label 'You do not have permission to transact on this teller till/Account.';
        Banks: Record "Bank Account";
        BankBal: Decimal;
        GenJournalLine: Record "Gen. Journal Line";
        JTemplate: Code[20];
        JBatch: Code[20];
        TillNo: Code[20];
        DBranch: Code[20];
        DActivity: Code[20];
        Text0001: label 'Ensure the Cashier Journal Template is set up in Banking User Setup';
        Text0002: label 'Ensure the Cashier Journal Batch is set up in Banking User Setup';
        Text0003: label 'Ensure the Default Bank is set up in User Setup';
        UserSetup: Record "User Setup";
        Text0007: label 'Please specify an amount greater than zero.';
        ToAccount: Code[20];
        FromAccount: Code[20];
        Text0008: label 'Coinage Amount must be equal to the amount';
        PDate: Date;
        Cust: Record Members;
    begin

        BankingUser.Get(UserId);

        BankingUser.TestField("Cashier Journal Template");
        BankingUser.TestField("Cashier Journal Batch");
        BankingUser.TestField("Default  Bank");

        JTemplate := BankingUser."Cashier Journal Template";
        JBatch := BankingUser."Cashier Journal Batch";
        TillNo := BankingUser."Default  Bank";

        if TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Mpesa to Teller" then
            TillNo := TreasuryTellerTransactions."From Account";


        CheckTillCurrency(TillNo, TreasuryTellerTransactions."Currency Code");

        UserSetup.Reset;
        UserSetup.SetRange(UserSetup."User ID", UpperCase(UserId));
        if UserSetup.Find('-') then begin
            UserSetup.TestField(UserSetup."Global Dimension 2 Code");
            UserSetup.TestField(UserSetup."Global Dimension 1 Code");
            DBranch := UserSetup."Global Dimension 2 Code";
            DActivity := UserSetup."Global Dimension 1 Code";
        end;

        TreasuryTellerTransactions.TestField(Amount);
        TreasuryTellerTransactions.TestField("From Account");
        TreasuryTellerTransactions.TestField("To Account");

        if TreasuryTellerTransactions.Amount <= 0 then
            Error(Text0007);

        if TreasuryTellerTransactions.Amount <> TreasuryTellerTransactions."Total Cash on Treasury Coinage" then
            Error(Text0008);



        if TreasuryTellerTransactions.Issued = TreasuryTellerTransactions.Issued::Yes then
            Error(Text0004);


        if (TreasuryTellerTransactions."Transaction Type" <> TreasuryTellerTransactions."transaction type"::"Bank to Treasury") and (TreasuryTellerTransactions."Transaction Type" <> TreasuryTellerTransactions."transaction type"::"Bank to Bank") then begin

            BankingUser.Reset;
            BankingUser.SetRange(BankingUser."User Name", TreasuryTellerTransactions."From Account");
            if BankingUser.Find('-') then begin

                if UserId <> BankingUser."User Name" then begin

                    Banks.Reset;
                    Banks.SetRange(Banks."No.", TreasuryTellerTransactions."From Bank");
                    Banks.SetFilter("Responsible User", UserId);
                    if not Banks.Find('-') then begin
                        Error(Text0005);
                    end

                end;


            end;
        end
        else begin


            Banks.Reset;
            Banks.SetRange(Banks."No.", TreasuryTellerTransactions."From Bank");
            if Banks.Find('-') then begin
                if Banks."Responsible User" <> '' then
                    if UserId <> Banks."Responsible User" then
                        Error(Text0005);

                Banks.CalcFields(Banks."Balance (LCY)");
                BankBal := Banks."Balance (LCY)";
                if TreasuryTellerTransactions.Amount > BankBal then begin
                    Error('You cannot issue more than the account balance.')
                end;
            end;
        end;


        Banks.Reset;
        Banks.SetRange(Banks."No.", TreasuryTellerTransactions."From Bank");
        if Banks.Find('-') then begin
            Banks.CalcFields(Banks."Balance (LCY)");
            BankBal := Banks."Balance (LCY)";
            if TreasuryTellerTransactions.Amount > BankBal then begin
                Error('You cannot issue more than the account balance.')
            end;
        end;

        if Confirm('Are you sure you want to make this issue to' + TreasuryTellerTransactions."To Account Name" + '?', false) = true then begin
            TreasuryTellerTransactions.Issued := TreasuryTellerTransactions.Issued::Yes;
            // "Date Issued" := Today;
            TreasuryTellerTransactions."Date Issued" := TreasuryTellerTransactions."Transaction Date";
            TreasuryTellerTransactions."Time Issued" := Time;
            TreasuryTellerTransactions."Issued By" := UserId;
            TreasuryTellerTransactions.Modify;
        end;
        Message('Money successfully issued/Returned.');
    end;

    procedure PostTreasuryTellerReceive(TreasuryTellerTransactions: Record "Treasury/Teller Transactions")
    var
        CurrentTellerAmount: Decimal;
        BankingUser: Record "Banking User Setup";
        Banks: Record "Bank Account";
        GenJournalLine: Record "Gen. Journal Line";
        LineNo: Integer;
        JTemplate: Code[20];
        JBatch: Code[20];
        TillNo: Code[20];
        DBranch: Code[20];
        DActivity: Code[20];
        UserSetup: Record "User Setup";
        Text0001: label 'Ensure the Cashier Journal Template is set up in Banking User Setup';
        Text0002: label 'Ensure the Cashier Journal Batch is set up in Banking User Setup';
        Text0003: label 'Ensure the Default Bank is set up in User Setup';
        Text0007: label 'Please specify an amount greater than zero.';
        ToAccount: Code[20];
        FromAccount: Code[20];
        ShortageAcc: Code[20];
        ExcessAcc: Code[20];
        Amt: Decimal;
        PDate: Date;
        MemberActivities: Codeunit "Member Activities";
        SaccoSetup: Record "Sacco Setup";
        Heading: text;
        SalutationTxt: Text;
        BodyTxt: text;
        RegardsTxt: Text;
        Receiver: Text;
        FilePath_Name: Text;
        Cust: Record Customer;


    begin

        FromAccount := TreasuryTellerTransactions."From Bank";
        ToAccount := TreasuryTellerTransactions."To Bank";

        BankingUser.Get(UserId);
        UserSetup.Get(UserId);

        BankingUser.TestField("Cashier Journal Template");
        BankingUser.TestField("Cashier Journal Batch");
        BankingUser.TestField("Default  Bank");

        JTemplate := BankingUser."Cashier Journal Template";
        JBatch := BankingUser."Cashier Journal Batch";
        TillNo := BankingUser."Default  Bank";

        CheckTillCurrency(TillNo, TreasuryTellerTransactions."Currency Code");

        UserSetup.Reset;
        UserSetup.SetRange(UserSetup."User ID", UpperCase(UserId));
        if UserSetup.Find('-') then begin
            UserSetup.TestField(UserSetup."Global Dimension 2 Code");
            UserSetup.TestField(UserSetup."Global Dimension 1 Code");
            DBranch := UserSetup."Global Dimension 2 Code";
            DActivity := UserSetup."Global Dimension 1 Code";
        end;

        TreasuryTellerTransactions.TestField(Amount);
        TreasuryTellerTransactions.TestField("From Account");
        TreasuryTellerTransactions.TestField("To Account");

        if TreasuryTellerTransactions.Amount <= 0 then
            Error(Text0007);


        if TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Bank to Treasury" then begin
            TreasuryTellerTransactions.TestField("External Document No.");


        end;



        CurrentTellerAmount := 0;

        if TreasuryTellerTransactions.Posted then
            Error('The transaction has already been received and posted.');


        if (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Treasury To Teller") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Mpesa to Teller") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Treasury to Treasury") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Teller To Treasury") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Treasury to Mpesa") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Treasury to Equity") or
            //("Transaction Type"="Transaction Type"::"Treasury To Bank") OR
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Mpesa to Treasury") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Equity to Treasury") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"End of Day Teller to Treasury") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Bank to Bank") or
            (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Teller to Teller") then begin

            if TreasuryTellerTransactions.Issued = TreasuryTellerTransactions.Issued::No then
                Error('The issue has not yet been made and therefore you cannot continue with this transaction.');


            BankingUser.Reset;
            BankingUser.SetRange(BankingUser."User Name", TreasuryTellerTransactions."To Account");
            if BankingUser.Find('-') then begin
                if UserId <> BankingUser."User Name" then begin

                    Banks.Reset;
                    Banks.SetRange(Banks."No.", TreasuryTellerTransactions."To Bank");
                    Banks.SetRange("Responsible User", UserId);
                    if not Banks.Find('-') then begin

                        Error('You do not have permission to transact on this teller till/Account.');
                    end;

                end;


                Banks.Reset;
                Banks.SetRange(Banks."No.", TreasuryTellerTransactions."To Bank");
                if Banks.Find('-') then begin



                    if (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Bank to Bank") then
                        if Banks."PV User" <> UserId then
                            Error('You are not allowed to receive funds to this Bank Account');


                    Banks.CalcFields(Banks."Balance (LCY)");
                    CurrentTellerAmount := Banks."Balance (LCY)";

                    if CurrentTellerAmount + TreasuryTellerTransactions.Amount > BankingUser."Max. Cashier Withholding" then
                        Error('The transaction will result in the teller having a balance more than the maximum allowable therefor terminated.');
                end;

            end
            else begin
                if TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Bank to Bank" then begin
                    if not UserSetup."Allow Bank to Bank Trans" then
                        Error('You do not have permission to transact on this teller till/Account.');


                    Banks.Reset;
                    Banks.SetRange(Banks."No.", TreasuryTellerTransactions."To Bank");
                    if Banks.Find('-') then begin




                        if (TreasuryTellerTransactions."Transaction Type" = TreasuryTellerTransactions."transaction type"::"Bank to Bank") then
                            if Banks."PV User" <> UserId then
                                Error('You are not allowed to receive funds to this Bank Account');
                    end;

                end
                else
                    Error('You do not have permission to transact on this teller till/Account.');
            end;

            BankingUser.Reset;
            BankingUser.SetRange(BankingUser."User Name", TreasuryTellerTransactions."From Account");
            if BankingUser.Find('-') then begin
                ExcessAcc := BankingUser."Excess Account";
                ShortageAcc := BankingUser."Shortage Account";
            end;

        end;

        if not Confirm('Are you sure you want to make this receipt?', false) then
            exit;

        JournalInit(JTemplate, JBatch);

        Amt := 0;

        if TreasuryTellerTransactions.Type = TreasuryTellerTransactions.Type::Excess then
            Amt := -(TreasuryTellerTransactions.Amount - TreasuryTellerTransactions."Excess/Shortage Amount")
        else
            if TreasuryTellerTransactions.Type = TreasuryTellerTransactions.Type::Shortage then
                Amt := -TreasuryTellerTransactions.Amount
            else
                if TreasuryTellerTransactions.Type = TreasuryTellerTransactions.Type::" " then
                    Amt := -TreasuryTellerTransactions.Amount;



        //PDate := Today;
        PDate := TreasuryTellerTransactions."Transaction Date";

        JournalInsert(
            JTemplate,
            JBatch,
            TreasuryTellerTransactions.Code,
            PDate,
            Accttype::"Bank Account",
            FromAccount,
            TreasuryTellerTransactions.Description,
            Balaccttype::"Bank Account",
            ToAccount,
            Amt,
            TreasuryTellerTransactions."External Document No.",
            '',
            Transtype::" ",
            DActivity,
            DBranch,
            true,
            TChannel::Treasury,
            TreasuryTellerTransactions."Dimension Set ID"
            );



        //Posting Excess
        if TreasuryTellerTransactions.Type = TreasuryTellerTransactions.Type::Excess then begin

            JournalInsert(
                JTemplate,
                JBatch,
                TreasuryTellerTransactions.Code,
                PDate,
                Accttype::"Bank Account",
                ToAccount,
                'Excess From Cashier',
                Balaccttype::Customer,
                ExcessAcc,
                TreasuryTellerTransactions."Excess/Shortage Amount",
                TreasuryTellerTransactions."External Document No.",
                '',
                Transtype::" ",
                DActivity,
                DBranch,
                true,
                TChannel::Treasury,
                TreasuryTellerTransactions."Dimension Set ID"
                );
        end;
        //Posting Excess


        //Posting Shortage
        if TreasuryTellerTransactions.Type = TreasuryTellerTransactions.Type::Shortage then begin

            JournalInsert(
                JTemplate,
                JBatch,
                TreasuryTellerTransactions.Code,
                PDate,
                Accttype::"Bank Account",
                ToAccount,
                'Shortage From Cashier',
                Balaccttype::Customer,
                ShortageAcc,
                -TreasuryTellerTransactions."Excess/Shortage Amount",
                TreasuryTellerTransactions."External Document No.",
                '',
                Transtype::" ",
                DActivity,
                DBranch,
                true,
                TChannel::Treasury,
                TreasuryTellerTransactions."Dimension Set ID"
                );
        end;
        //Posting Shortage


        TreasuryTellerTransactions.Posted := true;
        TreasuryTellerTransactions."Date Posted" := Today;
        TreasuryTellerTransactions."Date Posted" := TreasuryTellerTransactions."Transaction Date";
        TreasuryTellerTransactions."Time Posted" := Time;
        TreasuryTellerTransactions."Posted By" := UserId;
        TreasuryTellerTransactions.Received := TreasuryTellerTransactions.Received::Yes;
        TreasuryTellerTransactions."Date Received" := Today;
        TreasuryTellerTransactions."Date Received" := TreasuryTellerTransactions."Transaction Date";
        TreasuryTellerTransactions."Time Received" := Time;
        TreasuryTellerTransactions."Received By" := UserId;
        TreasuryTellerTransactions.Modify;

        JournalPost(JTemplate, JBatch);

        if TreasuryTellerTransactions."Excess/Shortage Amount" > 0 then begin
            SaccoSetup.Get();
            if SaccoSetup."Teller Shortage Email" <> '' then begin

                Heading := 'TELLER ' + UpperCase(Format(TreasuryTellerTransactions.Type));
                SalutationTxt := 'Dear Sir/Madam';
                Cust.Reset();
                if TreasuryTellerTransactions.Type = TreasuryTellerTransactions.Type::Shortage then begin
                    Cust.get(ShortageAcc);
                end;
                if TreasuryTellerTransactions.Type = TreasuryTellerTransactions.Type::Excess then begin
                    Cust.get(ExcessAcc);
                end;

                BodyTxt := 'Please Note that Teller ' + Cust.Name + ' has a ' + Format(TreasuryTellerTransactions.Type) + ' of KES ' + Format(TreasuryTellerTransactions."Excess/Shortage Amount");
                BodyTxt += '<br>';
                BodyTxt += 'Transaction Reference: ' + TreasuryTellerTransactions.Code;
                ;
                BodyTxt += '<br>';
                RegardsTxt := 'Kind Regards';
                Receiver := SaccoSetup."Teller Shortage Email";
                FilePath_Name := '';

                if MemberActivities.SendEmailNotification(Heading, SalutationTxt, BodyTxt, RegardsTxt, Receiver, FilePath_Name, '') then;


            end;
        end;
    end;

    procedure CheckTillCurrency(BankAcc: Code[20]; CurrCode: Code[20])
    var
        BankAcct: Record "Bank Account";
    begin
        BankAcct.Reset;
        BankAcct.SetRange(BankAcct."No.", BankAcc);
        if BankAcct.Find('-') then begin
            if BankAcct."Currency Code" <> CurrCode then begin
                if BankAcct."Currency Code" = '' then
                    Error('This bank [%1:- %2] can only transact in LOCAL Currency', BankAcct."No.", BankAcct.Name)
                else
                    Error('This bank [%1:- %2] can only transact in %3', BankAcct."No.", BankAcct.Name, BankAcct."Currency Code");
            end;
        end;
    end;

