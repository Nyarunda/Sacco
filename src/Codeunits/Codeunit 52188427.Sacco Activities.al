        UserSetup.TestField("Dimension Set ID");

        Jtemplate := UserSetup."CashRec Journal Template";
        JBatch := UserSetup."CashRec Journal Batch";

        JournalInit(Jtemplate, JBatch);

        TestBatch := '001';

        PDate := SalHeaD."Posting date";
        DocNo := SalHeaD."Document No";
        ExtDocNo := SalHeaD.No;
        PostingRemarks := SalHeaD.Remarks;


        while TestBatch <= SalHeaD."No. of Batches" do begin

            //if not PostLinebyLine then begin
            dWindow.Open('Checking Loan Arrears:         #1#########\'
                                + 'Accounts:             #2#########\'
                                + 'Counter:              #3#########\'
                                + 'Progress:             @4@@@@@@@@@\'
                                + 'Press Esc to abort');

            CurrentRecordNo := 0;
            NoOfRecords := 0;
            //end;

            SalLines.Reset;
            SalLines.SetRange(SalLines."Salary Header No.", SalHeaD.No);
            SalLines.SetRange("Batch No.", TestBatch);
            SalLines.SetRange(Posted, true);
            if SalLines.Find('-') then begin

                NoOfRecords := SalLines.Count;
                dWindow.Update(1, TestBatch);
                dWindow.Update(2, NoOfRecords);
                repeat

                    CurrentRecordNo += 1;
                    RecoverDefaultedFromSalaryProcessing(SalLines."Member No.", Jtemplate, JBatch, DocNo, PDate, UserSetup."Global Dimension 1 Code", UserSetup."Global Dimension 2 Code", UserSetup."Dimension Set ID");

                until SalLines.Next = 0;

            end;

            //if not PostLinebyLine then begin
            dWindow.Close;
            //end;

            TestBatch := IncStr(TestBatch);
        end;

    end;

