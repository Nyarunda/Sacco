        TrySendTransactionSms(Smssource::Dividends, Member."Mobile Phone No.", MessageText, Reference, Reference);
        SendEmail(Member."E-Mail", '', '', 'Dividend on Share Capital', 'Dear ' + FirstName + ',', Body);
    end;

    local procedure SendSavingsInterestNotifications(SavingsInterestHeader: Record "Savings Interest Header")
    var
        InterestLine: Record "Savings Interest Lines";
