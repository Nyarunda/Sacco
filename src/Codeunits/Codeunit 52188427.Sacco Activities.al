    procedure GenerateRepaymentSchedule(Loans: Record Loans)
    var
        LSchedule: Record "Loan Repayment Schedule";
        QCounter: Integer;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        InitialInstal: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        GrPrinciple: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        GrInterest: Decimal;
        RepayCode: Code[10];
        TInterest: Decimal;
        IntDen: Integer;
        DisbDay: Integer;
        Months: Integer;
        BonusDate: Date;
        CheckDate: Date;
        DisbDate: Date;
        TotalRepayment: Decimal;
        LoanType: Record "Product Setup";
        InitDF: DateFormula;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        LScheduleII: Record "Loan Repayment Schedule II";
        InMoratorium: Boolean;
        RemainingInstallments: Integer;
        InsuranceCharge: Decimal;
        AmortisedMonthlyRepayment: Decimal;
        StraightLineMonthlyRepayment: Decimal;
        ReducingMonthlyPrincipal: Decimal;
        RoundedInterest: Decimal;
    begin
        TotalRepayment := 0;

        Loans.CalcFields("Employer Code", "OutStanding Principal");

        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.DeleteAll;


        Loans.TestField("Disbursement Date");
        Loans.Validate("Disbursement Date");

        Loans.TestField("Repayment Start Date");

        if Loans."Schedule Start Date" = 0D then
            Loans."Schedule Start Date" := Loans."Repayment Start Date";

        LoanType.Get(Loans."Loan Product Type");
        if LoanType."Cutoff Day" > 0 then begin
            if Date2DMY(Loans."Disbursement Date", 1) <= LoanType."Cutoff Day" then begin
                if Loans."Repayment Start Date" <> CalcDate('CM', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end else begin
                if Loans."Repayment Start Date" <> CalcDate('1M+CM', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end;
        end;

        if LoanType."Repay Mode" = LoanType."Repay Mode"::Dividends then begin
            if Loans."Repay Mode" <> Loans."Repay Mode"::Dividends then begin
                Loans."Repay Mode" := Loans."Repay Mode"::Dividends;
                Loans.Modify();
            end;
        end;

        if LoanType."Available on Mobile" then begin
            if LoanType."Is Mobile" then begin
                Loans."Mobile Loan" := true;
            end;

            if LoanType."Default Installments" = 1 then begin
                if Loans.Installments <> 1 then begin
                    Loans.Installments := 1;
                    Loans.Modify();
                end;
                if Loans."Repayment Start Date" <> CalcDate('1M', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('1M', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end;
        end;

        LoanAmount := Loans."Amount To Disburse";
        InterestRate := Loans."Annual Interest %";
        RepayPeriod := Loans.Installments;
        InitialInstal := Loans.Installments;
        LBalance := Loans."Amount To Disburse";
        RunDate := Loans."Schedule Start Date";

        if (Loans.Posted) and (Loans."OutStanding Principal" > 0) then
            if Loans."Loan Moratorium Start Date" <> 0D then
                RunDate := Loans."Loan Moratorium Start Date";

        if Loans."Principal Grace Period" = InitDF then
            Loans."Principal Grace Period" := LoanType."Grace Period - Principal";
        if Loans."Interest Grace Period" = InitDF then
            Loans."Interest Grace Period" := LoanType."Grace Period - Interest";

        PrincipalStartDate := 0D;
        InterestStartDate := 0D;

        PrincipalStartDate := Loans."Repayment Start Date";
        InterestStartDate := Loans."Repayment Start Date";

        LoanType.Get(Loans."Loan Product Type");

        InstalNo := 0;
        IntDen := 12;

        // Repayment Frequency Denominator
        if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
            IntDen := 365
        else if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
            IntDen := 52
        else if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
            IntDen := 12
        else if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
            IntDen := 4
        else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Tri-Annual" then
            IntDen := 3
        else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
            IntDen := 2
        else if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
            IntDen := 1
        else if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then
            IntDen := 1;

        // Calculate insurance once before the loop since it doesn't change per installment
        InsuranceCharge := SaccoActivities.SmartRound(CalculateMonthlyInsurance(Loans, LoanType, RunDate));

        InstalNo := 1;

        repeat
            // 1. Calculate Months for Bonus Logic (Keep existing logic)
            Months := 12;
            if InstalNo = 1 then begin
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                    BonusDate := Dmy2date(31, 10, Date2dmy(Loans."Disbursement Date", 3));
                    if BonusDate < Loans."Disbursement Date" then
                        BonusDate := CalcDate('1Y', BonusDate);

                    CheckDate := CalcDate('1M-CM', Loans."Disbursement Date");
                    Months := 0;
                    while CheckDate <= BonusDate do begin
                        Months += 1;
                        CheckDate := CalcDate('1M', CheckDate);
                    end;
                end;
            end;

            // 2. CHECK MORATORIUM STATUS
            // If the current RunDate is between Start and End Date, we are in a Moratorium
            InMoratorium := (RunDate >= Loans."Loan Moratorium Start Date") and (RunDate <= Loans."Loan Moratorium End Date");

            // 3. CALCULATE REMAINING INSTALLMENTS
            // Needed to recalculate amortization after moratorium ends
            RemainingInstallments := Loans.Installments - InstalNo + 1;
            if RemainingInstallments < 1 then RemainingInstallments := 1;

            // 4. HANDLE AMORTIZED METHOD
            if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then begin
                if Loans."Annual Interest %" = 0 then
                    Loans."Interest Calculation Method" := Loans."interest calculation method"::"Reducing Balance";
            end;

            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised) then begin
                Loans.TestField("Annual Interest %");
                Loans.TestField(Installments);

                if InMoratorium then begin
                    // === IN MORATORIUM ===
                    LPrincipal := 0; // No Principal

                    // Calculate Interest normally
                    if LoanType."Available on Mobile" then
                        LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>')
                    else
                        LInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);

                    TotalMRepay := LInterest;

                end else begin
                    // === NORMAL PAYMENT ===
                    // Recalculate PMT based on REMAINING Balance and REMAINING Period
                    // This ensures the loan clears exactly at the end
                    if LoanType."Is Mobile" then begin
                        TotalMRepay := ROUND((InterestRate / IntDen / 100) / (1 - Power((1 + (InterestRate / IntDen / 100)), -(RepayPeriod))) * (LoanAmount), 0.01, '=');
                        LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>');
                        LPrincipal := TotalMRepay - LInterest;
                    end else begin
                        if AmortisedMonthlyRepayment = 0 then
                            AmortisedMonthlyRepayment := SaccoActivities.SmartRound((InterestRate / IntDen / 100) / (1 - Power((1 + (InterestRate / IntDen / 100)), -(RemainingInstallments))) * LBalance);

                        TotalMRepay := AmortisedMonthlyRepayment;
                        RoundedInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);
                        LInterest := RoundedInterest;
                        LPrincipal := TotalMRepay - RoundedInterest;

                        if InMoratorium then
                            LPrincipal := 0;
                    end;
                end;
            end;

            // 5. HANDLE STRAIGHT LINE METHOD
            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Straight Line") then begin
                Loans.TestField(Installments);

                if InMoratorium then begin
                    LPrincipal := 0;
                end else begin
                    if StraightLineMonthlyRepayment = 0 then
                        StraightLineMonthlyRepayment := SaccoActivities.SmartRound((LoanAmount / RepayPeriod) + (LoanAmount * InterestRate / IntDen / 100));
                end;

                if LoanType."Available on Mobile" then
                    LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>')
                else
                    // Straight Line usually calculates interest on Original Amount
                    LInterest := SaccoActivities.SmartRound(LoanAmount * InterestRate / IntDen / 100);

                if InMoratorium then
                    TotalMRepay := LInterest
                else begin
                    TotalMRepay := StraightLineMonthlyRepayment;
                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            // 6. HANDLE REDUCING BALANCE / FLAT
            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Balance") or (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Flat") then begin
                Loans.TestField(Installments);

                if InMoratorium then begin
                    LPrincipal := 0;
                end else begin
                    if ReducingMonthlyPrincipal = 0 then
                        ReducingMonthlyPrincipal := SaccoActivities.SmartRound(LoanAmount / RepayPeriod);
                    LPrincipal := ReducingMonthlyPrincipal;
                end;

                if (LoanType."Available on Mobile") and (LoanType."Is Mobile") then
                    LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>')
                else
                    LInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);

                TotalMRepay := LPrincipal + LInterest;
            end;

            // 7. HANDLE STAFF SALARY OVERRIDE
            if LoanType.Get(Loans."Loan Product Type") then begin
                if LoanType."Appraisal Parameter Type" = LoanType."appraisal parameter type"::"Staff Salary" then begin
                    Loans.TestField("Annual Interest %");
                    Loans.TestField(Installments);

                    if InMoratorium then
                        LPrincipal := 0
                    else
                        LPrincipal := LoanAmount / RepayPeriod;

                    LInterest := (Loans."Approved Amount" * InterestRate * RepayPeriod) / (200 * InterestRate * Loans.Installments);
                    Loans.Repayment := LPrincipal + LInterest;
                    Loans."Loan Principle Repayment" := LPrincipal;
                    Loans."Loan Interest Repayment" := LInterest;

                end;
            end;

            // 8. MANUAL GRACE PERIOD OVERRIDES
            if PrincipalStartDate <> 0D then
                if RunDate < PrincipalStartDate then
                    LPrincipal := 0;

            if InterestStartDate <> 0D then
                if RunDate < InterestStartDate then
                    LInterest := 0;

            // 9. FINAL UPDATES BEFORE INSERT
            if InstalNo = 0 then begin
                // Special handling for legacy reasons (though InstalNo is initialized to 1 above)
                LPrincipal := 0;
                // Move date back one step
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                    RunDate := CalcDate('-1D', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                    RunDate := CalcDate('-1W', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                    RunDate := CalcDate('CM-1M', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                    RunDate := CalcDate('-1Q', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                    RunDate := CalcDate('-6M', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                    RunDate := CalcDate('-1Y', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then
                    RunDate := CalcDate('-1Y', RunDate);
            end;

            // Decrease Balance (Ensure Principal isn't negative)
            if LPrincipal < 0 then LPrincipal := 0;
            if LPrincipal > LBalance then
                LPrincipal := LBalance;
            LBalance := LBalance - SaccoActivities.smartround(LPrincipal);
            if LBalance < 1 then
                LBalance := 0;

            Evaluate(RepayCode, Format(InstalNo));

            // 10. INSERT SCHEDULE LINE
            LSchedule.Init;
            LSchedule."Line No." := InstalNo;
            LSchedule."Loan No." := Loans."Loan No.";
            LSchedule."Loan Amount" := LoanAmount;

            if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                LSchedule."Repayment Date" := CalcDate('CM', RunDate)
            else
                LSchedule."Repayment Date" := RunDate;

            LSchedule."Monthly Repayment" := SaccoActivities.SmartRound(TotalMRepay);
            LSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
            LSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
            LSchedule."Loan Balance" := LBalance;
            LSchedule."Deposit Amount" := Loans."Deposit Contribution";
            LSchedule."Insurance Contribution" := Loans."Total Insurance";

            LSchedule.Insert;

            Loans."Completion Date" := LSchedule."Repayment Date";

            // 11. INCREMENT DATES
            if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                RunDate := CalcDate('1D', RunDate)
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                RunDate := CalcDate('1W', RunDate)
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                RunDate := CalcDate('1M', RunDate)
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                RunDate := CalcDate('1Q', RunDate)
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                RunDate := CalcDate('6M', RunDate)
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                RunDate := CalcDate('1Y', RunDate)
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then
                RunDate := CalcDate('1Y', RunDate);

            InstalNo := InstalNo + 1;

        until (LBalance < 1) or (InstalNo > RepayPeriod);


        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Monthly Principal", '>0');
        if LSchedule.FindFirst then begin
            Loans."Loan Interest Repayment" := SmartRound(LSchedule."Monthly Interest");
            Loans."Loan Principle Repayment" := SmartRound(LSchedule."Monthly Principal");
            Loans.Repayment := SmartRound(LSchedule."Monthly Repayment");

            if Loans.Installments = 1 then begin
                LoanType.Get(Loans."Loan Product Type");
                if LoanType."Interest Recovered Upfront" then begin
                    Loans."Repayment" := Loans."Loan Principle Repayment";
                end;
            end;

            if Loans."Mobile Loan" then begin
                LSchedule.calcsums(LSchedule."Monthly Interest");
                Loans."Loan Interest Repayment" := SmartRound(LSchedule."Monthly Interest" / Loans.Installments);
            end;
        end;

        if (Loans."Mobile Loan") and (LoanType."Interest Recovered Upfront" = false) then begin
            Loans.CalcFields("Schedule Repayment");
            if LoanType."Loan Type" <> LoanType."Loan Type"::Mavuno then
                Loans.Repayment := SmartRound(Loans."Schedule Repayment" / Loans.Installments);
        end;

        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Monthly Principal", '>0');
        if LSchedule.FindLast() then begin
            if Loans."Completion Date" <> LSchedule."Repayment Date" then
                Loans."Completion Date" := LSchedule."Repayment Date";
        end;

        Loans.Modify;
    end;







    procedure GenerateRepaymentScheduleOldLoans(Loan: Record Loans)
    var
        LSchedule: Record "Loan Repayment Schedule";
        QCounter: Integer;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        InitialInstal: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        GrPrinciple: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        GrInterest: Decimal;
        RepayCode: Code[10];
        TInterest: Decimal;
        IntDen: Integer;
        DisbDay: Integer;
        Months: Integer;
        BonusDate: Date;
        CheckDate: Date;
        DisbDate: Date;
        TotalRepayment: Decimal;
        LoanType: Record "Product Setup";
        InitDF: DateFormula;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        LScheduleII: Record "Loan Repayment Schedule II";
        InMoratorium: Boolean;
        RemainingInstallments: Integer;
        InsuranceCharge: Decimal;
        AmortisedMonthlyRepayment: Decimal;
        StraightLineMonthlyRepayment: Decimal;
        ReducingMonthlyPrincipal: Decimal;
        RoundedInterest: Decimal;
        Loans: record loans;
    begin
        TotalRepayment := 0;

        Loans.Reset();
        Loans.setrange("Loan no.", Loan."Loan No.");
        if Loans.findfirst then begin

            Loans.CalcFields("Employer Code");

            LSchedule.Reset;
            LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
            LSchedule.DeleteAll;


            Loans.TestField("Disbursement Date");
            //Loans.Validate("Disbursement Date");

            Loans.TestField("Repayment Start Date");

            //if Loans."Schedule Start Date" = 0D then
            Loans."Schedule Start Date" := Loans."Repayment Start Date";

            LoanType.Get(Loans."Loan Product Type");
            if LoanType."Cutoff Day" > 0 then begin
                if Date2DMY(Loans."Disbursement Date", 1) <= LoanType."Cutoff Day" then begin
                    if Loans."Repayment Start Date" <> CalcDate('CM', Loans."Disbursement Date") then begin
                        Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                        Loans.Modify();
                    end;
                end else begin
                    if Loans."Repayment Start Date" <> CalcDate('1M+CM', Loans."Disbursement Date") then begin
                        Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                        Loans.Modify();
                    end;
                end;
            end;

            if LoanType."Repay Mode" = LoanType."Repay Mode"::Dividends then begin
                if Loans."Repay Mode" <> Loans."Repay Mode"::Dividends then begin
                    Loans."Repay Mode" := Loans."Repay Mode"::Dividends;
                    Loans.Modify();
                end;
            end;

            if LoanType."Is Mobile" then begin
                Loans."Mobile Loan" := true;
            end;

            if LoanType."Available on Mobile" then begin

                if LoanType."Default Installments" = 1 then begin
                    if Loans.Installments <> 1 then begin
                        Loans.Installments := 1;
                        Loans.Modify();
                    end;
                    if Loans."Repayment Start Date" <> CalcDate('1M', Loans."Disbursement Date") then begin
                        Loans."Repayment Start Date" := CalcDate('1M', Loans."Disbursement Date");
                        Loans.Modify();
                    end;
                end;
            end;

            LoanAmount := Loans."Amount To Disburse";
            InterestRate := Loans."Annual Interest %";
            RepayPeriod := Loans.Installments;
            InitialInstal := Loans.Installments;
            LBalance := Loans."Amount To Disburse";

            //Aziz
            if LBalance = 0 then
                LBalance := Loans."Approved Amount";

            RunDate := Loans."Schedule Start Date";

            if Loans."Principal Grace Period" = InitDF then
                Loans."Principal Grace Period" := LoanType."Grace Period - Principal";
            if Loans."Interest Grace Period" = InitDF then
                Loans."Interest Grace Period" := LoanType."Grace Period - Interest";

            PrincipalStartDate := 0D;
            InterestStartDate := 0D;


            // if Loans."Principal Grace Period" <> InitDF then begin
            //     PrincipalStartDate := CalcDate(Loans."Principal Grace Period", Loans."Schedule Start Date");
            // end;
            // if Loans."Interest Grace Period" <> InitDF then begin
            //     InterestStartDate := CalcDate(Loans."Interest Grace Period", Loans."Schedule Start Date");
            // end;

            PrincipalStartDate := Loans."Repayment Start Date";
            InterestStartDate := Loans."Repayment Start Date";

            LoanType.Get(Loans."Loan Product Type");

            InstalNo := 0;
            IntDen := 12;

            // Repayment Frequency Denominator
            if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                IntDen := 365
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                IntDen := 52
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                IntDen := 12
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                IntDen := 4
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Tri-Annual" then
                IntDen := 3
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                IntDen := 2
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                IntDen := 1
            else if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then
                IntDen := 1;

            InstalNo := 1;

            InstalNo := 1;

            repeat
                // 1. Calculate Months for Bonus Logic (Keep existing logic)
                Months := 12;
                if InstalNo = 1 then begin
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                        BonusDate := Dmy2date(31, 10, Date2dmy(Loans."Disbursement Date", 3));
                        if BonusDate < Loans."Disbursement Date" then
                            BonusDate := CalcDate('1Y', BonusDate);

                        CheckDate := CalcDate('1M-CM', Loans."Disbursement Date");
                        Months := 0;
                        while CheckDate <= BonusDate do begin
                            Months += 1;
                            CheckDate := CalcDate('1M', CheckDate);
                        end;
                    end;
                end;

                // 2. CHECK MORATORIUM STATUS
                // If the current RunDate is between Start and End Date, we are in a Moratorium
                InMoratorium := (RunDate >= Loans."Loan Moratorium Start Date") and (RunDate <= Loans."Loan Moratorium End Date");

                // 3. CALCULATE REMAINING INSTALLMENTS
                // Needed to recalculate amortization after moratorium ends
                RemainingInstallments := Loans.Installments - InstalNo + 1;
                if RemainingInstallments < 1 then RemainingInstallments := 1;

                // 4. HANDLE AMORTIZED METHOD
                if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then begin
                    if Loans."Annual Interest %" = 0 then
                        Loans."Interest Calculation Method" := Loans."interest calculation method"::"Reducing Balance";
                end;

                if (Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised) then begin
                    Loans.TestField("Annual Interest %");
                    Loans.TestField(Installments);

                    if InMoratorium then begin
                        // === IN MORATORIUM ===
                        LPrincipal := 0; // No Principal

                        // Calculate Interest normally
                        if LoanType."Available on Mobile" then
                            LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>')
                        else
                            LInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);

                        TotalMRepay := LInterest;

                    end else begin
                        // === NORMAL PAYMENT ===
                        // Recalculate PMT based on REMAINING Balance and REMAINING Period
                        // This ensures the loan clears exactly at the end
                        if LoanType."Is Mobile" then begin
                            TotalMRepay := ROUND((InterestRate / IntDen / 100) / (1 - Power((1 + (InterestRate / IntDen / 100)), -(RepayPeriod))) * (LBalance), 0.01, '=');
                            LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>')
                        end else begin
                            if AmortisedMonthlyRepayment = 0 then
                                AmortisedMonthlyRepayment := SaccoActivities.SmartRound((InterestRate / IntDen / 100) / (1 - Power((1 + (InterestRate / IntDen / 100)), -(RepayPeriod))) * LoanAmount);

                            TotalMRepay := AmortisedMonthlyRepayment;
                            RoundedInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);
                            LInterest := RoundedInterest;
                            LPrincipal := TotalMRepay - RoundedInterest;
                        end;
                    end;
                end;

                // 5. HANDLE STRAIGHT LINE METHOD
                if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Straight Line") then begin
                    Loans.TestField(Installments);

                    if InMoratorium then begin
                        LPrincipal := 0;
                    end else begin
                        if StraightLineMonthlyRepayment = 0 then
                            StraightLineMonthlyRepayment := SaccoActivities.SmartRound((LoanAmount / RepayPeriod) + (LoanAmount * InterestRate / IntDen / 100));
                    end;

                    if LoanType."Available on Mobile" then
                        LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>')
                    else
                        // Straight Line usually calculates interest on Original Amount
                        LInterest := SaccoActivities.SmartRound(LoanAmount * InterestRate / IntDen / 100);

                    if InMoratorium then
                        TotalMRepay := LInterest
                    else begin
                        TotalMRepay := StraightLineMonthlyRepayment;
                        LPrincipal := TotalMRepay - LInterest;
                    end;
                end;

                // 6. HANDLE REDUCING BALANCE / FLAT
                if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Balance") or (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Flat") then begin
                    Loans.TestField(Installments);

                    if InMoratorium then begin
                        LPrincipal := 0;
                    end else begin
                        if ReducingMonthlyPrincipal = 0 then
                            ReducingMonthlyPrincipal := SaccoActivities.SmartRound(LoanAmount / RepayPeriod);
                        LPrincipal := ReducingMonthlyPrincipal;
                    end;

                    if (LoanType."Available on Mobile") and (LoanType."Is Mobile") then
                        LInterest := ROUND(((InterestRate / 100) * LoanAmount), 1, '>')
                    else
                        LInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);

                    TotalMRepay := LPrincipal + LInterest;
                end;

                // 7. HANDLE STAFF SALARY OVERRIDE
                if LoanType.Get(Loans."Loan Product Type") then begin
                    if LoanType."Appraisal Parameter Type" = LoanType."appraisal parameter type"::"Staff Salary" then begin
                        Loans.TestField("Annual Interest %");
                        Loans.TestField(Installments);

                        if InMoratorium then
                            LPrincipal := 0
                        else
                            LPrincipal := LoanAmount / RepayPeriod;

                        LInterest := (Loans."Approved Amount" * InterestRate * RepayPeriod) / (200 * InterestRate * Loans.Installments);
                        Loans.Repayment := LPrincipal + LInterest;
                        Loans."Loan Principle Repayment" := LPrincipal;
                        Loans."Loan Interest Repayment" := LInterest;

                    end;
                end;

                // 8. MANUAL GRACE PERIOD OVERRIDES
                if PrincipalStartDate <> 0D then
                    if RunDate < PrincipalStartDate then
                        LPrincipal := 0;

                if InterestStartDate <> 0D then
                    if RunDate < InterestStartDate then
                        LInterest := 0;

                // 9. FINAL UPDATES BEFORE INSERT
                if InstalNo = 0 then begin
                    // Special handling for legacy reasons (though InstalNo is initialized to 1 above)
                    LPrincipal := 0;
                    // Move date back one step
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                        RunDate := CalcDate('-1D', RunDate)
                    else if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                        RunDate := CalcDate('-1W', RunDate)
                    else if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                        RunDate := CalcDate('CM-1M', RunDate)
                    else if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                        RunDate := CalcDate('-1Q', RunDate)
                    else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                        RunDate := CalcDate('-6M', RunDate)
                    else if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                        RunDate := CalcDate('-1Y', RunDate)
                    else if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then
                        RunDate := CalcDate('-1Y', RunDate);
                end;

                // Decrease Balance (Ensure Principal isn't negative)
                if LPrincipal < 0 then LPrincipal := 0;
                if LPrincipal > LBalance then
                    LPrincipal := LBalance;
                LBalance := LBalance - SaccoActivities.smartround(LPrincipal);
                if LBalance < 1 then
                    LBalance := 0;

                Evaluate(RepayCode, Format(InstalNo));

                // 10. INSERT SCHEDULE LINE
                LSchedule.Init;
                LSchedule."Line No." := InstalNo;
                LSchedule."Loan No." := Loans."Loan No.";
                LSchedule."Loan Amount" := LoanAmount;

                if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                    LSchedule."Repayment Date" := CalcDate('CM', RunDate)
                else
                    LSchedule."Repayment Date" := RunDate;

                LSchedule."Monthly Repayment" := SaccoActivities.SmartRound(TotalMRepay);
                LSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
                LSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
                LSchedule."Loan Balance" := LBalance;
                LSchedule."Deposit Amount" := Loans."Deposit Contribution";
                LSchedule."Insurance Contribution" := Loans."Total Insurance";

                LSchedule.Insert;

                Loans."Completion Date" := LSchedule."Repayment Date";

                // 11. INCREMENT DATES
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                    RunDate := CalcDate('1D', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                    RunDate := CalcDate('1W', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                    RunDate := CalcDate('1M', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                    RunDate := CalcDate('1Q', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                    RunDate := CalcDate('6M', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                    RunDate := CalcDate('1Y', RunDate)
                else if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then
                    RunDate := CalcDate('1Y', RunDate);

                InstalNo := InstalNo + 1;

            until (LBalance < 1) or (InstalNo > RepayPeriod);


            LSchedule.Reset;
            LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
            LSchedule.SetFilter("Monthly Principal", '>0');
            if LSchedule.FindFirst then begin
                Loans."Loan Interest Repayment" := SmartRound(LSchedule."Monthly Interest");
                Loans."Loan Principle Repayment" := SmartRound(LSchedule."Monthly Principal");
                Loans.Repayment := SmartRound(LSchedule."Monthly Repayment");

                if Loans.Installments = 1 then begin
                    LoanType.Get(Loans."Loan Product Type");
                    if LoanType."Interest Recovered Upfront" then begin
                        Loans."Repayment" := Loans."Loan Principle Repayment";
                    end;
                end;

                if Loans."Mobile Loan" then begin
                    LSchedule.calcsums(LSchedule."Monthly Interest");
                    Loans."Loan Interest Repayment" := SmartRound(LSchedule."Monthly Interest" / Loans.Installments);
                end;
            end;

            if (Loans."Mobile Loan") and (LoanType."Interest Recovered Upfront" = false) then begin
                Loans.CalcFields("Schedule Repayment");
                if LoanType."Loan Type" <> LoanType."Loan Type"::Mavuno then
                    Loans.Repayment := SmartRound(Loans."Schedule Repayment" / Loans.Installments);
            end;

            LSchedule.Reset;
            LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
            LSchedule.SetFilter("Monthly Principal", '>0');
            if LSchedule.FindLast() then begin
                if Loans."Completion Date" <> LSchedule."Repayment Date" then
                    Loans."Completion Date" := LSchedule."Repayment Date";
            end;

            Loans.Modify;
        end;
    end;

    procedure GenerateRentRepaymentSchedule(CustomerRec: Record Customer)
    var
        RentSchedule: Record "Rent Repayment Schedule";
        InstallmentNo: Integer;
        TotalMonths: Integer;
        RentBalance: Decimal;
        MonthlyRepayment: Decimal;
        RepaymentDate: Date;
        BaseServiceCharge: Decimal;
        CurrentServiceCharge: Decimal;
        CurrentMonthlyRepayment: Decimal;
        VATAmt: Decimal;
        i: Integer;
        SaccoSetup: Record "Sacco Setup";
    begin
        SaccoSetup.Get();
        SaccoSetup.TestField("Lease Increment %");

        RentSchedule.reset();
        RentSchedule.SetRange("Customer No.", CustomerRec."No.");
        if RentSchedule.FindFirst() then
            RentSchedule.DeleteAll();

        // Validate required fields
        CustomerRec.TestField("Rent Amount");
        CustomerRec.TestField(Installments);
        CustomerRec.TestField("Repayment Frequency");
        CustomerRec.TestField("Service Charge");
        CustomerRec.TestField("Repayment Startdate");

        RentBalance := CustomerRec."Rent Amount";
        TotalMonths := CustomerRec.Installments;
        RepaymentDate := CustomerRec."Repayment Startdate"; //WorkDate(); // Default start date
        BaseServiceCharge := ROUND(CustomerRec."Service Charge" / TotalMonths, 0.01, '=');
        CurrentServiceCharge := BaseServiceCharge; // Initial service charge

        MonthlyRepayment := ROUND(RentBalance / TotalMonths, 0.01, '=');
        CurrentMonthlyRepayment := MonthlyRepayment;

        for InstallmentNo := 1 to TotalMonths do begin
            // Calculate Monthly Repayment

            // Increase service charge by 10% after 12 installments
            if InstallmentNo > 12 then begin
                CurrentServiceCharge := BaseServiceCharge + ROUND(BaseServiceCharge * SaccoSetup."Lease Increment %" * 0.01, 0.01, '=');
                MonthlyRepayment := CurrentMonthlyRepayment + ROUND(CurrentMonthlyRepayment * SaccoSetup."Lease Increment %" * 0.01, 0.01, '=');
            end;

            VATAmt := Round(CurrentServiceCharge + MonthlyRepayment) * SaccoSetup."VAT %" * 0.01;

            // Insert into Rent Schedule table
            i += 1;
            RentSchedule.Init();
            RentSchedule."Line No." := i;
            RentSchedule."Customer No." := CustomerRec."No.";
            RentSchedule."Repayment Date" := RepaymentDate;
            RentSchedule."Rent Amount" := RentBalance;
            RentSchedule."Monthly Principal" := MonthlyRepayment;
            RentSchedule."Monthly Charges" := CurrentServiceCharge;
            RentSchedule."VAT Amt" := VATAmt;
            RentSchedule."Monthly Repayment" := MonthlyRepayment + CurrentServiceCharge + VATAmt;
            RentSchedule."Rent Balance" := RentBalance - MonthlyRepayment;
            RentSchedule."Line No." := InstallmentNo;
            RentSchedule.Insert();

            // Move to next repayment date based on frequency
            RepaymentDate := CalcDate(CustomerRec."Repayment Frequency", RepaymentDate);

            // Reduce balance
            RentBalance := RentBalance - MonthlyRepayment;
        end;
    end;

    procedure GenerateAppraisalRepaymentSchedule(Loans: Record "Member Salary Appraisal")
    var
        LSchedule: Record "Loan Repayment Schedule";
        QCounter: Integer;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        InitialInstal: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        GrPrinciple: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        GrInterest: Decimal;
        RepayCode: Code[10];
        TInterest: Decimal;
        IntDen: Integer;
        DisbDay: Integer;
        Months: Integer;
        BonusDate: Date;
        CheckDate: Date;
        DisbDate: Date;
        LoanType: Record "Product Setup";
        InitDF: DateFormula;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        RepDate: Date;
        LscheduleII: Record "Loan Repayment Schedule II";
        InMoratorium: Boolean;
        RemainingInstallments: Integer;
        AmortisedMonthlyRepayment: Decimal;
        StraightLineMonthlyRepayment: Decimal;
        ReducingMonthlyPrincipal: Decimal;
        RoundedInterest: Decimal;
    begin

        // Delete schedule
        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Appraisal No.");
        LSchedule.DeleteAll;

        if Loans."Schedule Start Date" <> 0D then
            DisbDate := Loans."Schedule Start Date"
        else
            DisbDate := CalcDate('1M', Today);

        LoanAmount := Loans."Amount To Disburse";
        InterestRate := Loans."Annual Interest %";
        RepayPeriod := Loans.Period;
        InitialInstal := Loans.Period;
        LBalance := Loans."Amount To Disburse";
        RunDate := DisbDate;

        PrincipalStartDate := 0D;
        InterestStartDate := 0D;
        LoanType.Get(Loans."Loan Product Type");

        InstalNo := 1;
        IntDen := 12;

        repeat
            Months := 12;

            // 1. CHECK MORATORIUM
            // Check if current RunDate is inside the moratorium range
            InMoratorium := (RunDate >= Loans."Loan Moratorium Start Date") and (RunDate <= Loans."Loan Moratorium End Date");

            // 2. CALCULATE REMAINING INSTALLMENTS
            // How many months left? (Total Period - Current Month + 1)
            RemainingInstallments := Loans.Period - InstalNo + 1;
            if RemainingInstallments < 1 then RemainingInstallments := 1;


            // 3. AMORTISED CALCULATION
            if (Loans."Interest Calculation Method" = Loans."Interest Calculation Method"::Amortised) then begin
                Loans.TestField("Annual Interest %");
                Loans.TestField(Period);

                if InMoratorium then begin

                    LPrincipal := 0;
                    // Interest only on current balance
                    LInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);
                    TotalMRepay := LInterest;
                end else begin

                    if AmortisedMonthlyRepayment = 0 then
                        AmortisedMonthlyRepayment := SaccoActivities.SmartRound((InterestRate / IntDen / 100) / (1 - Power((1 + (InterestRate / IntDen / 100)), -(RemainingInstallments))) * LBalance);

                    TotalMRepay := AmortisedMonthlyRepayment;
                    RoundedInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);
                    LInterest := RoundedInterest;
                    LPrincipal := TotalMRepay - RoundedInterest;
                end;
            end;

            if (Loans."Interest Calculation Method" = Loans."Interest Calculation Method"::"Straight Line") then begin
                Loans.TestField(Period);

                if InMoratorium then begin
                    LPrincipal := 0;
                end else begin
                    if StraightLineMonthlyRepayment = 0 then
                        StraightLineMonthlyRepayment := SaccoActivities.SmartRound((LoanAmount / RepayPeriod) + (LoanAmount * InterestRate / IntDen / 100));
                end;

                // Straight Line interest is usually based on ORIGINAL Amount
                LInterest := SaccoActivities.SmartRound(LoanAmount * InterestRate / IntDen / 100);
                if InMoratorium then
                    TotalMRepay := LInterest
                else begin
                    TotalMRepay := StraightLineMonthlyRepayment;
                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            // 5. REDUCING BALANCE / FLAT CALCULATION
            if (Loans."Interest Calculation Method" = Loans."Interest Calculation Method"::"Reducing Balance") or (Loans."Interest Calculation Method" = Loans."Interest Calculation Method"::"Reducing Flat") then begin
                Loans.TestField(Period);

                if InMoratorium then begin
                    LPrincipal := 0;
                end else begin

                    if ReducingMonthlyPrincipal = 0 then
                        ReducingMonthlyPrincipal := SaccoActivities.SmartRound(LoanAmount / RepayPeriod);
                    LPrincipal := ReducingMonthlyPrincipal;
                end;

                LInterest := SaccoActivities.SmartRound(Months / 12 * LBalance * InterestRate / IntDen / 100);
                TotalMRepay := LPrincipal + LInterest;
            end;


            if PrincipalStartDate <> 0D then
                if RunDate < PrincipalStartDate then
                    LPrincipal := 0;

            if InterestStartDate <> 0D then
                if RunDate < InterestStartDate then
                    LInterest := 0;


            if LPrincipal < 0 then LPrincipal := 0;
            if LPrincipal > LBalance then
                LPrincipal := LBalance;

            // Reduce Balance
            LBalance := LBalance - LPrincipal;
            if LBalance < 1 then
                LBalance := 0;
            // LBalance := LBalance - SaccoActivities.smartround(LPrincipal);

            Evaluate(RepayCode, Format(InstalNo));


            LSchedule.Init;
            LSchedule."Line No." := InstalNo;
            LSchedule."Loan No." := Loans."Appraisal No.";
            LSchedule."Loan Amount" := LoanAmount;
            LSchedule."Repayment Date" := RunDate;
            LSchedule."Monthly Repayment" := SaccoActivities.smartround(LInterest + LPrincipal);
            LSchedule."Monthly Interest" := SaccoActivities.smartround(LInterest);
            LSchedule."Insurance Contribution" := Loans."Insurance";
            LSchedule."Monthly Principal" := SaccoActivities.smartround(LPrincipal);
            LSchedule."Loan Balance" := smartround(LBalance);
            LSchedule.Insert;


            RunDate := CalcDate('1M', RunDate);
            InstalNo := InstalNo + 1;

        until (LBalance < 1) or (InstalNo > RepayPeriod);

        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Appraisal No.");
        if LSchedule.FindFirst() then begin
            Loans."Interest Repayment" := SaccoActivities.smartround(LSchedule."Monthly Interest");
            Loans."Principal Repayment" := SaccoActivities.smartround(LSchedule."Monthly Principal");
            Loans."Monthly Repayment" := SaccoActivities.smartround(LSchedule."Monthly Repayment");
            Loans.Insurance := LSchedule."Insurance Contribution";
            Loans."Max. Monthly Deduction" := Loans."Interest Repayment" + Loans."Principal Repayment" + Loans."BOSA Savings" + Loans."Insurance";
        end;

        Loans.Modify;
    end;

    procedure GenerateMobileRepaymentSchedule(Loans: Record Loans)
    var
        LSchedule: Record "Loan Repayment Schedule";
        QCounter: Integer;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        InitialInstal: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        GrPrinciple: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        GrInterest: Decimal;
        RepayCode: Code[10];
        TInterest: Decimal;
        IntDen: Integer;
        DisbDay: Integer;
        Months: Integer;
        BonusDate: Date;
        CheckDate: Date;
        DisbDate: Date;
        LoanType: Record "Product Setup";
        InitDF: DateFormula;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        LScheduleII: Record "Loan Repayment Schedule II";
    begin

        //if "Disbursement Date" >= DMY2Date(31, 08, 2024) then begin
        Loans.CalcFields("Employer Code");

        //Delete schedule
        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.DeleteAll;

        LScheduleII.Reset;
        LScheduleII.SetRange(LScheduleII."Loan No.", Loans."Loan No.");
        LScheduleII.DeleteAll;


        Loans.TestField("Disbursement Date");
        Loans.Validate("Disbursement Date");

        Loans.TestField("Repayment Start Date");
        /* if "Schedule Start" <> "Schedule Start"::" " then
           "Schedule Start Date" := CalcDate('1M',"Schedule Start Date"); */

        if Loans."Schedule Start Date" = 0D then
            Loans."Schedule Start Date" := Loans."Repayment Start Date";

        LoanType.Get(Loans."Loan Product Type");
        if LoanType."Cutoff Day" > 0 then begin
            if Date2DMY(Loans."Disbursement Date", 1) <= LoanType."Cutoff Day" then begin
                if Loans."Repayment Start Date" <> CalcDate('CM', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end
            else begin
                if Loans."Repayment Start Date" <> CalcDate('1M+CM', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end;
        end;

        if Loans."Interest Calculation Method" <> LoanType."Interest Calculation Method" then
            Loans."Interest Calculation Method" := LoanType."Interest Calculation Method";

        if LoanType."Repay Mode" = LoanType."Repay Mode"::Dividends then begin
            if Loans."Repay Mode" <> Loans."Repay Mode"::Dividends then begin
                Loans."Repay Mode" := Loans."Repay Mode"::Dividends;
                Loans.Modify();
            end;
            if Loans."Disbursement Date" < DMY2Date(28, 02, 2023) then begin

                if Loans."Repayment Start Date" <> DMY2Date(28, 02, 2023) then begin
                    Loans."Repayment Start Date" := DMY2Date(28, 02, 2023);
                    Loans.Modify();
                end;
            end;
        end;
        If LoanType."Available on Mobile" then begin
            If LoanType."Default Installments" = 1 then begin
                if Loans.Installments <> 1 then begin
                    //Loans.Installments := 1;
                    //Loans.Modify();
                end;
                if Loans."Repayment Start Date" <> CalcDate('1M', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('1M', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end;
        end;

        LoanAmount := Loans."Approved Amount";
        InterestRate := Loans."Annual Interest %";
        RepayPeriod := Loans.Installments;
        InitialInstal := Loans.Installments;
        LBalance := Loans."Approved Amount";
        RunDate := Loans."Repayment Start Date";
        //RunDate := "Schedule Start Date";

        if Loans."Principal Grace Period" = InitDF then
            Loans."Principal Grace Period" := LoanType."Grace Period - Principal";
        if Loans."Interest Grace Period" = InitDF then
            Loans."Interest Grace Period" := LoanType."Grace Period - Interest";

        PrincipalStartDate := 0D;
        InterestStartDate := 0D;

        if Loans."Principal Grace Period" <> InitDF then begin
            PrincipalStartDate := CalcDate(Loans."Principal Grace Period", Loans."Schedule Start Date");
        end;
        if Loans."Interest Grace Period" <> InitDF then begin
            InterestStartDate := CalcDate(Loans."Interest Grace Period", Loans."Schedule Start Date");
        end;


        LoanType.Get(Loans."Loan Product Type");

        InstalNo := 0;
        IntDen := 12;
        //Repayment Frequency
        if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
            Loans."Repayment Frequency" := Loans."Repayment Frequency"::Monthly;

        //Repayment -Frequency
        if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
            IntDen := 365
        else
            if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                IntDen := 52
            else
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                    IntDen := 12
                else
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                        IntDen := 4
                    else
                        if Loans."Repayment Frequency" = Loans."repayment frequency"::"Tri-Annual" then
                            IntDen := 3
                        else
                            if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                                IntDen := 2
                            else
                                if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                                    IntDen := 1
                                else
                                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                                        IntDen := 1;
                                    end;


        InstalNo := 1;


        repeat


            Months := 12;
            if InstalNo = 1 then begin
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                    BonusDate := Dmy2date(31, 10, Date2dmy(Loans."Disbursement Date", 3));
                    if BonusDate < Loans."Disbursement Date" then
                        BonusDate := CalcDate('1Y', BonusDate);

                    CheckDate := CalcDate('1M-CM', Loans."Disbursement Date");
                    Months := 0;
                    while CheckDate <= BonusDate do begin
                        Months += 1;
                        CheckDate := CalcDate('1M', CheckDate);
                    end;
                end;
            end;

            if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then begin
                if Loans."Annual Interest %" = 0 then
                    Loans."Interest Calculation Method" := Loans."interest calculation method"::"Reducing Balance"

            end;

            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised) then begin
                Loans.TestField("Annual Interest %");
                Loans.TestField(Installments);

                TotalMRepay := ROUND((InterestRate / IntDen / 100) / (1 - Power((1 + (InterestRate / IntDen / 100)), -(RepayPeriod))) * (LoanAmount), 0.01, '=');
                LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                LPrincipal := TotalMRepay - LInterest;
            end;

            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Straight Line") then begin
                Loans.TestField(Installments);
                LPrincipal := ROUND(LoanAmount / RepayPeriod, 0.01, '=');
                LInterest := ROUND(LoanAmount * InterestRate / IntDen / 100, 0.01, '=');
                TotalMRepay := LPrincipal + LInterest;
            end;

            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Balance") or (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Flat") then begin
                Loans.TestField(Installments);
                LPrincipal := ROUND(LoanAmount / RepayPeriod, 0.01, '=');
                LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                TotalMRepay := LPrincipal + LInterest;
            end;


            if LoanType.Get(Loans."Loan Product Type") then begin
                if LoanType."Appraisal Parameter Type" = LoanType."appraisal parameter type"::"Staff Salary" then begin

                    Loans.TestField("Annual Interest %");
                    Loans.TestField(Installments);
                    LPrincipal := LoanAmount / RepayPeriod;
                    LInterest := (Loans."Approved Amount" * InterestRate * Loans.Installments) / (200 * InterestRate * Loans.Installments);
                    Loans.Repayment := LPrincipal + LInterest;
                    Loans."Loan Principle Repayment" := LPrincipal;
                    Loans."Loan Interest Repayment" := LInterest;
                end;
            end;


            if PrincipalStartDate <> 0D then
                if RunDate < PrincipalStartDate then
                    LPrincipal := 0;


            if InterestStartDate <> 0D then
                if RunDate < InterestStartDate then
                    LInterest := 0;

            if InstalNo = 0 then begin
                LPrincipal := 0;
                //Repayment Frequency
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                    RunDate := CalcDate('-1D', RunDate)
                else
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                        RunDate := CalcDate('-1W', RunDate)
                    else
                        if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                            RunDate := CalcDate('-1M', RunDate)
                        else
                            if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                                RunDate := CalcDate('-1Q', RunDate)
                            else
                                if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                                    RunDate := CalcDate('-6M', RunDate)
                                else
                                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                                        RunDate := CalcDate('-1Y', RunDate)
                                    else
                                        if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                                            RunDate := CalcDate('-1Y', RunDate);
                                        end;
            end;


            LBalance := LBalance - LPrincipal;

            Evaluate(RepayCode, Format(InstalNo));

            LSchedule.Init;
            LSchedule."Line No." := InstalNo;
            LSchedule."Loan No." := Loans."Loan No.";
            LSchedule."Loan Amount" := LoanAmount;
            LSchedule."Repayment Date" := RunDate;
            LSchedule."Monthly Repayment" := LInterest + LPrincipal;
            LSchedule."Monthly Interest" := LInterest;
            LSchedule."Monthly Principal" := LPrincipal;
            LSchedule."Loan Balance" := LBalance;
            LSchedule.Insert;

            Loans."Completion Date" := LSchedule."Repayment Date";


            //Repayment Frequency
            if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                RunDate := CalcDate('1D', RunDate)
            else
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                    RunDate := CalcDate('1W', RunDate)
                else
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                        RunDate := CalcDate('1M', RunDate)
                    else
                        if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                            RunDate := CalcDate('1Q', RunDate)
                        else
                            if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                                RunDate := CalcDate('6M', RunDate)
                            else
                                if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                                    RunDate := CalcDate('1Y', RunDate)
                                else
                                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                                        RunDate := CalcDate('1Y', RunDate);
                                    end;

            InstalNo := InstalNo + 1;

        until LBalance < 1;


        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Monthly Principal", '>0');
        if LSchedule.FindFirst then begin
            Loans."Loan Interest Repayment" := LSchedule."Monthly Interest";
            Loans."Loan Principle Repayment" := LSchedule."Monthly Principal";
            Loans.Repayment := LSchedule."Monthly Repayment";


            if Loans.Installments = 1 then begin
                LoanType.Get(Loans."Loan Product Type");
                if LoanType."Interest Recovered Upfront" then begin

                    Loans."Repayment" := Loans."Loan Principle Repayment";

                end;
            end;

        end;
        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Monthly Principal", '>0');
        if LSchedule.FindLast() then begin
            if Loans."Completion Date" <> LSchedule."Repayment Date" then
                Loans."Completion Date" := LSchedule."Repayment Date";
        end;

        Loans.Modify;

        LScheduleII.init;
        LScheduleII.TransferFields(LSchedule);
        LScheduleII.insert;
        //end;
    end;

    procedure GenerateRepaymentScheduleII(Loans: Record Loans)
    var
        LSchedule: Record "Loan Repayment Schedule II";
        QCounter: Integer;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        InitialInstal: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        GrPrinciple: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        GrInterest: Decimal;
        RepayCode: Code[10];
        TInterest: Decimal;
        IntDen: Integer;
        DisbDay: Integer;
        Months: Integer;
        BonusDate: Date;
        CheckDate: Date;
        DisbDate: Date;
        LoanType: Record "Product Setup";
        InitDF: DateFormula;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        LScheduleII: Record "Loan Repayment Schedule II";
    begin

        Loans.CalcFields("Employer Code");

        //Delete schedule
        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.DeleteAll;


        Loans.TestField("Disbursement Date");
        Loans.Validate("Disbursement Date");

        Loans.TestField("Repayment Start Date");
        if Loans."Schedule Start Date" = 0D then
            Loans."Schedule Start Date" := Loans."Repayment Start Date";

        LoanType.Get(Loans."Loan Product Type");
        if LoanType."Cutoff Day" > 0 then begin
            if Date2DMY(Loans."Disbursement Date", 1) <= LoanType."Cutoff Day" then begin
                if Loans."Repayment Start Date" <> CalcDate('CM', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end
            else begin
                if Loans."Repayment Start Date" <> CalcDate('1M+CM', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('CM', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end;
        end;
        if Loans."Interest Calculation Method" <> LoanType."Interest Calculation Method" then
            Loans."Interest Calculation Method" := LoanType."Interest Calculation Method";

        if LoanType."Repay Mode" = LoanType."Repay Mode"::Dividends then begin
            if Loans."Repay Mode" <> Loans."Repay Mode"::Dividends then begin
                Loans."Repay Mode" := Loans."Repay Mode"::Dividends;
                Loans.Modify();
            end;
            if Loans."Disbursement Date" < DMY2Date(28, 02, 2023) then begin

                if Loans."Repayment Start Date" <> DMY2Date(28, 02, 2023) then begin
                    Loans."Repayment Start Date" := DMY2Date(28, 02, 2023);
                    Loans.Modify();
                end;
            end;
        end;
        If LoanType."Available on Mobile" then begin
            If LoanType."Default Installments" = 1 then begin
                if Loans.Installments <> 1 then begin
                    Loans.Installments := 1;
                    Loans.Modify();
                end;
                if Loans."Repayment Start Date" <> CalcDate('1M', Loans."Disbursement Date") then begin
                    Loans."Repayment Start Date" := CalcDate('1M', Loans."Disbursement Date");
                    Loans.Modify();
                end;
            end;
        end;

        LoanAmount := Loans."Approved Amount";
        InterestRate := Loans."Annual Interest %";
        RepayPeriod := Loans.Installments;
        InitialInstal := Loans.Installments;
        LBalance := Loans."Approved Amount";
        //RunDate:="Repayment Start Date";
        RunDate := Loans."Schedule Start Date";

        if Loans."Principal Grace Period" = InitDF then
            Loans."Principal Grace Period" := LoanType."Grace Period - Principal";
        if Loans."Interest Grace Period" = InitDF then
            Loans."Interest Grace Period" := LoanType."Grace Period - Interest";
        PrincipalStartDate := 0D;
        InterestStartDate := 0D;

        if Loans."Principal Grace Period" <> InitDF then begin
            PrincipalStartDate := CalcDate(Loans."Principal Grace Period", Loans."Schedule Start Date");
        end;
        if Loans."Interest Grace Period" <> InitDF then begin
            InterestStartDate := CalcDate(Loans."Interest Grace Period", Loans."Schedule Start Date");
        end;


        LoanType.Get(Loans."Loan Product Type");

        InstalNo := 0;
        IntDen := 12;
        //Repayment Frequency
        if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
            Loans."Repayment Frequency" := Loans."Repayment Frequency"::Monthly;

        //Repayment -Frequency
        if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
            IntDen := 365
        else
            if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                IntDen := 52
            else
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                    IntDen := 12
                else
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                        IntDen := 4
                    else
                        if Loans."Repayment Frequency" = Loans."repayment frequency"::"Tri-Annual" then
                            IntDen := 3
                        else
                            if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                                IntDen := 2
                            else
                                if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                                    IntDen := 1
                                else
                                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                                        IntDen := 1;
                                    end;


        InstalNo := 1;


        repeat


            Months := 12;
            if InstalNo = 1 then begin
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                    BonusDate := Dmy2date(31, 10, Date2dmy(Loans."Disbursement Date", 3));
                    if BonusDate < Loans."Disbursement Date" then
                        BonusDate := CalcDate('1Y', BonusDate);

                    CheckDate := CalcDate('1M-CM', Loans."Disbursement Date");
                    Months := 0;
                    while CheckDate <= BonusDate do begin
                        Months += 1;
                        CheckDate := CalcDate('1M', CheckDate);
                    end;
                end;
            end;

            if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then begin
                if Loans."Annual Interest %" = 0 then
                    Loans."Interest Calculation Method" := Loans."interest calculation method"::"Reducing Balance"

            end;

            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised) then begin
                Loans.TestField("Annual Interest %");
                Loans.TestField(Installments);

                TotalMRepay := ROUND((InterestRate / IntDen / 100) / (1 - Power((1 + (InterestRate / IntDen / 100)), -(RepayPeriod))) * (LoanAmount), 0.01, '=');
                LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                LPrincipal := TotalMRepay - LInterest;
            end;

            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Straight Line") then begin
                Loans.TestField(Installments);
                LPrincipal := ROUND(LoanAmount / RepayPeriod, 0.01, '=');
                LInterest := ROUND(LoanAmount * InterestRate / IntDen / 100, 0.01, '=');
                TotalMRepay := LPrincipal + LInterest;
            end;

            if (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Balance") or (Loans."Interest Calculation Method" = Loans."interest calculation method"::"Reducing Flat") then begin
                Loans.TestField(Installments);
                LPrincipal := ROUND(LoanAmount / RepayPeriod, 0.01, '=');
                LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                TotalMRepay := LPrincipal + LInterest;
            end;


            if LoanType.Get(Loans."Loan Product Type") then begin
                if LoanType."Appraisal Parameter Type" = LoanType."appraisal parameter type"::"Staff Salary" then begin

                    Loans.TestField("Annual Interest %");
                    Loans.TestField(Installments);
                    LPrincipal := LoanAmount / RepayPeriod;
                    LInterest := (Loans."Approved Amount" * InterestRate * Loans.Installments) / (200 * InterestRate * Loans.Installments);
                    Loans.Repayment := LPrincipal + LInterest;
                    Loans."Loan Principle Repayment" := LPrincipal;
                    Loans."Loan Interest Repayment" := LInterest;
                end;
            end;


            if PrincipalStartDate <> 0D then
                if RunDate < PrincipalStartDate then
                    LPrincipal := 0;


            if InterestStartDate <> 0D then
                if RunDate < InterestStartDate then
                    LInterest := 0;

            if InstalNo = 0 then begin
                LPrincipal := 0;
                //Repayment Frequency
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                    RunDate := CalcDate('-1D', RunDate)
                else
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                        RunDate := CalcDate('-1W', RunDate)
                    else
                        if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                            RunDate := CalcDate('-1M', RunDate)
                        else
                            if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                                RunDate := CalcDate('-1Q', RunDate)
                            else
                                if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                                    RunDate := CalcDate('-6M', RunDate)
                                else
                                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                                        RunDate := CalcDate('-1Y', RunDate)
                                    else
                                        if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                                            RunDate := CalcDate('-1Y', RunDate);
                                        end;
            end;


            if (Loans."Employer Code" = '010') or
            (Loans."Employer Code" = '074') then begin
                if (RunDate >= DMY2Date(01, 04, 2020)) and (RunDate <= DMY2Date(31, 01, 2021)) then begin

                    LPrincipal := 0;
                    LInterest := 0;
                end
            end;

            LBalance := LBalance - LPrincipal;

            Evaluate(RepayCode, Format(InstalNo));

            LSchedule.Init;
            LSchedule."Line No." := InstalNo;
            LSchedule."Loan No." := Loans."Loan No.";
            LSchedule."Loan Amount" := LoanAmount;
            LSchedule."Repayment Date" := RunDate;
            LSchedule."Monthly Repayment" := LInterest + LPrincipal;
            LSchedule."Monthly Interest" := LInterest;
            LSchedule."Monthly Principal" := LPrincipal;
            LSchedule."Loan Balance" := LBalance;
            LSchedule.Insert;

            Loans."Completion Date" := LSchedule."Repayment Date";


            //Repayment Frequency
            if Loans."Repayment Frequency" = Loans."repayment frequency"::Daily then
                RunDate := CalcDate('1D', RunDate)
            else
                if Loans."Repayment Frequency" = Loans."repayment frequency"::Weekly then
                    RunDate := CalcDate('1W', RunDate)
                else
                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Monthly then
                        RunDate := CalcDate('1M', RunDate)
                    else
                        if Loans."Repayment Frequency" = Loans."repayment frequency"::Quarterly then
                            RunDate := CalcDate('1Q', RunDate)
                        else
                            if Loans."Repayment Frequency" = Loans."repayment frequency"::"Bi-Annual" then
                                RunDate := CalcDate('6M', RunDate)
                            else
                                if Loans."Repayment Frequency" = Loans."repayment frequency"::Yearly then
                                    RunDate := CalcDate('1Y', RunDate)
                                else
                                    if Loans."Repayment Frequency" = Loans."repayment frequency"::Bonus then begin
                                        RunDate := CalcDate('1Y', RunDate);
                                    end;

            InstalNo := InstalNo + 1;

        until LBalance < 1;


        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Monthly Principal", '>0');
        if LSchedule.FindFirst then begin
            Loans."Loan Interest Repayment" := LSchedule."Monthly Interest";
            Loans."Loan Principle Repayment" := LSchedule."Monthly Principal";
            Loans.Repayment := LSchedule."Monthly Repayment";


            if Loans.Installments = 1 then begin
                LoanType.Get(Loans."Loan Product Type");
                if LoanType."Interest Recovered Upfront" then begin

                    Loans."Repayment" := Loans."Loan Principle Repayment";

                end;
            end;

        end;
        LSchedule.Reset;
        LSchedule.SetRange(LSchedule."Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Monthly Principal", '>0');
        if LSchedule.FindLast() then begin
            if Loans."Completion Date" <> LSchedule."Repayment Date" then
                Loans."Completion Date" := LSchedule."Repayment Date";
        end;

        Loans.Modify;
    end;

    procedure PreviewRepaymentScheduleWithPartialDisbursementPosting(Loans: Record Loans; HeaderNo: Code[20])
    var
        PartialDisbursementLine: Record "Partial Loans Disb. Lines";
        ProductBand: Record "Tiered Debt Threshold";
        LSchedule: Record "Loan Repayment Schedule";
        LoanAmount: Decimal;
        CurrentDisbursement: Decimal;
        OutstandingPrincipal: Decimal;
        InterestRate: Decimal;
        ElapsedMonths: Integer;
        BandInstallments: Integer;
        RemainingInstallments: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        Months: Integer;
        LoanType: Record "Product Setup";
        InitDF: DateFormula;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        InMoratorium: Boolean;
        IntDen: Integer;
        FirstDisbursementDate: Date;
        InsChargeAmount: Decimal;
        DepositContrib: Decimal;
        LCharge: Record "Loan Charges";
        PartialH: Record "Partial Loans Disb. Header";
    begin

        //Get Outstanding Principal + Current Disbursement Amount ---
        OutstandingPrincipal := 0;
        CurrentDisbursement := 0;
        InsChargeAmount := 0;

        // Clear existing schedule for this loan ---
        LSchedule.Reset();
        LSchedule.SetRange("Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Deposit Amount", '>0');
        if LSchedule.findfirst then begin
            DepositContrib := LSchedule."Deposit Amount";
        end;

        if DepositContrib = 0 then
            DepositContrib := Loans."Deposit COntribution";

        LSchedule.Reset();
        LSchedule.SetRange("Loan No.", Loans."Loan No.");
        LSchedule.DeleteAll();

        PartialDisbursementLine.Reset();
        PartialDisbursementLine.SetRange("Loan No.", Loans."Loan No.");
        PartialDisbursementLine.SetRange("Header No.", HeaderNo);
        if PartialDisbursementLine.FindSet() then begin
            OutstandingPrincipal := PartialDisbursementLine."Outstanding Principal";
            CurrentDisbursement := PartialDisbursementLine."Amount to Disbuse";
        end;

        PartialH.Get(HeaderNo);

        LoanAmount := OutstandingPrincipal + CurrentDisbursement;

        if LoanAmount <= 0 then
            Error('No loan amount found for disbursement. Check partial disbursement lines.');

        // Calculate Elapsed Months ---
        FirstDisbursementDate := Loans."Disbursement Date";
        if FirstDisbursementDate = 0D then
            Error('Original Disbursement Date must be specified on the loan.');

        ElapsedMonths := (Date2DMY(Today, 3) - Date2DMY(FirstDisbursementDate, 3)) * 12
                       + (Date2DMY(Today, 2) - Date2DMY(FirstDisbursementDate, 2));

        if ElapsedMonths < 0 then
            ElapsedMonths := 0;

        //Band Lookup ---
        LoanType.Get(Loans."Loan Product Type");
        if LoanType."Use Tiered Debt Threshold" then begin
            ProductBand.Reset();
            ProductBand.SetRange("Loan Product", Loans."Loan Product Type");
            ProductBand.SetFilter("Lower Limit", '<= %1', LoanAmount);
            ProductBand.SetFilter("Upper Limit", '>= %1', LoanAmount);
            if not ProductBand.FindFirst() then
                Error('No repayment band found for amount %1 on product %2.',
                      LoanAmount, Loans."Loan Product Type");
            BandInstallments := ProductBand."Maximum Loan Term";
        end else
            BandInstallments := LoanType."Default Installments";

        // Validate Remaining Installments ---
        RemainingInstallments := PartialDisbursementLine."Remaining Period";
        if RemainingInstallments <= 0 then
            Error('Loan period exceeded. %1 months elapsed since %2, band allows %3 installments for %4.',
                  ElapsedMonths, FirstDisbursementDate, BandInstallments, LoanAmount);

        // --- STEP 6: Initialize ---
        Loans.TestField("Repayment Start Date");
        if Loans."Schedule Start Date" = 0D then
            Loans."Schedule Start Date" := Loans."Repayment Start Date";

        InterestRate := Loans."Annual Interest %";
        LBalance := LoanAmount;

        // Start from next month end, same as GenerateRepaymentSchedule
        if PartialH."Schedule Start Date" <> 0D then
            RunDate := calcdate('<CM>', PartialH."Schedule Start Date")
        else
            RunDate := Loans."Schedule Start Date";

        // if Loans."Principal Grace Period" = InitDF then
        //     Loans."Principal Grace Period" := LoanType."Grace Period - Principal";
        // if Loans."Interest Grace Period" = InitDF then
        //     Loans."Interest Grace Period" := LoanType."Grace Period - Interest";

        PrincipalStartDate := Loans."Repayment Start Date";
        InterestStartDate := Loans."Repayment Start Date";

        IntDen := 12;
        case Loans."Repayment Frequency" of
            Loans."repayment frequency"::Daily:
                IntDen := 365;
            Loans."repayment frequency"::Weekly:
                IntDen := 52;
            Loans."repayment frequency"::Monthly:
                IntDen := 12;
            Loans."repayment frequency"::Quarterly:
                IntDen := 4;
            Loans."repayment frequency"::"Tri-Annual":
                IntDen := 3;
            Loans."repayment frequency"::"Bi-Annual":
                IntDen := 2;
            Loans."repayment frequency"::Yearly:
                IntDen := 1;
            Loans."repayment frequency"::Bonus:
                IntDen := 1;
        end;


        LCharge.Reset();
        LCharge.SetRange("Loan No.", PartialH."No.");
        LCharge.SetRange("Charge Code", 'INS');
        if LCharge.findfirst then;


        // --- STEP 7: Generate and write to
        InstalNo := 1;
        repeat
            Months := 12;

            InMoratorium := (RunDate >= PartialH."Loan Moratorium Start Date") and
                            (RunDate <= PartialH."Loan Moratorium End Date");

            if PartialDisbursementLine."Interest Calculation Method" <> PartialDisbursementLine."Interest Calculation Method"::" " then
                Loans."Interest Calculation Method" := PartialDisbursementLine."Interest Calculation Method";

            // Reducing Balance / Straight Line
            if Loans."Interest Calculation Method" in [
                Loans."interest calculation method"::"Straight Line",
                Loans."interest calculation method"::"Reducing Balance",
                Loans."interest calculation method"::"Reducing Flat"] then begin

                if InMoratorium then
                    LPrincipal := 0
                else
                    LPrincipal := Round(LBalance / (RemainingInstallments - InstalNo + 1), 0.01, '=');

                if Loans."Interest Calculation Method" = Loans."interest calculation method"::"Straight Line" then
                    LInterest := Round(LoanAmount * InterestRate / IntDen / 100, 1, '>')
                else
                    LInterest := Round(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                TotalMRepay := LPrincipal + LInterest;
            end;

            // Amortised
            if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then begin
                if InMoratorium then begin
                    LPrincipal := 0;
                    LInterest := Round(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                    TotalMRepay := LInterest;
                end else begin
                    TotalMRepay := Round(
                        (InterestRate / IntDen / 100) /
                        (1 - Power(1 + (InterestRate / IntDen / 100), -(RemainingInstallments - InstalNo + 1))) *
                        LBalance, 0.01, '=');
                    LInterest := Round(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            // Grace period overrides
            if (PrincipalStartDate <> 0D) and (RunDate < PrincipalStartDate) then LPrincipal := 0;
            if (InterestStartDate <> 0D) and (RunDate < InterestStartDate) then LInterest := 0;
            if LPrincipal < 0 then LPrincipal := 0;

            // Final installment — absorb rounding residual
            if InstalNo = RemainingInstallments then begin
                LPrincipal := LBalance;
                LBalance := 0;
            end else
                LBalance := LBalance - SaccoActivities.SmartRound(LPrincipal);

            // Write to REAL Loan Repayment Schedule table
            LSchedule.Init();
            LSchedule."Line No." := InstalNo;
            LSchedule."Loan No." := Loans."Loan No.";
            LSchedule."Loan Amount" := LoanAmount;
            LSchedule."Repayment Date" := CalcDate('CM', RunDate);
            LSchedule."Deposit Amount" := DepositContrib;
            LSchedule."Insurance Contribution" := InsChargeAmount + LCharge.Amount;
            LSchedule."Monthly Repayment" := SaccoActivities.SmartRound(TotalMRepay + DepositContrib + LSchedule."Insurance Contribution");
            LSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
            LSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
            LSchedule."Loan Balance" := LBalance;
            LSchedule.Insert();

            RunDate := CalcDate('1M', RunDate);
            InstalNo += 1;

        until InstalNo > RemainingInstallments;
    end;


    procedure PreviewRepaymentScheduleWithPartialDisbursement(Loans: Record Loans; HeaderNo: Code[20])
    var
        PartialDisbursementLine: Record "Partial Loans Disb. Lines";
        ProductBand: Record "Tiered Debt Threshold";
        LSchedule: Record "Loan Repayment Schedule II";
        LScheduleNew: Record "Loan Repayment Schedule";
        LoanAmount: Decimal;
        CurrentDisbursement: Decimal;
        OutstandingPrincipal: Decimal;
        InterestRate: Decimal;
        ElapsedMonths: Integer;
        BandInstallments: Integer;
        RemainingInstallments: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        Months: Integer;
        LoanType: Record "Product Setup";
        InitDF: DateFormula;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        InMoratorium: Boolean;
        IntDen: Integer;
        FirstDisbursementDate: Date;
        InsChargeAmount: Decimal;
        DepositAmt: Decimal;
        LCharge: Record "Loan Charges";
        PartialH: Record "Partial Loans Disb. Header";
    begin

        //Get Outstanding Principal + Current Disbursement Amount ---
        OutstandingPrincipal := 0;
        CurrentDisbursement := 0;
        InsChargeAmount := 0;

        // Clear existing schedule for this loan ---
        LScheduleNew.Reset();
        LScheduleNew.SetRange("Loan No.", Loans."Loan No.");
        LScheduleNew.SetFilter("Deposit Amount", '>0');
        if LScheduleNew.findfirst then begin
            DepositAmt := LScheduleNew."Deposit Amount";
            //InsChargeAmount := LScheduleNew."Insurance Contribution";
        end;

        LSchedule.Reset();
        LSchedule.SetRange("Loan No.", Loans."Loan No.");
        LSchedule.DeleteAll();

        PartialDisbursementLine.Reset();
        PartialDisbursementLine.SetRange("Loan No.", Loans."Loan No.");
        PartialDisbursementLine.SetRange("Header No.", HeaderNo);
        if PartialDisbursementLine.FindSet() then begin
            OutstandingPrincipal := PartialDisbursementLine."Outstanding Principal";
            CurrentDisbursement := PartialDisbursementLine."Amount to Disbuse";
        end;

        PartialH.Get(HeaderNo);

        LoanAmount := OutstandingPrincipal + CurrentDisbursement;

        if LoanAmount <= 0 then
            Error('No loan amount found for disbursement. Check partial disbursement lines.');

        // Calculate Elapsed Months ---
        FirstDisbursementDate := Loans."Disbursement Date";
        if FirstDisbursementDate = 0D then
            Error('Original Disbursement Date must be specified on the loan.');

        ElapsedMonths := (Date2DMY(Today, 3) - Date2DMY(FirstDisbursementDate, 3)) * 12
                       + (Date2DMY(Today, 2) - Date2DMY(FirstDisbursementDate, 2));
        if ElapsedMonths < 0 then
            ElapsedMonths := 0;

        //Band Lookup ---
        LoanType.Get(Loans."Loan Product Type");
        if LoanType."Use Tiered Debt Threshold" then begin
            ProductBand.Reset();
            ProductBand.SetRange("Loan Product", Loans."Loan Product Type");
            ProductBand.SetFilter("Lower Limit", '<= %1', LoanAmount);
            ProductBand.SetFilter("Upper Limit", '>= %1', LoanAmount);
            if not ProductBand.FindFirst() then
                Error('No repayment band found for amount %1 on product %2.',
                      LoanAmount, Loans."Loan Product Type");
            BandInstallments := ProductBand."Maximum Loan Term";
        end else
            BandInstallments := LoanType."Default Installments";

        // Validate Remaining Installments ---
        RemainingInstallments := PartialDisbursementLine."Remaining Period";
        if RemainingInstallments <= 0 then
            Error('Loan period exceeded. %1 months elapsed since %2, band allows %3 installments for %4.',
                  ElapsedMonths, FirstDisbursementDate, BandInstallments, LoanAmount);

        // --- STEP 6: Initialize ---
        Loans.TestField("Repayment Start Date");
        if Loans."Schedule Start Date" = 0D then
            Loans."Schedule Start Date" := Loans."Repayment Start Date";

        InterestRate := Loans."Annual Interest %";
        LBalance := LoanAmount;

        // Start from next month end, same as GenerateRepaymentSchedule
        if PartialH."Schedule Start Date" <> 0D then
            RunDate := calcdate('<CM>', PartialH."Schedule Start Date")
        else
            RunDate := Loans."Schedule Start Date";

        // if Loans."Principal Grace Period" = InitDF then
        //     Loans."Principal Grace Period" := LoanType."Grace Period - Principal";
        // if Loans."Interest Grace Period" = InitDF then
        //     Loans."Interest Grace Period" := LoanType."Grace Period - Interest";

        PrincipalStartDate := Loans."Repayment Start Date";
        InterestStartDate := Loans."Repayment Start Date";

        IntDen := 12;
        case Loans."Repayment Frequency" of
            Loans."repayment frequency"::Daily:
                IntDen := 365;
            Loans."repayment frequency"::Weekly:
                IntDen := 52;
            Loans."repayment frequency"::Monthly:
                IntDen := 12;
            Loans."repayment frequency"::Quarterly:
                IntDen := 4;
            Loans."repayment frequency"::"Tri-Annual":
                IntDen := 3;
            Loans."repayment frequency"::"Bi-Annual":
                IntDen := 2;
            Loans."repayment frequency"::Yearly:
                IntDen := 1;
            Loans."repayment frequency"::Bonus:
                IntDen := 1;
        end;


        LCharge.Reset();
        LCharge.SetRange("Loan No.", PartialH."No.");
        LCharge.SetRange("Charge Code", 'INS');
        if LCharge.findfirst then;


        // --- STEP 7: Generate and write to
        InstalNo := 1;
        repeat
            Months := 12;

            InMoratorium := (RunDate >= PartialH."Loan Moratorium Start Date") and
                            (RunDate <= PartialH."Loan Moratorium End Date");

            // Reducing Balance / Straight Line
            if Loans."Interest Calculation Method" in [
                Loans."interest calculation method"::"Straight Line",
                Loans."interest calculation method"::"Reducing Balance",
                Loans."interest calculation method"::"Reducing Flat"] then begin

                if InMoratorium then
                    LPrincipal := 0
                else
                    LPrincipal := Round(LBalance / (RemainingInstallments - InstalNo + 1), 0.01, '=');

                if Loans."Interest Calculation Method" = Loans."interest calculation method"::"Straight Line" then
                    LInterest := Round(LoanAmount * InterestRate / IntDen / 100, 1, '>')
                else
                    LInterest := Round(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                TotalMRepay := LPrincipal + LInterest;
            end;

            // Amortised
            if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then begin
                if InMoratorium then begin
                    LPrincipal := 0;
                    LInterest := Round(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                    TotalMRepay := LInterest;
                end else begin
                    TotalMRepay := Round(
                        (InterestRate / IntDen / 100) /
                        (1 - Power(1 + (InterestRate / IntDen / 100), -(RemainingInstallments - InstalNo + 1))) *
                        LBalance, 0.01, '=');
                    LInterest := Round(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');
                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            // Grace period overrides
            if (PrincipalStartDate <> 0D) and (RunDate < PrincipalStartDate) then LPrincipal := 0;
            if (InterestStartDate <> 0D) and (RunDate < InterestStartDate) then LInterest := 0;
            if LPrincipal < 0 then LPrincipal := 0;

            // Final installment — absorb rounding residual
            if InstalNo = RemainingInstallments then begin
                LPrincipal := LBalance;
                LBalance := 0;
            end else
                LBalance := LBalance - SaccoActivities.SmartRound(LPrincipal);

            // Write to REAL Loan Repayment Schedule table
            LSchedule.Init();
            LSchedule."Line No." := InstalNo;
            LSchedule."Loan No." := Loans."Loan No.";
            LSchedule."Loan Amount" := LoanAmount;
            LSchedule."Repayment Date" := CalcDate('CM', RunDate);
            LSchedule."Deposit Amount" := DepositAmt;
            LSchedule."Monthly Appraisal" := LCharge.Amount;
            LSchedule."Monthly Repayment" := SaccoActivities.SmartRound(TotalMRepay + DepositAmt + LCharge.Amount);
            LSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
            LSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
            LSchedule."Loan Balance" := LBalance;
            LSchedule.Insert();

            RunDate := CalcDate('1M', RunDate);
            InstalNo += 1;

        until InstalNo > RemainingInstallments;
    end;

    procedure GetDefaultedAmount(LoanNo: Code[20]; AsAt: Date; var ExpectedAmt: Decimal; var AmtPaid: Decimal; var DefAmount: Decimal; var DaysInArrear: Integer; var ArrearsDate: Date; CurrentPayment: Boolean; GracePeriod: DateFormula)
    var
        Loans: Record Loans;
        LSchedule: Record "Loan Repayment Schedule";
        LastDate: Date;
        TRep: Decimal;
        CheckDate: Date;
        ExpBal: Decimal;
        Emp: Record Customer;
        M: Integer;
        D: Integer;
        Y: Integer;
        OldLoans: Record "Old Loans";
    begin

        ExpectedAmt := 0;
        AmtPaid := 0;
        DefAmount := 0;
        DaysInArrear := 0;
        ExpBal := 0;
        D := 0;
        M := 0;
        Y := 0;

        CheckDate := AsAt;

        if format(GracePeriod) <> '' then
            AsAt := CalcDate(GracePeriod, AsAt);

        Loans.Reset;
        Loans.SetRange("Loan No.", LoanNo);
        if CurrentPayment then
            Loans.SetFilter("Date Filter", '..%1', Today)
        else
            Loans.SetFilter("Date Filter", '..%1', AsAt);
        if Loans.FindFirst then begin
            Loans.CalcFields("Outstanding Principal", "Employer Code", "Principal Paid");

            /*if (Loans."Employer Code" <> '') and (Loans."Mobile Loan" = false) then begin
                if Emp.Get(Loans."Employer Code") then begin
                    //SaccoSetup.TestField("Days for Checkoff");
                    if Emp."Checkoff Agreement Date" <> '' then begin
                        Evaluate(D, Emp."Checkoff Agreement Date");

                        if AsAt = 0D then
                            AsAt := CalcDate('-1M+CM', Today);

                        M := Date2DMY(AsAt, 2);
                        Y := Date2DMY(AsAt, 3);
                        AsAt := DMY2Date(D, M, Y);
                    end;
                end;
            end;*/
            AmtPaid := Loans."Principal Paid";

            ExpBal := Loans."Approved Amount";

            LSchedule.Reset();
            LSchedule.SetRange("Loan No.", Loans."Loan No.");
            LSchedule.Setfilter("Repayment Date", '..%1', AsAt);
            if LSchedule.FindLast() then begin
                /* if Loans."Mobile Loan" then
                    ExpBal := Loans."Approved Amount" - Loans."Loan Principle Repayment" * LSchedule.count// //LSchedule."Loan Balance";
                else */
                ExpBal := LSchedule."Loan Balance";

            end;

            IF ExpBal < 0 then
                ExpBal := 0;

            //For sasra
            if not CurrentPayment then begin
                OldLoans.Reset();
                OldLoans.Setrange("Loan  No.", Loans."Loan No.");
                if OldLoans.FindFirst() then
                    Loans."Outstanding Principal" -= OldLoans."Interest Paid";
            end;
            DefAmount := Loans."Outstanding Principal" - ExpBal;
            LastDate := Loans."Schedule Start Date";

            LSchedule.Reset();
            LSchedule.SetRange("Loan No.", Loans."Loan No.");
            LSchedule.SetFilter("Monthly Principal", '>%1', 0);
            if LSchedule.FindFirst() then
                LastDate := LSchedule."Repayment Date";

            if DefAmount >= 100 then begin

                LSchedule.Reset();
                LSchedule.SetRange("Loan No.", Loans."Loan No.");
                LSchedule.SetFilter("Loan Balance", '>=%1', Loans."Outstanding Principal");
                if LSchedule.Findlast() then begin
                    LastDate := LSchedule."Repayment Date";
                    ArrearsDate := calcdate('1M', LastDate);

                    //ArrearsDate := ArrearsDate + 1;
                    //DaysInArrear := AsAt - ArrearsDate + 1;
                    ArrearsDate := ArrearsDate + 1;
                    DaysInArrear := AsAt - ArrearsDate + 1;
                    //DaysInArrear := Today - ArrearsDate + 1;
                end
                else begin
                    if lastDate <> 0D then begin
                        ArrearsDate := LastDate + 1;
                        DaysInArrear := AsAt - ArrearsDate + 1;
                    end
                end;
            end;

            If DaysInArrear < 0 then begin
                DefAmount := 0;
                DaysInArrear := 0;
            end;

            if DefAmount < 0 then
                DefAmount := 0;
        end;
    end;

    procedure GetMonthsInDefault(LoanNo: Code[20]; AsAt: Date; GracePeriod: DateFormula; var DefAmount: decimal): Decimal
    var
        Loans: Record Loans;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        //DefAmount: Decimal;
        DaysInArrear: Integer;
        ArrearsDate: Date;
        PrincipalInstallment: Decimal;
    begin
        if not Loans.Get(LoanNo) then
            exit(0);

        GetDefaultedAmount(LoanNo, AsAt, ExpectedAmt, AmtPaid, DefAmount, DaysInArrear, ArrearsDate, false, GracePeriod);
        if DefAmount <= 0 then
            exit(0);

        PrincipalInstallment := GetLoanPrincipal(Loans, AsAt);

        /* if PrincipalInstallment <= 0 then
            exit(0); */

        exit(Round(DefAmount / PrincipalInstallment, 0.01, '='));
    end;

    procedure LoanArrears(LoanCard: Record Loans; LoanProduct: Record "Product Setup"; StartDate: Date; EndDate: Date): Decimal
    var
        LoanSchedule: Record "Loan Repayment Schedule";
        AmountPaid: Decimal;
        TotalArrears: Decimal;
        ExpectedRepaidAmount: Decimal;
        CreditLedgerEntry: Record "Credit Ledger Entry";
        PenaltyArrears: Decimal;
    begin
        TotalArrears := 0;

        //Get the most recent installment.
        LoanSchedule.Reset;
        LoanSchedule.SetRange(LoanSchedule."Loan No.", LoanCard."Loan No.");
        LoanSchedule.SetFilter(LoanSchedule."Repayment Date", StrSubstNo('..%1', EndDate));
        if LoanSchedule.FindFirst then LoanSchedule.CalcSums("Monthly Principal");

        LoanCard.CalcFields("Outstanding Principal", "Schedule Principal");

        AmountPaid := LoanCard."Approved Amount" - LoanCard."Outstanding Principal";

        ExpectedRepaidAmount := LoanCard."Schedule Principal";

        TotalArrears := ExpectedRepaidAmount - AmountPaid;

        if TotalArrears <= 0 then exit(0);

        exit(TotalArrears);
    end;


    procedure GetCurrentMonthlyRepayment(LoanNo: Code[20]): Decimal
    var
        MonthStart: Date;
        MonthEnd: Date;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        DaysInArrear: Integer;
        ArrearsDate: Date;
        AsAt: Date;
        GracePeriod: DateFormula;
        CurrentRepayment: Decimal;
        MonthlyPrincipal: Decimal;
        MonthlyDeposit: Decimal;
        OutstandingInterest: Decimal;
        OutstandingInsurance: Decimal;
        DefAmt: decimal;
        ScheduleBal: decimal;
        LSchedule: Record "Loan Repayment Schedule";
        Loan: Record Loans;
    begin
        MonthStart := CalcDate('<-CM>', Today);
        MonthEnd := CalcDate('<CM>', Today);
        AsAt := CalcDate('<CM>', Today);

        ExpectedAmt := 0;
        AmtPaid := 0;
        DefAmount := 0;
        DaysInArrear := 0;
        ArrearsDate := 0D;
        ScheduleBal := 0;
        DefAmt := 0;

        LSchedule.Reset();
        LSchedule.SetRange("Loan No.", LoanNo);
        LSchedule.SetFilter("Repayment Date", '%1..%2', MonthStart, MonthEnd);
        if LSchedule.FindFirst() then begin
            MonthlyPrincipal := LSchedule."Monthly Principal";
            MonthlyDeposit := LSchedule."Deposit Amount";
            ScheduleBal := LSchedule."Loan Balance";
        end;

        if Loan.Get(LoanNo) then begin
            Loan.calcfields("Total Outstanding Balance", "Outstanding Principal");
            if Loan."Total Outstanding Balance" <= 0 then
                exit(0);

            if ScheduleBal = 0 then
                ScheduleBal := Loan."Outstanding Principal";

            DefAmt := Loan."Outstanding Principal" - ScheduleBal;

            if DefAmt < 0 then
                DefAmt := 0;

            OutstandingInterest :=
                GetMonthlyCreditLedgerBalance(
                    LoanNo,
                    MonthStart,
                    MonthEnd,
                    TransType::"Interest Due",
                    TransType::"Interest Paid");

            OutstandingInsurance :=
                GetMonthlyCreditLedgerBalance(
                    LoanNo,
                    MonthStart,
                    MonthEnd,
                    TransType::"Insurance Due",
                    TransType::"Insurance Paid");

            if MonthlyDeposit = 0 then
                MonthlyDeposit := Loan."Deposit COntribution";
        end;

        CurrentRepayment := DefAmt + OutstandingInterest + OutstandingInsurance + MonthlyDeposit;

        if CurrentRepayment < 0 then
            CurrentRepayment := 0;


        exit(CurrentRepayment);
    end;

    local procedure GetMonthlyCreditLedgerBalance(LoanNo: Code[20]; MonthStart: Date; MonthEnd: Date; DueTransactionType: Enum "Transaction Type Enum"; PaidTransactionType: Enum "Transaction Type Enum"): Decimal
    var
        CreditLedgerEntry: Record "Credit Ledger Entry";
        LedgerBalance: Decimal;
    begin
        CreditLedgerEntry.Reset();
        CreditLedgerEntry.SetRange("Loan No.", LoanNo);
        CreditLedgerEntry.SetRange("Posting Date", MonthStart, MonthEnd);
        CreditLedgerEntry.SetFilter("Transaction Type", '%1|%2', DueTransactionType, PaidTransactionType);
        CreditLedgerEntry.SetFilter("User ID", '<>%1', '');
        CreditLedgerEntry.SetFilter(Amount, '<>%1', 0);
        CreditLedgerEntry.SetFilter("Amount (LCY)", '<>%1', 0);
        CreditLedgerEntry.CalcSums("Amount (LCY)");
        LedgerBalance := CreditLedgerEntry."Amount (LCY)";

        if LedgerBalance < 0 then
            LedgerBalance := 0;

        exit(LedgerBalance);
    end;

    procedure OldGetDefaultedAmount(LoanNo: Code[20]; AsAt: Date; var ExpectedAmt: Decimal; var AmtPaid: Decimal; var DefAmount: Decimal; var DaysInArrear: Integer; var ArrearsDate: Date; CurrentPayment: Boolean)
    var
        Loans: Record Loans;
        LSchedule: Record "Loan Repayment Schedule";
        LastDate: Date;
        TRep: Decimal;
    begin

        ExpectedAmt := 0;
        AmtPaid := 0;
        DefAmount := 0;
        DaysInArrear := 0;

        Loans.Reset;
        Loans.SetRange("Loan No.", LoanNo);
        if CurrentPayment then
            Loans.SetFilter("Date Filter", '..%1', Today)
        else
            Loans.SetFilter("Date Filter", '..%1', AsAt);
        if Loans.FindFirst then begin
            Loans.CalcFields("Outstanding Principal");
            AmtPaid := Loans."Approved Amount" - Loans."Outstanding Principal";

            if (Loans."Loan Rescheduled") then begin

                LSchedule.Reset;
                LSchedule.SetRange("Loan No.", Loans."Loan No.");
                //LSchedule.SETFILTER("Monthly Principal",'>%1',0);
                if LSchedule.FindFirst then begin

                    Loans.Reset;
                    Loans.SetRange("Loan No.", LoanNo);
                    if CurrentPayment then
                        Loans.SetFilter("Date Filter", '%1..%2', CalcDate('-CM', LSchedule."Repayment Date"), Today)
                    else
                        Loans.SetFilter("Date Filter", '%1..%2', CalcDate('-CM', LSchedule."Repayment Date"), AsAt);
                    if Loans.FindFirst then begin
                        Loans.CalcFields("Principal Repayment");
                        AmtPaid := Loans."Principal Repayment";
                    end;
                end;
            end;
        end;

        if AmtPaid < 0 then
            AmtPaid := 0;

        Loans.Reset;
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Date Filter", '..%1', AsAt);
        if Loans.FindFirst then begin
            Loans.CalcFields("Schedule Principal");
            if Loans."Disbursement Date" = 0D then
                Loans."Disbursement Date" := Loans."Application Date";

            //Loans.TestField("Disbursement Date");

            ExpectedAmt := Loans."Schedule Principal";

            LastDate := Loans."Repayment Start Date";
        end;

        DefAmount := ExpectedAmt - AmtPaid;


        //Message('DefAmount %1 \ExpectedAmt %2\AmtPaid %3', DefAmount, ExpectedAmt, AmtPaid);


        if DefAmount < 100 then
            DefAmount := 0;

        LSchedule.Reset;
        LSchedule.SetRange("Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Monthly Principal", '>%1', 0);
        if LSchedule.FindFirst then begin
            repeat
                TRep += LSchedule."Monthly Principal";
                if AmtPaid >= TRep then
                    LastDate := LSchedule."Repayment Date";
            until (LSchedule.Next = 0);
        end;

        //MESSAGE('%1',DefAmount);
        if DefAmount > 0 then begin
            ArrearsDate := Loans."Repayment Start Date";
            LSchedule.Reset;
            LSchedule.SetRange("Loan No.", Loans."Loan No.");
            LSchedule.SetFilter("Repayment Date", '%1..', LastDate);
            if LSchedule.FindFirst then
                ArrearsDate := LSchedule."Repayment Date" + 1;

            DaysInArrear := AsAt - ArrearsDate;
            DaysInArrear += 1;
        end
        else
            DaysInArrear := 0;

        if Loans."Loan Product Type" = 'L30' then begin
            if CalcDate('+3M', Loans."Disbursement Date") > Today then begin
                DefAmount := 0;
            end;
        end
    end;

