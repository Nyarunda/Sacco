                        SavingsInterestHeader."No.", InterestLine."Account No");
                    SendEmail(Member."E-Mail", '', '', 'Interest on Deposits', 'Dear ' + FirstName + ',', Body);
                end;
        until InterestLine.Next() = 0;
    end;

