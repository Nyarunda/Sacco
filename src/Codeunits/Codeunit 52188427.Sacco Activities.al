    /// Posts the withdrawal fee journal entry.
    local procedure PostWithdrawalFee(Header: Record "Defaulter Loan Recovery"; RecoveryAccount: Code[20])
    var
        PDate: Date;
    begin
        PDate := Header."Posting Date";

        JournalInsert(
            JTemplate, JBatch, Header."No.", PDate,
            Accttype::Savings, RecoveryAccount,
            CopyStr('Withdrawal Fee: ' + Loans."Loan Product Type Name", 1, 100),
            Balaccttype::"G/L Account", ChargeAcct,
            Header."Withdrawal Fee",
            Header."No.", '', Transtype::" ",
            Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
            true, TChannel::Offset, Header."Dimension Set ID");
    end;


    /// Recovers principal on loans where the member is their own guarantor.
    /// Returns the updated running balance.
    local procedure RecoverSelfGuaranteedLoans(
        Header: Record "Defaulter Loan Recovery";
        RunBal: Decimal;
        RecoveryAccount: Code[20];
        PostEntries: Boolean): Decimal
    var
        AppraisalLine: Record "Offset Appraisal";
        OffsetLine: Record "Loans Offet List";
        PrAmt: Decimal;
        DedAmt: Decimal;
        PDate: Date;
    begin
        OffsetLine.Reset();
        OffsetLine.SetRange("Header No.", Header."No.");
        OffsetLine.SetRange("Member No", Header."Member No.");
        OffsetLine.SetRange("Self Guaranteed", true);
        if not OffsetLine.FindFirst() then
            exit(RunBal);

        repeat
            if RunBal <= 0 then
                break;

            PDate := Header."Posting Date";

            /*  If RunBal > Header."Self Guaranteed" then
                 RunBal := Header."Self Guaranteed"; */

            AppraisalLine.Reset();
            AppraisalLine.SetRange("Offset No.", Header."No.");
            AppraisalLine.SetRange("Loan No.", OffsetLine."Loan No");
            if not AppraisalLine.FindFirst() then
                continue;

            Loans.Get(OffsetLine."Loan No");

            if AppraisalLine."Outstanding Interest" = 0 then begin
                AppraisalLine.Savings := RunBal;
                AppraisalLine."New Savings Balance" := RunBal;
            end;

            DedAmt := OffsetLine."Amount to Recover" - OffsetLine."Outstanding Interest";
            DedAmt := MinDecimal(DedAmt, RunBal);
            DedAmt := MinDecimal(DedAmt, OffsetLine."Outstanding Principal");

            if DedAmt > 0 then begin
                PrAmt := DedAmt;
                RunBal -= PrAmt;
                AppraisalLine."New Outstanding Balance" := DedAmt;

                if PostEntries then begin
                    JournalInsert(
                        JTemplate, JBatch, Header."No.", PDate,
                        Accttype::Credit, Loans."Loan Account",
                        CopyStr('Principal Offset: ' + Loans."Loan Product Type Name", 1, 100),
                        Balaccttype::"G/L Account", '', -PrAmt,
                        Header."No.", Loans."Loan No.", Transtype::"Principal Repayment",
                        Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                        true, TChannel::Offset, Header."Dimension Set ID");

                    JournalInsert(
                        JTemplate, JBatch, Header."No.", PDate,
                        Accttype::Savings, RecoveryAccount,
                        CopyStr('Principal Offset: ' + Loans."Loan Product Type Name", 1, 100),
                        Balaccttype::"G/L Account", '', PrAmt,
                        Header."No.", '', Transtype::" ",
                        Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                        true, TChannel::Offset, Header."Dimension Set ID");
                end;
            end;

            AppraisalLine."New Savings Balance" := RunBal;
            AppraisalLine.Modify();

        until OffsetLine.Next() = 0;

        exit(RunBal);
    end;


    /// Recovers principal on loans where other members are guarantors.
    /// Returns the updated running balance.
    local procedure RecoverOtherLoans(
        Header: Record "Defaulter Loan Recovery";
        RunBal: Decimal;
        RecoveryAccount: Code[20];
        PostEntries: Boolean): Decimal
    var
        AppraisalLine: Record "Offset Appraisal";
        OffsetLine: Record "Loans Offet List";
        PrAmt: Decimal;
        DedAmt: Decimal;
        PDate: Date;
    begin
        OffsetLine.Reset();
        OffsetLine.SetRange("Header No.", Header."No.");
        OffsetLine.SetRange("Member No", Header."Member No.");
        OffsetLine.SetRange("Self Guaranteed", false);
        if not OffsetLine.FindFirst() then
            exit(RunBal);

        repeat
            if RunBal <= 0 then
                break;

            PDate := Header."Posting Date";

            AppraisalLine.Reset();
            AppraisalLine.SetRange("Offset No.", Header."No.");
            AppraisalLine.SetRange("Loan No.", OffsetLine."Loan No");
            if not AppraisalLine.FindFirst() then
                continue;

            Loans.Get(OffsetLine."Loan No");

            // Net off what interest has already been recovered
            DedAmt := OffsetLine."Amount to Recover" - AppraisalLine."Outstanding Interest";
            if DedAmt < 0 then
                DedAmt := 0;

            DedAmt := MinDecimal(DedAmt, RunBal);
            DedAmt := MinDecimal(DedAmt, OffsetLine."Outstanding Principal");

            if DedAmt > 0 then begin
                PrAmt := DedAmt;
                RunBal -= PrAmt;
                AppraisalLine."New Outstanding Balance" := AppraisalLine."Outstanding Balance" - DedAmt;

                if PostEntries then begin
                    JournalInsert(
                        JTemplate, JBatch, Header."No.", PDate,
                        Accttype::Credit, Loans."Loan Account",
                        CopyStr('Principal Offset: ' + Loans."Loan Product Type Name", 1, 100),
                        Balaccttype::"G/L Account", '', -PrAmt,
                        Header."No.", Loans."Loan No.", Transtype::"Principal Repayment",
                        Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                        true, TChannel::Offset, Header."Dimension Set ID");

                    JournalInsert(
                        JTemplate, JBatch, Header."No.", PDate,
                        Accttype::Savings, RecoveryAccount,
                        CopyStr('Principal Offset: ' + Loans."Loan Product Type Name", 1, 100),
                        Balaccttype::"G/L Account", '', PrAmt,
                        Header."No.", '', Transtype::" ",
                        Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                        true, TChannel::Offset, Header."Dimension Set ID");
                end;
            end;

            // Record the loan balance before guarantor recovery begins
            if Header."Recovery Source" = Header."Recovery Source"::"Guarantor Non-Withdrawable Deposits" then
                AppraisalLine."Loan Balance Before Guarantors" := AppraisalLine."New Outstanding Balance"
            else
                AppraisalLine."Loan Balance Before Guarantors" :=
                    AppraisalLine."New Outstanding Balance" + AppraisalLine."New Outstanding Interest";

            AppraisalLine."New Savings Balance" := RunBal;
            AppraisalLine.Modify();

        until OffsetLine.Next() = 0;

        exit(RunBal);
    end;


    /// Returns true when guarantor recovery is applicable
    local procedure IsGuarantorRecoveryRequired(Header: Record "Defaulter Loan Recovery"): Boolean
    begin
        exit(
            (Header."Recovery Source" = Header."Recovery Source"::"Issue Guarantor Defaulter Loan") or
            (Header."Recovery Source" = Header."Recovery Source"::"Guarantor Non-Withdrawable Deposits") or
            (Header."Recovery Source" = Header."Recovery Source"::"Recover & Issue Guarantor Defaulter Loan")
        );
    end;


    /// Processes guarantor recovery — either deducting from non-withdrawable deposits
    /// or issuing a new defaulter loan to each guarantor.
    /// Returns the updated running balance.
    local procedure RecoverFromGuarantors(
    Header: Record "Defaulter Loan Recovery";
    RunBal: Decimal;
    PDate: Date;
    PostEntries: Boolean): Decimal
    var
        AppraisalLine: Record "Offset Appraisal";
        OffsetLine: Record "Loans Offet List";
        RecoveryLines: Record "Defaulter Recovery Lines";
        MemberAccounts: Record "Savings Accounts";
        TotalGuaranteed: Decimal;
        DedAmt: Decimal;
    begin
        OffsetLine.Reset();
        OffsetLine.SetRange("Header No.", Header."No.");
        OffsetLine.SetRange("Member No", Header."Member No.");
        OffsetLine.SetRange("Recover From Guarantors", true);
        if not OffsetLine.FindFirst() then
            exit(RunBal);

        repeat
            AppraisalLine.Reset();
            AppraisalLine.SetRange("Offset No.", Header."No.");
            AppraisalLine.SetRange("Loan No.", OffsetLine."Loan No");
            if not AppraisalLine.FindFirst() then
                continue;

            TotalGuaranteed := SumGuaranteedAmounts(Header."No.", OffsetLine."Loan No");

            RecoveryLines.Reset();
            RecoveryLines.SetRange("Header No.", Header."No.");
            RecoveryLines.SetRange("Loan No.", OffsetLine."Loan No");
            if not RecoveryLines.Find('-') then
                continue;

            repeat
                RecoveryLines."Loan Balance After Offset" := AppraisalLine."Loan Balance Before Guarantors";

                Loans.Reset();
                Loans.SetRange("Loan No.", OffsetLine."Loan No");
                Loans.SetFilter("Total Outstanding Balance", '>0');
                Loans.SetAutoCalcFields("Outstanding Principal");
                if not Loans.FindFirst() then
                    continue;

                MemberAccounts.Reset();
                MemberAccounts.SetRange("No.", RecoveryLines."Guarantor Savings Account");
                MemberAccounts.SetAutoCalcFields("Balance (LCY)");
                if not MemberAccounts.FindFirst() then
                    continue;

                repeat
                    // ── ROUTING DECISION ─────────────────────────────────────────
                    case RecoveryLines."Recovery Method" of

                        RecoveryLines."Recovery Method"::Loan:
                            IssueGuarantorDefaulterLoan(
                                Header, Loans, AppraisalLine, RecoveryLines, MemberAccounts,
                                TotalGuaranteed, PDate, PostEntries);

                        RecoveryLines."Recovery Method"::Split:
                            RecoverFromGuarantorSplit(
                                Header, Loans, AppraisalLine, RecoveryLines, MemberAccounts,
                                TotalGuaranteed, PDate, PostEntries);

                        else
                            // Default + Savings both land here.
                            // "Default" means the officer made no choice → treat as Savings.
                            RecoverFromGuarantorDeposit(
                            Header, Loans, RecoveryLines, MemberAccounts,
                            PDate, PostEntries);
                    end;
                // ─────────────────────────────────────────────────────────────

                until MemberAccounts.Next() = 0;

            until RecoveryLines.Next() = 0;

            // Update the outstanding balance marker after all guarantor lines
            // for this loan have been processed.
            DedAmt := MinDecimal(OffsetLine."Outstanding Principal", RunBal);
            if DedAmt > 0 then begin
                RunBal -= DedAmt;
                AppraisalLine."New Outstanding Balance" := DedAmt;

                if Header."Recovery Source" = Header."Recovery Source"::"Guarantor Non-Withdrawable Deposits" then
                    AppraisalLine."Loan Balance Before Guarantors" := AppraisalLine."New Outstanding Balance"
                else
                    AppraisalLine."Loan Balance Before Guarantors" :=
                        AppraisalLine."New Outstanding Balance" + AppraisalLine."New Outstanding Interest";

                AppraisalLine.Modify();

                if PostEntries then
                    NotifyMember(Header, GetMemberRecord(Header."Member No."), PostEntries);
            end;

        until OffsetLine.Next() = 0;

        exit(RunBal);
    end;

    /// Sums all "Amount Guaranteed" values on recovery lines for a given loan.
    local procedure SumGuaranteedAmounts(HeaderNo: Code[20]; LoanNo: Code[20]): Decimal
    var
        RecoveryLines: Record "Defaulter Recovery Lines";
    begin
        RecoveryLines.Reset();
        RecoveryLines.SetRange("Header No.", HeaderNo);
        RecoveryLines.SetRange("Loan No.", LoanNo);
        if RecoveryLines.Find('-') then begin
            RecoveryLines.CalcSums("Amount Guaranteed");
            exit(RecoveryLines."Amount Guaranteed");
        end;
        exit(0);
    end;


    /// Deducts the recovery amount directly from a guarantor's non-withdrawable deposit account.
    local procedure RecoverFromGuarantorDeposit(
    Header: Record "Defaulter Loan Recovery";
    Loans: Record Loans;
    RecoveryLines: Record "Defaulter Recovery Lines";
    MemberAccounts: Record "Savings Accounts";
    PDate: Date;
    PostEntries: Boolean)
    var
        DedAmt: Decimal;
        Desc: Text[50];
    begin
        DedAmt := RecoveryLines.GetSavingsAmount();

        // Cannot take more than the guarantor actually holds.
        if DedAmt > MemberAccounts."Balance (LCY)" then
            DedAmt := MemberAccounts."Balance (LCY)";

        if DedAmt <= 0 then
            exit;

        Desc := CopyStr(
            Loans."Loan No." + ' Guarantor Savings Recovery: ' + MemberAccounts."Member No.",
            1, 50);

        if not PostEntries then
            exit;

        // Debit guarantor savings account
        JournalInsert(
            JTemplate, JBatch, Header."No.", PDate,
            Accttype::Savings, MemberAccounts."No.", Desc,
            Balaccttype::"G/L Account", '', DedAmt,
            Header."No.", '', Transtype::" ",
            Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
            true, TChannel::Offset, Header."Dimension Set ID");

        // Credit defaulter loan — principal repayment
        JournalInsert(
            JTemplate, JBatch, Header."No.", PDate,
            Accttype::Credit, Loans."Loan Account", Desc,
            Balaccttype::"G/L Account", '', -DedAmt,
            Header."No.", Loans."Loan No.", Transtype::"Principal Repayment",
            Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
            true, TChannel::Offset, Header."Dimension Set ID");

        // Notify guarantor by SMS
        SendGuarantorSavingsSms(MemberAccounts, DedAmt, Header.Name, PostEntries);
    end;

    /// Creates a new defaulter loan for a guarantor and transfers the loan balance.
    local procedure IssueGuarantorDefaulterLoan(
    Header: Record "Defaulter Loan Recovery";
    Loans: Record Loans;
    AppraisalLine: Record "Offset Appraisal";
    RecoveryLines: Record "Defaulter Recovery Lines";
    MemberAccounts: Record "Savings Accounts";
    TotalGuaranteed: Decimal;
    PDate: Date;
    PostEntries: Boolean)
    var
        PSetup: Record "Product Setup";
        DefLoan: Record Loans;
        Member: Record Members;
        LoanAmt: Decimal;
        IntAmt: Decimal;
        PrAmt: Decimal;
    begin
        LoanAmt := RecoveryLines.GetLoanAmount();
        if LoanAmt <= 0 then
            exit;

        PSetup.Reset();
        PSetup.SetRange("Nature of Loan Type", PSetup."Nature of Loan Type"::Defaulter);
        if not PSetup.FindFirst() then
            Error('Defaulter Loan Product does not exist. Please configure it in Product Setup.');

        // Remove any pre-existing unposted defaulter loan for this member/product.
        DefLoan.Reset();
        DefLoan.SetRange("Loan Product Type", PSetup."Product ID");
        DefLoan.SetRange("Member No.", MemberAccounts."Old Member No.");
        DefLoan.SetRange(Posted, false);
        if DefLoan.FindFirst() then
            DefLoan.DeleteAll();

        BuildGuarantorDefaulterLoan(DefLoan, PSetup, Loans, RecoveryLines, MemberAccounts, LoanAmt, PDate);

        if (DefLoan."Approved Amount" > 0) and PostEntries then
            DefLoan.Insert(true);

        // Proportional split of the loan amount into interest and principal.
        IntAmt := Round(
            (RecoveryLines."Amount Guaranteed" / TotalGuaranteed) * AppraisalLine."New Outstanding Interest",
            0.01, '=');
        if IntAmt < 0 then
            IntAmt := 0;
        PrAmt := DefLoan."Approved Amount" - IntAmt;

        if not PostEntries then
            exit;

        PostGuarantorLoanTransferJournals(
            Header, Loans, DefLoan, IntAmt, PrAmt, PDate);

        GenerateRepaymentSchedule(DefLoan);
        SendGuarantorLoanSms(MemberAccounts, DefLoan, Header.Name, PostEntries);
    end;

    // -----------------------------------------------------------------------------
    // SPLIT PATH  (NEW)
    // -----------------------------------------------------------------------------

    /// Handles a Split recovery line by running the savings path first (using
    /// "Amount from Savings"), then the loan path (using "Amount as Loan").
    /// Both helpers already read the correct amounts via GetSavingsAmount() /
    /// GetLoanAmount(), so no special overrides are needed here.
    local procedure RecoverFromGuarantorSplit(
        Header: Record "Defaulter Loan Recovery";
        Loans: Record Loans;
        AppraisalLine: Record "Offset Appraisal";
        RecoveryLines: Record "Defaulter Recovery Lines";
        MemberAccounts: Record "Savings Accounts";
        TotalGuaranteed: Decimal;
        PDate: Date;
        PostEntries: Boolean)
    begin
        // Savings portion first — reduces the loan balance before the loan is issued.
        if RecoveryLines."Amount from Savings" > 0 then
            RecoverFromGuarantorDeposit(
                Header, Loans, RecoveryLines, MemberAccounts, PDate, PostEntries);

        // Loan portion second — covers whatever savings couldn't.
        if RecoveryLines."Amount as Loan" > 0 then
            IssueGuarantorDefaulterLoan(
                Header, Loans, AppraisalLine, RecoveryLines, MemberAccounts,
                TotalGuaranteed, PDate, PostEntries);
    end;
    // -----------------------------------------------------------------------------
    // EXTRACTED HELPERS  (keep procedures focused and short)
    // -----------------------------------------------------------------------------

    /// Populates all fields on a new defaulter loan record for a guarantor.
    /// Separated from IssueGuarantorDefaulterLoan to keep that procedure readable.
    local procedure BuildGuarantorDefaulterLoan(
        var DefLoan: Record Loans;
        PSetup: Record "Product Setup";
        Loans: Record Loans;
        RecoveryLines: Record "Defaulter Recovery Lines";
        MemberAccounts: Record "Savings Accounts";
        LoanAmt: Decimal;
        PDate: Date)
    begin
        DefLoan.Init();
        DefLoan."Loan No." := '';
        DefLoan.Source := PSetup."Loan Source";
        DefLoan."Application Date" := PDate;
        DefLoan."Loan Product Type" := PSetup."Product ID";
        DefLoan."Loan Product Type Name" := PSetup.Description;
        DefLoan."Member No." := MemberAccounts."Member No.";
        DefLoan.Validate("Disbursement Account No", '');
        DefLoan."Member Name" := MemberAccounts.Name;
        DefLoan."Requested Amount" := LoanAmt;
        DefLoan."Approved Amount" := LoanAmt;
        DefLoan."amount to disburse" := LoanAmt;
        DefLoan."Repay Mode" := PSetup."Repay Mode";
        DefLoan.Status := DefLoan.Status::Approved;

        if RecoveryLines.Installement > 0 then
            DefLoan.Installments := RecoveryLines.Installement
        else
            DefLoan.Installments := PSetup."Default Installments";

        DefLoan."Repayment Frequency" := PSetup."Repayment Frequency";
        DefLoan."Annual Interest %" := PSetup."Interest Rate (Max.)";
        DefLoan."Main Sector Code" := Loans."Main Sector Code";
        DefLoan."Sub-Sector Level 1 Code" := Loans."Sub-Sector Level 1 Code";
        DefLoan."Sub-Sector Level 2 Code" := Loans."Sub-Sector Level 2 Code";
        DefLoan."Interest Calculation Method" := PSetup."Interest Calculation Method";
        DefLoan."Mode of Disbursement" := DefLoan."Mode of Disbursement"::"Transfer to FOSA";
        DefLoan."Global Dimension 1 Code" := PSetup."Global Dimension 1 Code";

        DefLoan."Loan Interest Repayment" := Round(LoanAmt * (DefLoan."Annual Interest %" / 1200), 1);
        DefLoan."Loan Principle Repayment" := Round(LoanAmt / DefLoan.Installments, 1);
        DefLoan.Repayment := Round(LoanAmt / DefLoan.Installments);
        DefLoan."Loan Principle Repayment" := DefLoan.Repayment;

        DefLoan."Booking Branch" := MemberAccounts."Global Dimension 2 Code";
        DefLoan.Posted := true;
        DefLoan."Disbursement Date" := Today;
        DefLoan."Repayment Start Date" := CalcDate('1M+CM', DefLoan."Disbursement Date");
        DefLoan."Completion Date" := CalcDate(Format(RecoveryLines.Installement) + 'M', DefLoan."Disbursement Date");
        DefLoan."Defaulted Amount Transfered" := LoanAmt;
        DefLoan."Defaulter Loan No." := Loans."Loan No.";
        DefLoan."Defaulter Member No." := Loans."Member No.";
    end;


    /// Posts the three journal entries that transfer a defaulter loan to a guarantor.
    local procedure PostGuarantorLoanTransferJournals(
        Header: Record "Defaulter Loan Recovery";
        Loans: Record Loans;
        DefLoan: Record Loans;
        IntAmt: Decimal;
        PrAmt: Decimal;
        PDate: Date)
    begin
        // 1. Clear the interest portion from the defaulted loan
        JournalInsert(
            JTemplate, JBatch, Header."No.", PDate,
            Accttype::Credit, Loans."Loan Account",
            CopyStr(Loans."Loan No." + ' Defaulted Interest Transfer: ' + DefLoan."Member No.", 1, 100),
            Balaccttype::"G/L Account", '', -IntAmt,
            Header."No.", Loans."Loan No.", Transtype::"Interest Paid",
            Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
            true, TChannel::Offset, Header."Dimension Set ID");

        // 2. Clear the principal portion from the defaulted loan
        JournalInsert(
            JTemplate, JBatch, Header."No.", PDate,
            Accttype::Credit, Loans."Loan Account",
            CopyStr(Loans."Loan No." + ' Defaulted Principal Transfer: ' + DefLoan."Member No.", 1, 100),
            Balaccttype::"G/L Account", '', -PrAmt,
            Header."No.", Loans."Loan No.", Transtype::"Principal Repayment",
            Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
            true, TChannel::Offset, Header."Dimension Set ID");

        // 3. Disburse the new guarantor defaulter loan
        JournalInsert(
            JTemplate, JBatch, Header."No.", PDate,
            Accttype::Credit, DefLoan."Loan Account",
            CopyStr(Loans."Loan No." + ' Defaulted Loan Issued: ' + Loans."Member No.", 1, 100),
            Balaccttype::"G/L Account", '', DefLoan."Approved Amount",
            Header."No.", DefLoan."Loan No.", Transtype::"Loan Disbursement",
            Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
            true, TChannel::Offset, Header."Dimension Set ID");
    end;


    /// Sends an SMS to a guarantor whose savings were deducted.
    local procedure SendGuarantorSavingsSms(
        MemberAccounts: Record "Savings Accounts";
        DedAmt: Decimal;
        DefaulterName: Text;
        PostEntries: Boolean)
    var
        Member: Record Members;
    begin
        if not PostEntries then
            exit;

        Member.Get(MemberAccounts."Member No.");
        if Member."Mobile Phone No." = '' then
            exit;

        MemberActivities.SendSms(
            Smssource::"Defaulter Loan Issued",
            Member."Mobile Phone No.",
            StrSubstNo(
                'KES %1 has been deducted from your savings to recover a loan you guaranteed for %2.',
                Format(DedAmt),
                DefaulterName),
            Member."No.", MemberAccounts."No.",
            true, false);
    end;
    /// Sends an SMS to a guarantor who has been issued a defaulter loan.
    local procedure SendGuarantorLoanSms(
        MemberAccounts: Record "Savings Accounts";
        DefLoan: Record Loans;
        DefaulterName: Text;
        PostEntries: Boolean)
    var
        Member: Record Members;
    begin
        if not PostEntries then
            exit;

        if DefLoan."Approved Amount" <= 0 then
            exit;

        Member.Get(MemberAccounts."Member No.");
        if Member."Mobile Phone No." = '' then
            exit;

        MemberActivities.SendSms(
            Smssource::"Defaulter Loan Issued",
            Member."Mobile Phone No.",
            StrSubstNo(
                'A loan of KES %1 has been issued to you to recover a loan you guaranteed for %2. ' +
                'Repayment starts %3.',
                Format(DefLoan."Approved Amount"),
                DefaulterName,
                Format(DefLoan."Repayment Start Date")),
            Member."No.", DefLoan."Disbursement Account No",
            true, false);
    end;

    /// Sends an SMS to the defaulting member confirming deduction.
    local procedure NotifyMember(Header: Record "Defaulter Loan Recovery"; Member: Record Members; PostEntries: Boolean)
    begin
        if not PostEntries then
            exit;
        if Member."Mobile Phone No." = '' then
            exit;

        MemberActivities.SendSms(
            Smssource::"Defaulter Loan Issued",
            Member."Mobile Phone No.",
            StrSubstNo('Your loan of %1 has been recovered from your Deposits/Guarantors',
                Format(Header."Total Deduction")),
            Member."No.", Member."No.",
            true, false);
    end;


    /// Retrieves a Members record; errors if not found.
    local procedure GetMemberRecord(MemberNo: Code[20]): Record Members
    var
        Member: Record Members;
    begin
        Member.Get(MemberNo);
        exit(Member);
    end;


    /// Returns the smaller of two Decimal values.
    local procedure MinDecimal(A: Decimal; B: Decimal): Decimal
    begin
        if A < B then exit(A);
        exit(B);
    end;

    procedure ValidateGuarantorLines(Header: Record "Defaulter Loan Recovery")
    var
        RecoveryLines: Record "Defaulter Recovery Lines";
    begin
        RecoveryLines.Reset();
        RecoveryLines.SetRange("Header No.", Header."No.");
        if not RecoveryLines.FindFirst() then
            exit;

        repeat
            RecoveryLines.CheckSplitComplete();
        until RecoveryLines.Next() = 0;
    end;

    procedure SendEmail(
     RecepientAddress: Text;
     AddCC: Text;
     FileName: Text;
     Subject: Text;
     Salutation: Text;
     Body: Text) Sent: Boolean
    var
        EmailMsg: Codeunit "Email Message";
        BodyMsg: Text;
        RegardsTxt: Label 'Kind Regards,';
        DisclaimerTxt: Label 'This is a system generated email. Please do not respond to this email.';
    begin
        Sent := false;

        if RecepientAddress = '' then
            exit(false);

        BodyMsg := Salutation;
        BodyMsg += '<br><br>';
        BodyMsg += Body;
        BodyMsg += '<br><br>';
        BodyMsg += RegardsTxt;
        BodyMsg += '<br>';
        BodyMsg += CompanyName;
        BodyMsg += '<br><br><hr>';
        BodyMsg += DisclaimerTxt;

        EmailMsg.Create(RecepientAddress, Subject, BodyMsg, true);

        if AddCC <> '' then
            EmailMsg.AddRecipient(Enum::"Email Recipient Type"::Cc, AddCC);

        Sent := TrySendEmail(EmailMsg);
    end;

