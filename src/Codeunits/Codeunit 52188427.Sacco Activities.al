    procedure BillInterest(Var Loans: Record Loans; BillDate: Date; PDate: Date)
    var
        LoanType: Record "Product Setup";
        DocNo: Code[20];
        "Document No.": Code[20];
        LoanAmount: Decimal;
        Members: Record Members;
        CurrDate: Date;
        FirstMonthDate: Date;
        CurrMonth: Date;
        MidDate: Date;
        EndDate: Date;
        LastMonthDate: Date;
        FirstDay: Date;
        FirstDate: Date;
        IntCharged: Decimal;
        Principle: Decimal;
        MonthDays: Integer;
        dWindow: Dialog;
        CurrentRecordNo: Integer;
        NoOfRecords: Integer;
        Exception: Boolean;
        IntDueDate: Date;
        Customer: Record Members;
        Auto: Boolean;
        LRec: Record Loans;
        StopInterest: Boolean;
        PSetup: Record "Product Setup";
    begin

        PSetup.Get(Loans."Loan Product Type");


        if Loans.Installments = 0 then begin
            Loans.Installments := PSetup."Default Installments";
            Loans.Modify();
            Commit();

        end;

        if Loans."Interest Calculation Method" <> PSetup."Interest Calculation Method" then begin
            Loans."Interest Calculation Method" := PSetup."Interest Calculation Method";
            Loans.Modify();
            Commit();

        end;

        Loans.CalcFields("Last Int. Due Date");

        StopInterest := false;
        Members.Reset();
        Members.SetLoadFields("No.", "Employer Code");
        if Members.Get(Loans."Member No.") then;

        Customer.SetLoadFields("No.", "Employer Code", "Stop Interest Due");
        if Customer.Get(Members."Employer Code") then
            if Customer."Stop Interest Due" then
                StopInterest := true;

        if not StopInterest then begin

            LRec.Reset;
            LRec.SetLoadFields("Loan No.", "Outstanding Principal");
            LRec.SetRange("Loan No.", Loans."Loan No.");
            LRec.SetFilter("Outstanding Principal", '>0');
            if LRec.FindFirst then begin

                if Loans."Last Int. Due Date" < CalcDate('-CM', PDate) then begin

                    if SaccoSetup."Loan Interest Date" = SaccoSetup."loan interest date"::"Loan Anniversary" then begin

                        IntDueDate := GetLoanRePaymentDate(Loans, BillDate) + 1;

                        if IntDueDate = BillDate then// changed abit
                            GenerateMobileLoanMonthlyInterest(Loans."Loan No.", BillDate, PDate, true);
                    end
                    else begin
                        GenerateMobileLoanMonthlyInterest(Loans."Loan No.", BillDate, PDate, true);
                    end;
                end;
            end;

        end;
    end;

    procedure CustomeReverseProcess(ReversalH: Record "Reversal Header")
    var
        CheckoffLines: Record "Monthly Checkoff Lines";
        RunBal: Decimal;
        LineNo: Integer;
        SavingsAccounts: Record "Savings Accounts";
        Members: Record Members;
        UserSetup: Record "User Setup";
        Mdays: Integer;
        dWindow: Dialog;
        CurrentRecordNo: Integer;
        NoOfRecords: Integer;
        BNo: Code[20];
        GL: Record "G/L Entry";
        GLRegister: Record "G/L Register";
        Custom: Record "Reversal Entry";
        SLedger: Record "Savings Ledger Entry";
        CreditLedger: Record "Credit Ledger Entry";
        BLedger: Record "Bank Account Ledger Entry";
        GLEntry: Record "G/L Entry";

    begin

        if not Confirm('Are you ABSOLUTELY sure you want to Reverse this Entriers?') then
            Error('ABORTED');

        dWindow.Open('Reversing Lines:                   #1#########\'
                        + 'Accounts:             #2#########\'
                        + 'Counter:              #3#########\'
                        + 'Progress:             @4@@@@@@@@@\'
                        + 'Press Esc to abort');

        CurrentRecordNo := 0;
        NoOfRecords := ReversalH.Count;
        dWindow.Update(2, NoOfRecords);

        if ReversalH."Account Type" = ReversalH."Account Type"::Account then begin
            SLedger.SetRange("Account No.", ReversalH."Account No");
            SLedger.SetRange("Document No.", ReversalH."Document No.");
            SLedger.SetRange("Posting Date", ReversalH."Date Posted");
            SLedger.SetRange("Reversed", false);
            if SLedger.FindFirst then begin

                GLRegister.Reset;
                GLRegister.SetFilter("From Entry No.", '<=%1', SLedger."Entry No.");
                GLRegister.SetFilter("To Entry No.", '>=%1', SLedger."Entry No.");
                if GLRegister.FindFirst then begin
                    GLEntry.Reset();
                    GLEntry.SetRange("Document No.", SLedger."Document No.");
                    GLEntry.SetRange("Posting Date", SLedger."Posting Date");
                    if GLEntry.FindFirst() then begin
                        Custom.ReverseRegister(GLRegister."No.");
                        //Custom.ReverseTransaction(GLEntry."Transaction No.");
                    end;
                end;
            end;
        end else
            if ReversalH."Account Type" = ReversalH."Account Type"::Bank then begin

                BLedger.SetRange("Bank Account No.", ReversalH."Account No");
                BLedger.SetRange("Document No.", ReversalH."Document No.");
                BLedger.SetRange("Posting Date", ReversalH."Date Posted");
                BLedger.SetRange("Reversed", false);
                if BLedger.FindFirst then begin

                    GLRegister.Reset;
                    GLRegister.SetFilter("From Entry No.", '<=%1', BLedger."Entry No.");
                    GLRegister.SetFilter("To Entry No.", '>=%1', BLedger."Entry No.");
                    if GLRegister.FindFirst then begin
                        GLEntry.Reset();
                        GLEntry.SetRange("Document No.", BLedger."Document No.");
                        GLEntry.SetRange("Posting Date", BLedger."Posting Date");
                        if GLEntry.FindFirst() then begin
                            Custom.ReverseRegister(GLRegister."No.");
                            //Custom.ReverseTransaction(GLEntry."Transaction No.");
                        end;
                    end;
                end;
            end;

        dWindow.Update(3, CurrentRecordNo);
        dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));
        dWindow.Close;
    end;

    procedure RecoverSTOLoans(MemberNo: Code[30]; RunBal: Decimal; Acc: Code[20])
    var
        j: Integer;
        LedgerFee: Decimal;
        Interest: Decimal;
        CreditLedger: Record "Credit Ledger Entry";
        LRepayment: Decimal;
        ProductType: Record "Product Setup";
        Penalty: Decimal;
        Amt: Decimal;
        Appraisal: Decimal;
        AppraisalPaid: Decimal;
        TotalAppraisal: Decimal;
        InterestPaid: Decimal;
        TotalInterest: Decimal;
        LRec: Record Loans;
        PrPaid: Decimal;
        AcctType: Enum "Gen. Journal Account Type";
        BalAcctType: Enum "Gen. Journal Account Type";
        TransType: Enum "Transaction Type Enum";
        InterestArrears: Decimal;
        PrincipalArrears: Decimal;
        MonthlyBalance: Decimal;
        Desc: Text[50];
        PDate: Date;
        DocNo: Code[20];
        ExtDocNo: Code[20];
        ExpectedBal: Decimal;
        CurrentBal: Decimal;
        DaysInArrear: integer;
        ArrearsDate: Date;
        DimSetID: Integer;
        DedAmt: decimal;
        LSchedule: Record "Loan Repayment Schedule";
        TChannel: Enum "Transaction Channel";
        Memb: Record Members;
        SavingsAccounts: Record "Savings Accounts";
        GracePeriod: DateFormula;
    begin
        GetPaymentJournalTemplate(JTemplate, JBatch);
        JournalInit(Jtemplate, Jbatch);
        for j := 1 to 3 do begin

            Loans.Reset;
            Loans.SetCurrentKey("Disbursement Date");
            Loans.SetRange("Loan Product Type", 'L05');
            Loans.SetRange("Repay Mode", Loans."Repay Mode"::"Internal Standing Order");
            Loans.SetRange(Loans."Member No.", MemberNo);
            Loans.SetFilter("Disbursement Date", '<>%1', 0D);
            if j = 1 then
                Loans.SetFilter("Outstanding Interest", '>0')
            else
                if j = 2 then begin
                    Loans.SetFilter("Outstanding Principal", '>0');
                end
                else if j = 3 then begin
                    Loans.SetFilter("Outstanding Principal", '>0');
                end
                else
                    Error('Invalid Code - Programming Error');

            if Loans.Find('-') then begin
                repeat

                    //RunBal := 0;
                    if Today >= calcdate('+30D', Loans."Disbursement Date") then begin
                        DedAmt := 0;
                        ExpectedBal := 0;
                        CurrentBal := 0;
                        DaysInArrear := 0;
                        ArrearsDate := 0D;
                        PDate := today();
                        DocNo := 'STO ' + FORMAT(PDate, 0, '<Month Text>');

                        SavingsAccounts.get(Acc);
                        ProductType.Get(Loans."Loan Product Type");


                        if RunBal > 0 then begin


                            if j = 1 then begin
                                Loans.CalcFields("Outstanding Interest");

                                if Loans."Outstanding Interest" < 0 then
                                    Loans."Outstanding Interest" := 0;

                                DedAmt := Loans."Outstanding Interest" - GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Interest Paid");

                                if DedAmt > 0 then
                                    DedAmt -= SaccoActivities.GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Interest Paid");

                                if DedAmt > Loans."Outstanding Interest" then
                                    DedAmt := Loans."Outstanding Interest";


                                Desc := 'Interest Recovery Standing Order';
                                TransType := TransType::"Interest Paid";
                            end;

                            if j = 2 then begin

                                Loans.CalcFields("Outstanding Principal");

                                if Loans."Outstanding Principal" < 0 then
                                    Loans."Outstanding Principal" := 0;

                                PrincipalArrears := 0;
                                SaccoActivities.GetDefaultedAmount(Loans."Loan No.", PDate, ExpectedBal, CurrentBal, PrincipalArrears, DaysInArrear, ArrearsDate, true, GracePeriod);

                                if PrincipalArrears > 0 then
                                    PrincipalArrears -= SaccoActivities.GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");

                                if PrincipalArrears < 0 then
                                    PrincipalArrears := 0;

                                DedAmt := PrincipalArrears;

                                Loans."Outstanding Principal" -= GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");

                                if DedAmt > Loans."Outstanding Principal" then
                                    DedAmt := Loans."Outstanding Principal";


                                Desc := 'Principal Arrears: Recovery Standing Order';
                                TransType := TransType::"Principal Repayment";

                            end;

                            if j = 3 then begin

                                Loans.CalcFields("Outstanding Principal");
                                DedAmt := 0;

                                /* if Loans."Interest Calculation Method" = Loans."Interest Calculation Method"::Amortised then begin
                                    Loans.CalcFields(Loans."Outstanding Interest");
                                    if Loans."Outstanding Interest" < 0 then
                                        Loans."Outstanding Interest" := 0;

                                    DedAmt := Loans.Repayment - Loans."Outstanding Interest";

                                end
                                else
                                    DedAmt := Loans."Loan Principle Repayment"; */


                                /*
                                LSchedule.reset;
                                LSchedule.SetRange("Loan No.", Loans."Loan No.");
                                LSchedule.SetFilter("Repayment Date", '..%1', PDate);
                                if LSchedule.FindLast() then begin
                                    DedAmt := LSchedule."Monthly Principal";
                                    if Loans."Outstanding Principal" <= LSchedule."Loan Balance" then
                                        DedAmt := 0;
                                end;

                                if Loans."Outstanding Principal" < 0 then
                                    Loans."Outstanding Principal" := 0;


                                if DedAmt > 0 then
                                    DedAmt := Loans."Outstanding Principal" - SaccoActivities.GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");

                                if DedAmt < 0 then
                                    DedAmt := 0;


                                if DedAmt > Loans."Outstanding Principal" then
                                    DedAmt := Loans."Outstanding Principal";


                                Desc := 'Principal Recovery';
                                TransType := TransType::"Principal Repayment";
                                */

                            end;

                            if DedAmt > 0 then begin

                                if DedAmt > RunBal then
                                    DedAmt := RunBal;

                                SaccoActivities.JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Desc, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                RunBal -= DedAmt;


                                if SavingsAccounts."No." <> '' then begin
                                    SaccoActivities.JournalInsert(Jtemplate, Jbatch, DocNo, PDate, BalAcctType::Savings, SavingsAccounts."No.", copystr(Loans."Loan No." + ': ' + Desc, 1, 100),
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                end;
                            end;

                        end;
                    end;

                until Loans.Next = 0;

            end;
        end;
        JournalPost(Jtemplate, JBatch);
    end;

