    procedure InterAccountTransfer(Jtemplate: Code[20]; JBatch: Code[20]; DocNo: Code[20]; PDate: Date; DebitAcctType: Enum "Gen. Journal Account Type"; DebitAcctNo: Code[20];
                                                                                                                           Desc: Text[150];
                                                                                                                           CreditAcctType: Enum "Gen. Journal Account Type";
                                                                                                                           CreditAcctNo: Code[20];
                                                                                                                           Amt: Decimal;
                                                                                                                           ExtDocNo: Code[20];
                                                                                                                           Loan: Code[20];
                                                                                                                           TransType: Enum "Transaction Type Enum";
                                                                                                                           Dim1: Code[20];
                                                                                                                           Dim2: Code[20];
                                                                                                                           SystemCreated: Boolean)
    var
        LineNo: Integer;
        GenJournalLine: Record "Gen. Journal Line";
    begin

        JournalInit(jtemplate, jbatch);

        GenJournalLine.Reset;
        GenJournalLine.SetRange("Journal Template Name", Jtemplate);
        GenJournalLine.SetRange("Journal Batch Name", JBatch);
        LineNo := GenJournalLine.Count;

        LineNo += 1;

        GenJournalLine.Init;
        GenJournalLine."Journal Template Name" := Jtemplate;
        GenJournalLine."Journal Batch Name" := JBatch;
        GenJournalLine."Line No." := LineNo;
        GenJournalLine."Document No." := DocNo;
        GenJournalLine."Posting Date" := PDate;
        GenJournalLine."Account Type" := DebitAcctType;
        GenJournalLine."Account No." := DebitAcctNo;
        GenJournalLine.Validate(GenJournalLine."Account No.");
        GenJournalLine.Description := CopyStr(Desc, 1, 50);
        GenJournalLine."Bal. Account Type" := BalAcctType::"G/L Account";
        GenJournalLine."Bal. Account No." := '';
        GenJournalLine.Validate(GenJournalLine."Bal. Account No.");
        GenJournalLine.Amount := Amt;
        GenJournalLine.Validate(GenJournalLine.Amount);
        GenJournalLine."External Document No." := ExtDocNo;
        GenJournalLine."Loan No." := Loan;
        GenJournalLine."Transaction Type" := TransType;
        GenJournalLine."Shortcut Dimension 1 Code" := Dim1;
        GenJournalLine."Shortcut Dimension 2 Code" := Dim2;
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 1 Code");
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 2 Code");
        GenJournalLine."System-Created Entry" := SystemCreated;

        //MESSAGE('%1', GenJournalLine);
        //MESSAGE('%1\%2\%3\%4', GenJournalLine."Document No.", GenJournalLine."Account Type", GenJournalLine."Account No.", GenJournalLine.Amount);
        if GenJournalLine.Amount <> 0 then
            GenJournalLine.Insert;


        LineNo += 1;


        GenJournalLine.Init;
        GenJournalLine."Journal Template Name" := Jtemplate;
        GenJournalLine."Journal Batch Name" := JBatch;
        GenJournalLine."Line No." := LineNo;
        GenJournalLine."Document No." := DocNo;
        GenJournalLine."Posting Date" := PDate;
        GenJournalLine."Account Type" := CreditAcctType;
        GenJournalLine."Account No." := CreditAcctNo;
        GenJournalLine.Validate(GenJournalLine."Account No.");
        GenJournalLine.Description := CopyStr(Desc, 1, 50);
        GenJournalLine."Bal. Account Type" := BalAcctType::"G/L Account";
        GenJournalLine."Bal. Account No." := '';
        GenJournalLine.Validate(GenJournalLine."Bal. Account No.");
        GenJournalLine.Amount := -Amt;
        GenJournalLine.Validate(GenJournalLine.Amount);
        GenJournalLine."External Document No." := ExtDocNo;
        GenJournalLine."Loan No." := Loan;
        GenJournalLine."Transaction Type" := TransType;
        GenJournalLine."Shortcut Dimension 1 Code" := Dim1;
        GenJournalLine."Shortcut Dimension 2 Code" := Dim2;
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 1 Code");
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 2 Code");
        GenJournalLine."System-Created Entry" := SystemCreated;

        //MESSAGE('%1', GenJournalLine);
        //MESSAGE('%1\%2\%3\%4', GenJournalLine."Document No.", GenJournalLine."Account Type", GenJournalLine."Account No.", GenJournalLine.Amount);
        if GenJournalLine.Amount <> 0 then
            GenJournalLine.Insert;

        JournalPost(Jtemplate, JBatch);

    end;

    procedure GenerateMemberRepaymentJournalsDirectLoan(Jtemplate: Code[20]; JBatch: Code[20]; DocNo: Code[20]; ExtDocNo: Code[20]; PDate: Date; Desc: Text[100]; DocDate: Date; RunBal: Decimal; MemberNo: Code[20]; LoanNo: Code[20]; BalAccountNo: Code[20]; BalAcctType: Enum "Gen. Journal Account Type"; "Dimension Set ID": Integer; TChannel: Enum "Transaction Channel"; ProcessInstruction: Boolean)
    var
        Instructions: Record "Dividend Instructions";
        ProdSetup: Record "Product Setup";
        Members: Record Members;
        Loans: Record Loans;
        Loans2: Record Loans;
        Savings: Record "Savings Accounts";
        FosaAccount: Record "Savings Accounts";
        AvailAmt: Decimal;
        j: Integer;
        DedAmt: Decimal;
        InterestArrears: Decimal;
        PrincipalArrears: Decimal;
        MonthlyBalance: Decimal;
        DimSetID: Integer;
        ExpectedBal: Decimal;
        CurrentBal: Decimal;
        DaysInArrear: Integer;
        ArrearsDate: Date;
        LSchedule: Record "Loan Repayment Schedule";
        LoanRepaymentDates: Record "Loan Repayment Dates";
        Narration: Text;
        RepayDate: Date;
        OpenBal: Decimal;
        CurrMonthRepayment: Decimal;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        AsAt: Date;
        d: Integer;
        CheckDate: Date;
        DedAmtHeld: Decimal;
        LoanContrib: decimal;
        InsuranceArrears: Decimal;
        GracePeriod: DateFormula;
        LoanType: Record "Product Setup";
        SaccoSetup: Record "Sacco Setup";
        SASRACat: Record "Sasra Categorization";
        SasraReport: report "SASRA Loan Categorization";
    begin
        Narration := '';
        DedAmt := 0;
        LoanContrib := 0;
        DedAmtHeld := 0;
        SaccoSetup.Get();


        //  message('a: %1', RunBal);
        if RunBal > 0 then begin
            if ProcessInstruction then begin
                Instructions.Reset();
                Instructions.SetCurrentKey(Priority);
                Instructions.SetRange("Member No.", MemberNo);
                Instructions.SetRange(Type, Instructions.Type::"Pay Internal Loan");
                if Instructions.FindFirst() then
                    repeat
                        AvailAmt := 0;
                        //Narration := 'Member Instruction';

                        Loans.Reset();
                        if Instructions."Loan No." <> '' then
                            Loans.SetRange("Loan No.", Instructions."Loan No.");
                        Loans.setrange("Member No.", Instructions."Member No.");
                        Loans.SetFilter("Total Outstanding Balance", '>0');
                        if Loans.FindFirst() then begin
                            repeat
                                AvailAmt := Instructions.Amount;

                                if AvailAmt = 0 then
                                    AvailAmt := RunBal;

                                if AvailAmt > RunBal then
                                    AvailAmt := RunBal;

                                LoanType.Get(Loans."Loan Product Type");

                                Loans.CalcFields("Outstanding Principal", "Outstanding Insurance", "Outstanding Interest", "Outstanding Penalty");

                                Loans."Outstanding Penalty" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Penalty Paid");
                                Loans."Outstanding Insurance" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Insurance Paid");
                                Loans."Outstanding Interest" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Interest Paid");
                                Loans."Outstanding Principal" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Principal Repayment");

                                if (Loans."Outstanding Penalty" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Penalty";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;


                                    Narration := LoanType."USSD Product Name" + ' ' + 'Penalty Paid';
                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Penalty Paid",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Penalty Paid",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                                if (Loans."Outstanding Insurance" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Insurance";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;
                                    Narration := LoanType."USSD Product Name" + ' ' + 'Insurance Paid';
                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                                if (Loans."Outstanding Interest" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Interest";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;

                                    Narration := LoanType."USSD Product Name" + ' ' + 'Interest Paid';

                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                                if (Loans."Outstanding Principal" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Principal";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;

                                    Narration := LoanType."USSD Product Name" + ' ' + 'Principal Repayment';

                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                            until Loans.Next() = 0;
                        end;
                    until Instructions.Next() = 0;


                //   message('b: %1', RunBal);
                if RunBal > 0 then begin
                    Instructions.Reset();
                    Instructions.SetCurrentKey(Priority);
                    Instructions.SetRange("Member No.", MemberNo);
                    Instructions.SetRange(Type, Instructions.Type::"Pay Internal Savings");
                    if Instructions.FindFirst() then
                        repeat
                            if RunBal > 0 then begin

                                Savings.Reset();
                                Savings.SetRange("Member No.", Instructions."Member No.");
                                if Instructions."Account No." <> '' then
                                    Savings.SetRange("No.", Instructions."Account No.")
                                else
                                    Savings.SetRange("Product Category", Savings."Product Category"::"Deposit Contribution");
                                if Savings.FindFirst() then begin
                                    TransType := TransType::" ";
                                    AvailAmt := Instructions.Amount;

                                    if AvailAmt = 0 then
                                        AvailAmt := RunBal;

                                    if AvailAmt > RunBal then
                                        AvailAmt := RunBal;

                                    DedAmt := AvailAmt;

                                    if DedAmt > 0 then begin
                                        if Savings."Product Category" = Savings."Product Category"::"Deposit Contribution" then begin
                                            DedAmt += DedAmtHeld;
                                            DedAmtHeld := 0;
                                        end;

                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', -DedAmt,
                                            ExtDocNo, LoanNo, TransType,
                                            '', '', true, TChannel, "Dimension Set ID");

                                        RunBal -= DedAmt;
                                        AvailAmt -= DedAmt;

                                        if BalAccountNo <> '' then
                                            JournalInsert(
                                                JTemplate, JBatch, DocNo, PDate,
                                                BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                                AcctType::"G/L Account", '', DedAmt,
                                                ExtDocNo, LoanNo, TransType,
                                                '', '', true, TChannel, "Dimension Set ID");
                                    end;
                                end;
                            end;
                        until Instructions.Next() = 0;
                end;
            end;
        end;

        //  message('c: %1', RunBal);
        //Extra to loans
        if RunBal > 0 then begin
            Loans.Reset();
            Loans.SetCurrentKey("Disbursement Date");
            Loans.SetAscending("Disbursement Date", true);
            Loans.SetRange("Member No.", MemberNo);
            Loans.SetFilter("Total Outstanding Balance", '>0');
            if Loans.FindSet() then
                repeat

                    DedAmt := 0;
                    ExpectedBal := 0;
                    CurrentBal := 0;
                    DaysInArrear := 0;
                    InsuranceArrears := 0;
                    InterestArrears := 0;
                    LoanType.Get(Loans."Loan Product Type");

                    // 3. PRINCIPAL
                    Loans.CalcFields("Outstanding Principal");

                    DedAmt := 0;

                    if Loans."Outstanding Principal" > 0 then begin

                        DedAmt := Loans."Outstanding Principal";

                        DedAmt :=
                            DedAmt -
                            GetJournalLoanCredits(
                                JTemplate, JBatch,
                                AcctType::Credit,
                                Loans."Loan Account",
                                Loans."Loan No.",
                                TransType::"Principal Repayment");

                        if DedAmt < 0 then
                            DedAmt := 0;

                        if DedAmt > Loans."Outstanding Principal" then
                            DedAmt := Loans."Outstanding Principal";
                    end;

                    if DedAmt > 0 then begin
                        if DedAmt > RunBal then
                            DedAmt := RunBal;

                        Narration := LoanType."USSD Product Name" + ': Loan Repayment';

                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                            AcctType::"G/L Account", '', -DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                            '', '', true, TChannel, "Dimension Set ID");

                        if BalAccountNo <> '' then
                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                AcctType::Savings, '', DedAmt,
                                ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                                '', '', true, TChannel, "Dimension Set ID");

                        RunBal -= DedAmt;
                    end;

                until Loans.Next() = 0;

        end;

    end;

    procedure GenerateMemberRepaymentJournals(Jtemplate: Code[20]; JBatch: Code[20]; DocNo: Code[20]; ExtDocNo: Code[20]; PDate: Date; Desc: Text[100]; DocDate: Date; RunBal: Decimal; MemberNo: Code[20]; LoanNo: Code[20]; BalAccountNo: Code[20]; BalAcctType: Enum "Gen. Journal Account Type"; "Dimension Set ID": Integer; TChannel: Enum "Transaction Channel"; ProcessInstruction: Boolean)
    var
        Instructions: Record "Dividend Instructions";
        ProdSetup: Record "Product Setup";
        Members: Record Members;
        Loans: Record Loans;
        Loans2: Record Loans;
        Savings: Record "Savings Accounts";
        FosaAccount: Record "Savings Accounts";
        AvailAmt: Decimal;
        j: Integer;
        DedAmt: Decimal;
        InterestArrears: Decimal;
        PrincipalArrears: Decimal;
        MonthlyBalance: Decimal;
        DimSetID: Integer;
        ExpectedBal: Decimal;
        CurrentBal: Decimal;
        DaysInArrear: Integer;
        ArrearsDate: Date;
        LSchedule: Record "Loan Repayment Schedule";
        LoanRepaymentDates: Record "Loan Repayment Dates";
        Narration: Text;
        RepayDate: Date;
        OpenBal: Decimal;
        CurrMonthRepayment: Decimal;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        AsAt: Date;
        d: Integer;
        CheckDate: Date;
        DedAmtHeld: Decimal;
        LoanContrib: decimal;
        InsuranceArrears: Decimal;
        GracePeriod: DateFormula;
        LoanType: Record "Product Setup";
        SaccoSetup: Record "Sacco Setup";
        SASRACat: Record "Sasra Categorization";
        SasraReport: report "SASRA Loan Categorization";
    begin
        Narration := '';
        DedAmt := 0;
        LoanContrib := 0;
        DedAmtHeld := 0;
        SaccoSetup.Get();

        Loans.Reset();
        Loans.SetRange("Member No.", MemberNo);
        if LoanNo <> '' then
            Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Outstanding Principal", '>0');
        if Loans.FindFirst() then begin
            Report.Run(Report::"SASRA Loan Categorization", false, false, Loans);
            Commit();
        end;


        //  message('a: %1', RunBal);


        Loans.Reset();
        Loans.SetCurrentKey("Disbursement Date");
        if LoanNo <> '' then
            Loans.SetRange("Loan No.", LoanNo);
        Loans.SetAscending("Disbursement Date", true);
        Loans.SetRange("Member No.", MemberNo);
        Loans.SetFilter("Total Outstanding Balance", '>0');
        if Loans.FindSet() then
            repeat
                LoanType.Get(Loans."Loan Product Type");
                // 1. PENALTY
                Loans.CalcFields("Outstanding Penalty");

                DedAmt := Loans."Outstanding Penalty" -
                    GetJournalLoanCredits(
                        JTemplate, JBatch,
                        AcctType::Credit,
                        Loans."Loan Account",
                        Loans."Loan No.",
                        TransType::"Penalty Paid");

                if DedAmt < 0 then
                    DedAmt := 0;

                if DedAmt > 0 then begin
                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Credit, Loans."Loan Account",
                        CopyStr(LoanType."USSD Product Name" + ': Penalty Repayment', 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, Loans."Loan No.", TransType::"Penalty Paid",
                        '', '', true, TChannel, "Dimension Set ID");

                    RunBal := RunBal - DedAmt;

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo,
                            CopyStr(LoanType."USSD Product Name" + ': Penalty Repayment: ' + Desc, 1, 100),
                            AcctType::Savings, '', DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Penalty Paid",
                            '', '', true, TChannel, "Dimension Set ID");
                end;


                // 2. INSURANCE
                Loans.CalcFields("Outstanding Insurance");

                CheckDate := CalcDate('-CM-1D', Today);

                InsuranceArrears := GetInsuranceArrears(Loans."Loan No.", CheckDate);

                DedAmt := InsuranceArrears -
                    GetJournalLoanCredits(
                        JTemplate, JBatch,
                        AcctType::Credit,
                        Loans."Loan Account",
                        Loans."Loan No.",
                        TransType::"Insurance Paid");

                if DedAmt < 0 then
                    DedAmt := 0;

                if DedAmt > Loans."Outstanding Insurance" then
                    DedAmt := Loans."Outstanding Insurance";

                if DedAmt > 0 then begin
                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Credit, Loans."Loan Account",
                        CopyStr(LoanType."USSD Product Name" + ': Insurance Repayment', 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                        '', '', true, TChannel, "Dimension Set ID");

                    RunBal := RunBal - DedAmt;

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo,
                            CopyStr(LoanType."USSD Product Name" + ': Insurance Repayment', 1, 100),
                            AcctType::Savings, '', DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                            '', '', true, TChannel, "Dimension Set ID");
                end;

                // 3. INTEREST
                Loans.CalcFields("Outstanding Interest");

                CheckDate := CalcDate('-CM-1D', Today);

                InterestArrears := GetInterestArrears(Loans."Loan No.", CheckDate);

                DedAmt := InterestArrears -
                    GetJournalLoanCredits(
                        JTemplate, JBatch,
                        AcctType::Credit,
                        Loans."Loan Account",
                        Loans."Loan No.",
                        TransType::"Interest Paid");

                if DedAmt < 0 then
                    DedAmt := 0;

                if DedAmt > Loans."Outstanding Interest" then
                    DedAmt := Loans."Outstanding Interest";

                if DedAmt > 0 then begin
                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Credit, Loans."Loan Account",
                        CopyStr(LoanType."USSD Product Name" + ': Interest Repayment', 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                        '', '', true, TChannel, "Dimension Set ID");

                    RunBal := RunBal - DedAmt;

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo,
                            CopyStr(LoanType."USSD Product Name" + ': Interest Repayment', 1, 100),
                            AcctType::Savings, '', DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                            '', '', true, TChannel, "Dimension Set ID");
                end;

                //COME BACK
                if RunBal <= 0 then
                    continue;

                CheckDate := CalcDate('-CM-1D', Today);
                // 4. PRINCIPAL
                Loans.CalcFields("Outstanding Principal");

                GetDefaultedAmount(
                    Loans."Loan No.",
                    CheckDate,
                    ExpectedBal,
                    CurrentBal,
                    PrincipalArrears,
                    DaysInArrear,
                    ArrearsDate,
                    true,
                    GracePeriod);

                DedAmt := PrincipalArrears -
                    GetJournalLoanCredits(
                        JTemplate, JBatch,
                        AcctType::Credit,
                        Loans."Loan Account",
                        Loans."Loan No.",
                        TransType::"Principal Repayment");

                if DedAmt < 0 then
                    DedAmt := 0;

                if DedAmt > Loans."Outstanding Principal" then
                    DedAmt := Loans."Outstanding Principal";

                if DedAmt > 0 then begin
                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Credit, Loans."Loan Account",
                        CopyStr(LoanType."USSD Product Name" + ': Principal Repayment', 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                        '', '', true, TChannel, "Dimension Set ID");


                    RunBal := RunBal - DedAmt;

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo,
                            CopyStr(LoanType."USSD Product Name" + ': Principal Repayment', 1, 100),
                            AcctType::Savings, '', DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                            '', '', true, TChannel, "Dimension Set ID");
                end;


            until Loans.Next() = 0;


        //  message('d: %1', RunBal);
        //Deposit Contribution Processing
        if RunBal > 0 then begin
            Savings.Reset();
            Savings.SetRange("Member No.", MemberNo);
            Savings.SetRange("Product Category", Savings."Product Category"::"Deposit Contribution");
            if Savings.FindFirst() and (RunBal > 0) then begin

                //DedAmt := GetMonthlyDepositAmount(Savings."Member No.");
                //if DedAmt <= 0 then
                DedAmt := Savings."Monthly Contribution";

                FosaAccount.Reset();
                FosaAccount.SetRange("No.", Savings."No.");
                FosaAccount.SetRange("Date Filter", CalcDate('-CM', PDate), CalcDate('CM', PDate));
                FosaAccount.SetAutoCalcFields("Balance (LCY)");
                FosaAccount.SetLoadFields("Balance (LCY)");
                if FosaAccount.FindFirst() then begin
                    if FosaAccount."Balance (LCY)" > 0 then
                        DedAmt := DedAmt - FosaAccount."Balance (LCY)";
                end;

                DedAmt -= GetJournalCredits(JTemplate, JBatch, AcctType::Savings, Savings."No.");

                if DedAmt < 0 then
                    DedAmt := 0;

                Narration := CopyStr(
                     StrSubstNo(format(Savings."Product Category")),
                    1,
                    100);

                if DedAmt > RunBal then
                    DedAmt := RunBal;

                if DedAmt > 0 then begin
                    /* JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, '', TransType::" ",
                        '', '', true, TChannel, "Dimension Set ID"); */

                    RunBal -= DedAmt;

                    DedAmtHeld := DedAmt;

                    /* if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                            AcctType::"G/L Account", '', DedAmt,
                            ExtDocNo, '', TransType::" ",
                            '', '', true, TChannel, "Dimension Set ID"); */
                end;
            end;
        end;


        // message('e: %1', RunBal);
        //Holiday savings
        if RunBal > 0 then begin
            Savings.Reset();
            Savings.SetRange("Member No.", MemberNo);
            Savings.SetRange("Product Category", Savings."Product Category"::"Holiday Savings");
            if Savings.FindFirst() and (RunBal > 0) then begin
                DedAmt := Savings."Monthly Contribution";

                if DedAmt < 0 then
                    DedAmt := 0;

                Narration := CopyStr(
                    StrSubstNo(format(Savings."Product Category")),
                    1,
                    100);

                if DedAmt > RunBal then
                    DedAmt := RunBal;

                if DedAmt > 0 then begin
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, '', TransType::" ",
                        '', '', true, TChannel, "Dimension Set ID");

                    RunBal -= DedAmt;

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                            AcctType::"G/L Account", '', DedAmt,
                            ExtDocNo, '', TransType::" ",
                            '', '', true, TChannel, "Dimension Set ID");
                end;
            end;

        end;


        //message('f: %1', RunBal);
        //Junior savings
        if RunBal > 0 then begin

            Savings.Reset();
            Savings.SetRange("Member No.", MemberNo);
            Savings.SetRange("Product Category", Savings."Product Category"::"Junior Savings");
            if Savings.FindFirst() and (RunBal > 0) then begin
                repeat
                    DedAmt := Savings."Monthly Contribution";

                    if DedAmt < 0 then
                        DedAmt := 0;

                    Narration := CopyStr(
                        StrSubstNo(format(Savings."Product Category")),
                        1,
                        100);

                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    if DedAmt > 0 then begin
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                            AcctType::"G/L Account", '', -DedAmt,
                            ExtDocNo, '', TransType::" ",
                            '', '', true, TChannel, "Dimension Set ID");

                        RunBal -= DedAmt;

                        if BalAccountNo <> '' then
                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                BalAcctType, BalAccountNo, CopyStr(Narration + ' ' + Savings."Child Name", 1, 100),
                                AcctType::"G/L Account", '', DedAmt,
                                ExtDocNo, '', TransType::" ",
                                '', '', true, TChannel, "Dimension Set ID");
                    end;
                until Savings.Next() = 0;
            end;

        end;

        // Current Monthly repayment processing based on instruction
        Loans.Reset();
        Loans.SetCurrentKey("Disbursement Date");
        if LoanNo <> '' then
            Loans.SetRange("Loan No.", LoanNo);
        Loans.SetAscending("Disbursement Date", true);
        Loans.SetRange("Member No.", MemberNo);
        Loans.SetFilter("Total Outstanding Balance", '>0');
        if Loans.FindSet() then
            repeat
                /*  if RunBal <= 0 then
                     exit; */

                DedAmt := 0;
                ExpectedBal := 0;
                CurrentBal := 0;
                DaysInArrear := 0;
                InsuranceArrears := 0;
                InterestArrears := 0;

                LoanType.Get(Loans."Loan Product Type");

                // 1. INSURANCE
                Loans.CalcFields("Outstanding Insurance");

                DedAmt := Loans."Outstanding Insurance" - GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Insurance Paid");

                if DedAmt < 0 then
                    DedAmt := 0;

                if DedAmt > 0 then begin
                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    Narration := LoanType."USSD Product Name" + ': Insurance Repayment';

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                        '', '', true, TChannel, "Dimension Set ID");

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                            AcctType::Savings, '', DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                            '', '', true, TChannel, "Dimension Set ID");
                    RunBal -= DedAmt;
                end;

                if RunBal <= 0 then
                    continue;

                // 2. INTEREST
                Loans.CalcFields("Outstanding Interest");

                DedAmt := Loans."Outstanding Interest" -
                    GetJournalLoanCredits(
                        JTemplate, JBatch,
                        AcctType::Credit,
                        Loans."Loan Account",
                        Loans."Loan No.",
                        TransType::"Interest Paid");

                if DedAmt < 0 then
                    DedAmt := 0;

                if DedAmt > 0 then begin
                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    Narration := LoanType."USSD Product Name" + ': Interest Repayment';

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                        '', '', true, TChannel, "Dimension Set ID");

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                            AcctType::Savings, '', DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                            '', '', true, TChannel, "Dimension Set ID");
                    RunBal -= DedAmt;
                end;

                /*  if RunBal <= 0 then
                     continue; */

                // 3. PRINCIPAL
                Loans.CalcFields("Outstanding Principal");

                DedAmt := 0;

                if Loans."Outstanding Principal" > 0 then begin
                    DedAmt := Loans."Loan Principle Repayment";

                    LSchedule.Reset();
                    LSchedule.SetRange("Loan No.", Loans."Loan No.");
                    LSchedule.SetFilter("Repayment Date", '..%1', CalcDate('CM', Today));
                    if LSchedule.FindLast() then begin
                        DedAmt := Loans."Outstanding Principal" - LSchedule."Loan Balance";
                        if DedAmt < 0 then
                            DedAmt := 0;
                    end
                    else
                        DedAmt := Loans."Loan Principle Repayment";

                    DedAmt :=
                        DedAmt -
                        GetJournalLoanCredits(
                            JTemplate, JBatch,
                            AcctType::Credit,
                            Loans."Loan Account",
                            Loans."Loan No.",
                            TransType::"Principal Repayment");

                    if DedAmt < 0 then
                        DedAmt := 0;

                    if DedAmt > Loans."Outstanding Principal" then
                        DedAmt := Loans."Outstanding Principal";
                end;

                if DedAmt > 0 then begin
                    if DedAmt > RunBal then
                        DedAmt := RunBal;

                    Narration := LoanType."USSD Product Name" + ' : Loan Repayment';

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                        '', '', true, TChannel, "Dimension Set ID");

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                            AcctType::Savings, '', DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                            '', '', true, TChannel, "Dimension Set ID");

                    RunBal -= DedAmt;
                end;


            until Loans.Next() = 0;


        // message('g: %1', RunBal);
        if RunBal > 0 then begin
            if ProcessInstruction then begin
                Instructions.Reset();
                Instructions.SetCurrentKey(Priority);
                Instructions.SetRange("Member No.", MemberNo);
                Instructions.SetRange(Type, Instructions.Type::"Pay Internal Loan");
                if Instructions.FindFirst() then
                    repeat
                        AvailAmt := 0;
                        //Narration := 'Member Instruction';

                        Loans.Reset();
                        if Instructions."Loan No." <> '' then
                            Loans.SetRange("Loan No.", Instructions."Loan No.");
                        Loans.setrange("Member No.", Instructions."Member No.");
                        Loans.SetFilter("Total Outstanding Balance", '>0');
                        if Loans.FindFirst() then begin
                            repeat
                                AvailAmt := Instructions.Amount;

                                if AvailAmt = 0 then
                                    AvailAmt := RunBal;

                                if AvailAmt > RunBal then
                                    AvailAmt := RunBal;

                                LoanType.Get(Loans."Loan Product Type");

                                Loans.CalcFields("Outstanding Principal", "Outstanding Insurance", "Outstanding Interest", "Outstanding Penalty");

                                Loans."Outstanding Penalty" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Penalty Paid");
                                Loans."Outstanding Insurance" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Insurance Paid");
                                Loans."Outstanding Interest" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Interest Paid");
                                Loans."Outstanding Principal" -= GetJournalLoanCredits(JTemplate, JBatch, AcctType::Credit, Loans."Loan Account", Loans."Loan No.", TransType::"Principal Repayment");

                                if (Loans."Outstanding Penalty" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Penalty";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;


                                    Narration := LoanType."USSD Product Name" + ' ' + 'Penalty Paid';
                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Penalty Paid",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Penalty Paid",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                                if (Loans."Outstanding Insurance" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Insurance";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;
                                    Narration := LoanType."USSD Product Name" + ' ' + 'Insurance Paid';
                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Insurance Paid",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                                if (Loans."Outstanding Interest" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Interest";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;

                                    Narration := LoanType."USSD Product Name" + ' ' + 'Interest Paid';

                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Interest Paid",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                                if (Loans."Outstanding Principal" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                    DedAmt := Loans."Outstanding Principal";

                                    if DedAmt > AvailAmt then
                                        DedAmt := AvailAmt;

                                    Narration := LoanType."USSD Product Name" + ' ' + 'Principal Repayment';

                                    JournalInsert(
                                        JTemplate, JBatch, DocNo, PDate,
                                        AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/L Account", '', -DedAmt,
                                        ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                                        '', '', true, TChannel, "Dimension Set ID");

                                    RunBal -= DedAmt;
                                    AvailAmt -= DedAmt;

                                    if BalAccountNo <> '' then
                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', DedAmt,
                                            ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                                            '', '', true, TChannel, "Dimension Set ID");
                                end;

                            until Loans.Next() = 0;
                        end;
                    until Instructions.Next() = 0;


                //  message('h: %1', RunBal);
                if RunBal > 0 then begin
                    Instructions.Reset();
                    Instructions.SetCurrentKey(Priority);
                    Instructions.SetRange("Member No.", MemberNo);
                    Instructions.SetRange(Type, Instructions.Type::"Pay Internal Savings");
                    if Instructions.FindFirst() then
                        repeat
                            if RunBal > 0 then begin

                                Savings.Reset();
                                Savings.SetRange("Member No.", Instructions."Member No.");
                                if Instructions."Account No." <> '' then
                                    Savings.SetRange("No.", Instructions."Account No.")
                                else
                                    Savings.SetRange("Product Category", Savings."Product Category"::"Deposit Contribution");
                                if Savings.FindFirst() then begin
                                    TransType := TransType::" ";
                                    AvailAmt := Instructions.Amount;

                                    if AvailAmt = 0 then
                                        AvailAmt := RunBal;

                                    if AvailAmt > RunBal then
                                        AvailAmt := RunBal;

                                    DedAmt := AvailAmt;

                                    if DedAmt > 0 then begin
                                        if Savings."Product Category" = Savings."Product Category"::"Deposit Contribution" then begin
                                            DedAmtHeld += DedAmt;
                                            DedAmt := 0;
                                        end;

                                        JournalInsert(
                                            JTemplate, JBatch, DocNo, PDate,
                                            AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                                            AcctType::"G/L Account", '', -DedAmt,
                                            ExtDocNo, LoanNo, TransType,
                                            '', '', true, TChannel, "Dimension Set ID");

                                        RunBal -= DedAmt;
                                        AvailAmt -= DedAmt;

                                        if BalAccountNo <> '' then
                                            JournalInsert(
                                                JTemplate, JBatch, DocNo, PDate,
                                                BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                                AcctType::"G/L Account", '', DedAmt,
                                                ExtDocNo, LoanNo, TransType,
                                                '', '', true, TChannel, "Dimension Set ID");
                                    end;
                                end;
                            end;
                        until Instructions.Next() = 0;
                end;
            end;
        end;

        /*
        if DedAmtHeld > 0 then begin
            Savings.Reset();
            Savings.SetRange("Member No.", MemberNo);
            Savings.SetRange("Product Category", Savings."Product Category"::"Deposit Contribution");
            if Savings.FindFirst() then begin

                Narration := CopyStr(
                     StrSubstNo(format(Savings."Product Category")),
                    1,
                    100);

                if DedAmtHeld > 0 then begin
                    JournalInsert(
                       JTemplate, JBatch, DocNo, PDate,
                       AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                       AcctType::"G/L Account", '', -DedAmtHeld,
                       ExtDocNo, '', TransType::" ",
                       '', '', true, TChannel, "Dimension Set ID");

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                            AcctType::"G/L Account", '', DedAmtHeld,
                            ExtDocNo, '', TransType::" ",
                            '', '', true, TChannel, "Dimension Set ID");
                end;
            end;

        end;
        */


        // message('h: %1', RunBal);
        //Extra to loans
        if RunBal > 0 then begin
            Loans.Reset();
            Loans.SetCurrentKey("Disbursement Date");
            Loans.SetAscending("Disbursement Date", true);
            Loans.SetRange("Member No.", MemberNo);
            Loans.SetFilter("Total Outstanding Balance", '>0');
            if Loans.FindSet() then
                repeat

                    DedAmt := 0;
                    ExpectedBal := 0;
                    CurrentBal := 0;
                    DaysInArrear := 0;
                    InsuranceArrears := 0;
                    InterestArrears := 0;
                    LoanType.Get(Loans."Loan Product Type");

                    // 3. PRINCIPAL
                    Loans.CalcFields("Outstanding Principal");

                    DedAmt := 0;

                    if Loans."Outstanding Principal" > 0 then begin

                        DedAmt := Loans."Outstanding Principal";

                        DedAmt :=
                            DedAmt -
                            GetJournalLoanCredits(
                                JTemplate, JBatch,
                                AcctType::Credit,
                                Loans."Loan Account",
                                Loans."Loan No.",
                                TransType::"Principal Repayment");

                        if DedAmt < 0 then
                            DedAmt := 0;

                        if DedAmt > Loans."Outstanding Principal" then
                            DedAmt := Loans."Outstanding Principal";
                    end;

                    if DedAmt > 0 then begin
                        if DedAmt > RunBal then
                            DedAmt := RunBal;

                        Narration := LoanType."USSD Product Name" + ': Loan Repayment';

                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                            AcctType::"G/L Account", '', -DedAmt,
                            ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                            '', '', true, TChannel, "Dimension Set ID");

                        if BalAccountNo <> '' then
                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                                AcctType::Savings, '', DedAmt,
                                ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment",
                                '', '', true, TChannel, "Dimension Set ID");

                        RunBal -= DedAmt;
                    end;

                until Loans.Next() = 0;

        end;
        // Extra amount
        //COME BACK
        RunBal += DedAmtHeld;
        //message('z: %1', RunBal);

        if RunBal > 0 then begin
            Savings.Reset();
            Savings.SetRange("Member No.", MemberNo);
            Savings.SetRange("Product Category", Savings."Product Category"::"Deposit Contribution");
            if Savings.FindFirst() then begin
                DedAmt := RunBal;

                if DedAmt < 0 then
                    DedAmt := 0;

                Narration := CopyStr(
                     StrSubstNo(format(Savings."Product Category")),
                    1,
                    100);

                if DedAmt > RunBal then
                    DedAmt := RunBal;

                if DedAmt > 0 then begin
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                        AcctType::"G/L Account", '', -DedAmt,
                        ExtDocNo, '', TransType::" ",
                        '', '', true, TChannel, "Dimension Set ID");

                    RunBal -= DedAmt;

                    if BalAccountNo <> '' then
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            BalAcctType, BalAccountNo, CopyStr(Narration, 1, 100),
                            AcctType::"G/L Account", '', DedAmt,
                            ExtDocNo, '', TransType::" ",
                            '', '', true, TChannel, "Dimension Set ID");
                end;
            end;
        end;

    end;

    procedure UpdateLoanRepaymentDates(MemberNo: Code[20])
    var
        LoanRepaymentDates: Record "Loan Repayment Dates";
        DaysInArrear: integer;
        ArrearsDate: Date;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        AsAt: date;
        GracePeriod: DateFormula;
    begin
        Loans.Reset();
        Loans.setcurrentkey("Recovery Priority");
        Loans.SetRange("Member No.", MemberNo);
        //Loans.setRange("Mobile Loan", false);
        Loans.SetFilter("Total Outstanding Balance", '>0');
        if Loans.findset() then begin
            repeat

                ExpectedAmt := 0;
                AmtPaid := 0;
                DefAmount := 0;
                DaysInArrear := 0;
                ArrearsDate := 0D;

                LoanRepaymentDates.Reset();
                LoanRepaymentDates.SetRange("Loan No.", Loans."Loan No.");
                if LoanRepaymentDates.FindFirst() then
                    LoanRepaymentDates.Delete();

                GetDefaultedAmount(Loans."Loan No.", CalcDate('-1D', Today), ExpectedAmt, AmtPaid, DefAmount, DaysInArrear, ArrearsDate, true, GracePeriod);

                LoanRepaymentDates.init();
                LoanRepaymentDates."Loan No." := Loans."Loan No.";
                LoanRepaymentDates."Member No." := Loans."Member No.";
                LoanRepaymentDates."Repayment Date" := Loans."Disbursement Date"; //GetLoanRePaymentDate(Loans, Today);
                LoanRepaymentDates."Days in Arrears" := DaysInArrear;
                LoanRepaymentDates.insert();

            until Loans.Next() = 0;
        end;

    end;

