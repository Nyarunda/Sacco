                SalLines.SetRange(SalLines."Salary Header No.", SalHeaD.No);
                SalLines.setrange("Member No.", Members."No.");
                if SalLines.Find('-') then begin
                    MemberFound := true;
                end;
                if SalHeaD.period <> SalHeaD.period::"End Month" then
                    if not MemberFound then
                        Continue := false;



                //Bonus - Income
                if Continue then begin
                    if (SalHeaD."Income Type" <> SalHeaD."income type"::" ") then begin
                        SalHeaD.testfield("Salary Month");
                        //Recover Arrears
                        Loans.Reset;
                        Loans.SetCurrentKey("Disbursement Date");
                        Loans.SetRange(Loans."Member No.", MemberNo);
                        Loans.SetFilter("Loan Product Type", '<>%1&<>%2&<>%3', 'L16', 'L27', 'L29');
                        Loans.SetFilter("Outstanding Principal", '>0');
                        if Loans.Find('-') then begin

                            repeat

                                ProductType.Get(Loans."Loan Product Type");

                                DefAmount := 0;
                                GetDefaultedAmount(Loans."Loan No.", CalcDate('-1M+CM', SalHeaD."Salary Month"), ExpectedAmt, AmtPaid, DefAmount, DaysInArrear, ArrearsDate, true, GracePeriod);
                                //Message('DefAmount %1', DefAmount);

                                if DefAmount > 0 then begin

                                    //Message('D2: %1\%2', SalHeaD."Salary Month", SalHeaD.no);
                                    Interest := GetInterestArrears(Loans."Loan No.", CalcDate('-1M+CM', SalHeaD."Salary Month"));

                                    if Interest > 0 then begin



                                        SalDeductions.init;
                                        SalDeductions."Salary Header No." := SalHead.No;
                                        SalDeductions."Member No." := Members."No.";
                                        SalDeductions."Account No." := Members."No.";
                                        SalDeductions."Account Name" := Members.Name;
                                        SalDeductions.Type := SalDeductions.Type::"Interest Arrears";
                                        SalDeductions."Expected Amount" := Interest;
                                        SalDeductions."Product Type" := Loans."Loan Product Type";
                                        SalDeductions."Loan No." := Loans."Loan No.";
                                        SalDeductions."Document No." := Loans."Loan No.";
                                        SalDeductions."Salary Present" := MemberFound;
                                        SalDeductions.Insert();
                                    end;

                                    if DefAmount > 0 then begin

                                        SalDeductions.init;
                                        SalDeductions."Salary Header No." := SalHead.No;
                                        SalDeductions."Member No." := Members."No.";
                                        SalDeductions."Account No." := Members."No.";
                                        SalDeductions."Account Name" := Members.Name;
                                        SalDeductions.Type := SalDeductions.Type::"Principlal Arrears";
                                        SalDeductions."Expected Amount" := DefAmount;
                                        SalDeductions."Product Type" := Loans."Loan Product Type";
                                        SalDeductions."Loan No." := Loans."Loan No.";
                                        SalDeductions."Document No." := Loans."Loan No.";
                                        SalDeductions."Salary Present" := MemberFound;
                                        SalDeductions.Insert();

                                    end;

                                end


                            until Loans.Next = 0;
                        end;



                        SkipLoans := false;
                        if (Not SalHeaD."Recover Bosa Loans") and (Not SalHeaD."Recover Fosa Loans") then
                            SkipLoans := true;

                        //Recover Tea
                        for j := 1 to 4 do begin


                            //if (not SkipLoans) then begin

                            Loans.Reset;
                            Loans.SetCurrentKey("Disbursement Date");
                            Loans.SetRange(Loans."Member No.", MemberNo);
                            //Loans.Setfilter(Loans."Repayment Start Date", '<=%1', "Salary Month");

                            /* if SalHeaD."Loan Balance Date" <> 0D then begin
                                 Loans.SetFilter("Date Filter", '..%1', SalHeaD."Loan Balance Date");
                             end;*/


                            if j = 1 then
                                Loans.SetFilter("Outstanding Penalty", '>0')
                            else
                                if j = 2 then
                                    Loans.SetFilter("Outstanding Appraisal", '>0')
                                else
                                    if j = 3 then
                                        Loans.SetFilter("Outstanding Interest", '>0')
                                    else
                                        if j = 4 then begin
                                            Loans.SetFilter("Outstanding Principal", '>0');
                                        end
                                        else
                                            Error('Invalid Code - Programming Error');

                            if Loans.Find('-') then begin
                                repeat
                                    SkipLoans := true;
                                    ProductType.Get(Loans."Loan Product Type");


                                    if SalHeaD."Recover Bosa Loans" then
                                        if ProductType."Repay Mode" = ProductType."Repay Mode"::"Check Off" then
                                            SkipLoans := false;

                                    if SalHeaD."Recover Fosa Loans" then
                                        if ProductType."Repay Mode" = SalHeaD."Income Type" then
                                            SkipLoans := false;

                                    if (SalHeaD."Loan Balance Date" <> 0D) and (
                                        not ProductType."Skip Salary Cutoff Date") and
                                        (not SkipLoans) then begin
                                        SalLoan.reset;
                                        SalLoan.SetRange("Loan No.", Loans."Loan No.");
                                        SalLoan.SetFilter("Date Filter", '..%1', SalHeaD."Loan Balance Date");
                                        SalLoan.SetFilter("Outstanding Principal", '>0');
                                        SkipLoans := not SalLoan.FindFirst();
                                    end;

                                    if (Not SkipLoans) then begin
                                        if j = 1 then begin

                                        end
                                        else
                                            if j = 2 then begin

                                            end
                                            else
                                                if j = 3 then begin

                                                    Interest := GetInterestArrears(Loans."Loan No.", SalHeaD."Salary Month");
                                                    Interest -= GetInterestArrears(Loans."Loan No.", CalcDate('-1M+CM', SalHeaD."Salary Month"));

                                                    if Interest > 0 then begin


                                                        SalDeductions.init;
                                                        SalDeductions."Salary Header No." := SalHead.No;
                                                        SalDeductions."Member No." := Members."No.";
                                                        SalDeductions."Account No." := Members."No.";
                                                        SalDeductions."Account Name" := Members.Name;
                                                        SalDeductions.Type := SalDeductions.Type::"Loan Interest";
                                                        SalDeductions."Expected Amount" := Interest;
                                                        SalDeductions."Product Type" := Loans."Loan Product Type";
                                                        SalDeductions."Loan No." := Loans."Loan No.";
                                                        SalDeductions."Document No." := Loans."Loan No.";
                                                        SalDeductions."Salary Present" := MemberFound;
                                                        SalDeductions.Insert();
                                                    end;
                                                end
                                                else
                                                    if j = 4 then begin
                                                        Loans.calcfields("Outstanding Interest");

                                                        LRepayment := Loans."Loan Principle Repayment";

                                                        if Loans."Interest Calculation Method" = Loans."interest calculation method"::Amortised then
                                                            LRepayment := Loans.Repayment - Loans."Outstanding Interest";

                                                        if LRepayment <= 0 then
                                                            LRepayment := Loans.Repayment;


                                                        LRec.Reset;
                                                        LRec.SetRange("Loan No.", Loans."Loan No.");
                                                        LRec.SetFilter("Date Filter", '%1..%2', CalcDate('-CM', SalHeaD."Salary Month"), CalcDate('CM', SalHeaD."Salary Month"));
                                                        if LRec.FindFirst then begin
                                                            LRec.CalcFields("Schedule Principal");
                                                            if LRepayment < LRec."Schedule Principal" then
                                                                LRepayment := LRec."Schedule Principal";
                                                        end;




                                                        if LRepayment <= 0 then
                                                            if Loans.Installments > 0 then
                                                                LRepayment := ROUND(Loans."Approved Amount" / Loans.Installments, 0.01, '>');



                                                        ProductType.Get(Loans."Loan Product Type");
                                                        if ProductType."Default Installments" = 1 then
                                                            LRepayment := Loans."Outstanding Principal";

                                                        if LRepayment > 0 then begin

                                                            SalDeductions.init;
                                                            SalDeductions."Salary Header No." := SalHead.No;
                                                            SalDeductions."Member No." := Members."No.";
                                                            SalDeductions."Account No." := Members."No.";
                                                            SalDeductions."Account Name" := Members.Name;
                                                            SalDeductions.Type := SalDeductions.Type::"Loan Principal";
                                                            SalDeductions."Expected Amount" := LRepayment;
                                                            SalDeductions."Product Type" := Loans."Loan Product Type";
                                                            SalDeductions."Loan No." := Loans."Loan No.";
                                                            SalDeductions."Document No." := Loans."Loan No.";

                                                            SalDeductions."Salary Present" := MemberFound;
                                                            SalDeductions.Insert();

                                                        end;

                                                    end;


                                    end;
                                until Loans.Next = 0;
                            end;
                            //end;

                        end;//For j


                    end;
                    //Bonus - Income

                    STO.Reset();
                    STO.SetRange("Member No.", MemberNo);
                    STO.SetRange("Income Type", SalHeaD."Income Type");
                    STO.setrange(Status, STO.Status::Approved);
                    if STO.FindFirst() then begin
                        repeat
                            STO.CalcFields("Destination Account Type");


                            SalDeductions.init;
                            SalDeductions."Salary Header No." := SalHead.No;
                            SalDeductions."Member No." := Members."No.";
                            SalDeductions."Account No." := STO."Source Account No.";
                            SalDeductions."Account Name" := Members.Name;
                            SalDeductions.Type := SalDeductions.Type::"Internal STO";
                            if STO."Destination Account Type" = STO."Destination Account Type"::External then
                                SalDeductions.Type := SalDeductions.Type::"External STO";
                            SalDeductions."Expected Amount" := STO.Amount;
                            SalDeductions."Product Type" := '';
                            SalDeductions."Loan No." := '';
                            SalDeductions."Document No." := STO.Code;
                            SalDeductions."Salary Present" := MemberFound;
                            SalDeductions.Insert();

                        until STO.next = 0;
                    end;

                end;
                //if not PostLinebyLine then begin
                // dWindow.Update(1, SalLines."Account Name");
                //end;
                //if not PostLinebyLine then begin
                dWindow.Update(3, CurrentRecordNo);
                dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));
            //end;
            until Members.Next = 0;
        end;

        //if not PostLinebyLine then begin
        dWindow.Close;
        //end;

        //TestBatch := IncStr(TestBatch);
        //end;
        Message('Posting Buffer Generated');

    end;

    procedure PostSalaryBuffer(SalHeaD: Record "Salary Header"; PostLinebyLine: Boolean)
    var
        SalLines: Record "Salary Lines";
        SalLine: Record "Salary Lines";
        SalaryPostingBuffer: Record "Salary Posting";
        UserSetup: Record "User Setup";
        Jtemplate: Code[20];
        JBatch: Code[20];
        Text0001: label 'Ensure the Salary  Journal Template is set up in Banking User Setup';
        Text0002: label 'Ensure the Salary Journal Batch is set up in Banking User Setup';
        Text0003: label 'Ensure the Default Bank is set up in User Setup';
        Text0004: label 'The transaction has already been posted.';
        RunBal: Decimal;
        SaccoSetup: Record "Sacco Setup";
        PDate: Date;
        DocNo: Code[20];
        PostingRemarks: Text[50];
        DActivity2: Code[20];
        DBranch2: Code[20];
        Account: Record "Savings Accounts";
        AvailableBal: Decimal;
        ProductSetup: Record "Product Setup";
        SalFee: Decimal;
        SalaryHeader: Record "Salary Header";
        SalGLAccount: Code[20];
        TCharges: Decimal;
        MemberNo: Code[20];
        Salaccno: Code[20];
        Text0005: label 'your salary of Ksh ';
        Text0006: label ' has been credited to your account at ';
        Text0007: label ' on ';
        NetAmount: Decimal;
        IncomeSMSCharge: Decimal;
        SMSSent: Boolean;
        SMSCharges: Record "SMS Charges";
        CurrentRecordNo: Integer;
        NoOfRecords: Integer;
        SavingsACC: Record "Savings Accounts";
        SavAcc: Record "Savings Accounts";
        RegFee: Decimal;
        Memb: Record Members;
        GLEntry: Record "G/L Entry";
        TestBatch: Code[20];
        ChargesLines: Record "Transaction Charges Lines";
        Sky: Codeunit "Sky MBanking";
        CI: Record "Company Information";
    begin

        if SalHeaD.Posted = true then
            Error(Text0004);

        if SalHeaD.Status <> SalHeaD.Status::Approved then
            Error('The document is not fully approved');

        UserSetup.Get(UserId);
        UserSetup.TestField("CashRec Journal Template");
        UserSetup.TestField("CashRec Journal Batch");
        UserSetup.Testfield("Dimension set ID");


        Jtemplate := UserSetup."CashRec Journal Template";
        JBatch := UserSetup."CashRec Journal Batch";

        JournalInit(Jtemplate, JBatch);

        SalHeaD.CalcFields("Total Count", "Scheduled Amount", "Posting Lines Amount");

        RunBal := 0;

        SaccoSetup.Get;
        CI.Get();

        SalHeaD."Posting date" := Today();
        SalHeaD.TestField(Remarks);
        SalHeaD.TestField("Document No");
        SalHeaD.TestField("Posting date");
        SalHeaD.TestField(Amount);

        /*if "Scheduled Amount" <> Amount then
            Error('Scheduled amount and Amount must be the same');


        if "Income Type" <> "Income Type"::"direct debit" THEN
            if "Posting Lines Amount" <> Amount then
                Error('Posting Lines amount and Amount must be the same');
        */
        if SalHeaD."Plough Back Type" = SalHeaD."Plough Back Type"::" " then
            if SalHeaD."Scheduled Amount" <> SalHeaD.Amount then
                Error('Scheduled Amount and Amount must be the same');


        if (SalHeaD."Income Type" <> SalHeaD."Income Type"::"direct debit") and (SalHeaD."Plough Back Type" = SalHeaD."Plough Back Type"::" ") THEN
            if SalHeaD."Posting Lines Amount" <> SalHeaD.Amount then
                Error('Posting Lines Amount and Amount must be the same');

        PDate := SalHeaD."Posting date";
        DocNo := SalHeaD."Document No";
        ExtDocNo := SalHeaD.No;
        PostingRemarks := SalHeaD.Remarks;

        SalLines.Reset;
        SalLines.SetRange(SalLines."Salary Header No.", SalHeaD.No);
        SalLines.SetRange("Batch No.", '');
        SalLines.SetRange(Posted, false);
        SalLines.Setfilter(Amount, '>0');
        if SalLines.Find('-') then begin
            Error('Entries not Batched');
        end;


        IncomeSMSCharge := 0;
        SMSCharges.Reset;
        if SalHeaD."Income Type" = SalHeaD."income type"::Bonus then
            SMSCharges.SetRange(Source, SMSCharges.Source::Bonus)
        else
            if SalHeaD."Income Type" = SalHeaD."income type"::"Mini-Bonus" then
                SMSCharges.SetRange(Source, SMSCharges.Source::"Mini Bonus")
            else
                SMSCharges.SetRange(Source, SMSCharges.Source::"Salary Processing");
        if SMSCharges.FindFirst then begin
            IncomeSMSCharge := SMSCharges."Charge Amount";
        end;


        if SalHeaD."Dont Send SMS" then
            if not Confirm('Are you sure you do not want to send sms?') then
                Error('Aborted');

        TestBatch := '001';



        while TestBatch <= SalHeaD."No. of Batches" do begin

            //if not PostLinebyLine then begin
            dWindow.Open('Generating Journal Lines:      #1#########\'
                                + 'Accounts:             #2#########\'
                                + 'Counter:              #3#########\'
                                + 'Progress:             @4@@@@@@@@@\'
                                + 'Press Esc to abort');

            CurrentRecordNo := 0;
            NoOfRecords := 0;
            //end;

            SalLines.Reset;
            SalLines.SetRange(SalLines."Salary Header No.", SalHeaD.No);
            //SalLines.SETRANGE(SalLines."Account No.",'100-0032875-00');
            SalLines.SetRange("Batch No.", TestBatch);
            SalLines.SetRange(Posted, false);
            SalLines.SetRange("Journal Posted", false);
            if SalLines.Find('-') then begin

                //if not PostLinebyLine then begin
                NoOfRecords := SalLines.Count;
                dWindow.Update(1, TestBatch);
                dWindow.Update(2, NoOfRecords);
                //end;

                if PostLinebyLine then begin
                    JournalInit(Jtemplate, JBatch);
                end;

                repeat

                    //if not PostLinebyLine then begin
                    CurrentRecordNo += 1;
                    //dWindow.Update(1, SalLines."Account Name");
                    //end;
                    if SalLines."Account Not Found" = false then begin


                        MemberNo := '';
                        Salaccno := '';

                        MemberNo := SalLines."Member No.";
                        Salaccno := SalLines."Account No.";


                        if Account.Get(SalLines."Account No.") then begin


                            SavingsACC.Reset;
                            SavingsACC.SetRange("Member No.", Account."Member No.");
                            SavingsACC.SetFilter(Blocked, '<>%1', SavingsACC.Blocked::" ");
                            if SavingsACC.Find('-') then begin
                                repeat
                                    SavingsACC."Test Blocked" := SavingsACC.Blocked;
                                    SavingsACC.Blocked := SavingsACC.Blocked::" ";
                                    SavingsACC.Modify;
                                until SavingsACC.Next = 0;
                            end;


                            if SalLines."Member No." <> '' then begin


                                if not SalHeaD."Dont Send SMS" then begin
                                    SMSSent := false;

                                    if PostLinebyLine then begin
                                        if Memb.Get(Account."Member No.") then begin
                                            MemberActivities.SendSms(Source::"Salary Processing", Memb."Mobile Phone No.", 'Dear ' + sky.FirstName(Memb.Name) + ', ' + Text0005 + Format(SalLines.Amount) + Text0006 + COMPANYNAME
                                            + Text0007 + Format(Today) + ' ' + Format(Time) + '. ' + SalHeaD."Additional SMS" + ' .Incase of inquiries call ' + CI."Phone No.", SalLines."Account No.", SalLines."Account No.", true, false);
                                            SMSSent := true;
                                        end;
                                    end;
                                end;


                                SalaryPostingBuffer.Reset;
                                SalaryPostingBuffer.SetRange("Header No.", SalHeaD.No);
                                SalaryPostingBuffer.SetRange(Posted, false);
                                SalaryPostingBuffer.SetRange("Member No.", SalLines."Member No.");
                                if SalaryPostingBuffer.FindSet(true) then begin

                                    repeat


                                        JournalInsert(
                                            JTemplate,
                                            JBatch,
                                            SalaryPostingBuffer."Document No.",
                                            SalaryPostingBuffer."Posting Date",
                                            SalaryPostingBuffer."Account Type",
                                            SalaryPostingBuffer."Account No.",
                                            SalaryPostingBuffer.Description,
                                            SalaryPostingBuffer."Bal. Account Type",
                                            SalaryPostingBuffer."Bal. Account No.",
                                            SalaryPostingBuffer.Amount,
                                            SalaryPostingBuffer."External Document No.",
                                            SalaryPostingBuffer."Loan No",
                                            SalaryPostingBuffer."Transaction Type",
                                            SalaryPostingBuffer."Shortcut Dimension 1 Code",
                                            SalaryPostingBuffer."Shortcut Dimension 2 Code",
                                            true,
                                            TChannel::Salary,
                                             UserSetup."Dimension set ID"
                                            );


                                        if PostLinebyLine then begin
                                            SalaryPostingBuffer.Posted := true;
                                            SalaryPostingBuffer.Modify;
                                        end;

                                    until SalaryPostingBuffer.Next = 0;


                                end;

                                SalLines."Journal Posted" := true;
                                SalLines.Modify();

                            end;
                        end;

                    end
                    else
                        if SalLines."Account Not Found" = true then begin

                            if PostLinebyLine then
                                JournalInit(Jtemplate, JBatch);

                            JournalInsert(Jtemplate, JBatch, DocNo, PDate, Accttype::Vendor, SalHeaD."Unidentified Account No", CopyStr((SalLines."Account No." + '-' + SalLines.Name), 1, 100),
                                    Balaccttype::"G/L Account", '', -SalLines.Amount, SalLines."Account No.", '', Transtype::" ", DActivity2, DBranch2, true, TChannel::Salary, UserSetup."Dimension set ID");


                            //SalProcessingHeader.GET(SalLines."Salary Header No.");
                            SaccoSetup.TestField("Income Control Account");

                            JournalInsert(Jtemplate, JBatch, DocNo, PDate, Accttype::"G/L Account", SaccoSetup."Income Control Account", PostingRemarks,
                                    Balaccttype::"G/L Account", '', SalLines.Amount, '', '', Transtype::" ", DActivity2, DBranch2, true, TChannel::Salary, UserSetup."Dimension set ID");

                            if PostLinebyLine then begin
                                JournalPost(Jtemplate, JBatch);


                                SalLines.Posted := true;
                                SalLines."Posted By" := UserId;
                                SalLines."Posting Date" := PDate;
                                SalLines."Posting Time" := Time;
                                SalLines.Modify;
                                Commit;//*
                            end;
                        end;

                    //if not PostLinebyLine then begin
                    dWindow.Update(3, CurrentRecordNo);
                    dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));
                //end;
                until SalLines.Next = 0;

                if PostLinebyLine then begin
                    JournalPost(Jtemplate, JBatch);

                    SavingsACC.Reset;
                    SavingsACC.SetRange("Member No.", Account."Member No.");
                    SavingsACC.SetFilter("Test Blocked", '<>%1', SavingsACC."Test Blocked"::" ");
                    if SavingsACC.Find('-') then begin
                        repeat
                            SavingsACC.Blocked := SavingsACC."Test Blocked";
                            SavingsACC."Test Blocked" := SavingsACC."test blocked"::" ";
                            SavingsACC.Modify;
                        until SavingsACC.Next = 0;
                    end;

                    SalLine.reset;
                    SalLine.SetRange("Salary Header No.", SalHeaD.No);
                    SalLine.SetRange("Batch No.", TestBatch);
                    SalLine.SetRange("Journal Posted", true);
                    SalLine.SetRange(Posted, false);
                    if SalLine.FindSet() then
                        repeat
                            //RecoverDefaultedFromSalaryProcessing(SalLine."Member No.", Jtemplate, JBatch, DocNo, PDate);
                            SalLine.Posted := true;
                            SalLine."Posted By" := UserId;
                            SalLine."Posting Date" := PDate;
                            SalLine."Posting Time" := Time;
                            SalLine.Modify;
                            Commit;//*

                        until SalLine.Next = 0;
                end;
            end;

            //if not PostLinebyLine then begin
            dWindow.Close;
            //end;

            TestBatch := IncStr(TestBatch);
        end;

        SalHeaD.posted := true;
        SalHeaD."Posted By" := UserId;
        SalHeaD."Posting date" := Today;
        SalHeaD.Modify();
        Message('The salary batch has been posted successfully');

        if PostLinebyLine then begin

            SalLines.Reset;
            SalLines.SetRange(SalLines."Salary Header No.", SalHeaD.No);
            SalLines.SetRange("Journal Posted", true);
            if SalLines.Find('-') then begin

                SalHeaD.Posted := true;
                SalHeaD."Posted By" := UserId;
                SalHeaD."Posting date" := Today;
                SalHeaD.Modify();
                Message('The salary batch has been posted successfully');

                ///  end;
            end;

            /*
            GLEntry.RESET;
            GLEntry.SETRANGE("Document No.",DocNo);
            GLEntry.SETRANGE("Posting Date",PDate);
            GLEntry.SETRANGE("G/L Account No.",SaccoSetup."Income Control Account");
            GLEntry.SETFILTER(Amount,'>0');
            GLEntry.SETRANGE(Reversed,FALSE);
            IF GLEntry.FINDFIRST THEN BEGIN
                GLEntry.CALCSUMS(Amount);
                MESSAGE('Income Control Account %1 \Income Amount %2',GLEntry.Amount,Amount);
                IF GLEntry.Amount=Amount THEN BEGIN
                    JournalInit(Jtemplate,JBatch);
                    JournalInsert(Jtemplate,JBatch,DocNo,PDate,"Account Type","Account No",PostingRemarks,
                            BalAcctType::"G/L Account",SaccoSetup."Income Control Account",Amount,'','',TransType::" ",DActivity2,DBranch2,TRUE);

                    Posted:=TRUE;
                    "Posted By":=USERID;

                    MODIFY;
                    JournalPost(Jtemplate,JBatch);
                    MESSAGE('The salary batch has been posted successfully');
                END;
            END;
            */
        end
        else
            Message('Template %1\Batch %2', Jtemplate, JBatch);

    end;

    procedure PostSalaryLoanArrears(SalHeaD: Record "Salary Header")
    var
        SalLines: Record "Salary Lines";
        SalaryPostingBuffer: Record "Salary Posting";
        UserSetup: Record "User Setup";
