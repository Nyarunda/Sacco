    procedure GetDepositContribution(AccNo: Code[20]; Class: Text[20]) DepAmt: Decimal;
    var
        Advice: Record "Monthly Checkoff Lines";
        Savings: Record "Savings Accounts";
        ChkHeader: Record "Monthly Checkoff Header";
        Classes: Record "Member Class";
    begin
        DepAmt := 0;
        if Classes.Get(Class) then;
        Savings.Get(AccNo);
        case Savings."Product Category" of

            Savings."Product Category"::"Deposit Contribution":
                DepAmt := Classes."Default Share Deposits";
            Savings."Product Category"::"Share Capital":
                DepAmt := Classes."Default Share Capital";

        end;

        exit(DepAmt);

    end;

    procedure GetLoanPrincipal(Loans: Record Loans; RepDate: Date): Decimal
    var
        d: Integer;
        m: Integer;
        y: Integer;
        EndMonth: Date;
        RepDay: Integer;
        LoanRepaymentSchedule: Record "Loan Repayment Schedule";
    begin

        LoanRepaymentSchedule.Reset;
        LoanRepaymentSchedule.SetRange("Loan No.", Loans."Loan No.");
        LoanRepaymentSchedule.SetRange("Repayment Date", CalcDate('-CM', RepDate), CalcDate('CM', RepDate));
        LoanRepaymentSchedule.SetFilter("Monthly Principal", '>0');
        if LoanRepaymentSchedule.FindFirst then
            exit(LoanRepaymentSchedule."Monthly Principal")
        else begin

            LoanRepaymentSchedule.Reset;
            LoanRepaymentSchedule.SetRange("Loan No.", Loans."Loan No.");
            LoanRepaymentSchedule.SetFilter("Monthly Principal", '>0');
            if LoanRepaymentSchedule.FindFirst then
                exit(LoanRepaymentSchedule."Monthly Principal");
        end;


        if Loans."Loan Principle Repayment" > 0 then
            exit(Loans."Loan Principle Repayment");

        if Loans.Installments > 0 then
            exit(ROUND(Loans."Approved Amount" / Loans.Installments));
    end;

    procedure GetCheckoffInstructions(AccNo: Code[20]; Var MonthlyRepay: Decimal; Source: Option Savings,Credit)
    var
        Instr: Record "Dividend Instructions";
    begin
        Instr.reset();
        Instr.Setrange("Process Type", Instr."Process Type"::"Excess-Checkoff");
        if Source = Source::Savings then
            Instr.Setrange("Account No.", AccNo);
        if Source = Source::Credit then
            Instr.Setrange("Loan No.", AccNo);
        if Instr.findfirst() then
            MonthlyRepay := Instr.Amount;
    end;

    procedure PostOverDraft(Overdraft: Record "Overdraft Header")
    var
        Text0001: label 'Ensure the Overdraft Journal Template is set up in Banking User Setup';
        Text0002: label 'Ensure the Overdraft Journal Batch is set up in Banking User Setup';
        Text0003: label 'Ensure the Default Bank is set up in User Setup';
        Text0004: label 'The transaction has already been posted.';
        LineNo: Integer;
        SaccoSetup: Record "Sacco Setup";
        MemberActivities: Codeunit "Member Activities";
        DimID: Integer;
    begin

        if Overdraft.Posted = true then
            Error(Text0004);

        SaccoSetup.Get;

        JTemplate := '';
        JBatch := '';
        GetPaymentJournalTemplate(JTemplate, JBatch);

        DimID := Overdraft."Dimension Set ID";


        if Overdraft.Status <> Overdraft.Status::Approved then
            Error('You cannot post an application being processed.');

        Overdraft.TestField("Account No.");
        Overdraft.TestField("Effective/Start Date");
        Overdraft.TestField(Duration);
        Overdraft.TestField("Expiry Date");
        Overdraft.TestField("Requested Amount");
        Overdraft.TestField("Approved Amount");


        if not Confirm('Are you sure you want to post this Overdraft?') then
            Error('Aborted');

        JournalInit(JTemplate, JBatch);



        ChargeAmt := 0;
        ChargeDuty := 0;
        ChargeAcct := '';
        MemberActivities.GetGeneralChargeAmount(Overdraft."Transaction Type", Overdraft."Approved Amount", ChargeAmt, ChargeDuty, ChargeAcctType, ChargeAcct);

        JournalInsert(JTemplate, JBatch, Overdraft."No.", Today, Accttype::Savings, Overdraft."Account No.", 'Overdraft Fee',
                ChargeAcctType, ChargeAcct, ChargeAmt, Overdraft."Account No.", '', Transtype::" ", Overdraft."Global Dimension 1 Code", Overdraft."Global Dimension 2 Code", true, TChannel::Overdraft, DimID);

        JournalInsert(JTemplate, JBatch, Overdraft."No.", Today, Accttype::Savings, Overdraft."Account No.", 'Excise Duty on Overdraft Fee',
                Chargeaccttype::"G/L Account", SaccoSetup."Excise Duty GL", ChargeDuty, Overdraft."Account No.", '', Transtype::" ", Overdraft."Global Dimension 1 Code", Overdraft."Global Dimension 2 Code", true, TChannel::Overdraft, DimID);


        Overdraft.Posted := true;
        Overdraft.Modify;

        JournalPost(JTemplate, JBatch);

        Message('Overdraft charges posted successfully.');
    end;

    local procedure ClearOverDraft()
    var
        OverDraft: Record "Overdraft Header";
    begin

        OverDraft.Reset;
        OverDraft.SetRange(Posted, true);
        OverDraft.SetRange(Expired, false);
        OverDraft.SetFilter("Expiry Date", '<>%1', 0D);
        if OverDraft.Find('-') then begin
            repeat
                if OverDraft."Expiry Date" <= Today then begin
                    OverDraft.Expired := true;
                    OverDraft.Modify;
                end;
            until OverDraft.Next = 0;
        end;
    end;

