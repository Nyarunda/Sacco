    procedure GenerateCheckoffCorrection(checkoffHeader: Record "Monthly Checkoff Header")
    var
        CheckoffLines: Record "Monthly Checkoff Lines";
        CheckoffBuffer: Record "Monthly Checkoff Buffer";
        Members: Record Members;
        EntryNo: Integer;
        dWindow: Dialog;
        CurrentRecordNo: Integer;
        NoOfRecords: Integer;
        RunBal: Decimal;
        Loans: Record Loans;
        ExpAmt: Decimal;
        SavAcc: Record "Savings Accounts";
        ProductSetup: Record "Product Setup";
        SaccoSetup: Record "Sacco Setup";
        ArrearsDate: Date;
        DedAmount: Decimal;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        DaysInArrear: Integer;
        AsAt: Date;
        RepayDate: Date;
        Instructions: Record "Dividend Instructions";
        DefAmt: Decimal;
        DaysDef: Integer;
        GracePeriod: DateFormula;
        Setup: Record "User Setup";
    begin




        CheckoffLines.Reset;
        CheckoffLines.SetRange(CheckoffLines."Checkoff Header", CheckoffHeader."No.");
        CheckoffLines.SetRange(CheckoffLines.Posted, true);
        CheckoffLines.SetRange(type, CheckoffLines.type::interest);
        if CheckoffLines.Find('-') then begin

            dWindow.Open('Correcting Checkoff Lines:         #1#########\'
                                    + 'Accounts:             #2#########\'
                                    + 'Counter:              #3#########\'
                                    + 'Progress:             @4@@@@@@@@@\'
                                    + 'Press Esc to abort');

            CurrentRecordNo := 0;
            NoOfRecords := CheckoffLines.Count;
            dWindow.Update(2, NoOfRecords);

            repeat

                CheckoffLines."Expected Interest" := 0;
                CheckoffLines."Principal Arrears" := 0;
                Loans.reset;
                Loans.SetFilter("Loan No.", CheckoffLines."Loan No.");
                Loans.SetFilter("Outstanding Principal", '>0');
                if Loans.FindFirst() then begin


                    Loans.reset;
                    Loans.SetFilter("Loan No.", CheckoffLines."Loan No.");
                    Loans.SetFilter("Date Filter", '..%1', Calcdate('-1M+CM', CheckoffHeader."Posting Date"));
                    if Loans.FindFirst() then begin
                        Loans.calcfields("Outstanding Interest");
                        if Loans."Outstanding Interest" < 0 then
                            Loans."Outstanding Interest" := 0;
                        CheckoffLines."Expected Interest" := Loans."Outstanding Interest";

                    end;

                    CheckoffLines."Interest Variation" := CheckoffLines.Amount - CheckoffLines."Expected Interest";

                    if CheckoffLines."Interest Variation" > 0 then begin

                        DefAmt := 0;

                        GetDefaultedAmount(Loans."Loan No.", CalcDate('CM', CheckoffHeader."Posting Date"), ExpAmt, AmtPaid, DefAmt, DaysDef, ArrearsDate, true, GracePeriod);

                        if DefAmt > 0 then begin

                            Loans.reset;
                            Loans.SetFilter("Loan No.", CheckoffLines."Loan No.");
                            Loans.SetFilter("Outstanding Principal", '>0');
                            if Loans.FindFirst() then begin
                                Loans.CalcFields("Outstanding Principal");
                                if DefAmt > loans."Outstanding Principal" then
                                    DefAmt := loans."Outstanding Principal";


                                CheckoffLines."Principal Arrears" := DefAmt;
                            end;
                        end;
                    end;



                end;






                CheckoffLines.Modify();




                CurrentRecordNo += 1;
                dWindow.Update(3, CurrentRecordNo);
                dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));
            until CheckoffLines.Next = 0;
            dWindow.Close;

        end;


    end;


    procedure GenerateSingleCheckoff(checkoffHeader: Record "Monthly Checkoff Header")
    var
        CheckoffLines: Record "Monthly Checkoff Lines";
        CheckoffBuffer: Record "Monthly Checkoff Buffer";
        Members: Record Members;
        EntryNo: Integer;
        dWindow: Dialog;
        CurrentRecordNo: Integer;
        NoOfRecords: Integer;
        RunBal: Decimal;
        Loans: Record Loans;
        ExpAmt: Decimal;
        ExpPriAmt: Decimal;
        SavAcc: Record "Savings Accounts";
        ProductSetup: Record "Product Setup";
        SaccoSetup: Record "Sacco Setup";
        ArrearsDate: Date;
        DedAmount: Decimal;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        DaysInArrear: Integer;
        AsAt: Date;
        CheckOffCode: Record "Check Off Codes";
        RepayDate: Date;
        GracePeriod: DateFormula;
        LoanRepaymentDates: Record "Loan Repayment Dates";
        LSchedule: Record "Loan repayment Schedule";
        Instructions: Record "Dividend Instructions";
    begin


        SaccoSetup.Get();
        CheckoffBuffer.Reset;
        CheckoffBuffer.SetRange("Checkoff No", checkoffHeader."No.");
        CheckoffBuffer.SetRange("Member Not Found", true);
        if CheckoffBuffer.FindFirst then
            Error('%1 Accounts were not found. Kindly Correct this', CheckoffBuffer.Count);

        CheckoffBuffer.Reset;
        CheckoffBuffer.SetRange("Checkoff No", checkoffHeader."No.");
        CheckoffBuffer.SetRange("Member Not Found", false);
        if CheckoffBuffer.FindFirst then begin

            CheckoffLines.Reset;
            CheckoffLines.SetRange("Checkoff Header", CheckoffBuffer."Checkoff No");
            if CheckoffLines.FindFirst then
                CheckoffLines.DeleteAll;


            dWindow.Open('Generating Check-Off Lines:        #1#########\'
                                     + 'Accounts:             #2#########\'
                                     + 'Counter:              #3#########\'
                                     + 'Progress:             @4@@@@@@@@@\'
                                     + 'Press Esc to abort');



            CurrentRecordNo := 0;
            NoOfRecords := CheckoffBuffer.Count;
            dWindow.Update(2, NoOfRecords);

            repeat
                CurrentRecordNo += 1;

                RunBal := 0;
                SaccoSetup.Get();
                //SaccoSetup.Testfield("Minimum Share Capital");
                //RunBal := CheckoffBuffer."Loan Amount";
                //Members.Get(CheckoffLines."Member No.");
                RunBal := CheckoffBuffer.Amount;


                if CheckoffBuffer."Loan Amount" > 0 then begin

                    RunBal := CheckoffBuffer."Loan Amount";

                    Loans.Reset;
                    Loans.setcurrentkey("Recovery Priority", "Repayment Day");
                    Loans.SetAscending("Repayment Day", true);
                    //Loans.SetRange("Member No.", CheckoffBuffer."Member No.");
                    Loans.SetRange("Loan No.", CheckoffBuffer."Loan No");
                    Loans.SetFilter("Date Filter", '..%1', checkoffHeader."Loan Cut-Off Date");
                    Loans.SetFilter("Total Outstanding Balance", '>0');
                    if Loans.FindFirst then begin
                        //repeat
                        if RunBal > 0 then begin
                            ExpAmt := 0;
                            ExpPriAmt := 0;

                            Loans.CalcFields("Outstanding Interest", "Outstanding Principal");

                            LSchedule.reset;
                            LSchedule.SetRange("Loan No.", Loans."Loan No.");
                            LSchedule.SetFilter("Repayment Date", '..%1', CalcDate('CM', checkoffHeader."Posting Date"));
                            if LSchedule.FindFirst() then begin
                                if Loans."Adjusted Repayment" > 0 then
                                    ExpPriAmt := Loans."Adjusted Repayment" - LSchedule."Monthly Interest";

                                if ExpPriAmt < LSchedule."Monthly Principal" then
                                    ExpPriAmt := LSchedule."Monthly Principal";

                            end else
                                ExpPriAmt := Loans."Loan Principle Repayment";


                            if Loans."Outstanding Principal" < 0 then
                                Loans."Outstanding Principal" := 0;

                            if Loans."Outstanding Interest" < 0 then
                                Loans."Outstanding Interest" := 0;

                            ExpAmt := Loans."Outstanding Interest";

                            if Loans."Mobile Loan" then
                                ExpAmt := Loans."Loan Interest Repayment";

                            if ExpAmt > Loans."Outstanding Interest" then
                                ExpAmt := Loans."Outstanding Interest";

                            if ExpAmt = 0 then
                                ExpAmt := Loans."Outstanding Interest";

                            ExpAmt -= GetCheckoffLineAmounts(CheckoffBuffer."Checkoff No", Loans."Loan No.", CheckoffLines.Type::Interest);

                            //message(format(ExpAmt));

                            if ExpAmt > RunBal then
                                ExpAmt := RunBal;


                            EntryNo += 1;
                            CheckoffLines.Init;
                            CheckoffLines."Entry No" := EntryNo;
                            CheckoffLines.Amount := ExpAmt;
                            CheckoffLines."Account No." := Loans."Member No.";
                            CheckoffLines."Loan No." := Loans."Loan No.";
                            CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                            CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                            CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                            CheckoffLines."Savings Account" := false;
                            CheckoffLines."Credit Account" := true;
                            CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                            CheckoffLines.Name := CheckoffBuffer.Name;
                            CheckoffLines."Product ID" := Loans."Loan Product Type";
                            CheckoffLines.Type := CheckoffLines.Type::Interest;
                            if CheckoffLines.Amount > 0 then
                                CheckoffLines.Insert;
                            RunBal -= ExpAmt;

                            ExpPriAmt -= GetCheckoffLineAmounts(CheckoffBuffer."Checkoff No", Loans."Loan No.", CheckoffLines.Type::Principal);

                            //if ExpPriAmt > RunBal then
                            ExpPriAmt := RunBal;

                            //message(format(ExpAmt));
                            if ExpPriAmt > Loans."Outstanding Principal" then
                                ExpPriAmt := Loans."Outstanding Principal";

                            EntryNo += 1;
                            CheckoffLines.Init;
                            CheckoffLines."Entry No" := EntryNo;
                            CheckoffLines.Amount := ExpPriAmt;
                            CheckoffLines."Account No." := Loans."Member No.";
                            CheckoffLines."Loan No." := Loans."Loan No.";
                            CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                            CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                            CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                            CheckoffLines."Savings Account" := false;
                            CheckoffLines."Credit Account" := true;
                            CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                            CheckoffLines.Name := CheckoffBuffer.Name;
                            CheckoffLines."Product ID" := Loans."Loan Product Type";
                            CheckoffLines.Type := CheckoffLines.Type::Principal;
                            if CheckoffLines.Amount > 0 then
                                CheckoffLines.Insert;
                            RunBal -= ExpPriAmt;

                            if RunBal > 0 then begin
                                SavAcc.Reset;
                                SavAcc.SetRange("Member No.", CheckoffBuffer."Member No.");
                                SavAcc.SetRange("Product Category", SavAcc."product category"::"Unallocated Fund");
                                if SavAcc.FindFirst() then begin

                                    EntryNo += 1;
                                    CheckoffLines.Init;
                                    CheckoffLines."Entry No" := EntryNo;
                                    CheckoffLines.Amount := RunBal;
                                    CheckoffLines."Account No." := SavAcc."No.";
                                    CheckoffLines."Loan No." := '';
                                    CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                                    CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                                    CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                                    CheckoffLines."Savings Account" := true;
                                    CheckoffLines."Credit Account" := false;
                                    CheckoffLines."Excess Amount" := true;
                                    CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                                    CheckoffLines.Name := CheckoffBuffer.Name;
                                    CheckoffLines."Product ID" := SavAcc."Product Type";
                                    if CheckoffLines.Amount > 0 then
                                        CheckoffLines.Insert;

                                    RunBal -= CheckoffLines.Amount;
                                end;

                            end;

                        end;

                    end;
                end;

                //Deposit
                if CheckoffBuffer."Savings Amount" > 0 then begin
                    RunBal := CheckoffBuffer."Savings Amount";

                    SavAcc.Reset;
                    SavAcc.SetRange("No.", CheckoffBuffer."Account No");
                    if SavAcc.FindFirst then begin
                        if RunBal > 0 then begin

                            //ExpAmt := 0;
                            ExpAmt := RunBal;
                            Members.Get(SavAcc."Member No.");

                            ProductSetup.Get(SavAcc."Product Type");

                            if ExpAmt > RunBal then
                                ExpAmt := RunBal;

                            EntryNo += 1;
                            CheckoffLines.Init;
                            CheckoffLines."Entry No" := EntryNo;
                            CheckoffLines.Amount := ExpAmt;
                            CheckoffLines."Account No." := SavAcc."No.";
                            CheckoffLines."Loan No." := '';
                            CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                            CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                            CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                            CheckoffLines."Savings Account" := true;
                            CheckoffLines."Credit Account" := false;
                            CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                            CheckoffLines.Name := CheckoffBuffer.Name;
                            CheckoffLines."Product ID" := SavAcc."Product Type";
                            if CheckoffLines.Amount > 0 then
                                CheckoffLines.Insert;

                            RunBal -= ExpAmt;

                        end;
                    end;
                end;

                if RunBal > 0 then begin

                    Instructions.Reset();
                    Instructions.SetCurrentKey(Priority);
                    Instructions.SetRange("Process Type", Instructions."Process Type"::"Excess-Checkoff");
                    Instructions.SetRange("Member No.", CheckoffBuffer."Member No.");
                    //Instructions.SetFilter("Loan No.", '<>%1', '');
                    if (Instructions.FindFirst()) and (RunBal > 0) then
                        repeat

                            if Instructions."Loan No." <> '' then begin

                                ExpAmt := Instructions.amount;

                                if Instructions.amount = 0 then
                                    ExpAmt := RunBal;

                                if ExpAmt > RunBal then
                                    ExpAmt := Runbal;

                                Loans.Reset();
                                Loans.SetRange(Loans."Loan No.", Instructions."Loan No.");
                                if Loans.FindFirst() then begin
                                    Loans.CalcFields("Outstanding Principal");

                                    Loans."Outstanding Principal" -= GetCheckoffLineAmounts(CheckoffBuffer."Checkoff No", Loans."Loan No.", CheckoffLines.Type::"Principal Arrears")
                                                                    - GetCheckoffLineAmounts(CheckoffBuffer."Checkoff No", Loans."Loan No.", CheckoffLines.Type::Principal);

                                    if ExpAmt > Loans."Outstanding Principal" then
                                        ExpAmt := Loans."Outstanding Principal";

                                    EntryNo += 1;
                                    CheckoffLines.Init;
                                    CheckoffLines."Entry No" := EntryNo;
                                    CheckoffLines.Amount := ExpAmt;
                                    CheckoffLines."Account No." := Loans."Loan Account";
                                    CheckoffLines."Loan No." := Loans."Loan No.";
                                    CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                                    CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                                    CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                                    CheckoffLines."Savings Account" := false;
                                    CheckoffLines."Credit Account" := true;
                                    CheckoffLines."Excess Amount" := false;
                                    CheckoffLines.Type := CheckoffLines.Type::Principal;
                                    CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                                    CheckoffLines.Name := CheckoffBuffer.Name;
                                    CheckoffLines."Product ID" := Loans."Loan Product Type";
                                    if CheckoffLines.Amount > 0 then begin
                                        CheckoffLines.Insert;
                                        RunBal -= ExpAmt;
                                    end
                                end;
                            end;

                            if Instructions."Loan No." = '' then begin
                                SavAcc.Reset;
                                SavAcc.SetRange("No.", Instructions."Account No.");
                                //SavAcc.SetRange("Product Category", SavAcc."product category"::"Deposit Contribution");
                                if SavAcc.FindFirst then begin

                                    ExpAmt := Instructions.amount;

                                    if Instructions.amount = 0 then
                                        ExpAmt := RunBal;

                                    if ExpAmt > RunBal then
                                        ExpAmt := Runbal;

                                    EntryNo += 1;
                                    CheckoffLines.Init;
                                    CheckoffLines."Entry No" := EntryNo;
                                    CheckoffLines.Amount := ExpAmt;
                                    CheckoffLines."Account No." := SavAcc."No.";
                                    CheckoffLines."Loan No." := '';
                                    CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                                    CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                                    CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                                    CheckoffLines."Savings Account" := true;
                                    CheckoffLines."Credit Account" := false;
                                    CheckoffLines."Excess Amount" := false;
                                    CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                                    CheckoffLines.Name := CheckoffBuffer.Name;
                                    CheckoffLines."Product ID" := SavAcc."Product Type";
                                    if CheckoffLines.Amount > 0 then begin
                                        CheckoffLines.Insert;
                                        RunBal -= ExpAmt;
                                    end;

                                end;
                            end;

                        until Instructions.Next() = 0;

                    SavAcc.Reset;
                    SavAcc.SetRange("Member No.", CheckoffBuffer."Member No.");
                    SavAcc.SetRange("Product Category", SavAcc."product category"::"Unallocated Fund");
                    if (SavAcc.FindFirst) and (runbal > 0) then begin

                        EntryNo += 1;
                        CheckoffLines.Init;
                        CheckoffLines."Entry No" := EntryNo;
                        CheckoffLines.Amount := RunBal;
                        CheckoffLines."Account No." := SavAcc."No.";
                        CheckoffLines."Loan No." := '';
                        CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                        CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                        CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                        CheckoffLines."Savings Account" := true;
                        CheckoffLines."Credit Account" := false;
                        CheckoffLines."Excess Amount" := true;
                        CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                        CheckoffLines.Name := CheckoffBuffer.Name;
                        CheckoffLines."Product ID" := SavAcc."Product Type";
                        if CheckoffLines.Amount > 0 then
                            CheckoffLines.Insert;
                    end;

                end;

                dWindow.Update(3, CurrentRecordNo);
                dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));

            until CheckoffBuffer.Next = 0;
            dWindow.Close;
        end;
    end;

