                            TChannel::PV,
                            DocLine."Dimension Set ID"
                            );
                    end;

                    DocLine.TESTFIELD("Board MNo");
                    if DocLine."Withholding Tax" > 0 then
                        InsertP9Record(DocLine."Board MNo", DocLine.Amount - Docline."Housing Levy", Docline."Housing Levy", DocLine."Withholding Tax", PaymentHeader.Date);

                until DocLine.Next = 0;


                PaymentHeader.Posted := true;
                PaymentHeader."Posted By" := UserId;
                PaymentHeader."Date Posted" := Today;
                PaymentHeader."Time Posted" := Time;
                PaymentHeader.Modify;

                JournalPost(JTemplate, JBatch);
                Message('PV Posted Successfully');

            end;
        end;
    end;

    procedure PostSalaryAdvance(Rec: Record "PR Salary Advance")
    Var
        Usetup: Record "User Setup";
        Dim1: Text[50];
        Dim2: Text[50];
        AcctType: Enum "Gen. Journal Account Type";
        BalAcctType: Enum "Gen. Journal Account Type";
        TransType: Enum "Transaction Type Enum";
        TCode: Record "Payroll Codes";
        GLAcc: code[50];
        DimID: Integer;
    begin


        JTemplate := '';
