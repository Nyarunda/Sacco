    procedure ValidateFDLienSecurityOnApproval(LoanNo: Code[20])
    var
        LoanSecurity: Record "Loan Security";
        FixedDeposit: Record "Fixed Deposit Accounts";
        HasLienSecurity: Boolean;
        FDAccountsFound: Integer;
        FDAccountsUpdated: Integer;
    begin
        HasLienSecurity := false;
        FDAccountsFound := 0;
        FDAccountsUpdated := 0;

        // Find all lien securities for this loan
        LoanSecurity.Reset();
        LoanSecurity.SetRange("Loan No.", LoanNo);
        LoanSecurity.SetRange("Guarantor Type", LoanSecurity."Guarantor Type"::Lien);
        LoanSecurity.SetRange("Guaranteed By", LoanSecurity."Guaranteed By"::"Fixed Deposit");

        if LoanSecurity.FindSet() then begin
            HasLienSecurity := true;

            repeat
                // Check if it's a Fixed Deposit
                if FixedDeposit.Get(LoanSecurity."Account No.") then begin
                    FDAccountsFound += 1;

                    // Update if necessary
                    if FixedDeposit."FD Maturity Instructions" <>
                       FixedDeposit."FD Maturity Instructions"::"Renew Both Principal & Interest" then begin

                        FixedDeposit."FD Maturity Instructions" :=
                            FixedDeposit."FD Maturity Instructions"::"Renew Both Principal & Interest";
                        FixedDeposit.Modify(true);

                        FDAccountsUpdated += 1;
                    end;
                end;
            until LoanSecurity.Next() = 0;
        end;

        // Validation messages
        if HasLienSecurity then begin
            if FDAccountsFound = 0 then
                Error('Loan %1 has lien security but no Fixed Deposit accounts were found. ' +
                      'Please verify the lien security setup.', LoanNo)
            else if FDAccountsUpdated > 0 then
                Message('%1 Fixed Deposit account(s) have been set to "Renew Both Principal & Interest" ' +
                        'for loan %2 to secure the lien.', FDAccountsUpdated, LoanNo);
        end;
    end;

