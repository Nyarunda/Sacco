    procedure AutomatedPenaltyRecovery()
    var
        myInt: Integer;
        Loans: Record Loans;
    begin
        SaccoSetup.get();

        if (SaccoSetup."Loan Penalty Next RunDate" <> 0DT) and (SaccoSetup."Loan Penalty Next RunDate" < CurrentDateTime) then begin

            SaccoSetup."Loan Penalty Next RunDate" := CurrentDateTime + 86400000;
            SaccoSetup.Modify();

            Loans.Reset();
            Loans.SetRange(Posted, true);
            Loans.Setfilter("Total Arrears", '>0');
            Loans.SetFilter("Total Outstanding Balance", '>0');
            if Loans.FindSet() then begin
                repeat
                    if GetLoanRePaymentDate(Loans, Today) = Today() then begin
                        GenerateLoanPenalty(Loans."Loan No.", Today(), True)
                    end;
                until Loans.Next() = 0;

            end
        end;
    end;

    procedure GenerateLoanPenalty(LoanNo: Code[20]; PDate: Date; Auto: Boolean)
    var
        Loans: Record Loans;
        PSetup: Record "Product Setup";
        SaccoSetup: Record "Sacco Setup";
        Members: Record Members;
        MonthlyBuffer: Record "Monthly Processes Buffer";
        JTemplate: Code[20];
        JBatch: Code[20];
        DocNo: Code[20];
        AcctType: Enum "Gen. Journal Account Type";
        BalAcctType: Enum "Gen. Journal Account Type";
        AcctNo: Code[20];
        BalAcctNo: Code[20];
        Desc: Text[150];
        ExtDocNo: Code[20];
        TransType: Enum "Transaction Type Enum";
        Dim1: Code[20];
        Dim2: Code[20];
        DimID: Integer;
        ArrearsDate: Date;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        DailyPenalty: Decimal;
        DaysInBillingMonth: Integer;
        BillingDate: Date;
        DaysInArrear: Integer;
        EmptyDateFormula: DateFormula;
        PrincipalAmt: decimal;
        LSchedule: Record "Loan Repayment Schedule";
    begin
        if LoanNo = '' then
            Error('Loan No. cannot be blank.');

        if PDate = 0D then
            PDate := Today;

        SaccoSetup.Get();

        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Outstanding Principal", '>0');
        Loans.SetFilter("Loan Product Type", '<>%1', 'L43');
        if not Loans.FindFirst() then
            exit;

        if not UserSetup.Get(UserId) then
            Error('User Setup does not exist for user %1.', UserId);

        Dim1 := UserSetup."Global Dimension 1 Code";
        Dim2 := UserSetup."Global Dimension 2 Code";

        if Members.Get(Loans."Member No.") then begin
            if Members."Global Dimension 1 Code" <> '' then
                Dim1 := Members."Global Dimension 1 Code";
            if Members."Global Dimension 2 Code" <> '' then
                Dim2 := Members."Global Dimension 2 Code";
        end;

        PrincipalAmt := Loans."Principal Repayment";

        LSchedule.Reset();
        LSchedule.SetRange("Loan No.", Loans."Loan No.");
        Lschedule.SetRange("Repayment Date", calcdate('-CM', Today), calcdate('CM', Today));
        if LSchedule.FindFirst() then
            PrincipalAmt := LSchedule."Monthly Principal";

        PSetup.Get(Loans."Loan Product Type");
        PSetup.TestField("Penalty Percentage");
        PSetup.TestField("Loan Penalty Income [G/L]");

        // Derive billing date: last day of the prior month
        // e.g. PDate = 3rd May → BillingDate = 30th April
        BillingDate := CalcDate('<-1D>', CalcDate('<-CM>', PDate));

        // Days in the billing month (April = 30, January = 31 etc.)
        DaysInBillingMonth := Date2DMY(BillingDate, 1);

        // Get arrears as of billing date (last day of prior month)
        // DaysInArrear is ignored — we generate one day at a time
        GetDefaultedAmount(
            Loans."Loan No.",
            PDate,
            ExpectedAmt,
            AmtPaid,
            DefAmount,
            DaysInArrear,  // returned but not used in formula
            ArrearsDate,
            true,
            EmptyDateFormula
        );

        if DefAmount <= 0 then
            exit;

        if PrincipalAmt > DefAmount then
            PrincipalAmt := DefAmount;

        DailyPenalty := Round(
            (PrincipalAmt * PSetup."Penalty Percentage" / 100),
            0.01, '='
        );

        if DailyPenalty < 1 then
            exit;

        if DailyPenalty <= 0 then
            exit;

        MonthlyBuffer.Reset();
        MonthlyBuffer.SetRange("Loan No.", Loans."Loan No.");
        MonthlyBuffer.SetRange("Posting Date", PDate);
        MonthlyBuffer.SetRange("Transaction Type", MonthlyBuffer."Transaction Type"::"Penalty Due");
        MonthlyBuffer.SetRange(Posted, false);

        if MonthlyBuffer.FindFirst() then
            exit;

        DocNo := Loans."Loan No.";
        AcctType := AcctType::Credit;
        AcctNo := Loans."Loan Account";
        Desc := CopyStr(
            StrSubstNo('Penalty for Loan %1 — %2', Loans."Loan No.", Format(PDate, 0, '<Day,2>/<Month,2>/<Year4>')),
            1, MaxStrLen(Desc)
        );
        TransType := TransType::"Penalty Due";
        BalAcctType := BalAcctType::"G/L Account";
        BalAcctNo := PSetup."Loan Penalty Income [G/L]";
        DimID := Loans."Dimension Set ID";

        InsertToMonthlyBuffer(
            JTemplate,
            JBatch,
            DocNo,
            PDate,
            AcctType,
            AcctNo,
            CopyStr(Desc, 1, 100),
            BalAcctType,
            BalAcctNo,
            DailyPenalty,
            ExtDocNo,
            Loans."Loan No.",
            TransType,
            Dim1,
            Dim2,
            true,
            TChannel::"Penalty Billing",
            DimID
        );
    end;

    procedure InsertToMonthlyBuffer(Jtemplate: Code[20]; JBatch: Code[20]; DocNo: Code[20]; PDate: Date; AcctType: Enum "Gen. Journal Account Type"; AcctNo: Code[20];
                                                                                                                       Desc: Text[100];
                                                                                                                       BalAcctType: Enum "Gen. Journal Account Type";
                                                                                                                       BalAcctNo: Code[20];
                                                                                                                        Amt: Decimal;
                                                                                                                       ExtDocNo: Code[20];
                                                                                                                       Loan: Code[20];
                                                                                                                       TransType: Enum "Transaction Type Enum";
                                                                                                                       Dim1: Code[20];
                                                                                                                       Dim2: Code[20];
                                                                                                                       SystemCreated: Boolean;
                                                                                                                       Channel: Enum "Transaction Channel";
                                                                                                                       DimID: Integer)
    var
        MonthlyBuffer: Record "Monthly Processes Buffer";
        ExistingMonthlyBuffer: Record "Monthly Processes Buffer";
    begin


        MonthlyBuffer.Reset();
        MonthlyBuffer.LockTable();
        MonthlyBuffer.SetCurrentKey("Entry No.");
        //MonthlyBuffer.SetRange("Loan No.", Loan);
        //MonthlyBuffer.SetRange("Date Entered", Today);
        if MonthlyBuffer.FindLast() then
            i := MonthlyBuffer."Entry No." + 1
        else
            i := 1;

        while ExistingMonthlyBuffer.Get(Loan, Today, i) do
            i += 1;

        MonthlyBuffer.Init();
        MonthlyBuffer.JTemplate := Jtemplate;
        MonthlyBuffer.JBatch := JBatch;
        MonthlyBuffer."Entry No." := i;
        MonthlyBuffer."Document No." := DocNo;
        MonthlyBuffer."Posting Date" := PDate;
        MonthlyBuffer."Account Type" := AcctType;
        MonthlyBuffer."Account No" := AcctNo;
        MonthlyBuffer.SetMemberNoFromAccount();
        MonthlyBuffer.Description := Desc;
        MonthlyBuffer."Transaction Type" := TransType;
        MonthlyBuffer."Bal. Account Type" := BalAcctType;
        MonthlyBuffer."Bal. Account No." := BalAcctNo;
        MonthlyBuffer."Amount" := Amt;
        MonthlyBuffer."External Document No." := ExtDocNo;
        MonthlyBuffer.validate("Loan No.", Loan);
        MonthlyBuffer.SetMemberNoFromAccount();
        MonthlyBuffer."Global Dimension 1 Code" := Dim1;
        MonthlyBuffer."Global Dimension 2 Code" := Dim2;
        MonthlyBuffer."Dimension Set ID" := DimID;
        MonthlyBuffer."date entered" := Today;
        if MonthlyBuffer."Amount" <> 0 then
            MonthlyBuffer.Insert();


    end;

    procedure LoanInterestRecovery(LoanNo: Code[20])
    var
        Loans: Record Loans;
        Jtemplate: Code[20];
        JBatch: Code[20];
        DocNo: Code[20];
        PDate: Date;
        AcctType: Enum "Gen. Journal Account Type";
        AcctNo: Code[20];
        Desc: Text[150];
        BalAcctType: Enum "Gen. Journal Account Type";
        BalAcctNo: Code[20];
        Amt: Decimal;
        ExtDocNo: Code[20];
        Loan: Code[20];
        TransType: Enum "Transaction Type Enum";
        Dim1: Code[20];
        Dim2: Code[20];
        SystemCreated: Boolean;
        Channel: Enum "Transaction Channel";
        DimID: Integer;
        ArrearsDate: Date;
        ExpectedAmt: Decimal;
        AmtPaid: decimal;
        DefAmount: decimal;
        PSetup: Record "Product Setup";
        DaysInArrear: Integer;
        GracePeriod: DateFormula;
    begin


        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Outstanding Interest", '>0');
        Loans.SetFilter("Loan Product Type", '<>%1', 'L43');
        if (Loans.FindFirst()) then begin
            repeat
                Clear(Amt);
                Clear(LoanNo);

                PDate := Today;
                DocNo := 'Interest-R ' + FORMAT(DATE2DMY(PDate, 2)) + '-' + FORMAT(DATE2DMY(PDate, 3));
                ArrearsDate := CALCDATE('-1M+CM', today());
                DimID := Loans."Dimension Set ID";
                LoanNo := Loans."Loan No.";

                GetDefaultedAmount(Loans."Loan No.", ArrearsDate, ExpectedAmt, AmtPaid, DefAmount, DaysInArrear, ArrearsDate, False, GracePeriod);

                if DefAmount > 0 then begin


                    GetPaymentJournalTemplate(JTemplate, JBatch);
                    JournalInit(JTemplate, JBatch);

                    Amt := MemberActivities.GetAccountBalance(Legacy.GetDepositAccounts(Loans."Member No."));

                    if Amt > 0 then begin
                        if Amt > DefAmount then begin
                            Amt := DefAmount;

                            AcctNo := Legacy.GetDepositAccounts(Loans."Member No.");
                            AcctType := AcctType::Savings;
                            Desc := 'Interest Recovery for Loan No. ' + Loans."Loan No.";
                            BalAcctType := AcctType::"G/l Account";

                            JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType, AcctNo, Desc, BalAcctType, BalAcctNo, Amt, ExtDocNo, '', TransType::" ", Dim1, Dim2, true, TChannel::Recovery, DimID);

                            AcctType := AcctType::Credit;
                            AcctNo := Loans."Loan Account";
                            TransType := TransType::"Interest Paid";

                            JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType, AcctNo, Desc, BalAcctType, BalAcctNo, -Amt, ExtDocNo, LoanNo, TransType, Dim1, Dim2, true, TChannel::Recovery, DimID);
                        end;
                    end;

                    JournalPost(Jtemplate, JBatch);

                end;
            until Loans.Next() = 0;
        end;
    end;

    procedure GetMonthlyRepayment(MembNo: Code[20]; var Deposit: Decimal; var ShareCapital: Decimal; var GFE: Decimal)
    var
        SavingsAccounts: Record "Savings Accounts";
        ProductSetup: Record "Product Setup";
        LSchedule: Record "Loan Repayment Schedule";
    begin
        SavingsAccounts.reset();
        SavingsAccounts.SetRange("Member No.", MembNo);
        SavingsAccounts.SetFilter("Product Category", '%1|%2|%3',
                        SavingsAccounts."Product Category"::"Deposit Contribution",
                        SavingsAccounts."Product Category"::"Share Capital",
                        SavingsAccounts."Product Category"::"Benevolent Fund");
        SavingsAccounts.SetAutoCalcFields("Balance (LCY)");
        if SavingsAccounts.FindSet() then begin
            repeat
                if SavingsAccounts."Product Category" = SavingsAccounts."Product Category"::"Deposit Contribution" then begin
                    ProductSetup.Get(SavingsAccounts."Product Type");
                    Deposit := SavingsAccounts."Monthly Contribution";
                    if SavingsAccounts."Monthly Contribution" = 0 then
                        Deposit := ProductSetup."Minimum Contribution";

                    LSchedule.Reset();
                    LSchedule.SetRange("Member No.", MembNo);
                    LSchedule.setfilter("Deposit Amount", '>0');
                    if LSchedule.FindFirst() then
                        Deposit := LSchedule."Deposit Amount";
                end;
                if SavingsAccounts."Product Category" = SavingsAccounts."Product Category"::"Share Capital" then begin
                    ProductSetup.Get(SavingsAccounts."Product Type");
                    ShareCapital := SavingsAccounts."Monthly Contribution";
                    if SavingsAccounts."Monthly Contribution" = 0 then
                        ShareCapital := ProductSetup."Minimum Contribution";

                    if SavingsAccounts."Balance (LCY)" >= ProductSetup."Minimum Contribution" then
                        ShareCapital := 0;
                    if (ShareCapital > 0) and ((SavingsAccounts."Balance (LCY)" + ShareCapital) > ProductSetup."Minimum Contribution") then
                        ShareCapital := ProductSetup."Minimum Contribution" - SavingsAccounts."Balance (LCY)";
                end;
                if SavingsAccounts."Product Category" = SavingsAccounts."Product Category"::"Benevolent Fund" then begin
                    ProductSetup.Get(SavingsAccounts."Product Type");
                    GFE := SavingsAccounts."Monthly Contribution";
                    if SavingsAccounts."Monthly Contribution" = 0 then
                        GFE := ProductSetup."Minimum Contribution"
                end;
            until SavingsAccounts.Next() = 0;
        end;
    end;

    procedure GenerateMemberSalaryPostingBufferWithPriority(HeaderNo: Code[20]; DocNo: Code[20]; ExtDocNo: Code[20]; PDate: Date; Desc: Text[50]; DocDate: Date; RunBal: Decimal; MemberNo: Code[20]; LoanNo: Code[20]; BalAccountNo: Code[20]; BalAcctType: Enum "Gen. Journal Account Type"; "Dimension Set ID": integer;
                                                                                                                                                                                                                                                                 TChannel: Enum "Transaction Channel";
                                                                                                                                                                                                                                                                 ProcessInstruction: Boolean)
    var

        Instructions: Record "Dividend Instructions";
        myInt: Integer;
        ProdSetup: Record "Product Setup";
        Members: Record Members;
        Loans: Record Loans;
        Savings: Record "Savings Accounts";
        FosaAccount: Record "Savings Accounts";
        AvailAmt: Decimal;
        j: integer;
        DedAmt: Decimal;
        InterestArrears: Decimal;
        PrincipalArrears: Decimal;
        MonthlyBalance: Decimal;
        DimSetID: Integer;
        ExpectedBal: Decimal;
        CurrentBal: Decimal;
        DaysInArrear: integer;
        ArrearsDate: Date;
        LSchedule: Record "Loan Repayment Schedule";
        Narration: text;
        OpenBal: Decimal;
        SaccoSetup: Record "Sacco Setup";
        AmtPaid: Decimal;
        CurrMonthRepayment: Decimal;
        LoanRepaymentDates: Record "Loan Repayment Dates";
        DateFilter: Text;
        RepayDate: Date;
        GracePeriod: DateFormula;
    begin
        SaccoSetup.get;

        Narration := Desc;

        DedAmt := 0;
        UpdateLoanRepaymentDates(MemberNo);


        //Arrears
        LoanRepaymentDates.Reset();
        LoanRepaymentDates.SetCurrentKey("Days in Arrears");
        LoanRepaymentDates.SetAscending("Days in Arrears", false);
        LoanRepaymentDates.SetRange("Member No.", MemberNo);
        if LoanRepaymentDates.findset() then
            repeat
                Loans.Reset();
                Loans.setcurrentkey("Recovery Priority", "Repayment Day");
                Loans.SetAscending("Repayment Day", true);
                Loans.SetRange("Loan No.", LoanRepaymentDates."Loan No.");
                Loans.setRange("Mobile Loan", false);
                Loans.SetFilter("Total Outstanding Balance", '>0');
                if Loans.FindSet() then begin
                    if RunBal > 0 then begin
                        j := 1;
                        DedAmt := 0;
                        CurrMonthRepayment := 0;
                        DimSetID := "Dimension Set ID";
                        if DimSetID = 0 then
                            DimSetID := Loans."Dimension Set ID";

                        if j = 1 then begin //principal arrears
                            Loans.CalcFields("Outstanding Principal");

                            if Loans."Outstanding Principal" < 0 then
                                Loans."Outstanding Principal" := 0;

                            PrincipalArrears := 0;
                            GetDefaultedAmount(Loans."Loan No.", CalcDate('-1M+CM', PDate), ExpectedBal, CurrentBal, PrincipalArrears, DaysInArrear, ArrearsDate, true, SaccoSetup."Arrears Grace Period");

                            if PrincipalArrears > 0 then
                                PrincipalArrears -= GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");

                            if PrincipalArrears < 0 then
                                PrincipalArrears := 0;
                            DedAmt := PrincipalArrears;

                            if DedAmt > Loans."Outstanding Principal" then
                                DedAmt := Loans."Outstanding Principal";

                            Narration := 'Principal Arrears: ' + Desc;
                            TransType := TransType::"Principal Repayment";

                            if DedAmt > 0 then begin

                                if DedAmt > RunBal then
                                    DedAmt := RunBal;

                                JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                RunBal -= DedAmt;


                                if BalAccountNo <> '' then begin
                                    JournalInsert(Jtemplate, Jbatch, DocNo, PDate, BalAcctType, BalAccountNo, copystr(Loans."Loan No." + ': ' + Narration, 1, 100),
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                end;
                                DedAmt := 0;
                            end;

                            j += 1;
                        end;

                        if j = 2 then begin //Interest arrears
                            Loans.CalcFields("Outstanding Interest");

                            if Loans."Outstanding Interest" < 0 then
                                Loans."Outstanding Interest" := 0;

                            InterestArrears := GetInterestArrears(Loans."Loan No.", CalcDate('-1M+CM', PDate));
                            if InterestArrears > 0 then
                                InterestArrears -= GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Interest Paid");

                            if InterestArrears < 0 then
                                InterestArrears := 0;
                            DedAmt := InterestArrears;

                            if DedAmt > Loans."Outstanding Interest" then
                                DedAmt := Loans."Outstanding Interest";


                            Narration := 'Interest Arrears: ' + Desc;
                            TransType := TransType::"Interest Paid";
                            if DedAmt > 0 then begin

                                if DedAmt > RunBal then
                                    DedAmt := RunBal;

                                JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                RunBal -= DedAmt;


                                if BalAccountNo <> '' then begin
                                    JournalInsert(Jtemplate, Jbatch, DocNo, PDate, BalAcctType, BalAccountNo, copystr(Loans."Loan No." + ': ' + Narration, 1, 100),
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                end;
                                DedAmt := 0;
                                j := 0;
                            end;
                        end;

                    end;
                end;

            until LoanRepaymentDates.Next() = 0;


        LoanRepaymentDates.Reset();
        LoanRepaymentDates.SetCurrentKey("Repayment Date");
        LoanRepaymentDates.SetRange("Member No.", MemberNo);
        if LoanRepaymentDates.findset() then
            repeat

                Loans.Reset();
                Loans.SetRange("Loan No.", LoanRepaymentDates."Loan No.");
                Loans.SetRange("Mobile Loan", false);
                Loans.SetFilter("Total Outstanding Balance", '>0');
                if Loans.FindSet() then begin
                    repeat
                        DimSetID := "Dimension Set ID";
                        if DimSetID = 0 then
                            DimSetID := Loans."Dimension Set ID";

                        j := 1;
                        if RunBal > 0 then begin
                            DedAmt := 0;
                            AmtPaid := 0;

                            if j = 1 then begin
                                j += 1;
                                Loans.CalcFields("Outstanding Penalty");
                                Loans."Outstanding Penalty" -= GetSalaryLoanCredits(HeaderNo, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Penalty Paid");
                                if Loans."Outstanding Penalty" < 0 then
                                    Loans."Outstanding Penalty" := 0;
                                DedAmt := Loans."Outstanding Penalty";
                                Narration := 'Penalty Repayment: ' + Desc;
                                TransType := TransType::"Penalty Paid";


                                if DedAmt > 0 then begin
                                    if DedAmt > RunBal then
                                        DedAmt := RunBal;

                                    DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                    AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', 0, TChannel, DimSetID);
                                    RunBal -= DedAmt;


                                    if BalAccountNo <> '' then begin
                                        DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, copystr(Loans."Loan No." + ': ' + Narration, 1, 100),
                                        AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', 0, TChannel, DimSetID);
                                    end;
                                end;

                            end;

                            if j = 2 then begin
                                j += 1;
                                Loans.CalcFields("Outstanding Principal");

                                Loans."Outstanding Principal" -= GetSalaryLoanCredits(HeaderNo, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");


                                if Loans."Outstanding Principal" > 0 then begin
                                    if Loans."Adjusted Repayment" > 0 then begin

                                        LSchedule.reset;
                                        LSchedule.SetRange("Loan No.", Loans."Loan No.");
                                        LSchedule.SetFilter("Repayment Date", '..%1', CalcDate('CM', PDate));
                                        if LSchedule.FindFirst() then begin
                                            DedAmt := Loans."Adjusted Repayment" - LSchedule."Monthly Interest";
                                            if DedAmt < LSchedule."Monthly Principal" then
                                                DedAmt := LSchedule."Monthly Principal";
                                        end else begin
                                            DedAmt := Loans."Loan Principle Repayment";
                                        end;

                                    end else begin
                                        if Loans."Interest Calculation Method" = Loans."Interest Calculation Method"::Amortised then begin
                                            Loans.CalcFields(Loans."Outstanding Interest");
                                            if Loans."Outstanding Interest" < 0 then
                                                Loans."Outstanding Interest" := 0;

                                            DedAmt := Loans.Repayment - Loans."Outstanding Interest";

                                            LSchedule.reset;
                                            LSchedule.SetRange("Loan No.", Loans."Loan No.");
                                            LSchedule.SetFilter("Repayment Date", '..%1', CalcDate('CM', PDate));
                                            if LSchedule.FindLast() then begin
                                                if DedAmt < LSchedule."Monthly Principal" then
                                                    DedAmt := LSchedule."Monthly Principal";
                                            end;
                                        end
                                        else
                                            DedAmt := Loans."Loan Principle Repayment";


                                        LSchedule.reset;
                                        LSchedule.SetRange("Loan No.", Loans."Loan No.");
                                        LSchedule.SetFilter("Repayment Date", '..%1', CalcDate('CM', PDate));
                                        if LSchedule.FindLast() then begin
                                            CurrMonthRepayment := Loans."Outstanding Principal" - LSchedule."Loan Balance";
                                        end;

                                        if DedAmt > CurrMonthRepayment then
                                            DedAmt := CurrMonthRepayment;
                                    end;

                                    if DedAmt < 0 then
                                        DedAmt := 0;

                                    Narration := 'Principal Repayment: ' + Desc;
                                    TransType := TransType::"Principal Repayment";

                                    if DedAmt > 0 then begin
                                        if DedAmt > RunBal then
                                            DedAmt := RunBal;

                                        DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                        AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', 0, TChannel, DimSetID);
                                        RunBal -= DedAmt;


                                        if BalAccountNo <> '' then begin
                                            DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, copystr(Loans."Loan No." + ': ' + Narration, 1, 100),
                                            AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', 0, TChannel, DimSetID);
                                        end;
                                    end;
                                end
                                else
                                    DedAmt := 0;
                            end;

                            if j = 3 then begin
                                Loans.CalcFields("Outstanding Interest");

                                Loans."Outstanding Interest" -= GetSalaryLoanCredits(HeaderNo, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Interest Paid");
                                if Loans."Outstanding Interest" < 0 then
                                    Loans."Outstanding Interest" := 0;

                                DedAmt := Loans."Outstanding Interest";

                                if DedAmt > 0 then begin
                                    if DedAmt > RunBal then
                                        DedAmt := RunBal;

                                    DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                    AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', 0, TChannel, DimSetID);
                                    RunBal -= DedAmt;


                                    if BalAccountNo <> '' then begin
                                        DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, copystr(Loans."Loan No." + ': ' + Narration, 1, 100),
                                        AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', 0, TChannel, DimSetID);
                                    end;
                                end;

                                Narration := 'Interest Repayment: ' + Desc;
                                TransType := TransType::"Interest Paid";
                            end;
                        end;
                    until Loans.Next = 0;
                end;


            until LoanRepaymentDates.next() = 0;


        ProdSetup.Reset();
        ProdSetup.setcurrentkey("Recovery Priority");
        ProdSetup.SetRange("Product Class", ProdSetup."Product Class"::Savings);
        if ProdSetup.FindFirst() then begin
            repeat
                DedAmt := 0;
                if ProdSetup."Mandatory Contribution" > 0 then
                    DedAmt := ProdSetup."Mandatory Contribution";

                Savings.Reset();
                Savings.SetRange("Member No.", MemberNo);
                Savings.SetRange("Product Type", ProdSetup."Product ID");
                if Savings.FindFirst() then begin
                    repeat
                        DimSetID := "Dimension Set ID";
                        if DimSetID = 0 then
                            DimSetID := Savings."Dimension Set ID";

                        if RunBal > 0 then begin

                            if Savings."Monthly Contribution" > DedAmt then
                                DedAmt := Savings."Monthly Contribution";

                            if DedAmt > 0 then begin
                                //00115385
                                OpenBal := 0;
                                if SaccoSetup."Go Live Date" >= calcdate('-CM', PDate) then begin

                                    if SaccoSetup."Go Live Date" <= calcdate('CM', PDate) then begin

                                        FosaAccount.Reset();
                                        FosaAccount.SetRange("No.", Savings."No.");
                                        FosaAccount.Setfilter("Date Filter", '%1', SaccoSetup."Go Live Date");
                                        if FosaAccount.FindFirst() then begin
                                            FosaAccount.CalcFields("Balance (LCY)");
                                            OpenBal := FosaAccount."Balance (LCY)";
                                        end;
                                    end
                                end;

                                FosaAccount.Reset();
                                FosaAccount.SetRange("No.", Savings."No.");
                                FosaAccount.SetRange("Date Filter", calcdate('-CM', PDate), CalcDate('CM', PDate));
                                FosaAccount.SetAutoCalcFields("Balance (LCY)", "Credit Amount (LCY)");
                                if FosaAccount.FindFirst() then begin
                                    //MonthlyBalance := FosaAccount."Balance (LCY)" - OpenBal;
                                    //DedAmt := DedAmt - MonthlyBalance;
                                    DedAmt := DedAmt - FosaAccount."Credit Amount (LCY)";

                                    if DedAmt < 0 then
                                        DedAmt := 0;
                                end;

                                if ProdSetup."Maximum Balance" > 0 then begin


                                    FosaAccount.Reset();
                                    FosaAccount.SetRange("No.", Savings."No.");
                                    FosaAccount.SetAutoCalcFields("Balance (LCY)");
                                    if FosaAccount.FindFirst() then begin
                                        if DedAmt + FosaAccount."Balance (LCY)" > ProdSetup."Maximum Balance" then begin
                                            DedAmt := ProdSetup."Maximum Balance" - FosaAccount."Balance (LCY)";

                                        end;

                                        if DedAmt < 0 then
                                            DedAmt := 0;
                                    end;
                                end;

                                if Savings."Product Category" = Savings."Product Category"::"Registration Fee" then begin
                                    ProdSetup.TestField("Registration Start Date");
                                    if Members."Registration Date" = 0D then
                                        DedAmt := 0
                                    else begin

                                        if Members."Registration Date" <= ProdSetup."Registration Start Date" then begin
                                            FosaAccount.Reset();
                                            FosaAccount.SetRange("No.", Savings."No.");
                                            if FosaAccount.FindFirst() then begin
                                                FosaAccount.CalcFields("Balance (LCY)");
                                                //if FosaAccount."Balance (LCY)" > 0 then
                                                DedAmt := 0;
                                            end;
                                        end;
                                    end;

                                end;

                                if Savings."Product Category" = Savings."Product Category"::"Share Capital" then begin
                                    ProdSetup.TestField("Registration Start Date");
                                    if Savings."Balance (LCY)" >= SaccoSetup."Minimum Share Capital" then
                                        DedAmt := 0;

                                end;
                            end;


                            if DedAmt > RunBal then
                                DedAmt := RunBal;

                            if DedAmt > 0 then begin

                                //DefAmount -= GetSalaryLoanCredits(SalHeaD.no, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");


                                //SalaryBufferInsert(RunBal, MemberNo, HeaderNo, DocNo, PDate, Accttype::Savings, SalLines."Account No.", ChargesLines.Description,
                                //  Balaccttype::"G/L Account", ChargeAcct, ChargeAmt, ExtDocNo, '', Transtype::" ", DActivity2, DBranch2, EntryType::" ");
                                Narration := 'Paybill';

                                DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Savings, Savings."No.", CopyStr(Savings."Product Name" + ': ' + Narration, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);
                                RunBal -= DedAmt;


                                if BalAccountNo <> '' then begin
                                    DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, copystr(Savings."Product Name" + ': ' + Narration, 1, 100),
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);
                                end;
                            end;

                        end;
                    until Savings.Next = 0;
                end;

            until ProdSetup.next = 0;
        end;

        if RunBal > 0 then begin

            if ProcessInstruction then begin

                //Recover Member Instructions
                Instructions.Reset();
                Instructions.SetCurrentKey(Priority);
                Instructions.SetRange("Process Type", Instructions."Process Type"::"Excess-Receipt");
                Instructions.SetRange("Member No.", MemberNo);
                Instructions.SetFilter("Loan No.", '<>%1', '');
                if (Instructions.FindFirst()) then begin

                    repeat

                        Narration := 'Member Instruction';
                        Loans.Reset();
                        Loans.SetRange(Loans."Loan No.", Instructions."Loan No.");
                        if Loans.FindFirst() then begin
                            AvailAmt := Instructions.Amount;
                            If AvailAmt = 0 then
                                AvailAmt := RunBal;

                            if AvailAmt > RunBal then
                                AvailAmt := RunBal;

                            Loans.CalcFields("Outstanding Principal", "Outstanding Penalty", "Outstanding Interest");

                            Loans."Outstanding Penalty" -= GetSalaryLoanCredits(HeaderNo, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Penalty Paid");
                            Loans."Outstanding Interest" -= GetSalaryLoanCredits(HeaderNo, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"INterest Paid");
                            Loans."Outstanding Principal" -= GetSalaryLoanCredits(HeaderNo, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");

                            if (Loans."Outstanding Penalty" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                DedAmt := Loans."Outstanding Penalty";
                                If DedAmt > AvailAmt then
                                    DedAmt := Availamt;

                                DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType::"Penalty Paid", '', '', 0, TChannel, DimSetID);
                                RunBal -= DedAmt;
                                Availamt -= DedAmt;


                                if BalAccountNo <> '' then begin
                                    DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, Loans."Loan No." + ': ' + Desc,
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', 0, TChannel, DimSetID);
                                end;

                            end;

                            if (Loans."Outstanding Interest" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                DedAmt := Loans."Outstanding Interest";
                                If DedAmt > AvailAmt then
                                    DedAmt := Availamt;


                                DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType::"Interest Paid", '', '', 0, TChannel, DimSetID);
                                RunBal -= DedAmt;
                                Availamt -= DedAmt;


                                if BalAccountNo <> '' then begin
                                    DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, CopyStr(Loans."Loan No." + ': ' + Narration, 1, 100),
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);
                                end;

                            end;

                            if (Loans."Outstanding Principal" > 0) and (AvailAmt > 0) and (RunBal > 0) then begin
                                DedAmt := Loans."Outstanding Principal";
                                If DedAmt > AvailAmt then
                                    DedAmt := Availamt;


                                DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Narration, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType::"Principal Repayment", '', '', 0, TChannel, DimSetID);
                                RunBal -= DedAmt;
                                Availamt -= DedAmt;


                                if BalAccountNo <> '' then begin
                                    DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, CopyStr(Loans."Loan No." + ': ' + Narration, 1, 100),
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);
                                end;

                            end;


                        end;

                    until Instructions.Next() = 0;

                end;



                if RunBal > 0 then begin

                    Instructions.Reset();
                    Instructions.SetCurrentKey(Priority);
                    Instructions.SetRange("Process Type", Instructions."Process Type"::"Excess-Receipt");
                    Instructions.SetRange("Member No.", memberno);
                    Instructions.SetFilter("Loan No.", '=%1', '');
                    Instructions.SetFilter("Account No.", '<>%1', '');
                    //Instructions.SetFilter(Amount, '>0');
                    if (Instructions.FindFirst()) then begin

                        repeat

                            if RunBal > 0 then begin


                                Savings.Reset();
                                Savings.SetRange("No.", Instructions."Account No.");
                                if Savings.FindFirst() then begin

                                    AvailAmt := Instructions.Amount;
                                    If AvailAmt = 0 then
                                        AvailAmt := RunBal;

                                    if AvailAmt > RunBal then
                                        AvailAmt := RunBal;

                                    DedAmt := AvailAmt;
                                    if DedAmt > 0 then begin

                                        DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Savings, Savings."No.", Narration,
                                        AcctType::"G/l Account", '', -DedAmt, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);
                                        RunBal -= DedAmt;
                                        AvailAmt -= DedAmt;


                                        if BalAccountNo <> '' then begin
                                            DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, Narration,
                                            AcctType::"G/l Account", '', DedAmt, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);
                                        end;
                                    end;
                                end;

                            end;
                        until Instructions.Next() = 0;
                    end;
                end;
            end;

        end;

        if runBal > 0 then begin
            Narration := 'Additional: ' + Desc;

            Savings.Reset();
            Savings.SetRange("Member No.", MemberNo);
            Savings.SetFilter(Savings."Product Category", '%1', Savings."Product Category"::"Deposit Contribution");
            if (Savings.FindFirst()) then begin


                DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, AcctType::Savings, Savings."No.", CopyStr(Narration, 1, 100),
                AcctType::"G/l Account", '', -runBal, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);


                if BalAccountNo <> '' then begin
                    DetSalaryBufferInsert(RunBal, memberno, HeaderNo, DocNo, PDate, BalAcctType, BalAccountNo, CopyStr(Savings."Product Name" + ': ' + Narration, 1, 100),
                    AcctType::"G/l Account", '', runBal, ExtDocNo, LoanNo, TransType, '', '', 0, TChannel, DimSetID);
                end;
            end;


        end;
        //error('TEST');


    end;


