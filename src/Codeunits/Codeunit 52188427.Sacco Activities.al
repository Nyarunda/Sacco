                    ProductSetup.SetRange("Product Category", ProductSetup."Product Category"::"Deposit Contribution");
                    if ProductSetup.FindFirst() then
                        MemberActivities.CreateSavingsAccount(ProductSetup, Members, 0, true, ProductSetup."Repay Mode");
                end;
                */

                RunBal := 0;
                CheckoffBuffer.Balance := CheckoffBuffer.Amount;

                if (CheckoffBuffer."Reporting Name" = 'Wanandege Fosa Loans') or (CheckoffBuffer."Reporting Name" = 'Wanandege Bosa Loans') then begin

                    RunBal := CheckoffBuffer.Amount;

                    //if CheckoffBuffer."Loan Not Found" then begin
                    UpdateLoanRepaymentDates(CheckoffBuffer."Member No.");

                    LoanRepaymentDates.Reset();
                    LoanRepaymentDates.SetCurrentKey("Days in Arrears");
                    LoanRepaymentDates.SetAscending("Days in Arrears", false);
                    LoanRepaymentDates.SetRange("Member No.", CheckoffBuffer."Member No.");
                    if LoanRepaymentDates.findset() then
                        repeat

                            Loans.Reset;
                            Loans.SetCurrentKey("Loan No.");
                            Loans.SetRange("Member No.", CheckoffBuffer."Member No.");
                            Loans.SetRange("Loan No.", LoanRepaymentDates."Loan No.");
                            Loans.SetFilter("Total Outstanding Balance", '>0');
                            Loans.SetFilter("Date Filter", '..%1', checkoffHeader."Loan Cut-Off Date");
                            Loans.SetRange("Repay Mode", Loans."Repay Mode"::"Check Off");
                            if CheckoffBuffer."Reporting Name" = 'Wanandege Fosa Loans' then
                                Loans.SetRange(Source, Loans.Source::FOSA);
                            if CheckoffBuffer."Reporting Name" = 'Wanandege Bosa Loans' then
                                Loans.SetRange(Source, Loans.Source::BOSA);
                            if Loans.FindFirst then begin
                                repeat

                                    Loans.CalcFields("Outstanding Interest", "Outstanding Principal");

                                    if RunBal > 0 then begin

                                        /*LSchedule.Reset();
                                        LSchedule.SetRange("Loan No.", Loans."Loan No.");
                                        LSchedule.SetRange("Repayment Date", CalcDate('-CM', Today), CalcDate('CM', Today));
                                        if LSchedule.FindFirst() then
                                            IntAmt := LSchedule."Monthly Interest"
                                        else*/

                                        if Loans."Outstanding Interest" < 0 then
                                            Loans."Outstanding Interest" := 0;

                                        IntAmt := Loans."Outstanding Interest";

                                        if Loans."Mobile Loan" then //due to arreas and billing of full interest for all installements
                                            IntAmt := Loans."Loan Interest Repayment";

                                        if IntAmt > Loans."Outstanding Interest" then
                                            IntAmt := Loans."Outstanding Interest";

                                        if Loans."Outstanding Interest" > IntAmt then
                                            Loans."Outstanding Interest" := IntAmt;

                                        if IntAmt = 0 then
                                            IntAmt := Loans."Outstanding Interest";

                                        if IntAmt > RunBal then
                                            IntAmt := RunBal;

                                        if IntAmt > 0 then begin
                                            EntryNo += 1;
                                            CheckoffLines.Init;
                                            CheckoffLines."Entry No" := EntryNo;
                                            CheckoffLines.Amount := IntAmt;
                                            CheckoffLines."Account No." := Loans."Member No.";
                                            CheckoffLines."Loan No." := Loans."Loan No.";
                                            CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                                            CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                                            CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                                            CheckoffLines."Savings Account" := false;
                                            CheckoffLines."Credit Account" := true;
                                            CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                                            CheckoffLines.Name := CheckoffBuffer.Name;
                                            CheckoffLines."Product ID" := Loans."Loan Product Type";
                                            CheckoffLines.Type := CheckoffLines.Type::Interest;
                                            if CheckoffLines.Amount > 0 then
                                                CheckoffLines.Insert;

                                            RunBal -= IntAmt;
                                            CheckoffBuffer.Balance -= CheckoffLines.Amount;
                                            CheckoffBuffer.Processed := true;
                                        end;
                                    end;

                                    if RunBal > 0 then begin

                                        if Loans."Outstanding Principal" > RunBal then
                                            Loans."Outstanding Principal" := RunBal;

                                        LSchedule.Reset();
                                        LSchedule.SetRange("Loan No.", Loans."Loan No.");
                                        LSchedule.SetRange("Repayment Date", CalcDate('-CM', Today), CalcDate('CM', Today));
                                        if LSchedule.FindFirst() then
                                            RepAmt := LSchedule."Monthly Principal"
                                        else
                                            RepAmt := Loans."Loan Principle Repayment";

                                        RepAmt := Loans.Repayment - IntAmt;
                                        if RepAmt < 0 then
                                            RepAmt := 0;

                                        if RepAmt > Loans."Outstanding Principal" then
                                            RepAmt := Loans."Outstanding Principal";

                                        if RepAmt > 0 then begin
                                            if RepAmt > RunBal then
                                                RepAmt := RunBal;

                                            EntryNo += 1;
                                            CheckoffLines.Init;
                                            CheckoffLines."Entry No" := EntryNo;
                                            CheckoffLines.Amount := RepAmt;
                                            CheckoffLines."Account No." := Loans."Member No.";
                                            CheckoffLines."Loan No." := Loans."Loan No.";
                                            CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                                            CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                                            CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                                            CheckoffLines."Savings Account" := false;
                                            CheckoffLines."Credit Account" := true;
                                            CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                                            CheckoffLines.Name := CheckoffBuffer.Name;
                                            CheckoffLines."Product ID" := Loans."Loan Product Type";
                                            CheckoffLines.Type := CheckoffLines.Type::Principal;
                                            if CheckoffLines.Amount > 0 then
                                                CheckoffLines.Insert;
                                            RunBal -= RepAmt;
                                            CheckoffBuffer.Balance -= CheckoffLines.Amount;
                                            CheckoffBuffer.Processed := true;
                                        end;
                                    end;

                                until Loans.Next() = 0;
                            end;

                        //end;
                        Until LoanRepaymentDates.Next() = 0;
                end;

                if CheckoffBuffer."Reporting Name" = 'Wanandege Deposit Savings' then begin
                    RunBal := CheckoffBuffer.Amount;
                    if RunBal > 0 then begin

                        ProductSetup.Reset();
                        ProductSetup.SetCurrentKey("Recovery Priority");
                        ProductSetup.SetAscending("Recovery Priority", true);
                        ProductSetup.SetFilter("Product Category", '<>%1&<>%2&<>%3',
                                    ProductSetup."Product Category"::"Registration Fee",
                                    ProductSetup."Product Category"::"Share Capital",
                                    ProductSetup."Product Category"::"Unallocated Fund"
                        );
                        ProductSetup.SetRange("Product Class", ProductSetup."Product Class"::Savings);
                        if ProductSetup.findSet() then
                            repeat
                                SavAcc.Reset;
                                SavAcc.SetRange("Member No.", CheckoffBuffer."Member No.");
                                SavAcc.Setrange("Product Type", ProductSetup."Product ID");
                                SavAcc.SetRange("Repay Mode", SavAcc."Repay Mode"::"Check Off");
                                SavAcc.SetFilter("Monthly Contribution", '>0');
                                if SavAcc.FindFirst then begin
                                    repeat

                                        RepAmt := SavAcc."Monthly Contribution";
                                        IF RepAmt > Runbal then
                                            RepAmt := RunBal;

                                        EntryNo += 1;
                                        CheckoffLines.Init;
                                        CheckoffLines."Entry No" := EntryNo;
                                        CheckoffLines.Amount := RepAmt;
                                        CheckoffLines."Account No." := SavAcc."No.";
                                        CheckoffLines."Loan No." := '';
                                        CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                                        CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                                        CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                                        CheckoffLines."Savings Account" := true;
                                        CheckoffLines."Credit Account" := false;
                                        CheckoffLines."Excess Amount" := false;
                                        CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                                        CheckoffLines.Name := CheckoffBuffer.Name;
                                        CheckoffLines."Product ID" := SavAcc."Product Type";
                                        if CheckoffLines.Amount > 0 then
                                            CheckoffLines.Insert;
                                        RunBal -= CheckoffLines.Amount;
                                        CheckoffBuffer.Processed := true;
                                        CheckoffBuffer.Balance -= CheckoffLines.Amount;

                                    until SavAcc.Next() = 0;
                                end;
                            Until ProductSetup.Next() = 0;
                    end;
                end;

                if RunBal > 0 then begin //excess

                    SavAcc.Reset;
                    SavAcc.SetRange("Member No.", CheckoffBuffer."Member No.");
                    SavAcc.SetRange("Product Category", SavAcc."product category"::"Unallocated Fund");
                    if SavAcc.FindFirst then begin

                        EntryNo += 1;
                        CheckoffLines.Init;
                        CheckoffLines."Entry No" := EntryNo;
                        CheckoffLines.Amount := RunBal;
                        CheckoffLines."Account No." := SavAcc."No.";
                        CheckoffLines."Loan No." := '';
                        CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                        CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                        CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                        CheckoffLines."Savings Account" := true;
                        CheckoffLines."Credit Account" := false;
                        CheckoffLines."Excess Amount" := true;
                        CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                        CheckoffLines.Name := CheckoffBuffer.Name;
                        CheckoffLines."Product ID" := SavAcc."Product Type";
                        if CheckoffLines.Amount > 0 then
                            CheckoffLines.Insert;
                        CheckoffBuffer.Processed := true;
                        CheckoffBuffer.Balance -= CheckoffLines.Amount;
                    end;
                end;


                CheckoffBuffer.Modify();

                dWindow.Update(3, CurrentRecordNo);
                dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));
            until CheckoffBuffer.Next = 0;
            dWindow.Close;
        end;
    end;

    procedure GenerateShareCapitalSingleCheckoff(checkoffHeader: Record "Monthly Checkoff Header")
    var
        CheckoffLines: Record "Monthly Checkoff Lines";
        CheckoffBuffer: Record "Monthly Checkoff Buffer";
        Members: Record Members;
        EntryNo: Integer;
        dWindow: Dialog;
        CurrentRecordNo: Integer;
        NoOfRecords: Integer;
        RunBal: Decimal;
        Loans: Record Loans;
        ExpAmt: Decimal;
        SavAcc: Record "Savings Accounts";
        ProductSetup: Record "Product Setup";
        RegFee: Decimal;
    begin

        CheckoffBuffer.Reset;
        CheckoffBuffer.SetRange("Checkoff No", checkoffHeader."No.");
        CheckoffBuffer.SetRange("Member Not Found", true);
        if CheckoffBuffer.FindFirst then
            Error('%1 Accounts were not found. Kindly Correct this', CheckoffBuffer.Count);



        CheckoffBuffer.Reset;
        CheckoffBuffer.SetRange("Checkoff No", checkoffHeader."No.");
        CheckoffBuffer.SetRange("Member Not Found", false);
        if CheckoffBuffer.FindFirst then begin

            CheckoffLines.Reset;
            CheckoffLines.SetRange("Checkoff Header", CheckoffBuffer."Checkoff No");
            if CheckoffLines.FindFirst then
                CheckoffLines.DeleteAll;



            SavAcc.Reset;
            SavAcc.SetRange("Product Category", SavAcc."product category"::"Share Capital");
            if SavAcc.FindFirst then begin
                repeat
                    if ProductSetup.Get(SavAcc."Product Type") then begin
                        SavAcc."Product Category" := ProductSetup."Product Category";
                        SavAcc.Modify();
                    end;
                until SavAcc.Next() = 0;
            end;



            dWindow.Open('Generating Check-Off Lines:        #1#########\'
                                     + 'Accounts:             #2#########\'
                                     + 'Counter:              #3#########\'
                                     + 'Progress:             @4@@@@@@@@@\'
                                     + 'Press Esc to abort');



            CurrentRecordNo := 0;
            NoOfRecords := CheckoffBuffer.Count;
            dWindow.Update(2, NoOfRecords);

            repeat
                CurrentRecordNo += 1;
                CheckoffBuffer.Processed := false;


                SavAcc.Reset;
                SavAcc.SetRange("Member No.", CheckoffBuffer."Member No.");
                SavAcc.SetRange(SavAcc."Product Category", SavAcc."Product Category"::"Share Capital");
                if not SavAcc.FindFirst then begin
                    Members.get(CheckoffBuffer."Member No.");
                    ProductSetup.Reset();
                    ProductSetup.SetRange("Product Category", ProductSetup."Product Category"::"Share Capital");
                    if ProductSetup.FindFirst() then
                        MemberActivities.CreateSavingsAccount(ProductSetup, Members, 0, true, ProductSetup."Repay Mode");
                end;

                RunBal := 0;
                CheckoffBuffer.Balance := CheckoffBuffer.Amount;

                if CheckoffBuffer."Share Capital" > 0 then begin

                    RunBal := CheckoffBuffer."Share Capital";



                    SavAcc.Reset;
                    SavAcc.SetRange("Member No.", CheckoffBuffer."Member No.");
                    SavAcc.SetRange(SavAcc."Product Category", SavAcc."Product Category"::"Share Capital");
                    if SavAcc.FindFirst then begin
                        if RunBal > 0 then begin
                            EntryNo += 1;
                            CheckoffLines.Init;
                            CheckoffLines."Entry No" := EntryNo;
                            CheckoffLines.Amount := RunBal;
                            CheckoffLines."Account No." := SavAcc."No.";
                            CheckoffLines."Loan No." := '';
                            CheckoffLines."Payroll No." := CheckoffBuffer.Payroll;
                            CheckoffLines."ID Number" := CheckoffBuffer."ID No.";
                            CheckoffLines."Member No." := CheckoffBuffer."Member No.";
                            CheckoffLines."Savings Account" := true;
                            CheckoffLines."Credit Account" := false;
                            CheckoffLines."Checkoff Header" := CheckoffBuffer."Checkoff No";
                            CheckoffLines.Name := CheckoffBuffer.Name;
                            CheckoffLines."Product ID" := SavAcc."Product Type";
                            if CheckoffLines.Amount > 0 then
                                CheckoffLines.Insert;
                            CheckoffBuffer.Processed := true;
                            CheckoffBuffer.Balance -= CheckoffLines.Amount;
                        end;
                    end;

                end;

                CheckoffBuffer.Modify();

                dWindow.Update(3, CurrentRecordNo);
                dWindow.Update(4, ROUND(CurrentRecordNo / NoOfRecords * 10000, 1));
            until CheckoffBuffer.Next = 0;
            dWindow.Close;
        end;
    end;


    local procedure GetCheckoffLineAmounts(HeaderNo: Code[20]; LoanNo: Code[20]; TransType: Option " ",Principal,Interest,Penalty,"Interest Arrears","Principal Arrears"): Decimal
    var
        GenJournalLine: Record "Gen. Journal Line";
        CheckoffLines: Record "Monthly Checkoff Lines";
        JDebits: Decimal;
        JCredits: Decimal;
    begin
        JDebits := 0;

        CheckoffLines.Reset;
        CheckoffLines.SetRange("Checkoff Header", HeaderNo);
        CheckoffLines.SetRange("Loan No.", LoanNo);
        CheckoffLines.SetRange(Type, TransType);
        CheckoffLines.SetFilter(Amount, '>0');
        if CheckoffLines.Find('-') then begin
            repeat
                JDebits += CheckoffLines.Amount;
            until CheckoffLines.Next = 0;
        end;

        exit(JDebits);
    end;

