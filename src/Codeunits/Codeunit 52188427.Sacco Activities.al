        If Savings.Get(AcctNo) then
            SalaryPosting."Product Type Name" := Savings."Product Name";
        SalaryPosting."Transaction Type" := TransType;
        SalaryPosting."Shortcut Dimension 1 Code" := Dim1;
        SalaryPosting."Shortcut Dimension 2 Code" := Dim2;
        if SalaryPosting.Amount <> 0 then
            SalaryPosting.Insert;


        //Error('HEaderNo %1\EntryType %2\MNo %3\Amt %4\', HEaderNo, EntryType, MNo, Amt);
        if EntryType <> EntryType::" " then begin

            if Amt < 0 then begin
                //Error('HEaderNo %1\EntryType %2\MNo %3\ExtDocNo %4\', HEaderNo, EntryType, MNo, ExtDocNo);

                if (EntryType = EntryType::"External STO") or (EntryType = EntryType::"Internal STO") then begin

                    SalDed.Reset();
                    SalDed.SetRange("Salary Header No.", HeaderNo);
                    SalDed.SetRange(Type, EntryType);
                    SalDed.SetRange("Member No.", MNo);
                    SalDed.SetRange("Loan No.", '');
                    SalDed.SetRange("Document No.", ExtDocNo);
                    if SalDed.findfirst then begin
                        SalDed."Amount Paid" := Amt * -1;
                        SalDed.Variance := SalDed."Expected Amount" - SalDed."Amount Paid";
                        SalDed.Modify();
                    end;
                end
                else begin

                    SalDed.Reset();
                    SalDed.SetRange("Salary Header No.", HeaderNo);
                    SalDed.SetRange(Type, EntryType);
                    SalDed.SetRange("Member No.", MNo);
                    SalDed.SetRange("Loan No.", Loan);
                    SalDed.SetRange("Document No.", Loan);
                    if SalDed.findfirst then begin
                        SalDed."Amount Paid" := Amt * -1;
                        SalDed.Variance := SalDed."Expected Amount" - SalDed."Amount Paid";
                        SalDed.Modify();
                    end;
                end;
            end;
        end;

    end;



