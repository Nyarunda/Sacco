                                                                            Accttype::"G/L Account", '', -Loans."Outstanding Appraisal", '', Loans."Loan No.", Transtype::"Appraisal Paid", Loans."Global Dimension 1 Code", Loans."Booking Branch", true, TChannel::"Loan Changes", DimID);


