    procedure PostMonthlyCheckoff(CheckoffHeader: Record "Monthly Checkoff Header"; JTransfer: Boolean)
    var
        Loans: Record Loans;
        CheckoffLines: Record "Monthly Checkoff Lines";
        RunBal: Decimal;
        PName: Text;
