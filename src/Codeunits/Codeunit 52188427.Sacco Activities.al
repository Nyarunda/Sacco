    procedure GenerateLoanMonthlyInsurance(LoanNo: Code[20]; BDate: Date; PDate: Date)
    var
        Loans: Record Loans;
        LoanType: Record "Product Setup";
        LineNo: Integer;
        DocNo: Code[20];
        "Document No.": Code[20];
        LoansInterest: Record "Loan Interest Buffer";
        LoanAmount: Decimal;
        CustMember: Record Members;
        CurrDate: Date;
        FirstMonthDate: Date;
        CurrMonth: Date;
        MidDate: Date;
        EndDate: Date;
        LastMonthDate: Date;
        FirstDay: Date;
        FirstDate: Date;
        IntCharged: Decimal;
        Principle: Decimal;
        AlreadyPostedErr: label 'This transaction Is Already posted';
        Memb: Record Members;
        InterestAmount: Decimal;
        BalDate: Date;
        MemberAccounts: Record "Savings Accounts";
        SkipLoan: Boolean;
        SaccoSetup: Record "Sacco Setup";
    begin


        //BalDate:=CALCDATE('-1M+CM',BDate);
        BalDate := BDate;

        Loans.Reset;
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Date Filter", '..%1', BalDate);
        Loans.SetFilter("Outstanding Principal", '>0');
        if Loans.FindSet() then begin

            repeat
                Loans.CalcFields("Loans Category-SACCO");

                begin
                    if LoanType.Get(Loans."Loan Product Type") then begin

                        InterestAmount := ROUND(CalculateMonthlyInsurance(Loans, LoanType, PDate), 0.01, '>');

                        SkipLoan := VerifyLoanDuplumRule(Loans, BDate, InterestAmount);

                        if not SkipLoan then begin

                            LoansInterest.Reset;
                            LoansInterest.SetRange("Loan No.", Loans."Loan No.");
                            LoansInterest.SetRange("Interest Date", BDate);
                            LoansInterest.Setrange(Source, LoansInterest.Source::Insurance);
                            if LoansInterest.FindSet(true) then
                                repeat
                                    LoansInterest.CalcFields(Reversed);
                                    if (LoansInterest.Posted) and (not LoansInterest.Reversed) then
                                        InterestAmount := 0
                                    else
                                        LoansInterest.Delete();
                                until (LoansInterest.Next() = 0) or (InterestAmount = 0);



                            if InterestAmount > 0 then begin
                                Loans.CalcFields(Loans."Outstanding Principal", Loans."Outstanding Interest");

                                LoansInterest.Init;
                                LoansInterest."Loan No." := Loans."Loan No.";
                                LoansInterest."Account Type" := LoansInterest."account type"::Credit;
                                LoansInterest."Account No" := Loans."Loan Account";
                                LoansInterest."Member No." := Loans."Member No.";
                                LoansInterest."Interest Date" := BDate;
                                LoansInterest."Issued Date" := Loans."Disbursement Date";
                                LoansInterest."Interest Amount" := InterestAmount;
                                LoansInterest."Posting Date" := PDate;
                                LoansInterest.Description := 'Insurance Due' + ' ' + CopyStr(Format(PDate, 0, '<Month Text>'), 1, 3) + ' ' + Format(Date2dmy(PDate, 3));
                                LoansInterest."Global Dimension 1 Code" := Loans."Global Dimension 1 Code";
                                LoansInterest."Global Dimension 2 Code" := Loans."Booking Branch";
                                LoansInterest."Loan Product type" := Loans."Loan Product Type";
                                LoansInterest.Source := LoansInterest.Source::Insurance;

                                LoanType.TestField("Insurance Income [G/L]");
                                LoansInterest."Bal. Account No." := LoanType."Insurance Income [G/L]";


                                if CustMember.Get(Loans."Member No.") then begin
                                    LoansInterest.Status := CustMember.Status;
                                    //LoansInterest.Blocked := CustMember.Blocked;
                                end;

                                LoansInterest."Outstanding Balance" := Loans."Outstanding Principal";
                                LoansInterest."Outstanding Interest" := Loans."Outstanding Interest";
                                LoansInterest.Insert;
                            end;
                        end;
                    end;
                end;
            until Loans.Next = 0;
        end;
    end;

    procedure CalculateMonthlyInsurance(Loans: Record Loans; LoanType: Record "Product Setup"; InsDate: Date): Decimal
    var
        TotalInsurance: Decimal;
        MonthlyInsurance: Decimal;
        CLedger: Record "Credit Ledger Entry";
        LSchedule: Record "Loan Repayment Schedule";
    begin
        // Calculate total insurance on disbursement amount
        /* if Loans."Amount To Disburse" > 0 then
            TotalInsurance := Loans."Amount To Disburse" * LoanType."Insurance Percentage" / 100
        else
            TotalInsurance := Loans."Total Insurance"; */

        CLedger.Reset;
        CLedger.SetRange("Loan No.", Loans."Loan No.");
        CLedger.SetRange("Transaction Type", CLedger."transaction type"::"Insurance Due");
        CLedger.SetFilter("Posting Date", '%1..%2', CalcDate('-CM', InsDate), CalcDate('CM', InsDate));
        CLedger.SetFilter(Amount, '>0');
        CLedger.SetRange(Reversed, false);
        if CLedger.FindFirst then
            exit(0);

        LSchedule.Reset;
        LSchedule.SetRange("Loan No.", Loans."Loan No.");
        LSchedule.SetFilter("Insurance Contribution", '>0');
        if LSchedule.FindFirst then
            if LSchedule."Insurance Contribution" > 0 then
                TotalInsurance := LSchedule."Insurance Contribution"; // Don't charge insurance if there is a repayment within a month of the insurance date

        exit(SmartRound(TotalInsurance));
    end;

    procedure CalculateMonthlyInsuranceAppraisal(Loans: Record "Member Salary Appraisal"; LoanType: Record "Product Setup"): Decimal
    var
        TotalInsurance: Decimal;
        MonthlyInsurance: Decimal;
    begin
        // Calculate total insurance on disbursement amount
        if Loans."Amount To Disburse" > 0 then
            TotalInsurance := Loans."Amount To Disburse" * LoanType."Insurance Percentage" / 100
        else
            TotalInsurance := Loans.Insurance;


        exit(SmartRound(TotalInsurance));
    end;

    procedure CalculateLoanOffset(Header: Record "Defaulter Loan Recovery"; PostEntries: Boolean)
    var
        AppraisalLine: Record "Offset Appraisal";
        PSetup: Record "Product Setup";
        MemberAccounts: Record "Savings Accounts";
        OffsetLine: Record "Loans Offet List";
        RecoveryLines: Record "Defaulter Recovery Lines";
        DefLoan: Record Loans;
        Member: Record Members;
        Legacy: Codeunit Legacy;

        RunBal: Decimal;
        DedAmt: Decimal;
        PrAmt: Decimal;
        IntAmt: Decimal;
        ArrearsAmt: Decimal;
        AvailDep: Decimal;
        TotalGuaranteed: Decimal;
        ChargeAmt: Decimal;

        RecoveryAccount: Code[20];
        ConsolidateAcc: Code[20];
        PDate: Date;
        Desc: Text[100];
    begin
        PDate := GetPostingDate(Header);

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 1: Build/refresh the appraisal lines (preview mode only)
        // ─────────────────────────────────────────────────────────────────────────
        MemberAccounts.Get(Legacy.GetDepositAccounts(Header."Member No."));
        Header."Free Shares" := Header.GetFreeShares(MemberAccounts);

        if not PostEntries then begin
            Header.GetAmounts();
            DeleteAppraisalLines(Header."No.");
        end;

        Header.Waiver := 0;

        if Header."Recovery Type" <> Header."Recovery Type"::Arrears then
            BuildAppraisalLines(Header);

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 2: Initialise journal + consolidate source funds (post mode only)
        // ─────────────────────────────────────────────────────────────────────────
        if PostEntries then begin
            GetGeneralJournalTemplate(JTemplate, JBatch);
            JournalInit(JTemplate, JBatch);

            ConsolidateAcc := GetConsolidationAccount(Header."Member No.");
            RecoveryAccount := '';

            if Header."Recovery Option" = Header."Recovery Option"::"Recover from Multiple Accounts" then begin
                RecoveryAccount := MemberAccounts."No."; //Legacy.GetDepositAccounts(Header."Member No.");
                AvailDep := ConsolidateMemberFunds(Header, ConsolidateAcc);
                AvailDep += SaccoActivities.GetAccountBalance(MemberAccounts."No.");
            end else begin
                AvailDep := MemberActivities.GetAccountBalance(Header."Source Account");
                RecoveryAccount := Header."Source Account";
            end;

            RunBal := DetermineRunningBalance(Header, AvailDep);
        end else
            RunBal := Header."Total Available";

        //RunBal to be free shares raised by users
        //RunBal := Header."Free Shares";


        // ─────────────────────────────────────────────────────────────────────────
        // STEP 3: Recover arrears (principal then interest)
        // ─────────────────────────────────────────────────────────────────────────
        if (RunBal > 0) and (Header.Arrears > 0) then
            RunBal := RecoverArrears(Header, RunBal, RecoveryAccount, PDate, PostEntries);

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 4: Recover outstanding penalty, interest and insurance across all offset lines
        // ─────────────────────────────────────────────────────────────────────────
        RunBal := RecoverPenalty(Header, RunBal, RecoveryAccount, PDate, PostEntries);
        RunBal := RecoverInterest(Header, RunBal, RecoveryAccount, PDate, PostEntries);
        RunBal := RecoverInsurance(Header, RunBal, RecoveryAccount, PDate, PostEntries);

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 5: Apply withdrawal fee (if any)
        // ─────────────────────────────────────────────────────────────────────────
        SaccoSetup.Get();
        ChargeAmt := 0;
        Header."Withdrawal Fee" := ChargeAmt;

        if (PostEntries) and (Header."Withdrawal Fee" > 0) then
            PostWithdrawalFee(Header, RecoveryAccount);

        if Header."Net Refund" < 0 then
            Header."Net Refund" := 0;

        Header.Modify();

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 6: Recover self-guaranteed loan principal
        // ─────────────────────────────────────────────────────────────────────────
        RunBal := RecoverSelfGuaranteedLoans(Header, RunBal, RecoveryAccount, PostEntries);

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 7: Recover other (non-self-guaranteed) loan principal
        // ─────────────────────────────────────────────────────────────────────────
        RunBal := RecoverOtherLoans(Header, RunBal, RecoveryAccount, PostEntries);

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 8: Recover from guarantors (issue defaulter loans or deduct deposits)
        // ─────────────────────────────────────────────────────────────────────────
        if IsGuarantorRecoveryRequired(Header) then
            RunBal := RecoverFromGuarantors(Header, RunBal, PDate, PostEntries);

        // ─────────────────────────────────────────────────────────────────────────
        // STEP 9: Finalise — post journal, flag member as defaulter
        // ─────────────────────────────────────────────────────────────────────────
        if PostEntries then begin
            Header.Recovered := true;
            Header.Modify();

            JournalPost(JTemplate, JBatch);

            Member.Get(Header."Member No.");
            Member.Validate("Member Status", Member."Member Status"::Defaulter);
            Member.Modify();

            NotifyMember(Header, Member, PostEntries);

            Message('Entries Posted Successfully');
        end;
    end;


    /// Returns today if no posting date is set on the header.
    local procedure GetPostingDate(Header: Record "Defaulter Loan Recovery"): Date
    begin
        if Header."Posting Date" <> 0D then
            exit(Header."Posting Date");
        exit(Today);
    end;


    /// Deletes all existing appraisal lines for the given offset number.
    local procedure DeleteAppraisalLines(OffsetNo: Code[20])
    var
        AppraisalLine: Record "Offset Appraisal";
    begin
        AppraisalLine.Reset();
        AppraisalLine.SetRange("Offset No.", OffsetNo);
        if AppraisalLine.FindFirst() then
            AppraisalLine.DeleteAll();
    end;


    /// Creates an appraisal line for each loan in the offset list.
    local procedure BuildAppraisalLines(Header: Record "Defaulter Loan Recovery")
    var
        AppraisalLine: Record "Offset Appraisal";
        OffsetLine: Record "Loans Offet List";
    begin
        OffsetLine.Reset();
        OffsetLine.SetRange("Header No.", Header."No.");
        OffsetLine.SetRange("Member No", Header."Member No.");
        if not OffsetLine.FindFirst() then
            exit;

        repeat
            // Remove any stale line for this specific loan before re-inserting.
            AppraisalLine.Reset();
            AppraisalLine.SetRange("Offset No.", Header."No.");
            AppraisalLine.SetRange("Loan No.", OffsetLine."Loan No");
            if AppraisalLine.FindFirst() then
                AppraisalLine.Delete();

            Loans.Get(OffsetLine."Loan No");

            AppraisalLine.Init();
            AppraisalLine."Offset No." := Header."No.";
            AppraisalLine."Member No." := Header."Member No.";
            AppraisalLine."Loan No." := OffsetLine."Loan No";
            AppraisalLine."Member Name" := Header.Name;
            AppraisalLine."Loan Product" := Loans."Loan Product Type";
            AppraisalLine."Approved Amount" := Loans."Approved Amount";
            AppraisalLine.Savings := Header."Total Available";
            AppraisalLine."New Savings Balance" := Header."Total Available";

            AppraisalLine."Share Capital" := Header."Share Capital";
            AppraisalLine."Share Capital Top Up" := Header."Share Capital Top Up";
            AppraisalLine."New Share Capital" := CalcNewShareCapital(Header);

            AppraisalLine."Outstanding Interest" := OffsetLine."Outstanding Interest";
            AppraisalLine."Interest Waived" := OffsetLine."interest waiver";
            AppraisalLine."Out. Interest After Waiver" := OffsetLine."Outstanding Interest" - OffsetLine."interest waiver";
            AppraisalLine."New Outstanding Interest" := AppraisalLine."Out. Interest After Waiver";
            AppraisalLine."Outstanding Balance" := OffsetLine."Outstanding Principal";
            AppraisalLine."New Outstanding Balance" := OffsetLine."Outstanding Principal";
            AppraisalLine.Arrears := Header.Arrears;

            AppraisalLine.Insert();

            Header.Waiver += AppraisalLine."Interest Waived";
        until OffsetLine.Next() = 0;
    end;


    /// Calculates the new share capital after applying top-ups.
    local procedure CalcNewShareCapital(Header: Record "Defaulter Loan Recovery"): Decimal
    begin
        if Header."Share Capital Top Up" <= 0 then
            exit(Header."Share Capital");

        if Header."Total Available" > Header."Share Capital Top Up" then
            exit(Header."Share Capital" + Header."Share Capital Top Up")
        else
            exit(Header."Share Capital Top Up" - Header."Total Available");
    end;


    /// Finds the primary deposit account used to consolidate funds before offset.
    local procedure GetConsolidationAccount(MemberNo: Code[20]): Code[20]
    var
        MemberAccounts: Record "Savings Accounts";
    begin
        MemberAccounts.Reset();
        MemberAccounts.SetRange("Member No.", MemberNo);
        MemberAccounts.SetRange("Product Category", MemberAccounts."Product Category"::"Deposit Contribution");
        if MemberAccounts.FindFirst() then
            exit(MemberAccounts."No.");

        MemberAccounts.Reset();
        MemberAccounts.SetRange("Member No.", MemberNo);
        MemberAccounts.SetRange("Product Category", MemberAccounts."Product Category"::"Micro Member Deposit");
        if MemberAccounts.FindFirst() then
            exit(MemberAccounts."No.");

        exit('');
    end;


    /// Moves balances from all eligible deposit products into the consolidation account.
    /// Returns the total amount consolidated.
    local procedure ConsolidateMemberFunds(Header: Record "Defaulter Loan Recovery"; ConsolidateAcc: Code[20]): Decimal
    var
        PSetup: Record "Product Setup";
        MemberAccounts: Record "Savings Accounts";
        TotalConsolidated: Decimal;
    begin
        TotalConsolidated := 0;

        PSetup.Reset();
        PSetup.SetRange("Can Offset Loan", true);
        PSetup.SetFilter("Product Category", '<>%1', PSetup."Product Category"::"Deposit Contribution");
        if not PSetup.FindFirst() then
            exit(TotalConsolidated);

        repeat
            MemberAccounts.Reset();
            MemberAccounts.SetRange("Member No.", Header."Member No.");
            MemberAccounts.SetRange("Product Type", PSetup."Product ID");
            MemberAccounts.SetFilter("Balance (LCY)", '>0');
            if MemberAccounts.FindFirst() then
                repeat
                    MemberAccounts.CalcFields("Balance (LCY)");
                    TotalConsolidated += MemberAccounts."Balance (LCY)";

                    // Debit the source account
                    JournalInsert(
                        JTemplate, JBatch,
                        Header."No.", Today,
                        Accttype::Savings, MemberAccounts."No.",
                        CopyStr('Offset Consolidation: ' + MemberAccounts."Product Name", 1, 100),
                        Balaccttype::"G/L Account", '',
                        MemberAccounts."Balance (LCY)",
                        Header."No.", '', Transtype::" ",
                        Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                        true, TChannel::Defaulter, Header."Dimension Set ID");

                    // Credit the consolidation account
                    JournalInsert(
                        JTemplate, JBatch,
                        Header."No.", Today,
                        Accttype::Savings, ConsolidateAcc,
                        CopyStr('Offset Consolidation: ' + MemberAccounts."Product Name", 1, 100),
                        Balaccttype::"G/L Account", '',
                        -MemberAccounts."Balance (LCY)",
                        Header."No.", '', Transtype::" ",
                        Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                        true, TChannel::Defaulter, Header."Dimension Set ID");
                until MemberAccounts.Next() = 0;
        until PSetup.Next() = 0;

        exit(TotalConsolidated);
    end;


    /// Resolves the balance available to run against loan obligations.
    local procedure DetermineRunningBalance(Header: Record "Defaulter Loan Recovery"; AvailDep: Decimal): Decimal
    var
        RunBal: Decimal;
    begin
        if Header."Amount to Recover" > 0 then
            RunBal := Header."Amount to Recover"
        else
            RunBal := AvailDep;

        if Header."Amount to Recover" > 0 then begin
            if RunBal > Header."Amount to Recover" then
                RunBal := Header."Amount to Recover"
            else
                if Header."Recovery Type" = Header."Recovery Type"::"All Loans" then
                    Error('Insufficient Balance');
        end;

        exit(RunBal);
    end;


    /// Recovers principal and interest arrears from the running balance.
    /// Returns the updated running balance.
    local procedure RecoverArrears(
        Header: Record "Defaulter Loan Recovery";
        RunBal: Decimal;
        RecoveryAccount: Code[20];
        PDate: Date;
        PostEntries: Boolean): Decimal
    var
        ArrearsAmt: Decimal;
    begin
        if (RunBal <= 0) or (Header.Arrears <= 0) then
            exit(RunBal);

        Loans.Get(Header."Loan No.");

        // --- Principal arrears ---
        ArrearsAmt := MinDecimal(Header."Principal Arrears", RunBal);
        if (PostEntries) and (ArrearsAmt > 0) then begin
            RunBal -= ArrearsAmt;

            JournalInsert(
                JTemplate, JBatch, Header."No.", PDate,
                Accttype::Credit, Loans."Loan Account",
                CopyStr('Principal Arrears Offset: ' + Loans."Loan Product Type Name", 1, 100),
                Balaccttype::"G/L Account", '', -ArrearsAmt,
                Header."No.", Loans."Loan No.", Transtype::"Principal Repayment",
                Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                true, TChannel::Offset, Header."Dimension Set ID");

            JournalInsert(
                JTemplate, JBatch, Header."No.", PDate,
                Accttype::Savings, RecoveryAccount,
                CopyStr('Principal Arrears Offset: ' + Loans."Loan Product Type Name", 1, 100),
                Balaccttype::"G/L Account", '', ArrearsAmt,
                Header."No.", '', Transtype::" ",
                Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                true, TChannel::Offset, Header."Dimension Set ID");
        end;

        // --- Interest arrears ---
        ArrearsAmt := MinDecimal(Header."Interest Arrears", RunBal);
        if (PostEntries) and (ArrearsAmt > 0) then begin
            RunBal -= ArrearsAmt;

            JournalInsert(
                JTemplate, JBatch, Header."No.", PDate,
                Accttype::Credit, Loans."Loan Account",
                CopyStr('Interest Arrears Offset: ' + Loans."Loan Product Type Name", 1, 100),
                Balaccttype::"G/L Account", '', -ArrearsAmt,
                Header."No.", Loans."Loan No.", Transtype::"Interest Paid",
                Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                true, TChannel::Offset, Header."Dimension Set ID");

            JournalInsert(
                JTemplate, JBatch, Header."No.", PDate,
                Accttype::Savings, RecoveryAccount,
                CopyStr('Interest Arrears Offset: ' + Loans."Loan Product Type Name", 1, 100),
                Balaccttype::"G/L Account", '', ArrearsAmt,
                Header."No.", '', Transtype::" ",
                Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                true, TChannel::Offset, Header."Dimension Set ID");
        end;

        exit(RunBal);
    end;


    /// Recovers outstanding penalty for each loan in the offset list.
    /// Returns the updated running balance.
    local procedure RecoverPenalty(
        Header: Record "Defaulter Loan Recovery";
        RunBal: Decimal;
        RecoveryAccount: Code[20];
        PDate: Date;
        PostEntries: Boolean): Decimal
    var
        AppraisalLine: Record "Offset Appraisal";
        OffsetLine: Record "Loans Offet List";
        PenaltyAmt: Decimal;
        DedAmt: Decimal;
    begin
        OffsetLine.Reset();
        OffsetLine.SetRange("Header No.", Header."No.");
        OffsetLine.SetRange("Member No", Header."Member No.");
        if not OffsetLine.FindFirst() then
            exit(RunBal);

        repeat
            if RunBal <= 0 then
                break;

            AppraisalLine.Reset();
            AppraisalLine.SetRange("Offset No.", Header."No.");
            AppraisalLine.SetRange("Loan No.", OffsetLine."Loan No");
            if not AppraisalLine.FindFirst() then
                continue;

            Loans.Get(OffsetLine."Loan No");
            Loans.CalcFields("Outstanding Penalty");

            DedAmt := Round(Loans."Outstanding Penalty", 0.01, '=');
            if DedAmt <= 0 then
                continue;

            if DedAmt > OffsetLine."Amount to Recover" then
                DedAmt := OffsetLine."Amount to Recover";

            DedAmt := MinDecimal(DedAmt, RunBal);

            AppraisalLine.Savings := RunBal;
            AppraisalLine."New Savings Balance" := RunBal;

            if PostEntries and (DedAmt > 0) then begin
                OffsetLine."Amount to Recover" -= DedAmt;
                PenaltyAmt := DedAmt;
                RunBal -= PenaltyAmt;

                JournalInsert(
                    JTemplate, JBatch, Header."No.", PDate,
                    Accttype::Credit, Loans."Loan Account",
                    CopyStr('Penalty Offset: ' + Loans."Loan Product Type Name", 1, 100),
                    Balaccttype::"G/L Account", '', -PenaltyAmt,
                    Header."No.", Loans."Loan No.", Transtype::"Penalty Paid",
                    Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                    true, TChannel::Offset, Header."Dimension Set ID");

                JournalInsert(
                    JTemplate, JBatch, Header."No.", PDate,
                    Accttype::Savings, RecoveryAccount,
                    CopyStr('Penalty Offset: ' + Loans."Loan Product Type Name", 1, 100),
                    Balaccttype::"G/L Account", '', PenaltyAmt,
                    Header."No.", '', Transtype::" ",
                    Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                    true, TChannel::Offset, Header."Dimension Set ID");
            end;

            AppraisalLine."New Savings Balance" := RunBal;
            AppraisalLine.Modify();
            Commit();

        until OffsetLine.Next() = 0;

        exit(RunBal);
    end;


    /// Recovers outstanding interest for each loan in the offset list.
    /// Returns the updated running balance.
    local procedure RecoverInterest(
        Header: Record "Defaulter Loan Recovery";
        RunBal: Decimal;
        RecoveryAccount: Code[20];
        PDate: Date;
        PostEntries: Boolean): Decimal
    var
        AppraisalLine: Record "Offset Appraisal";
        OffsetLine: Record "Loans Offet List";
        PSetup: Record "Product Setup";
        IntAmt: Decimal;
        DedAmt: Decimal;
    begin
        OffsetLine.Reset();
        OffsetLine.SetRange("Header No.", Header."No.");
        OffsetLine.SetRange("Member No", Header."Member No.");
        if not OffsetLine.FindFirst() then
            exit(RunBal);

        repeat
            if RunBal <= 0 then
                break;

            AppraisalLine.Reset();
            AppraisalLine.SetRange("Offset No.", Header."No.");
            AppraisalLine.SetRange("Loan No.", OffsetLine."Loan No");
            AppraisalLine.SetFilter("Out. Interest After Waiver", '>0');
            if not AppraisalLine.FindFirst() then
                continue;

            Loans.Get(OffsetLine."Loan No");
            PSetup.Get(Loans."Loan Product Type");

            // Cap deduction at what the offset line says to recover
            DedAmt := Round(AppraisalLine."Outstanding Interest", 0.01, '=');
            if AppraisalLine."Outstanding Interest" > OffsetLine."Amount to Recover" then
                DedAmt := OffsetLine."Amount to Recover";

            DedAmt := MinDecimal(DedAmt, RunBal);

            AppraisalLine.Savings := RunBal;
            AppraisalLine."New Savings Balance" := RunBal;

            if PostEntries and (DedAmt > 0) then begin
                OffsetLine."Amount to Recover" -= DedAmt;
                IntAmt := DedAmt;
                RunBal -= IntAmt;

                AppraisalLine."New Outstanding Interest" -= DedAmt;
                if AppraisalLine."New Outstanding Interest" < 0 then
                    AppraisalLine."New Outstanding Interest" := 0;

                // Debit loan account for interest paid
                JournalInsert(
                    JTemplate, JBatch, Header."No.", PDate,
                    Accttype::Credit, Loans."Loan Account",
                    CopyStr('Interest Offset: ' + Loans."Loan Product Type Name", 1, 100),
                    Balaccttype::"G/L Account", '', -IntAmt,
                    Header."No.", Loans."Loan No.", Transtype::"Interest Paid",
                    Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                    true, TChannel::Offset, Header."Dimension Set ID");

                // Post interest waiver against the GL income account
                if AppraisalLine."Interest Waived" <> 0 then
                    JournalInsert(
                        JTemplate, JBatch, Header."No.", PDate,
                        Accttype::Credit, Loans."Loan Account",
                        CopyStr('Interest Waiver: ' + Loans."Loan Product Type Name", 1, 100),
                        Balaccttype::"G/L Account", PSetup."Loan Interest Income [G/L]",
                        -AppraisalLine."Interest Waived",
                        Header."No.", Loans."Loan No.", Transtype::"Interest Paid",
                        Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                        true, TChannel::Offset, Header."Dimension Set ID");

                // Credit recovery (savings) account
                JournalInsert(
                    JTemplate, JBatch, Header."No.", PDate,
                    Accttype::Savings, RecoveryAccount,
                    CopyStr('Interest Offset: ' + Loans."Loan Product Type Name", 1, 100),
                    Balaccttype::"G/L Account", '', IntAmt,
                    Header."No.", '', Transtype::" ",
                    Header."Global Dimension 1 Code", Header."Global Dimension 2 Code",
                    true, TChannel::Offset, Header."Dimension Set ID");
            end;

            AppraisalLine."New Savings Balance" := RunBal;
            AppraisalLine.Modify();
            Commit();

        until OffsetLine.Next() = 0;

        exit(RunBal);
    end;


