                                                                            end;
                                                                            if LoanChanges."Charge Type" = LoanChanges."charge type"::Restructure then
                                                                                NewLoans."Loan Restructured" := true;

                                                                            NewLoans."Loan Principle Repayment" := SaccoActivities.smartround(RSchedule."Monthly Principal");
                                                                            NewLoans."Loan Interest Repayment" := SaccoActivities.smartround(RSchedule."Monthly Interest");
                                                                            NewLoans.Repayment := SaccoActivities.smartround(LoanChanges."New Repayment");
                                                                            NewLoans."Adjusted Repayment" := LoanChanges."Adjusted Repayment";
                                                                            NewLoans."Old Installments" := LoanChanges."Original Installments";

                                                                            NewLoans.Modify;

                                                                            GenerateLoanChangeNewLoanSchedule(LoanChanges, NewLoans);

                                                                            LoanChanges.Processed := true;
                                                                            LoanChanges."Rescheduling Date" := Today;
                                                                            LoanChanges.Modify;

                                                                            //ERROR('Inst %1',NewLoans.Installments);
                                                                        end
                                                                        else begin

                                                                            GenerateNewLoanSchedule(LoanChanges);

                                                                            RSchedule.Reset;
                                                                            RSchedule.SetRange("Loan No.", Loans."Loan No.");
                                                                            if RSchedule.FindFirst then begin

                                                                                Loans.Reset();
                                                                                Loans.SetRange("Loan No.", LoanChanges."Loan No.");
                                                                                if Loans.FindFirst() then begin
                                                                                    Loans.Installments := LoanChanges."New Installments";
                                                                                    if LoanChanges."Repayment Start Date" <> 0D then begin
                                                                                        Loans."Repayment Start Date" := LoanChanges."Repayment Start Date";
                                                                                        Loans."Schedule Start Date" := LoanChanges."Repayment Start Date";
                                                                                    end;
                                                                                    Loans."Old Installments" := LoanChanges."Original Installments";
                                                                                    Loans."Reschedule by" := UserId;


                                                                                    Loans."Loan Rescheduled" := true;
                                                                                    Loans."Date Rescheduled" := LoanChanges."Rescheduling Date";

                                                                                    if LoanChanges."Charge Type" = LoanChanges."charge type"::Reschedule then
                                                                                        Loans."Loan Rescheduled" := true;
                                                                                    if LoanChanges."Charge Type" = LoanChanges."charge type"::Restructure then
                                                                                        Loans."Loan Restructured" := true;

                                                                                    Loans."Old Repayment" := LoanChanges."Old Repayment";
                                                                                    if Loans."Old Repayment" <= 0 then
                                                                                        Loans."Old Repayment" := Loans.Repayment;
                                                                                    Loans."Loan Principle Repayment" := SaccoActivities.smartround(RSchedule."Monthly Principal");
                                                                                    Loans.Repayment := SaccoActivities.smartround(RSchedule."Monthly Repayment");
                                                                                    Loans."Loan Interest Repayment" := SaccoActivities.smartround(RSchedule."Monthly Interest");
                                                                                    Loans."Adjusted Repayment" := LoanChanges."Adjusted Repayment";

                                                                                    Loans."Last Advice Date" := Today;
                                                                                    Loans."Advice Type" := Loans."Advice Type"::Adjustment;
                                                                                    Loans.Modify;
                                                                                end;
                                                                            end
                                                                            else
                                                                                Error('Schedule Not Generated');

                                                                            LoanChanges.Processed := true;
                                                                            LoanChanges."Rescheduling Date" := Today;
                                                                            LoanChanges.Modify;

                                                                        end;
                                                                    end;

                                                                    JournalPost(JTemplate, JBatch);
                                                                    //MESSAGE('%1\%2',JTemplate,JBatch);
                                                                end;


        end;
    end;

    local procedure ApplyLoanChargeControl(var LoanChanges: Record "Loan Changes"; var Loan: Record Loans)
    begin
        ValidateLoanChargeControl(LoanChanges, Loan);

        case LoanChanges."Interest Action" of
            LoanChanges."Interest Action"::Stop:
                begin
                    Loan."Stop Interest Due" := true;
                    Loan."Int Stop Date" := LoanChanges."Rescheduling Date";
                end;
            LoanChanges."Interest Action"::Resume:
                begin
                    Loan."Stop Interest Due" := false;
                    Loan."Int Stop Date" := 0D;
                end;
        end;

        case LoanChanges."Penalty Action" of
            LoanChanges."Penalty Action"::Stop:
                Loan."Stop Penalty" := true;
            LoanChanges."Penalty Action"::Resume:
                Loan."Stop Penalty" := false;
        end;

        case LoanChanges."Insurance Action" of
            LoanChanges."Insurance Action"::Stop:
                begin
                    Loan."Stop Insurance" := true;
                    UpdateFutureScheduleInsurance(LoanChanges, Loan, 0);
                end;
            LoanChanges."Insurance Action"::Resume:
                begin
                    Loan."Stop Insurance" := false;
                    Loan."Total Insurance" := LoanChanges."New Insurance Amount";
                    UpdateFutureScheduleInsurance(LoanChanges, Loan, LoanChanges."New Insurance Amount");
                end;
        end;

        Loan.Modify();
        LoanChanges.Processed := true;
        LoanChanges.Modify();
    end;

    local procedure ValidateLoanChargeControl(LoanChanges: Record "Loan Changes"; Loan: Record Loans)
    begin
        LoanChanges.TestField("Rescheduling Date");
        LoanChanges.TestField(Remarks);

        if (LoanChanges."Interest Action" = LoanChanges."Interest Action"::"No Change") and
           (LoanChanges."Penalty Action" = LoanChanges."Penalty Action"::"No Change") and
           (LoanChanges."Insurance Action" = LoanChanges."Insurance Action"::"No Change")
        then
            Error('Select Stop or Resume for at least one component.');

        if (LoanChanges."Interest Action" = LoanChanges."Interest Action"::Stop) and Loan."Stop Interest Due" then
            Error('Interest is already stopped for loan %1.', Loan."Loan No.");
        if (LoanChanges."Interest Action" = LoanChanges."Interest Action"::Resume) and not Loan."Stop Interest Due" then
            Error('Interest is not stopped for loan %1.', Loan."Loan No.");

        if (LoanChanges."Penalty Action" = LoanChanges."Penalty Action"::Stop) and Loan."Stop Penalty" then
            Error('Penalty is already stopped for loan %1.', Loan."Loan No.");
        if (LoanChanges."Penalty Action" = LoanChanges."Penalty Action"::Resume) and not Loan."Stop Penalty" then
            Error('Penalty is not stopped for loan %1.', Loan."Loan No.");

        if (LoanChanges."Insurance Action" = LoanChanges."Insurance Action"::Stop) and Loan."Stop Insurance" then
            Error('Insurance is already stopped for loan %1.', Loan."Loan No.");
        if (LoanChanges."Insurance Action" = LoanChanges."Insurance Action"::Resume) then begin
            if not Loan."Stop Insurance" then
                Error('Insurance is not stopped for loan %1.', Loan."Loan No.");
            LoanChanges.TestField("New Insurance Amount");
        end;
    end;

    local procedure UpdateFutureScheduleInsurance(LoanChanges: Record "Loan Changes"; Loan: Record Loans; NewInsuranceAmount: Decimal)
    var
        RepaymentSchedule: Record "Loan Repayment Schedule";
    begin
        RepaymentSchedule.Reset();
        RepaymentSchedule.SetRange("Loan No.", Loan."Loan No.");
        //RepaymentSchedule.SetRange("Member No.", Loan."Member No.");
        //RepaymentSchedule.SetFilter("Repayment Date", '>=%1', LoanChanges."Rescheduling Date");
        if not RepaymentSchedule.FindSet(true) then
            Error(
                'No repayment schedule was found for loan %1, member %2, from repayment date %3.',
                Loan."Loan No.", Loan."Member No.", LoanChanges."Rescheduling Date");

        repeat
            RepaymentSchedule."Monthly Repayment" :=
                SmartRound(
                    RepaymentSchedule."Monthly Repayment" -
                    RepaymentSchedule."Insurance Contribution" +
                    NewInsuranceAmount);
            RepaymentSchedule."Insurance Contribution" := NewInsuranceAmount;
            RepaymentSchedule.Modify();
        until RepaymentSchedule.Next() = 0;
    end;

    procedure GenerateNewLoanSchedule(LoanChanges: Record "Loan Changes")
    begin
        GenerateLoanChangeRepaymentSchedule(LoanChanges, LoanChanges."Loan No.", false);
    end;

    procedure GenerateLoanReschedulingPreview(LoanChanges: Record "Loan Changes")
    var
        PreviewLoan: Record Loans temporary;
    begin
        LoanChanges.TestField("Loan No.");
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then begin
            LoanChanges.TestField("Schedule Start Date");
            if LoanChanges."Schedule Balance" < 0 then
                Error('Schedule Balance cannot be negative.');
        end;
        /* if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then
            LoanChanges.TestField("New Deposit Contribution") */  //Mwende said
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
            LoanChanges.TestField("Loan Moratorium Start Date");
            LoanChanges.TestField("Loan Moratorium End Date");
            if LoanChanges."Loan Moratorium End Date" < LoanChanges."Loan Moratorium Start Date" then
                Error('Moratorium End Date cannot be before Moratorium Start Date.');
        end
        else begin
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Rescheduling" then begin
                LoanChanges.TestField("New Installments");
                LoanChanges.TestField("Rescheduling Date");
            end;
        end;

        ClearLoanReschedulingPreview(LoanChanges."No.");

        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then begin
            GenerateDepositContributionPreview(LoanChanges);
            exit;
        end;

        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then
            GenerateNewLoanSchedulePreview(LoanChanges)
        else
        if LoanChanges."Rescheduling Type" = LoanChanges."Rescheduling Type"::"Create New Loan" then begin
            BuildLoanChangePreviewLoan(LoanChanges, LoanChanges."No.", PreviewLoan);
            GenerateRepaymentScheduleII(PreviewLoan);
        end else
            GenerateNewLoanSchedulePreview(LoanChanges);
    end;

    local procedure ClearLoanReschedulingPreview(PreviewNo: Code[20])
    var
        PreviewSchedule: Record "Loan Repayment Schedule II";
    begin
        PreviewSchedule.Reset();
        PreviewSchedule.SetRange("Loan No.", PreviewNo);
        if PreviewSchedule.FindFirst() then
            PreviewSchedule.DeleteAll();
    end;

    local procedure GenerateDepositContributionPreview(LoanChanges: Record "Loan Changes")
    var
        LoanSchedule: Record "Loan Repayment Schedule";
        PreviewSchedule: Record "Loan Repayment Schedule II";
    begin
        LoanSchedule.Reset();
        LoanSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
        if not LoanSchedule.FindSet() then
            Error('No repayment schedule exists for loan %1.', LoanChanges."Loan No.");

        repeat
            PreviewSchedule.Init();
            PreviewSchedule."Loan No." := LoanChanges."No.";
            PreviewSchedule."Repayment Date" := LoanSchedule."Repayment Date";
            PreviewSchedule."Loan Amount" := LoanSchedule."Loan Amount";
            PreviewSchedule."Monthly Principal" := LoanSchedule."Monthly Principal";
            PreviewSchedule."Monthly Interest" := LoanSchedule."Monthly Interest";
            PreviewSchedule."Monthly Appraisal" := LoanSchedule."Insurance Contribution";
            PreviewSchedule."Monthly Repayment" := GetMonthlyRepaymentAfterDepositChange(
                LoanSchedule."Monthly Repayment",
                LoanSchedule."Deposit Amount",
                LoanChanges."New Deposit Contribution");
            PreviewSchedule."Loan Balance" := LoanSchedule."Loan Balance";
            PreviewSchedule."Line No." := LoanSchedule."Line No.";
            PreviewSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution";
            PreviewSchedule."Member No." := LoanSchedule."Member No.";
            if PreviewSchedule."Member No." = '' then
                PreviewSchedule."Member No." := LoanChanges."Member No.";
            PreviewSchedule.Insert();
        until LoanSchedule.Next() = 0;
    end;

    local procedure GetMonthlyRepaymentAfterDepositChange(CurrentMonthlyRepayment: Decimal; CurrentDepositAmount: Decimal; NewDepositAmount: Decimal): Decimal
    begin
        exit(SmartRound(CurrentMonthlyRepayment - CurrentDepositAmount + NewDepositAmount));
    end;

    local procedure GenerateNewLoanSchedulePreview(LoanChanges: Record "Loan Changes")
    begin
        GenerateLoanChangeRepaymentSchedule(LoanChanges, LoanChanges."No.", true);
    end;

    local procedure GenerateLoanChangeNewLoanSchedule(LoanChanges: Record "Loan Changes"; var NewLoans: Record Loans)
    var
        ActualAmountToDisburse: Decimal;
    begin
        ActualAmountToDisburse := NewLoans."Amount To Disburse";

        if LoanChanges."New Schedule Amount" > 0 then begin
            NewLoans."Amount To Disburse" := LoanChanges."New Schedule Amount";
            NewLoans.Modify();
        end;

        GenerateRepaymentSchedule(NewLoans);

        if LoanChanges."New Schedule Amount" > 0 then begin
            NewLoans.Get(NewLoans."Loan No.");
            NewLoans."Amount To Disburse" := ActualAmountToDisburse;
            NewLoans.Modify();
        end;
    end;

    local procedure BuildLoanChangePreviewLoan(LoanChanges: Record "Loan Changes"; TargetLoanNo: Code[20]; var PreviewLoan: Record Loans temporary)
    var
        LoanRec: Record Loans;
        EffectiveDisbursementDate: Date;
        EffectiveRepaymentStartDate: Date;
    begin
        LoanChanges.TestField("Loan No.");
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then
            LoanChanges.TestField("New Deposit Contribution")
        else begin
            LoanChanges.TestField("New Installments");
            LoanChanges.TestField("Rescheduling Date");
        end;

        LoanRec.Get(LoanChanges."Loan No.");

        PreviewLoan.Reset();
        if PreviewLoan.FindFirst() then
            PreviewLoan.DeleteAll();

        PreviewLoan.Init();
        PreviewLoan.TransferFields(LoanRec);
        PreviewLoan."Loan No." := TargetLoanNo;
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then begin
            PreviewLoan."Deposit COntribution" := LoanChanges."New Deposit Contribution";
            PreviewLoan.Insert(false);
            exit;
        end;

        if LoanChanges."New Loan Amount" <> 0 then begin
            PreviewLoan."Requested Amount" := LoanChanges."New Loan Amount";
            PreviewLoan."Approved Amount" := LoanChanges."New Loan Amount";
            PreviewLoan."Amount To Disburse" := GetLoanChangeScheduleAmount(LoanChanges, LoanChanges."New Loan Amount");
        end else begin
            PreviewLoan."Requested Amount" := LoanRec."Requested Amount";
            PreviewLoan."Approved Amount" := LoanRec."Approved Amount";
            PreviewLoan."Amount To Disburse" := GetLoanChangeScheduleAmount(LoanChanges, LoanRec."Amount To Disburse");
        end;

        if LoanChanges."New Installments" <> 0 then
            PreviewLoan.Installments := LoanChanges."New Installments"
        else
            PreviewLoan.Installments := LoanRec.Installments;

        EffectiveDisbursementDate := LoanChanges."Rescheduling Date";
        if EffectiveDisbursementDate = 0D then
            EffectiveDisbursementDate := WorkDate();

        EffectiveRepaymentStartDate := LoanChanges."Repayment Start Date";
        if EffectiveRepaymentStartDate = 0D then
            EffectiveRepaymentStartDate := CalcDate('1M', EffectiveDisbursementDate);

        PreviewLoan."Disbursement Date" := EffectiveDisbursementDate;
        PreviewLoan."Repayment Start Date" := EffectiveRepaymentStartDate;
        PreviewLoan."Schedule Start Date" := EffectiveRepaymentStartDate;
        if Format(LoanChanges."New Principal Grace Period") <> '' then
            PreviewLoan."Principal Grace Period" := LoanChanges."New Principal Grace Period"
        else
            PreviewLoan."Principal Grace Period" := LoanChanges."Principal Grace Period";

        PreviewLoan.Insert(false);
    end;

    local procedure GetLoanChangeScheduleAmount(LoanChanges: Record "Loan Changes"; DefaultAmount: Decimal): Decimal
    begin
        if LoanChanges."New Schedule Amount" > 0 then
            exit(LoanChanges."New Schedule Amount");

        exit(DefaultAmount);
    end;

    local procedure GenerateLoanChangeRepaymentScheduleOld(LoanChanges: Record "Loan Changes"; TargetLoanNo: Code[20]; UsePreviewSchedule: Boolean)
    var
        LoanRec: Record Loans;
        LoanSchedule: Record "Loan Repayment Schedule";
        PreviewSchedule: Record "Loan Repayment Schedule II";
        LoanType: Record "Product Setup";
        CurrentLoanBalance: Decimal;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        RepayCode: Code[10];
        IntDen: Integer;
        Months: Integer;
        BonusDate: Date;
        CheckDate: Date;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        InitDF: DateFormula;
        InMoratorium: Boolean;
        RemainingInstallments: Integer;
        AmortisedMonthlyRepayment: Decimal;
        StraightLineMonthlyRepayment: Decimal;
        ReducingMonthlyPrincipal: Decimal;
        RoundedInterest: Decimal;
        NonMoratoriumInstallments: Integer;
        FutureDate: Date;
        FutureInstalNo: Integer;
        MoratoriumStarted: Boolean;
        CurrentScheduleDate: Date;
        CurrentScheduleInstallments: Integer;
        MoratoriumReducingMonthlyPrincipal: Decimal;
    begin
        LoanChanges.TestField("Loan No.");
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then
            LoanChanges.TestField("New Deposit Contribution")
        else if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
            LoanChanges.TestField("Loan Moratorium Start Date");
            LoanChanges.TestField("Loan Moratorium End Date");
            if LoanChanges."Loan Moratorium End Date" < LoanChanges."Loan Moratorium Start Date" then
                Error('Moratorium End Date cannot be before Moratorium Start Date.');
        end else begin
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Rescheduling" then begin
                LoanChanges.TestField("New Installments");
                LoanChanges.TestField("Rescheduling Date");
                LoanChanges.TestField("Repayment Start Date");
            end;
        end;


        LoanRec.Get(LoanChanges."Loan No.");
        LoanRec.CalcFields("Outstanding Principal", "Employer Code");
        LoanRec.TestField("Disbursement Date");

        // An interest-calculation-method change must retain the term from the
        // current live schedule, not the original Installments value on the loan.
        // This is important where a moratorium or earlier rescheduling extended
        // the schedule without changing that original value.
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then begin
            LoanSchedule.Reset();
            LoanSchedule.SetCurrentKey("Loan No.", "Repayment Date", "Member No.");
            LoanSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
            LoanSchedule.SetRange("Repayment Date", WorkDate(), 99991230D);
            LoanSchedule.SetFilter("Line No.", '>0');
            CurrentScheduleInstallments := LoanSchedule.Count();
            if CurrentScheduleInstallments = 0 then
                Error('No remaining repayment-schedule lines were found for loan %1.', LoanChanges."Loan No.");

            if LoanSchedule.FindFirst() then
                CurrentScheduleDate := LoanSchedule."Repayment Date";
        end;

        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
            LoanSchedule.Reset();
            LoanSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
            LoanSchedule.SetRange("Repayment Date", WorkDate(), 99991230D);
            if LoanSchedule.FindFirst() then
                CurrentScheduleDate := LoanSchedule."Repayment Date";

            if Loanchanges."Loan Moratorium Start Date" <> 0D then
                CurrentScheduleDate := LoanChanges."Loan Moratorium Start Date";
        end;

        if LoanChanges."Rescheduling Date" = 0D then
            LoanChanges."Rescheduling Date" := LoanRec."Repayment Start Date";

        CurrentLoanBalance := LoanRec."Outstanding Principal";
        if CurrentLoanBalance <= 0 then
            CurrentLoanBalance := LoanChanges."Outstanding Principal";
        if CurrentLoanBalance <= 0 then
            Error('Current loan balance must be greater than zero for loan %1.', LoanChanges."Loan No.");

        if UsePreviewSchedule then begin
            PreviewSchedule.Reset();
            PreviewSchedule.SetRange("Loan No.", TargetLoanNo);
            if PreviewSchedule.FindFirst() then
                PreviewSchedule.DeleteAll();
        end else begin
            LoanSchedule.Reset();
            LoanSchedule.SetRange("Loan No.", TargetLoanNo);
            if LoanSchedule.FindFirst() then
                LoanSchedule.DeleteAll();
        end;

        LoanType.Get(LoanRec."Loan Product Type");

        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then begin
            if LoanChanges."Schedule Balance" > 0 then
                LoanAmount := LoanChanges."Schedule Balance"
            else
                LoanAmount := CurrentLoanBalance;
        end else
            LoanAmount := GetLoanChangeScheduleAmount(LoanChanges, CurrentLoanBalance);
        InterestRate := LoanRec."Annual Interest %";
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then
            RepayPeriod := CurrentScheduleInstallments
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") and (LoanChanges."New Installments" = 0) then
            RepayPeriod := LoanRec.Installments
        else
            RepayPeriod := LoanChanges."New Installments";

        if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium") and
           (LoanChanges."Remaining Installments" > 0) then
            RepayPeriod := LoanChanges."Remaining Installments"
        else if (LoanChanges."Type of Change" <> LoanChanges."Type of Change"::"Interest Calculation Method") and
                (LoanChanges."New Installments" = 0) then
            RepayPeriod := LoanRec.Installments;

        if LoanRec."Total Insurance" > 0 then
            LoanChanges."Insurance Amount" := LoanRec."Total Insurance";

        if LoanRec."Deposit COntribution" > 0 then
            LoanChanges."Deposit Contribution" := LoanRec."Deposit COntribution";

        LBalance := LoanAmount;

        if LoanChanges."Repayment Start Date" <> 0D then
            RunDate := LoanChanges."Repayment Start Date"
        else if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then
            RunDate := CurrentScheduleDate
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") and (LoanRec."Repayment Start Date" <> 0D) then
            RunDate := LoanRec."Repayment Start Date"
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") and (LoanRec."Schedule Start Date" <> 0D) then
            RunDate := LoanRec."Schedule Start Date"
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") then
            RunDate := CalcDate('1M', WorkDate())
        else if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
            if CurrentScheduleDate <> 0D then
                RunDate := CurrentScheduleDate
            else if LoanRec."Repayment Start Date" <> 0D then
                RunDate := LoanRec."Repayment Start Date"
            else if LoanRec."Schedule Start Date" <> 0D then
                RunDate := LoanRec."Schedule Start Date"
            else
                RunDate := CalcDate('1M', WorkDate());

        end else
            RunDate := CalcDate('1M', LoanChanges."Rescheduling Date");

        if LoanChanges."New Principal Grace Period" <> InitDF then
            PrincipalStartDate := CalcDate(LoanChanges."New Principal Grace Period", RunDate)
        // else if LoanChanges."Principal Grace Period" <> InitDF then
        //     PrincipalStartDate := CalcDate(LoanChanges."Principal Grace Period", RunDate)
        else
            PrincipalStartDate := RunDate;

        InterestStartDate := RunDate;

        if LoanChanges."New Interest Calc. Method" <> LoanChanges."Interest Calculation Method" then
            LoanRec."Interest Calculation Method" := LoanChanges."New Interest Calc. Method";

        IntDen := 12;
        if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Daily then
            IntDen := 365
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Weekly then
            IntDen := 52
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
            IntDen := 12
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Quarterly then
            IntDen := 4
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Tri-Annual" then
            IntDen := 3
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Bi-Annual" then
            IntDen := 2
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Yearly then
            IntDen := 1
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then
            IntDen := 1;

        InstalNo := 1;
        repeat
            Months := 12;
            if InstalNo = 1 then
                if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then begin
                    BonusDate := Dmy2date(31, 10, Date2dmy(LoanRec."Disbursement Date", 3));
                    if BonusDate < LoanRec."Disbursement Date" then
                        BonusDate := CalcDate('1Y', BonusDate);

                    CheckDate := CalcDate('1M-CM', LoanRec."Disbursement Date");
                    Months := 0;
                    while CheckDate <= BonusDate do begin
                        Months += 1;
                        CheckDate := CalcDate('1M', CheckDate);
                    end;
                end;

            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then
                InMoratorium := (RunDate >= LoanChanges."Loan Moratorium Start Date") and
                                (RunDate <= LoanChanges."Loan Moratorium End Date")
            else
                InMoratorium := (RunDate >= LoanRec."Loan Moratorium Start Date") and
                                (RunDate <= LoanRec."Loan Moratorium End Date");

            RemainingInstallments := RepayPeriod - InstalNo + 1;
            if RemainingInstallments < 1 then
                RemainingInstallments := 1;

            NonMoratoriumInstallments := RemainingInstallments;
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
                if RunDate >= LoanChanges."Loan Moratorium Start Date" then
                    MoratoriumStarted := true;
            end;

            if MoratoriumStarted then begin
                NonMoratoriumInstallments := 0;
                FutureDate := RunDate;
                FutureInstalNo := InstalNo;
                while FutureInstalNo <= RepayPeriod do begin
                    if (FutureDate < LoanChanges."Loan Moratorium Start Date") or
                       (FutureDate > LoanChanges."Loan Moratorium End Date") then
                        NonMoratoriumInstallments += 1;

                    if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Daily then
                        FutureDate := CalcDate('1D', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Weekly then
                        FutureDate := CalcDate('1W', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                        FutureDate := CalcDate('1M', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Quarterly then
                        FutureDate := CalcDate('1Q', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Bi-Annual" then
                        FutureDate := CalcDate('6M', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Yearly then
                        FutureDate := CalcDate('1Y', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then
                        FutureDate := CalcDate('1Y', FutureDate);

                    FutureInstalNo += 1;
                end;
                if NonMoratoriumInstallments < 1 then
                    NonMoratoriumInstallments := 1;
            end;

            if LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::Amortised then
                if LoanRec."Annual Interest %" = 0 then
                    LoanRec."Interest Calculation Method" := LoanRec."Interest Calculation Method"::"Reducing Balance";

            if LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::Amortised then begin
                LoanRec.TestField("Annual Interest %");
                if InMoratorium then begin
                    LPrincipal := 0;

                    if LoanType."Available on Mobile" then
                        LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                    else
                        LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                    TotalMRepay := LInterest;
                end else begin
                    if not MoratoriumStarted and (AmortisedMonthlyRepayment = 0) then
                        AmortisedMonthlyRepayment := SaccoActivities.SmartRound((InterestRate / IntDen / 100) /
                            (1 - Power((1 + (InterestRate / IntDen / 100)), -(RemainingInstallments))) * LBalance);

                    if MoratoriumStarted then
                        TotalMRepay := SaccoActivities.SmartRound((InterestRate / IntDen / 100) /
                            (1 - Power((1 + (InterestRate / IntDen / 100)), -(NonMoratoriumInstallments))) * LBalance)
                    else
                        TotalMRepay := AmortisedMonthlyRepayment;

                    /*if LoanType."Available on Mobile" then
                        LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                    else*/
                    LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            if LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::"Straight Line" then begin
                if InMoratorium then
                    LPrincipal := 0
                else begin
                    if MoratoriumStarted then
                        StraightLineMonthlyRepayment := SaccoActivities.SmartRound((LBalance / NonMoratoriumInstallments) +
                            (LoanAmount * InterestRate / IntDen / 100))
                    else if StraightLineMonthlyRepayment = 0 then
                        StraightLineMonthlyRepayment := SaccoActivities.SmartRound((LoanAmount / RepayPeriod) +
                            (LoanAmount * InterestRate / IntDen / 100));
                end;

                if LoanType."Available on Mobile" then
                    LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                else
                    LInterest := ROUND(LoanAmount * InterestRate / IntDen / 100, 1, '>');

                if InMoratorium then
                    TotalMRepay := LInterest
                else begin
                    TotalMRepay := StraightLineMonthlyRepayment;
                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            if (LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::"Reducing Balance") or
               (LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::"Reducing Flat")
            then begin
                if InMoratorium then
                    LPrincipal := 0
                else
                    if MoratoriumStarted then
                        if MoratoriumReducingMonthlyPrincipal = 0 then begin
                            MoratoriumReducingMonthlyPrincipal := SaccoActivities.SmartRound(LBalance / NonMoratoriumInstallments);
                            LPrincipal := MoratoriumReducingMonthlyPrincipal;
                        end else
                            LPrincipal := MoratoriumReducingMonthlyPrincipal
                    else begin
                        if ReducingMonthlyPrincipal = 0 then
                            ReducingMonthlyPrincipal := SaccoActivities.SmartRound(LoanAmount / RepayPeriod);
                        LPrincipal := ReducingMonthlyPrincipal;
                    end;

                /* if LoanType."Available on Mobile" then
                    LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                else */
                LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                TotalMRepay := LPrincipal + LInterest;
            end;

            if LoanType."Appraisal Parameter Type" = LoanType."Appraisal Parameter Type"::"Staff Salary" then begin
                if InMoratorium then
                    LPrincipal := 0
                else if MoratoriumStarted then
                    LPrincipal := LBalance / NonMoratoriumInstallments
                else
                    LPrincipal := LoanAmount / RepayPeriod;

                LInterest := (LoanAmount * InterestRate * RepayPeriod) / (200 * InterestRate * RepayPeriod);
            end;

            if MoratoriumStarted and not InMoratorium and (NonMoratoriumInstallments = 1) then begin
                LPrincipal := LBalance;
                TotalMRepay := LPrincipal + LInterest;
            end;

            if PrincipalStartDate <> 0D then
                if RunDate < PrincipalStartDate then
                    LPrincipal := 0;

            if InterestStartDate <> 0D then
                if RunDate < InterestStartDate then
                    LInterest := 0;

            if LPrincipal < 0 then
                LPrincipal := 0;

            LBalance := LBalance - SaccoActivities.SmartRound(LPrincipal);
            Evaluate(RepayCode, Format(InstalNo));

            if UsePreviewSchedule then begin
                if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then begin
                    LoanSchedule.Reset();
                    LoanSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
                    LoanSchedule.SetFilter("Insurance Contribution", '>%1', 0);
                    if LoanSchedule.FindFirst() then
                        LoanChanges."New Insurance Amount" := LoanSchedule."Insurance Contribution";

                end;
                PreviewSchedule.Init();
                PreviewSchedule."Line No." := InstalNo;
                PreviewSchedule."Loan No." := TargetLoanNo;
                PreviewSchedule."Member No." := LoanChanges."Member No.";
                PreviewSchedule."Loan Amount" := LoanAmount;
                if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                    PreviewSchedule."Repayment Date" := CalcDate('CM', RunDate)
                else
                    PreviewSchedule."Repayment Date" := RunDate;
                PreviewSchedule."Monthly Repayment" := SaccoActivities.SmartRound(LInterest + LPrincipal);
                PreviewSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
                PreviewSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
                PreviewSchedule."Monthly Appraisal" := LoanChanges."New Insurance Amount";
                PreviewSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution";

                if LoanChanges."New Deposit Contribution" > 0 then
                    PreviewSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution"
                else
                    PreviewSchedule."Deposit Amount" := LoanChanges."Deposit Contribution";

                if LoanChanges."New Insurance Amount" > 0 then
                    PreviewSchedule."Monthly Appraisal" := LoanChanges."New Insurance Amount"
                else begin
                    if LoanChanges."Insurance Amount" > 0 then
                        PreviewSchedule."Monthly Appraisal" := LoanChanges."Insurance Amount"
                    else
                        PreviewSchedule."Monthly Appraisal" := SaccoActivities.SmartRound(CalculateMonthlyInsurance(LoanRec, LoanType, RunDate));
                end;

                PreviewSchedule."Monthly Repayment" += (PreviewSchedule."Monthly Appraisal" + PreviewSchedule."Deposit Amount");
                PreviewSchedule."Loan Balance" := LBalance;
                PreviewSchedule.Insert();
            end else begin
                LoanSchedule.Init();
                LoanSchedule."Line No." := InstalNo;
                LoanSchedule."Loan No." := TargetLoanNo;
                LoanSchedule."Loan Amount" := LoanAmount;
                if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                    LoanSchedule."Repayment Date" := CalcDate('CM', RunDate)
                else
                    LoanSchedule."Repayment Date" := RunDate;
                LoanSchedule."Monthly Repayment" := SaccoActivities.SmartRound(LInterest + LPrincipal);
                LoanSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
                LoanSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
                LoanSchedule."Insurance Contribution" := LoanChanges."New Insurance Amount";
                LoanSchedule."Loan Balance" := LBalance;
                if LoanChanges."New Deposit Contribution" > 0 then
                    LoanSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution"
                else
                    LoanSchedule."Deposit Amount" := LoanChanges."Deposit Contribution";

                if LoanChanges."New Insurance Amount" > 0 then
                    LoanSchedule."Insurance Contribution" := LoanChanges."New Insurance Amount"
                else begin
                    if LoanChanges."Insurance Amount" > 0 then
                        LoanSchedule."Insurance Contribution" := LoanChanges."Insurance Amount"
                    else
                        LoanSchedule."Insurance Contribution" := SaccoActivities.SmartRound(CalculateMonthlyInsurance(LoanRec, LoanType, RunDate));
                end;
                LoanSchedule."Monthly Repayment" += LoanSchedule."Insurance Contribution";
                LoanSchedule."Monthly Repayment" += LoanSchedule."Deposit Amount";
                LoanSchedule.Insert();
            end;

            if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Daily then
                RunDate := CalcDate('1D', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Weekly then
                RunDate := CalcDate('1W', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                RunDate := CalcDate('1M', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Quarterly then
                RunDate := CalcDate('1Q', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Bi-Annual" then
                RunDate := CalcDate('6M', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Yearly then
                RunDate := CalcDate('1Y', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then
                RunDate := CalcDate('1Y', RunDate);

            InstalNo := InstalNo + 1;
        until (LBalance < 1) or (InstalNo > RepayPeriod);



        if not UsePreviewSchedule then begin
            if LoanChanges."New Insurance Amount" > 0 then
                LoanRec."Total Insurance" := LoanChanges."New Insurance Amount";

            if LoanChanges."New Deposit Contribution" > 0 then
                LoanRec."Deposit COntribution" := LoanChanges."New Deposit Contribution";

            LoanSchedule.Reset();
            LoanSchedule.SetRange("Loan No.", TargetLoanNo);
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
                LoanSchedule.SetFilter("Monthly Principal", '>0');
                if LoanSchedule.FindFirst() then begin
                    LoanRec.Repayment := LoanSchedule."Monthly Repayment";
                    LoanRec."Loan Principle Repayment" := LoanSchedule."Monthly Principal";
                    LoanRec."Loan Interest Repayment" := LoanSchedule."Monthly Interest";
                end;
                LoanSchedule.SetRange("Monthly Principal");
            end;
            if LoanSchedule.FindLast() then
                LoanRec."Completion Date" := LoanSchedule."Repayment Date";

            LoanRec.Modify();
        end;
    end;

    local procedure GenerateLoanChangeRepaymentSchedule(LoanChanges: Record "Loan Changes"; TargetLoanNo: Code[20]; UsePreviewSchedule: Boolean)
    var
        LoanRec: Record Loans;
        LoanSchedule: Record "Loan Repayment Schedule";
        PreviewSchedule: Record "Loan Repayment Schedule II";
        LoanType: Record "Product Setup";
        CurrentLoanBalance: Decimal;
        LoanAmount: Decimal;
        InterestRate: Decimal;
        RepayPeriod: Integer;
        LBalance: Decimal;
        RunDate: Date;
        InstalNo: Integer;
        TotalMRepay: Decimal;
        LInterest: Decimal;
        LPrincipal: Decimal;
        RepayCode: Code[10];
        IntDen: Integer;
        Months: Integer;
        BonusDate: Date;
        CheckDate: Date;
        PrincipalStartDate: Date;
        InterestStartDate: Date;
        InitDF: DateFormula;
        InMoratorium: Boolean;
        RemainingInstallments: Integer;
        AmortisedMonthlyRepayment: Decimal;
        StraightLineMonthlyRepayment: Decimal;
        ReducingMonthlyPrincipal: Decimal;
        RoundedInterest: Decimal;
        NonMoratoriumInstallments: Integer;
        FutureDate: Date;
        FutureInstalNo: Integer;
        MoratoriumStarted: Boolean;
        CurrentScheduleDate: Date;
        CurrentScheduleInstallments: Integer;
        MoratoriumReducingMonthlyPrincipal: Decimal;
    begin
        LoanChanges.TestField("Loan No.");
        /* if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then
            LoanChanges.TestField("New Deposit Contribution")
        else  */
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
            LoanChanges.TestField("Loan Moratorium Start Date");
            LoanChanges.TestField("Loan Moratorium End Date");
            if LoanChanges."Loan Moratorium End Date" < LoanChanges."Loan Moratorium Start Date" then
                Error('Moratorium End Date cannot be before Moratorium Start Date.');
        end else begin
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Rescheduling" then begin
                LoanChanges.TestField("New Installments");
                LoanChanges.TestField("Rescheduling Date");
                LoanChanges.TestField("Repayment Start Date");
            end;
        end;


        LoanRec.Get(LoanChanges."Loan No.");
        LoanRec.CalcFields("Outstanding Principal", "Employer Code");
        LoanRec.TestField("Disbursement Date");

        // An interest-calculation-method change must retain the term from the
        // current live schedule, not the original Installments value on the loan.
        // This is important where a moratorium or earlier rescheduling extended
        // the schedule without changing that original value.
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then begin
            LoanSchedule.Reset();
            LoanSchedule.SetCurrentKey("Loan No.", "Repayment Date", "Member No.");
            LoanSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
            LoanSchedule.SetRange("Repayment Date", LoanChanges."Schedule Start Date", 99991230D);
            LoanSchedule.SetFilter("Line No.", '>0');
            CurrentScheduleInstallments := LoanSchedule.Count();
            if CurrentScheduleInstallments = 0 then
                Error('No remaining repayment-schedule lines were found for loan %1.', LoanChanges."Loan No.");

            if LoanSchedule.FindFirst() then
                CurrentScheduleDate := LoanSchedule."Repayment Date";
        end;

        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
            LoanSchedule.Reset();
            LoanSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
            LoanSchedule.SetRange("Repayment Date", WorkDate(), 99991230D);
            if LoanSchedule.FindFirst() then
                CurrentScheduleDate := LoanSchedule."Repayment Date";

            if Loanchanges."Loan Moratorium Start Date" <> 0D then
                CurrentScheduleDate := LoanChanges."Loan Moratorium Start Date";
        end;

        if LoanChanges."Rescheduling Date" = 0D then
            LoanChanges."Rescheduling Date" := LoanRec."Repayment Start Date";

        CurrentLoanBalance := LoanRec."Outstanding Principal";
        if CurrentLoanBalance <= 0 then
            CurrentLoanBalance := LoanChanges."Outstanding Principal";
        if CurrentLoanBalance <= 0 then
            Error('Current loan balance must be greater than zero for loan %1.', LoanChanges."Loan No.");

        if UsePreviewSchedule then begin
            PreviewSchedule.Reset();
            PreviewSchedule.SetRange("Loan No.", TargetLoanNo);
            if PreviewSchedule.FindFirst() then
                PreviewSchedule.DeleteAll();
        end else begin
            LoanSchedule.Reset();
            LoanSchedule.SetRange("Loan No.", TargetLoanNo);
            if LoanSchedule.FindFirst() then
                LoanSchedule.DeleteAll();
        end;

        LoanType.Get(LoanRec."Loan Product Type");

        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then begin
            if LoanChanges."Schedule Balance" > 0 then
                LoanAmount := LoanChanges."Schedule Balance"
            else
                LoanAmount := CurrentLoanBalance;
        end else
            LoanAmount := GetLoanChangeScheduleAmount(LoanChanges, CurrentLoanBalance);
        InterestRate := LoanRec."Annual Interest %";
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then
            RepayPeriod := CurrentScheduleInstallments
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") and (LoanChanges."New Installments" = 0) then
            RepayPeriod := LoanRec.Installments
        else
            RepayPeriod := LoanChanges."New Installments";

        if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium") and
           (LoanChanges."Remaining Installments" > 0) then
            RepayPeriod := LoanChanges."Remaining Installments"
        else if (LoanChanges."Type of Change" <> LoanChanges."Type of Change"::"Interest Calculation Method") and
                (LoanChanges."New Installments" = 0) then
            RepayPeriod := LoanRec.Installments;

        if LoanRec."Total Insurance" > 0 then
            LoanChanges."Insurance Amount" := LoanRec."Total Insurance";

        if LoanRec."Deposit COntribution" > 0 then
            LoanChanges."Deposit Contribution" := LoanRec."Deposit COntribution";

        LBalance := LoanAmount;

        if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method") and
           (LoanChanges."Schedule Start Date" <> 0D) then
            RunDate := LoanChanges."Schedule Start Date"
        else if LoanChanges."Repayment Start Date" <> 0D then
            RunDate := LoanChanges."Repayment Start Date"
        else if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then begin
            RunDate := CurrentScheduleDate;
            if LoanRec."Loan Moratorium Start Date" <> 0D then
                RunDate := LoanRec."Loan Moratorium Start Date"
            /*else
                if LoanRec."Schedule Start Date" <> 0D then
                    RunDate := LoanRec."Schedule Start Date"
                    */

        end
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") and (LoanRec."Repayment Start Date" <> 0D) then
            RunDate := LoanRec."Repayment Start Date"
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") and (LoanRec."Schedule Start Date" <> 0D) then
            RunDate := LoanRec."Schedule Start Date"
        else if (LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution") then
            RunDate := CalcDate('1M', WorkDate())
        else if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
            if CurrentScheduleDate <> 0D then
                RunDate := CurrentScheduleDate
            else if LoanRec."Repayment Start Date" <> 0D then
                RunDate := LoanRec."Repayment Start Date"
            else if LoanRec."Schedule Start Date" <> 0D then
                RunDate := LoanRec."Schedule Start Date"
            else
                RunDate := CalcDate('1M', WorkDate());

        end else
            RunDate := CalcDate('1M', LoanChanges."Rescheduling Date");

        //changes added on 092426 if loan change is moratarium then the the run date to be the moratarium start date CAl0019
        if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then
            RunDate := LoanChanges."Loan Moratorium Start Date";

        // end of changes 092426

        if LoanChanges."New Principal Grace Period" <> InitDF then
            PrincipalStartDate := CalcDate(LoanChanges."New Principal Grace Period", RunDate)
        // else if LoanChanges."Principal Grace Period" <> InitDF then
        //     PrincipalStartDate := CalcDate(LoanChanges."Principal Grace Period", RunDate)
        else
            PrincipalStartDate := RunDate;

        InterestStartDate := RunDate;

        if LoanChanges."New Interest Calc. Method" <> LoanChanges."Interest Calculation Method" then
            LoanRec."Interest Calculation Method" := LoanChanges."New Interest Calc. Method";

        IntDen := 12;
        if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Daily then
            IntDen := 365
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Weekly then
            IntDen := 52
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
            IntDen := 12
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Quarterly then
            IntDen := 4
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Tri-Annual" then
            IntDen := 3
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Bi-Annual" then
            IntDen := 2
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Yearly then
            IntDen := 1
        else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then
            IntDen := 1;

        InstalNo := 1;
        repeat
            Months := 12;
            if InstalNo = 1 then
                if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then begin
                    BonusDate := Dmy2date(31, 10, Date2dmy(LoanRec."Disbursement Date", 3));
                    if BonusDate < LoanRec."Disbursement Date" then
                        BonusDate := CalcDate('1Y', BonusDate);

                    CheckDate := CalcDate('1M-CM', LoanRec."Disbursement Date");
                    Months := 0;
                    while CheckDate <= BonusDate do begin
                        Months += 1;
                        CheckDate := CalcDate('1M', CheckDate);
                    end;
                end;

            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then
                InMoratorium := (RunDate >= LoanChanges."Loan Moratorium Start Date") and
                                (RunDate <= LoanChanges."Loan Moratorium End Date")
            else
                InMoratorium := (RunDate >= LoanRec."Loan Moratorium Start Date") and
                                (RunDate <= LoanRec."Loan Moratorium End Date");

            RemainingInstallments := RepayPeriod - InstalNo + 1;
            if RemainingInstallments < 1 then
                RemainingInstallments := 1;

            NonMoratoriumInstallments := RemainingInstallments;
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
                if RunDate >= LoanChanges."Loan Moratorium Start Date" then
                    MoratoriumStarted := true;
            end;

            if MoratoriumStarted then begin
                NonMoratoriumInstallments := 0;
                FutureDate := RunDate;
                FutureInstalNo := InstalNo;
                while FutureInstalNo <= RepayPeriod do begin
                    if (FutureDate < LoanChanges."Loan Moratorium Start Date") or
                       (FutureDate > LoanChanges."Loan Moratorium End Date") then
                        NonMoratoriumInstallments += 1;

                    if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Daily then
                        FutureDate := CalcDate('1D', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Weekly then
                        FutureDate := CalcDate('1W', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                        FutureDate := CalcDate('1M', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Quarterly then
                        FutureDate := CalcDate('1Q', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Bi-Annual" then
                        FutureDate := CalcDate('6M', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Yearly then
                        FutureDate := CalcDate('1Y', FutureDate)
                    else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then
                        FutureDate := CalcDate('1Y', FutureDate);

                    FutureInstalNo += 1;
                end;
                if NonMoratoriumInstallments < 1 then
                    NonMoratoriumInstallments := 1;
            end;

            if LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::Amortised then
                if LoanRec."Annual Interest %" = 0 then
                    LoanRec."Interest Calculation Method" := LoanRec."Interest Calculation Method"::"Reducing Balance";

            if LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::Amortised then begin
                LoanRec.TestField("Annual Interest %");
                if InMoratorium then begin
                    LPrincipal := 0;

                    if LoanType."Available on Mobile" then
                        LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                    else
                        LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                    TotalMRepay := LInterest;
                end else begin
                    if not MoratoriumStarted and (AmortisedMonthlyRepayment = 0) then
                        AmortisedMonthlyRepayment := SaccoActivities.SmartRound((InterestRate / IntDen / 100) /
                            (1 - Power((1 + (InterestRate / IntDen / 100)), -(RemainingInstallments))) * LBalance);

                    if MoratoriumStarted then
                        TotalMRepay := SaccoActivities.SmartRound((InterestRate / IntDen / 100) /
                            (1 - Power((1 + (InterestRate / IntDen / 100)), -(NonMoratoriumInstallments))) * LBalance)
                    else
                        TotalMRepay := AmortisedMonthlyRepayment;

                    /*if LoanType."Available on Mobile" then
                        LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                    else*/
                    LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            if LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::"Straight Line" then begin
                if InMoratorium then
                    LPrincipal := 0
                else begin
                    if MoratoriumStarted then
                        StraightLineMonthlyRepayment := SaccoActivities.SmartRound((LBalance / NonMoratoriumInstallments) +
                            (LoanAmount * InterestRate / IntDen / 100))
                    else if StraightLineMonthlyRepayment = 0 then
                        StraightLineMonthlyRepayment := SaccoActivities.SmartRound((LoanAmount / RepayPeriod) +
                            (LoanAmount * InterestRate / IntDen / 100));
                end;

                if LoanType."Available on Mobile" then
                    LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                else
                    LInterest := ROUND(LoanAmount * InterestRate / IntDen / 100, 1, '>');

                if InMoratorium then
                    TotalMRepay := LInterest
                else begin
                    TotalMRepay := StraightLineMonthlyRepayment;
                    LPrincipal := TotalMRepay - LInterest;
                end;
            end;

            if (LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::"Reducing Balance") or
               (LoanRec."Interest Calculation Method" = LoanRec."Interest Calculation Method"::"Reducing Flat")
            then begin
                if InMoratorium then
                    LPrincipal := 0
                else
                    if MoratoriumStarted then
                        if MoratoriumReducingMonthlyPrincipal = 0 then begin
                            MoratoriumReducingMonthlyPrincipal := SaccoActivities.SmartRound(LBalance / NonMoratoriumInstallments);
                            LPrincipal := MoratoriumReducingMonthlyPrincipal;
                        end else
                            LPrincipal := MoratoriumReducingMonthlyPrincipal
                    else begin
                        if ReducingMonthlyPrincipal = 0 then
                            ReducingMonthlyPrincipal := SaccoActivities.SmartRound(LoanAmount / RepayPeriod);
                        LPrincipal := ReducingMonthlyPrincipal;
                    end;

                /* if LoanType."Available on Mobile" then
                    LInterest := ROUND(((InterestRate / 100) * LBalance), 1, '>')
                else */
                LInterest := ROUND(Months / 12 * LBalance * InterestRate / IntDen / 100, 0.01, '=');

                TotalMRepay := LPrincipal + LInterest;
            end;

            if LoanType."Appraisal Parameter Type" = LoanType."Appraisal Parameter Type"::"Staff Salary" then begin
                if InMoratorium then
                    LPrincipal := 0
                else if MoratoriumStarted then
                    LPrincipal := LBalance / NonMoratoriumInstallments
                else
                    LPrincipal := LoanAmount / RepayPeriod;

                LInterest := (LoanAmount * InterestRate * RepayPeriod) / (200 * InterestRate * RepayPeriod);
            end;

            if MoratoriumStarted and not InMoratorium and (NonMoratoriumInstallments = 1) then begin
                LPrincipal := LBalance;
                TotalMRepay := LPrincipal + LInterest;
            end;

            if PrincipalStartDate <> 0D then
                if RunDate < PrincipalStartDate then
                    LPrincipal := 0;

            if InterestStartDate <> 0D then
                if RunDate < InterestStartDate then
                    LInterest := 0;

            if LPrincipal < 0 then
                LPrincipal := 0;

            LBalance := LBalance - SaccoActivities.SmartRound(LPrincipal);
            Evaluate(RepayCode, Format(InstalNo));

            if UsePreviewSchedule then begin
                if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then begin
                    LoanSchedule.Reset();
                    LoanSchedule.SetRange("Loan No.", LoanChanges."Loan No.");
                    LoanSchedule.SetFilter("Insurance Contribution", '>%1', 0);
                    if LoanSchedule.FindFirst() then
                        LoanChanges."New Insurance Amount" := LoanSchedule."Insurance Contribution";

                end;
                PreviewSchedule.Init();
                PreviewSchedule."Line No." := InstalNo;
                PreviewSchedule."Loan No." := TargetLoanNo;
                PreviewSchedule."Member No." := LoanChanges."Member No.";
                PreviewSchedule."Loan Amount" := LoanAmount;
                if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                    PreviewSchedule."Repayment Date" := CalcDate('CM', RunDate)
                else
                    PreviewSchedule."Repayment Date" := RunDate;
                PreviewSchedule."Monthly Repayment" := SaccoActivities.SmartRound(LInterest + LPrincipal);
                PreviewSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
                PreviewSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
                PreviewSchedule."Monthly Appraisal" := LoanChanges."New Insurance Amount";
                PreviewSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution";

                if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Adjust Deposit Contribution" then
                    PreviewSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution"
                else
                    PreviewSchedule."Deposit Amount" := LoanChanges."Deposit Contribution";

                if LoanChanges."New Insurance Amount" > 0 then
                    PreviewSchedule."Monthly Appraisal" := LoanChanges."New Insurance Amount"
                else begin
                    if LoanChanges."Insurance Amount" > 0 then
                        PreviewSchedule."Monthly Appraisal" := LoanChanges."Insurance Amount"
                    else
                        PreviewSchedule."Monthly Appraisal" := SaccoActivities.SmartRound(CalculateMonthlyInsurance(LoanRec, LoanType, RunDate));
                end;

                PreviewSchedule."Monthly Repayment" += (PreviewSchedule."Monthly Appraisal" + PreviewSchedule."Deposit Amount");
                PreviewSchedule."Loan Balance" := LBalance;
                PreviewSchedule.Insert();
            end else begin
                LoanSchedule.Init();
                LoanSchedule."Line No." := InstalNo;
                LoanSchedule."Loan No." := TargetLoanNo;
                LoanSchedule."Loan Amount" := LoanAmount;
                if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                    LoanSchedule."Repayment Date" := CalcDate('CM', RunDate)
                else
                    LoanSchedule."Repayment Date" := RunDate;
                LoanSchedule."Monthly Repayment" := SaccoActivities.SmartRound(LInterest + LPrincipal);
                LoanSchedule."Monthly Interest" := SaccoActivities.SmartRound(LInterest);
                LoanSchedule."Monthly Principal" := SaccoActivities.SmartRound(LPrincipal);
                LoanSchedule."Insurance Contribution" := LoanChanges."New Insurance Amount";
                LoanSchedule."Loan Balance" := LBalance;
                if LoanChanges."New Deposit Contribution" > 0 then
                    LoanSchedule."Deposit Amount" := LoanChanges."New Deposit Contribution"
                else
                    LoanSchedule."Deposit Amount" := LoanChanges."Deposit Contribution";

                if LoanChanges."New Insurance Amount" > 0 then
                    LoanSchedule."Insurance Contribution" := LoanChanges."New Insurance Amount"
                else begin
                    if LoanChanges."Insurance Amount" > 0 then
                        LoanSchedule."Insurance Contribution" := LoanChanges."Insurance Amount"
                    else
                        LoanSchedule."Insurance Contribution" := SaccoActivities.SmartRound(CalculateMonthlyInsurance(LoanRec, LoanType, RunDate));
                end;
                LoanSchedule."Monthly Repayment" += LoanSchedule."Insurance Contribution";
                LoanSchedule."Monthly Repayment" += LoanSchedule."Deposit Amount";
                LoanSchedule.Insert();
            end;

            if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Daily then
                RunDate := CalcDate('1D', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Weekly then
                RunDate := CalcDate('1W', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Monthly then
                RunDate := CalcDate('1M', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Quarterly then
                RunDate := CalcDate('1Q', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::"Bi-Annual" then
                RunDate := CalcDate('6M', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Yearly then
                RunDate := CalcDate('1Y', RunDate)
            else if LoanRec."Repayment Frequency" = LoanRec."Repayment Frequency"::Bonus then
                RunDate := CalcDate('1Y', RunDate);

            InstalNo := InstalNo + 1;
        until (LBalance < 1) or (InstalNo > RepayPeriod);



        if not UsePreviewSchedule then begin
            if LoanChanges."New Insurance Amount" > 0 then
                LoanRec."Total Insurance" := LoanChanges."New Insurance Amount";

            if LoanChanges."New Deposit Contribution" > 0 then
                LoanRec."Deposit COntribution" := LoanChanges."New Deposit Contribution";

            LoanSchedule.Reset();
            LoanSchedule.SetRange("Loan No.", TargetLoanNo);
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Interest Calculation Method" then begin
                // The schedule basis controls only the generated schedule; keep actual loan balance fields unchanged.
                if LoanSchedule.FindLast() then
                    LoanRec."Completion Date" := LoanSchedule."Repayment Date";
            end else
            if LoanChanges."Type of Change" = LoanChanges."Type of Change"::"Loan Moratorium" then begin
                LoanSchedule.SetFilter("Monthly Principal", '>0');
                if LoanSchedule.FindFirst() then begin
                    LoanRec.Repayment := LoanSchedule."Monthly Repayment";
                    LoanRec."Loan Principle Repayment" := LoanSchedule."Monthly Principal";
                    LoanRec."Loan Interest Repayment" := LoanSchedule."Monthly Interest";
                end;
                LoanSchedule.SetRange("Monthly Principal");
            end;
            if (LoanChanges."Type of Change" <> LoanChanges."Type of Change"::"Interest Calculation Method") and
               LoanSchedule.FindLast() then
                LoanRec."Completion Date" := LoanSchedule."Repayment Date";

            LoanRec.Modify();
        end;
    end;





    local procedure VerifyLoanDuplumRule(Loan: Record Loans; AsAt: Date; InterestAmount: Decimal) SkipLoan: Boolean
    var
        SaccoSetup: Record "Sacco Setup";
        ODateFormula: DateFormula;
    begin
        SkipLoan := false;

        SaccoSetup.Get();
        /*SaccoSetup.TestField("Duplum Interest Period");
        if (SaccoSetup."Duplum Interest Period" <> ODateFormula) then begin
            Loan.SetFilter("Date Filter", '..%1', AsAt);
            Loan.CalcFields("Last Int. Due Date", "Outstanding Interest", "Outstanding Principal");
            SkipLoan := ((Loan."Outstanding Interest" + InterestAmount) > Loan."Outstanding Principal");
            if not SkipLoan then begin
                if Loan."Last Int. Due Date" <> 0D then
                    SkipLoan := CalcDate(SaccoSetup."Duplum Interest Period", Loan."Last Int. Due Date") < AsAt;
            end; 
        end;
        */
        if (format(SaccoSetup."Stop Loan Interest After") <> '') then
            if Loans."Completion Date" <> 0D then begin
                if Calcdate(SaccoSetup."Stop Loan Interest After", Loans."Completion Date") < Today then
                    SkipLoan := true;
            end else
                if Loans."Application Date" <> 0D then begin
                    if Calcdate(SaccoSetup."Stop Loan Interest After", Loans."Application Date") < Today then
                        SkipLoan := true;
                end

    end;

    procedure GenerateLoanMonthlyInterest(LoanNo: Code[20]; BDate: Date; PDate: Date; Post: boolean)
    var
        Loans: Record Loans;
        LoanType: Record "Product Setup";
        LineNo: Integer;
        DocNo: Code[20];
        "Document No.": Code[20];
        LoansInterest: Record "Loan Interest Buffer";
        LoanAmount: Decimal;
        CustMember: Record Members;
        CurrDate: Date;
        FirstMonthDate: Date;
        CurrMonth: Date;
        MidDate: Date;
        EndDate: Date;
        LastMonthDate: Date;
        FirstDay: Date;
        FirstDate: Date;
        IntCharged: Decimal;
        Principle: Decimal;
        AlreadyPostedErr: label 'This transaction Is Already posted';
        Memb: Record Members;
        InterestAmount: Decimal;
        BalDate: Date;
        MemberAccounts: Record "Savings Accounts";
        SkipLoan: Boolean;
        SaccoSetup: Record "Sacco Setup";
        LoansBillingDates: Record "Loans Billing Date";
    begin


        //BalDate:=CALCDATE('-1M+CM',BDate);
        SaccoSetup.Get();

        Loans.Get(LoanNo);
        if Loans."Disbursement Date" <> 0D then begin
            //Loans.SetFilter("Disbursement Date",);
        end;

        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Date Filter", '..%1', BDate);
        if SaccoSetup."Minimum Principal Billing" > 0 then
            Loans.SetFilter("Outstanding Principal", '>=%1', SaccoSetup."Minimum Principal Billing")
        else
            Loans.SetFilter("Outstanding Principal", '>%1', 0);
        if Loans.FindSet() then begin

            repeat

            begin
                if LoanType.Get(Loans."Loan Product Type") then begin

                    InterestAmount := SmartRound(GetInterestAmount(Loans."Loan No.", BDate, PDate, true));

                    SkipLoan := VerifyLoanDuplumRule(Loans, BDate, InterestAmount);

                    Loans.CalcFields("Loans Category-SASRA");

                    if Loans."Loans Category-SASRA" = Loans."Loans Category-SASRA"::Loss then
                        SkipLoan := true;

                    if not SkipLoan then begin

                        LoansInterest.Reset;
                        LoansInterest.SetRange("Loan No.", Loans."Loan No.");
                        LoansInterest.SetRange("Interest Date", BDate);
                        LoansInterest.SetRange(Source, LoansInterest.Source::Interest);
                        //LoansInterest.SETRANGE(Reversed,FALSE);
                        if LoansInterest.FindFirst then begin
                            LoansInterest.CalcFields(Reversed);
                            if (LoansInterest.Posted) and (LoansInterest.Reversed = false) then
                                InterestAmount := 0
                            else
                                LoansInterest.Delete;
                        end;

                        if InterestAmount > 0 then begin
                            Loans.CalcFields(Loans."Outstanding Principal", Loans."Outstanding Interest");

                            if CustMember.Get(Loans."Member No.") then begin

                                if Loans."Global Dimension 1 Code" = '' then begin
                                    Loans."Global Dimension 1 Code" := LoanType."Global Dimension 1 Code";
                                    Loans.Modify();
                                    Commit();
                                end;

                                if Loans."Booking Branch" = '' then begin
                                    Loans."Booking Branch" := CustMember."Global Dimension 2 Code";
                                    Loans.Modify();
                                    Commit();
                                end;


                                LoansInterest.Init;
                                LoansInterest."Loan No." := Loans."Loan No.";
                                LoansInterest."Account Type" := LoansInterest."account type"::Credit;
                                LoansInterest."Account No" := Loans."Loan Account";
                                LoansInterest."Interest Date" := BDate;
                                LoansInterest."Member No." := Loans."Member No.";
                                LoansInterest."Issued Date" := Loans."Disbursement Date";
                                LoansInterest."Interest Amount" := InterestAmount;
                                LoansInterest."Posting Date" := PDate;
                                LoansInterest.Description := 'Interest Due' + ' ' + CopyStr(Format(PDate, 0, '<Month Text>'), 1, 3) + ' ' + Format(Date2dmy(BDate, 3));
                                LoansInterest."Global Dimension 1 Code" := Loans."Global Dimension 1 Code";
                                LoansInterest."Global Dimension 2 Code" := Loans."Booking Branch";
                                LoansInterest."Loan Product type" := Loans."Loan Product Type";
                                LoanType.TestField("Loan Interest Income [G/L]");
                                LoansInterest."Bal. Account No." := LoanType."Loan Interest Income [G/L]";
                                LoansInterest.Status := CustMember.Status;
                                LoansInterest."Is Mobile" := Loans."Mobile Loan";
                                LoansInterest."Dimension Set ID" := Loans."Dimension Set ID";
                                LoansInterest."Outstanding Balance" := Loans."Outstanding Principal";
                                LoansInterest."Outstanding Interest" := Loans."Outstanding Interest";
                                LoansInterest.Source := LoansInterest.Source::Interest;
                                LoansInterest.Insert;
                            end;
                        end;
                    end else begin
                        DocNo := CopyStr(UpperCase(Format(PDate, 0, '<Month Text,3> <Year4>')) + '-INT', 1, MaxStrLen(DocNo));
                        SuspendInterest(DocNo, Loans, InterestAmount, PDate, BDate); //Suspended
                    end;
                end;
            end;
            until Loans.Next = 0;
        end;
    end;

