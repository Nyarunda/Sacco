    procedure SmartRound(InputValue: Decimal): Decimal
    var
        SaccoSetup: Record "Sacco Setup";
        RoundedValue: Decimal;
    begin
        SaccoSetup.Get();

        case SaccoSetup."Rounding Precision" of
            0:
                RoundedValue := ROUND(InputValue, 1, '='); // rounds to whole number
            1:
                RoundedValue := ROUND(InputValue, 0.1); // one decimal place
            2:
                RoundedValue := ROUND(InputValue, 0.01); // two decimal places
            else
                Error('Invalid rounding precision: %1', SaccoSetup."Rounding Precision");
        end;

        exit(RoundedValue);
    end;

    procedure SuggestReceiptLinesFromBuffer(RHeader: Record "Receipt Header")
    var
        RcptBufLines: Record "Receipt Buffer Lines";
        TempRHeader: Record "Receipt Header" temporary;
        Cust: Record Customer;
        Savings: Record "Savings Accounts";
        RunBal: Decimal;
        Type: Option LOANS,CUSTOMER,SAVINGS,EXCESS;
        Window: Dialog;
        Counter: Integer;
        Total: Integer;
        ProcessingLbl: Label 'Processing Members... #2########## @1@@@@@@@@@@@@@@@@';
        RLine: Record "Document line";
        ReceiptHeader: Record "Receipt Header";
        TotalAmount: Decimal;
        RunningLineNo: Integer;
        FirstTransNo: Code[35];
        CurrentMemberNo: Code[20];
        TotalBufferAmount: Decimal;
        RemainingReceiptAmount: Decimal;
        MemberGeneratedAmount: Decimal;
        TotalGeneratedAmount: Decimal;
        PreservedDistributionAmount: Decimal;
    begin
        if ReceiptHeader.Get(RHeader."No.") then
            RHeader := ReceiptHeader;

        RHeader.TestField("Amount Recieved");

        RLine.Reset();
        RLine.SetRange("Header No.", RHeader."No.");
        if not RLine.IsEmpty() then begin
            if Confirm('Existing distribution lines found for this receipt. Do you want to clear them and re-suggest?', false) then
                DeleteUnpostedReceiptDistributionLines(RHeader."No.")
            else
                exit;
        end;

        RLine.Reset();
        RLine.SetRange("Header No.", RHeader."No.");
        RLine.CalcSums(Amount);
        PreservedDistributionAmount := RLine.Amount;

        RcptBufLines.SetRange("Batch No", RHeader."No.");
        RcptBufLines.SetRange("Member Found", true);
        if RcptBufLines.IsEmpty() then
            Error('No validated buffer lines found. Please run validation first.');

        RcptBufLines.Reset();
        RcptBufLines.SetCurrentKey("Line No.");
        RcptBufLines.SetAscending("Line No.", true);
        RcptBufLines.SetRange("Batch No", RHeader."No.");
        RcptBufLines.SetRange("Member Found", true);
        if RcptBufLines.FindSet() then
            repeat
                if not BulkReceiptGroupAlreadyPosted(RHeader."No.", RcptBufLines."Member No", RcptBufLines."Transaction No.") then
                    TotalBufferAmount += RcptBufLines.Amount;
            until RcptBufLines.Next() = 0;

        Total := CountUnpostedReceiptBufferGroups(RHeader."No.");
        if Total = 0 then begin
            Message('All validated buffer lines for receipt %1 already have posted G/L entries. Nothing was re-suggested.', RHeader."No.");
            exit;
        end;

        RunningLineNo := 0;
        RemainingReceiptAmount := RHeader."Amount Recieved" - PreservedDistributionAmount;
        if RemainingReceiptAmount < 0 then
            Error(
                'Existing posted distribution lines amount %1 exceeds the receipt amount received %2. Review receipt %3 before re-suggesting.',
                PreservedDistributionAmount,
                RHeader."Amount Recieved",
                RHeader."No.");
        Window.Open(ProcessingLbl);

        RcptBufLines.Reset();
        RcptBufLines.SetCurrentKey("Line No.");
        RcptBufLines.SetAscending("Line No.", true);
        RcptBufLines.SetRange("Batch No", RHeader."No.");
        RcptBufLines.SetRange("Member Found", true);
        if RcptBufLines.FindSet() then
            repeat
                if not BulkReceiptGroupAlreadyPosted(RHeader."No.", RcptBufLines."Member No", RcptBufLines."Transaction No.") then begin
                    Counter += 1;
                    Window.Update(1, Round(Counter / Total * 10000, 1));
                    Window.Update(2, RcptBufLines."Member No");
                    CurrentMemberNo := RcptBufLines."Member No";
                    TotalAmount := RcptBufLines.Amount;
                    if TotalAmount > RemainingReceiptAmount then
                        Error('Receipt %1 has only %2 remaining, but buffer line %3 for member %4 transaction %5 requires %6. Increase the receipt amount or reduce earlier buffer allocations.',
                            RHeader."No.", RemainingReceiptAmount, RcptBufLines."Line No.", CurrentMemberNo, RcptBufLines."Transaction No.", RcptBufLines.Amount);

                    FirstTransNo := RcptBufLines."Transaction No.";
                    RunBal := TotalAmount;

                    if RunBal > 0 then begin
                        Clear(Cust);
                        TempRHeader.Init();
                        TempRHeader.TransferFields(RHeader);
                        TempRHeader."Customer No." := CurrentMemberNo;
                        TempRHeader."Amount Recieved" := TotalAmount;
                        TempRHeader."External Document No" := FirstTransNo;

                        if TempRHeader."Customer Type" = TempRHeader."Customer Type"::Customer then begin
                            Cust.Reset();
                            Cust.SetRange("No.", TempRHeader."Customer No.");
                            if Cust.FindFirst() then begin
                                InItRecType(Cust, Savings, Loans, Type::CUSTOMER);
                                InsertReceiptLines(TempRHeader, Cust, RunBal, '', '', Type::CUSTOMER, RunningLineNo);
                            end;
                        end;

                        InsertReceiptLines(TempRHeader, Cust, RunBal, '', '', Type::LOANS, RunningLineNo);
                        InsertReceiptLines(TempRHeader, Cust, RunBal, '', '', Type::SAVINGS, RunningLineNo);

                        if RunBal > 0 then
                            InsertReceiptLines(TempRHeader, Cust, RunBal, '', '', Type::EXCESS, RunningLineNo);

                        MemberGeneratedAmount := TotalAmount - RunBal;
                        if MemberGeneratedAmount <> TotalAmount then
                            Error('Buffer line %1 for member %2 transaction %3 has amount %4, but only %5 was suggested. Review the member distribution setup.',
                                RcptBufLines."Line No.", CurrentMemberNo, FirstTransNo, TotalAmount, MemberGeneratedAmount);

                        TotalGeneratedAmount += MemberGeneratedAmount;
                        RemainingReceiptAmount -= MemberGeneratedAmount;

                    end;
                end;
            until (RcptBufLines.Next() = 0) or (RemainingReceiptAmount <= 0);

        Window.Close();

        RLine.Reset();
        RLine.SetCurrentKey("Line No.");
        RLine.SetAscending("Line No.", true);
        RLine.SetRange("Header No.", RHeader."No.");
        RLine.CalcSums(Amount);
        if RLine.Amount > RHeader."Amount Recieved" then
            Error('Suggested distribution amount %1 exceeds the receipt amount received %2. Review the receipt distribution rules before posting.',
                RLine.Amount, RHeader."Amount Recieved");

        if TotalGeneratedAmount <> TotalBufferAmount then
            Error('Suggested distribution total %1 does not match the generated buffer amount %2.', TotalGeneratedAmount, TotalBufferAmount);

        if TotalBufferAmount > RHeader."Amount Recieved" then
            Message('Distribution suggested for %1 buffer line(s). Validated buffer amount %2 was capped to the receipt amount received %3.',
                Counter, TotalBufferAmount, RHeader."Amount Recieved")
        else
            Message('Distribution suggested for %1 buffer line(s).', Counter);
    end;

