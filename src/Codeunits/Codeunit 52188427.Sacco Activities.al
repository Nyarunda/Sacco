    procedure LoanRecoveryLogs(LoanNo: Code[20]; RecoveryDate: Date): Boolean;
    var
        i: Integer;
        Logs: Record "Loans Recovery Logs";
    begin
        Logs.Reset();
        Logs.Setrange("Loan No", LoanNo);
        Logs.Setrange("Recovery Date", Calcdate('-CM', RecoveryDate), Calcdate('CM', RecoveryDate));
        if Logs.findfirst() then
            Exit(false);

        Logs.reset();
        if Logs.findlast() then
            i := Logs."entry no";

        Logs.InIt();
        Logs."Loan No" := LoanNo;
        Logs."Entry No" := i + 1;
        Logs."Recovery Date" := RecoveryDate;
        if Logs.Insert() then
            exit(true)
    end;

    procedure GetMonthlyDepositAmount(SavingsNo: Code[20]; LoanNo: Code[20]): Decimal
    var
        Loans: Record Loans;
        LSchedule: Record "Loan Repayment Schedule";
    begin
        Loans.Reset();
        Loans.SetRange("Member No.", SavingsNo);
        Loans.SetRange(Posted, true);
        if LoanNo <> '' then
            Loans.SetRange("Loan No.", LoanNo);
        Loans.SetFilter("Outstanding Principal", '>0');
        if Loans.FindSet() then
            repeat
                LSchedule.Reset();
                LSchedule.SetRange("Loan No.", Loans."Loan No.");
                LSchedule.Setfilter("Deposit Amount", '>0');
                if LSchedule.FindFirst() then
                    exit(LSchedule."Deposit Amount");

            until Loans.Next() = 0;

        exit(0);
    end;

    Procedure GenerateSavingssInterest(SavingsInterestHeader: Record "Savings Interest Header")
    var
        InterestBuffer: Record "Savings Interest Lines";
        InterestBuffer2: Record "Savings Interest Lines";
        SavingsAccounts: Record "Savings Accounts";
        SavingsAccounts2: Record "Savings Accounts";
        DateFilter: Text[100];
        ProductFactory: Record "Product Setup";
        ProductFactoryCode: Code[20];
        InterestRate: Decimal;
        PayableAccount: Code[20];
        ExpenseAccount: Code[20];
        Members: Record Members;
        MSGConfirmation: Label 'Confirm interest Generation for period starting %1 and Ending %2';
        LowestBal: Decimal;
        InterestAmount: Decimal;
        Counter1: Integer;
        diaProgress: Dialog;
    begin
        ValidateInterestHeaderFields(SavingsInterestHeader);

        if not ConfirmInterestGeneration(SavingsInterestHeader."Start Date", SavingsInterestHeader."End Date") then
            exit;

        ClearExistingInterestEntries(SavingsInterestHeader."No.");
        DateFilter := FormatDateFilter(SavingsInterestHeader."Start Date", SavingsInterestHeader."End Date");

        diaProgress.Open('INTEREST GENERATION: #1############################\#2########################################\Progress: @3@@@@@@@@@@@@@@@@@@@@@@@@@@@@');
        Counter1 := 0;

        SavingsAccounts.Reset();
        SavingsAccounts.SetFilter("Date Filter", DateFilter);
        if SavingsAccounts.FindSet() then begin
            repeat
                if ShouldProcessAccount(SavingsAccounts) then begin
                    if ProductFactory.Get(SavingsAccounts."Product Type") then begin
                        if IsValidSavingsProduct(ProductFactory) then begin
                            diaProgress.Update(2, SavingsAccounts."No." + '-' + SavingsAccounts.Name);

                            InterestRate := ProductFactory."Interest Rate (Min.)";
                            PayableAccount := ProductFactory."Interest Payable Account";
                            ExpenseAccount := ProductFactory."Interest Expense Account";
                            InterestAmount := 0;

                            case SavingsInterestHeader.Type of
                                SavingsInterestHeader.Type::Monthly:
                                    ProcessMonthlyInterest(SavingsAccounts, SavingsInterestHeader, InterestBuffer, LowestBal, InterestAmount, InterestRate, PayableAccount, ExpenseAccount, Members);
                                SavingsInterestHeader.Type::Yearly:
                                    ProcessYearlyInterest(SavingsAccounts, SavingsInterestHeader, InterestBuffer, LowestBal, InterestAmount, InterestRate, PayableAccount, ExpenseAccount, Members);
                            end;

                            diaProgress.Update(3, Counter1);
                            Counter1 += 1;
                        end;
                    end;
                end;
            until SavingsAccounts.Next() = 0;
        end;

        diaProgress.Close();
    end;

    local procedure ValidateInterestHeaderFields(var SavingsInterestHeader: Record "Savings Interest Header")
    begin
        SavingsInterestHeader.TestField(Posted, false);
        SavingsInterestHeader.TestField("Start Date");
        SavingsInterestHeader.TestField("End Date");
        SavingsInterestHeader.TestField(Description);
    end;

    local procedure ConfirmInterestGeneration(StartDate: Date; EndDate: Date): Boolean
    var
        MSGConfirmation: Label 'Confirm interest Generation for period starting %1 and Ending %2';
    begin
        exit(Confirm(MSGConfirmation, true, StartDate, EndDate));
    end;

    local procedure ClearExistingInterestEntries(HeaderNo: Code[20])
    var
        InterestBuffer2: Record "Savings Interest Lines";
    begin
        InterestBuffer2.Reset();
        InterestBuffer2.SetRange(No, HeaderNo);
        if InterestBuffer2.FindSet() then
            InterestBuffer2.DeleteAll();
    end;

    local procedure FormatDateFilter(StartDate: Date; EndDate: Date): Text[100]
    var
        FromDate: Text[100];
        ToDate: Text[100];
    begin
        FromDate := Format(StartDate);
        ToDate := Format(EndDate);
        exit(FromDate + '..' + ToDate);
    end;

    local procedure ShouldProcessAccount(var SavingsAccounts: Record "Savings Accounts"): Boolean
    var
        SavingsAccounts2: Record "Savings Accounts";
    begin
        SavingsAccounts2.Reset();
        SavingsAccounts2.SetRange("No.", SavingsAccounts."No.");
        SavingsAccounts2.SetFilter(Status, '=%1|=%2', SavingsAccounts2.Status::Active, SavingsAccounts2.Status::Dormant);
        SavingsAccounts2.SetFilter("Balance (LCY)", '>0');
        exit(SavingsAccounts2.FindFirst());
    end;

    local procedure IsValidSavingsProduct(var ProductFactory: Record "Product Setup"): Boolean
    begin
        exit((ProductFactory."Product Class" = ProductFactory."Product Class"::Savings) and (ProductFactory."Earns Interest" = true));
    end;

    local procedure ProcessMonthlyInterest(var SavingsAccounts: Record "Savings Accounts"; var SavingsInterestHeader: Record "Savings Interest Header"; var InterestBuffer: Record "Savings Interest Lines"; var LowestBal: Decimal; var InterestAmount: Decimal; InterestRate: Decimal; PayableAccount: Code[20]; ExpenseAccount: Code[20]; var Members: Record Members)
    begin
        LowestBal := 0;
        InterestAmount := GetMonthlyInterest(SavingsAccounts."No.", SavingsInterestHeader."Start Date", SavingsInterestHeader."End Date", LowestBal);
        CreateInterestBufferEntry(InterestBuffer, SavingsInterestHeader, SavingsAccounts, LowestBal, InterestAmount, InterestRate, PayableAccount, ExpenseAccount, Members, CalcDate('<CM>', SavingsInterestHeader."Start Date"));
    end;

    local procedure ProcessYearlyInterest(var SavingsAccounts: Record "Savings Accounts"; var SavingsInterestHeader: Record "Savings Interest Header"; var InterestBuffer: Record "Savings Interest Lines"; var LowestBal: Decimal; var InterestAmount: Decimal; InterestRate: Decimal; PayableAccount: Code[20]; ExpenseAccount: Code[20]; var Members: Record Members)
    var
        TestDate: Date;
        MonthStart: Date;
    begin
        MonthStart := SavingsInterestHeader."Start Date";
        TestDate := MonthStart;
        InterestAmount := 0;

        while TestDate <= SavingsInterestHeader."End Date" do begin
            LowestBal := 0;
            InterestAmount += GetMonthlyInterest(SavingsAccounts."No.", MonthStart, CalcDate('<CM>', MonthStart), LowestBal);
            TestDate := CalcDate('<1M+CM>', TestDate);
            MonthStart := CalcDate('<-CM>', TestDate);
        end;

        CreateInterestBufferEntry(InterestBuffer, SavingsInterestHeader, SavingsAccounts, LowestBal, InterestAmount, InterestRate, PayableAccount, ExpenseAccount, Members, SavingsInterestHeader."End Date");
    end;

    local procedure CreateInterestBufferEntry(var InterestBuffer: Record "Savings Interest Lines"; var SavingsInterestHeader: Record "Savings Interest Header"; var SavingsAccounts: Record "Savings Accounts"; LowestBal: Decimal; InterestAmount: Decimal; InterestRate: Decimal; PayableAccount: Code[20]; ExpenseAccount: Code[20]; var Members: Record Members; InterestDate: Date)
    begin
        if InterestAmount = 0 then
            exit;

        InterestBuffer.Init();
        InterestBuffer.No := SavingsInterestHeader."No.";
        InterestBuffer."Account No" := SavingsAccounts."No.";
        InterestBuffer.Name := SavingsAccounts.Name;
        InterestBuffer."Account Type" := InterestBuffer."Account Type"::Savings;
        InterestBuffer."Bal. Account Type" := InterestBuffer."Bal. Account Type"::"G/L Account";
        InterestBuffer."Payable Account" := PayableAccount;
        InterestBuffer."Expense Account" := ExpenseAccount;
        InterestBuffer."Account Balance" := LowestBal;
        InterestBuffer.Description := SavingsInterestHeader.Description;
        InterestBuffer."Interest Date" := InterestDate;
        InterestBuffer."Interest Rate" := InterestRate;
        InterestBuffer."Interest Amount" := InterestAmount;
        InterestBuffer."Product Factory Code" := SavingsAccounts."Product Type";

        if Members.Get(SavingsAccounts."Member No.") then begin
            InterestBuffer."Shortcut Dimension 1 Code" := Members."Global Dimension 1 Code";
            InterestBuffer."Shortcut Dimension 2 Code" := Members."Global Dimension 2 Code";
        end;

        InterestBuffer."User ID" := UserId();
        InterestBuffer.Insert(true);
    end;

    procedure GetMonthlyInterest(AccNo: Code[20]; MonthStart: Date; MonthEnd: Date; var LowestBal: Decimal): Decimal
    var
        SavAcc: Record "Savings Accounts";
        ProductFactory: Record "Product Setup";
        CheckDate: Date;
        Turn: Integer;
        IntAmount: Decimal;
        Bal: Decimal;
    begin
        CheckDate := MonthStart;
        Turn := 0;
        LowestBal := 0;

        while CheckDate <= MonthEnd do begin
            SavAcc.Reset();
            SavAcc.SetRange("No.", AccNo);
            SavAcc.SetFilter("Date Filter", '..' + Format(CheckDate));
            if SavAcc.FindFirst() then begin
                if ProductFactory.Get(SavAcc."Product Type") then begin
                    if (ProductFactory."Product Class" = ProductFactory."Product Class"::Savings) and (ProductFactory."Earns Interest" = true) then begin
                        if (ProductFactory."Product Category" = ProductFactory."Product Category"::"Ordinary Savings") or (ProductFactory."Product Category" = ProductFactory."Product Category"::"Junior Savings") then begin
                            SavAcc.CalcFields("Net Change (LCY)", "Balance (LCY)");
                            Bal := SavAcc."Net Change (LCY)";

                            if Turn = 0 then
                                LowestBal := Bal
                            else if LowestBal > Bal then
                                LowestBal := Bal;
                        end;
                    end;
                end;
            end;

            Turn += 1;
            CheckDate := CalcDate('1D', CheckDate);
        end;

        IntAmount := 0;
        if LowestBal >= ProductFactory."Interest Calc Min Balance" then
            IntAmount := Round(LowestBal * (ProductFactory."Interest Rate (Min.)" / 100) * (1 / 12), 0.01, '=');

        exit(IntAmount);
    end;

    procedure PostSavingsInterest(SavingsInterestHeader: Record "Savings Interest Header")
    var
        InterestBuffer: Record "Savings Interest Lines";
        UserSetup: Record "User Setup";
        GenJournalLine: Record "Gen. Journal Line";
        JTemp: Code[20];
        JBatch: Code[20];
        LineNo: Integer;
        ErrPosted: Label 'This document has already been posted';
        ErrNoEntries: Label 'This Document has no Lines to post';
    begin
        if not Confirm('Do you want to post the journal lines?') then
            exit;

        ValidatePostingPrerequisites(SavingsInterestHeader);
        GetJournalTemplate(JTemp, JBatch);
        ClearJournalBatch(JTemp, JBatch);

        LineNo := 0;
        InterestBuffer.Reset();
        InterestBuffer.SetRange(No, SavingsInterestHeader."No.");
        InterestBuffer.SetRange(Posted, false);
        if InterestBuffer.FindSet() then begin
            repeat
                LineNo += 10000;
                CreateInterestJournalLine(GenJournalLine, JTemp, JBatch, LineNo, SavingsInterestHeader, InterestBuffer);
                PostMemberInterestToAccount(InterestBuffer, SavingsInterestHeader."Posting Date", SavingsInterestHeader.Description, JTemp, JBatch, LineNo);
                InterestBuffer.Posted := true;
                InterestBuffer.Modify();
                Commit();
            until InterestBuffer.Next() = 0;
        end;

        PostJournalLines(JTemp, JBatch);
        SendSavingsInterestNotifications(SavingsInterestHeader);

        Message('Posted Successfully');
        SavingsInterestHeader.Posted := true;
        SavingsInterestHeader."Posted By" := UserId();
        SavingsInterestHeader."Posting Date" := Today();
        SavingsInterestHeader.Modify();
    end;

    local procedure ValidatePostingPrerequisites(var SavingsInterestHeader: Record "Savings Interest Header")
    var
        ErrPosted: Label 'This document has already been posted';
        ErrNoEntries: Label 'This Document has no Lines to post';
    begin
        if SavingsInterestHeader.Posted then
            Error(ErrPosted);

        SavingsInterestHeader.CalcFields("Distributed Amount");
        if SavingsInterestHeader."Distributed Amount" = 0 then
            Error(ErrNoEntries);
    end;

    local procedure GetJournalTemplate(var JTemp: Code[20]; var JBatch: Code[20])
    var
        UserSetup: Record "User Setup";
    begin
        UserSetup.Get(UserId());
        JTemp := UserSetup."CashRec Journal Template";
        JBatch := UserSetup."CashRec Journal Batch";
    end;

    local procedure ClearJournalBatch(JTemp: Code[20]; JBatch: Code[20])
    var
        GenJournalLine: Record "Gen. Journal Line";
    begin
        GenJournalLine.Reset();
        GenJournalLine.SetRange("Journal Template Name", JTemp);
        GenJournalLine.SetRange("Journal Batch Name", JBatch);
        if GenJournalLine.FindSet() then
            GenJournalLine.DeleteAll();
    end;

    local procedure CreateInterestJournalLine(var GenJournalLine: Record "Gen. Journal Line"; JTemp: Code[20]; JBatch: Code[20]; LineNo: Integer; var SavingsInterestHeader: Record "Savings Interest Header"; var InterestBuffer: Record "Savings Interest Lines")
    var
        TotalInterestAmount: Decimal;
    begin
        // Calculate total interest (current + old interest amount)
        TotalInterestAmount := InterestBuffer."Interest Amount" + InterestBuffer."Old Interest Amount";

        GenJournalLine.Init();
        GenJournalLine."Journal Template Name" := JTemp;
        GenJournalLine."Journal Batch Name" := JBatch;
        GenJournalLine."Line No." := LineNo;
        GenJournalLine."Account Type" := GenJournalLine."Account Type"::"G/L Account";
        GenJournalLine."Account No." := InterestBuffer."Expense Account";
        GenJournalLine.Validate(GenJournalLine."Account No.");
        GenJournalLine."Document No." := SavingsInterestHeader."Document No.";
        GenJournalLine."Posting Date" := SavingsInterestHeader."Posting Date";
        GenJournalLine.Description := SavingsInterestHeader.Description;
        GenJournalLine.Amount := TotalInterestAmount;
        GenJournalLine.Validate(GenJournalLine.Amount);
        GenJournalLine."Bal. Account Type" := GenJournalLine."Bal. Account Type"::"G/L Account";
        GenJournalLine."Bal. Account No." := InterestBuffer."Payable Account";
        GenJournalLine.Validate(GenJournalLine."Bal. Account No.");
        GenJournalLine."Shortcut Dimension 1 Code" := InterestBuffer."Shortcut Dimension 1 Code";
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 1 Code");
        GenJournalLine."Shortcut Dimension 2 Code" := InterestBuffer."Shortcut Dimension 2 Code";
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 2 Code");

        if GenJournalLine.Amount <> 0 then
            GenJournalLine.Insert();
    end;

    local procedure PostJournalLines(JTemp: Code[20]; JBatch: Code[20])
    var
        GenJournalLine: Record "Gen. Journal Line";
    begin
        GenJournalLine.Reset();
        GenJournalLine.SetRange("Journal Template Name", JTemp);
        GenJournalLine.SetRange("Journal Batch Name", JBatch);
        if GenJournalLine.FindSet() then
            Codeunit.Run(Codeunit::"Gen. Jnl.-Post New", GenJournalLine);
    end;

    local procedure PostMemberInterestToAccount(var InterestBuffer: Record "Savings Interest Lines"; PostingDate: Date; Description: Text[100]; JTemp: Code[20]; JBatch: Code[20]; var LineNo: Integer)
    var
        SavingsAccounts: Record "Savings Accounts";
        GenJournalLine: Record "Gen. Journal Line";
        TotalInterestAmount: Decimal;
    begin
        // Get the savings account
        if not SavingsAccounts.Get(InterestBuffer."Account No") then
            exit;

        // Calculate total interest (current + old interest amount)
        TotalInterestAmount := InterestBuffer."Interest Amount" + InterestBuffer."Old Interest Amount";

        if TotalInterestAmount = 0 then
            exit;

        // Create journal line to credit member account (customer ledger entry)
        LineNo += 10000;
        GenJournalLine.Init();
        GenJournalLine."Journal Template Name" := JTemp;
        GenJournalLine."Journal Batch Name" := JBatch;
        GenJournalLine."Line No." := LineNo;
        GenJournalLine."Account Type" := GenJournalLine."Account Type"::Savings;
        GenJournalLine."Account No." := InterestBuffer."Account No";
        GenJournalLine.Validate(GenJournalLine."Account No.");
        GenJournalLine."Document No." := InterestBuffer.No;
        GenJournalLine."Posting Date" := PostingDate;
        GenJournalLine.Description := Description;
        GenJournalLine.Amount := TotalInterestAmount * -1;
        GenJournalLine.Validate(GenJournalLine.Amount);
        GenJournalLine."Bal. Account Type" := GenJournalLine."Bal. Account Type"::"G/L Account";
        GenJournalLine."Bal. Account No." := InterestBuffer."Payable Account";
        GenJournalLine.Validate(GenJournalLine."Bal. Account No.");
        GenJournalLine."Shortcut Dimension 1 Code" := InterestBuffer."Shortcut Dimension 1 Code";
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 1 Code");
        GenJournalLine."Shortcut Dimension 2 Code" := InterestBuffer."Shortcut Dimension 2 Code";
        GenJournalLine.Validate(GenJournalLine."Shortcut Dimension 2 Code");

        if GenJournalLine.Amount <> 0 then
            GenJournalLine.Insert();
    end;


    procedure GetPricingScore(DocType: Enum "RFQ Document Type"; Budget: Decimal;
                                           Actual: Decimal): Decimal
    var
        Param: Record "RFQ Scoring Criteria Setup";
    begin
        Param.SetRange("Document Type", DocType);
        Param.SetRange("Criteria Type", "RFQ Criteria Type"::Pricing);
        if Param.FindFirst() then
            // Traditional RFQ formula: (Budget / Actual) * Max Weight
            exit((Budget / Actual) * Param."Weight %");

        exit(0);
    end;

}


