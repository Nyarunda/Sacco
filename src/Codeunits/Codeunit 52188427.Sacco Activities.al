    procedure CreateCreditAccount(var Loans: record Loans) AcctNo: Code[20]
    var
        CrAccount: Record "Credit Accounts";
        ProdFac: Record "Product Setup";
        Member: Record Members;
    begin
        ProdFac.Get(Loans."Loan Product Type");
        AcctNo := ProdFac."Product ID" + '-' + Loans."Member No.";
        CrAccount.Reset();
        CrAccount.SetRange("No.", AcctNo);
        if CrAccount.FindFirst() then begin
            if CrAccount."Product Type" <> ProdFac."Product ID" then begin
                CrAccount."Product Type" := ProdFac."Product ID"; //*
                CrAccount."Product Name" := ProdFac.Description;
                CrAccount.modify;
            end;
            exit(AcctNo)
        end
        else begin
            Member.Get(Loans."Member No.");
            CrAccount.Init;
            CrAccount."No." := AcctNo;
            CrAccount."Date of Birth" := Member."Date of Birth";
            CrAccount.Name := Member.Name;
            CrAccount.Validate(CrAccount.Name);
            CrAccount."ID No." := Member."ID No.";
            CrAccount."Member No." := Member."No.";
            CrAccount."Employer Code" := Member."Employer Code";
            CrAccount.Status := CrAccount.Status::New;
            CrAccount."Account Category" := Member."Account Category";
            CrAccount."Date of Birth" := Member."Date of Birth";
            CrAccount.City := Member.City;
            CrAccount."Phone No." := Member."Mobile Phone No.";
            CrAccount."Post Code" := Member."Post Code";
            CrAccount.County := Member.County;
            CrAccount."E-Mail" := Member."E-Mail";
            CrAccount."Product Type" := ProdFac."Product ID"; //*
            CrAccount."Product Name" := ProdFac.Description;
            CrAccount."Customer Posting Group" := ProdFac."Product Posting Group";
            CrAccount.Insert(true);
            Commit();
            //MESSAGE('%1',Accounts);
            exit(AcctNo);
        end;
    end;

    procedure PostLoan(LoanNo: Code[20]; DocNo: Code[20]; BatchPosting: Boolean; var BatchAmt: Decimal; PDate: Date)
    var
        Loans: Record Loans;
        JTemplate: Code[10];
        JBatch: Code[10];
        CurrDay: Integer;
        TDays1: Integer;
        Days1: Integer;
        Desc: Text[50];
        ExtDocNo: Code[20];
        Dim1: Code[10];
        Dim2: Code[10];
        RecoverInt: Boolean;
        LoanType: Record "Product Setup";
        NetLoanAmt: Decimal;
        LoanCharges: Record "Loan Charges";
        TopUp: Record "Loan Top Up";
        TopUpLoan: Record Loans;
        TopUpAmt: Decimal;
        MonthlyInterest: Decimal;
        TDays: Integer;
        Days: Integer;
        EndMonth: Date;
        IntDue: Decimal;
        MemberAccounts: Record "Savings Accounts";
        TopUpProduct: Record "Product Setup";
        PortalLoans: Record "Portal Loans";
        OtherClearance: Record "Other Committments Clearance";
        LRec: Record Loans;
        LoanRunBal: Decimal;
        ArrearsAmt: Decimal;
        ArrearsRecovery: Record "Arrears Recovery";
        Lns: Record Loans;
        BankAccounts: Record "HR Employee Bank Accounts";
        ChargeDecision: Integer;
        SkipThisCharge: Boolean;
        PostComm: Boolean;
        ExciseDuty: Decimal;
        TopUpChanged: Boolean;
    begin
        Loans.Reset();
        Loans.SetRange("Loan No.", LoanNo);
        if not Loans.FindFirst() then
            Error('Loan No. %1 not found.', LoanNo);

        if Loans.Posted then
            Error('Loan No. %1 has already been posted.', Loans."Loan No.");

        //VALARIE: CODE BELOW COMMENTED FOR CLIENT TO POST DIRECTLY
        //SEARCH: POST DIRECTLY
        //if Loans.Status <> Loans.Status::Approved then
        //  Error('Loan No. %1 has not been Approved.', Loans."Loan No.");

        // if Loans."Mode of Disbursement" = Loans."mode of disbursement"::" " then
        //     Error('Mode of Disbursement Not Captured for Loan No. %1.', Loans."Loan No.");

        Loans.TestField("Approved Amount");
        Loans.TestField("Amount To Disburse");
        Loans.TestField("Member No.");
        Loans.TestField("Loan Product Type");
        Loans.TestField("Loan Account");


        // Validate source accounts exist before proceeding
        BankAccounts.Reset();
        BankAccounts.SetRange("Loan No.", Loans."Loan No.");
        if BankAccounts.IsEmpty() then
            Error('No source bank accounts defined for Loan %1. Please define source accounts before posting.', Loans."Loan No.");

        UserSetup.Get(UserId);
        UserSetup.TestField("Payment Journal Template");
        UserSetup.TestField("Payment Journal Batch");
        JTemplate := UserSetup."Payment Journal Template";
        JBatch := UserSetup."Payment Journal Batch";
        Dim1 := Loans."Global Dimension 1 Code";
        Dim2 := Loans."Booking Branch";

        PDate := Loans."Disbursement Date";

        SaccoSetup.Get();
        LoanType.Get(Loans."Loan Product Type");
        LoanType.TestField(Description);
        Loans."Loan Product Type Name" := LoanType.Description;

        ChargeDecision := GetAssetChargeToPost(Loans, LoanType);

        // Validate TopUp amounts have not changed
        TopUp.Reset();
        TopUp.SetRange("Loan No.", Loans."Loan No.");
        TopUp.SetFilter("Principle Top Up", '>0');
        if TopUp.FindFirst() then begin
            repeat
                LRec.Get(TopUp."Loan Top Up");
                LRec.CalcFields("Total Outstanding Balance");
                if Round((TopUp."Interest Top Up" + TopUp."Principle Top Up"), 0.01, '=') > LRec."Total Outstanding Balance" then
                    Error('Top Up Amounts needs to be re-calculated for Loan No. %1. Current Balance has changed.', LRec."Loan No.");
            until TopUp.Next() = 0;
        end;

        // Create Loan Credit Account if missing
        if Loans."Loan Account" = '' then
            CreateCreditAccount(Loans);

        if not BatchPosting then
            JournalInit(JTemplate, JBatch);

        ExtDocNo := Loans."Loan No.";
        NetLoanAmt := Loans."Amount To Disburse";

        // ── Credit the Loan Account ───────────────────────────────────────────
        Desc := 'Loan Disbursement: ' + Loans."Loan Product Type Name";
        JournalInsert(
            JTemplate, JBatch, DocNo, PDate,
            Accttype::Credit, Loans."Loan Account",
            Desc, Balaccttype::"G/L Account", '',
            Loans."Amount To Disburse",
            ExtDocNo, Loans."Loan No.",
            Transtype::"Loan Disbursement",
            Dim1, Dim2, true, TChannel::Loan,
            Loans."Dimension Set ID"
        );

        // ── Registration Fee ──────────────────────────────────────────────────
        if Loans."Registration Fee" > 0 then begin
            MemberAccounts.Reset();
            MemberAccounts.SetRange("Member No.", Loans."Member No.");
            MemberAccounts.SetRange("Product Category", MemberAccounts."product category"::"Registration Fee");
            if MemberAccounts.FindFirst() then begin
                Desc := 'Member Registration Fee ' + MemberAccounts."Member No.";
                JournalInsert(
                    JTemplate, JBatch, DocNo, PDate,
                    Accttype::Savings, MemberAccounts."No.",
                    Desc, Balaccttype::"G/L Account", '',
                    Loans."Registration Fee" * -1,
                    ExtDocNo, Loans."Loan No.",
                    Transtype::" ",
                    Dim1, Dim2, true, TChannel::Loan,
                    Loans."Dimension Set ID"
                );
                NetLoanAmt -= Loans."Registration Fee";

                //excise duty on registration fee
                SaccoSetup.GET();
                Desc := 'Excise Duty on Member Registration Fee ' + MemberAccounts."Member No.";
                ExciseDuty := Loans."Registration Fee" * SaccoSetup."Excise Duty (%)" / 100;
                JournalInsert(
                    JTemplate, JBatch, DocNo, PDate,
                    Accttype::"G/L Account", SaccoSetup."Excise Duty GL",
                    Desc, Balaccttype::"G/L Account", '',
                    ExciseDuty * -1,
                    ExtDocNo, Loans."Loan No.",
                    Transtype::" ",
                    Dim1, Dim2, true, TChannel::Loan,
                    Loans."Dimension Set ID"
                );
                NetLoanAmt -= ExciseDuty;
            end;
        end;

        // ── Deposit Boosting ──────────────────────────────────────────────────
        if Loans."Deposit Boosting" > 0 then begin
            MemberAccounts.Reset();
            MemberAccounts.SetRange("Member No.", Loans."Member No.");
            MemberAccounts.SetRange("Product Category", MemberAccounts."product category"::"Deposit Contribution");
            if MemberAccounts.FindFirst() then begin
                Desc := 'Deposit Boosting ' + Loans."Loan No.";
                JournalInsert(
                    JTemplate, JBatch, DocNo, PDate,
                    Accttype::Savings, MemberAccounts."No.",
                    Desc, Balaccttype::"G/L Account", '',
                    Loans."Deposit Boosting" * -1,
                    ExtDocNo, Loans."Loan No.",
                    Transtype::" ",
                    Dim1, Dim2, true, TChannel::Loan,
                    Loans."Dimension Set ID"
                );
                NetLoanAmt -= Loans."Deposit Boosting";
            end;
        end;

        // ── Share Capital Boosting ────────────────────────────────────────────
        if Loans."Share Capital Boosting" > 0 then begin
            MemberAccounts.Reset();
            MemberAccounts.SetRange("Member No.", Loans."Member No.");
            MemberAccounts.SetRange("Product Category", MemberAccounts."product category"::"Share Capital");
            if MemberAccounts.FindFirst() then begin
                Desc := 'Share Capital Boosting ' + Loans."Loan No.";
                JournalInsert(
                    JTemplate, JBatch, DocNo, PDate,
                    Accttype::Savings, MemberAccounts."No.",
                    Desc, Balaccttype::"G/L Account", '',
                    Loans."Share Capital Boosting" * -1,
                    ExtDocNo, Loans."Loan No.",
                    Transtype::" ",
                    Dim1, Dim2, true, TChannel::Loan,
                    Loans."Dimension Set ID"
                );
                NetLoanAmt -= Loans."Share Capital Boosting";
            end;
        end;

        // ── Loan Charges ──────────────────────────────────────────────────────
        LoanCharges.Reset();
        LoanCharges.SetRange("Loan No.", Loans."Loan No.");
        LoanCharges.SetRange("Loan Product Type", Loans."Loan Product Type");
        LoanCharges.SetFilter("Charge Type", '<>%1', LoanCharges."Charge Type"::Insurance);

        if LoanCharges.FindFirst() then begin
            repeat
                /* SkipThisCharge :=
                    (LoanCharges."Charge Type" = LoanCharges."Charge Type"::"Loan Processing Fee") and
                    (ChargeDecision <> 1); */

                if LoanCharges.Amount > 0 then begin
                    LoanCharges.TestField(Description);

                    Desc := CopyStr(LoanCharges.Description + ': ' + Loans."Loan No.", 1, 100);

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        LoanCharges."Account Type", LoanCharges."Account No.",
                        Desc, Balaccttype::"G/L Account", '',
                        LoanCharges.Amount * -1,
                        ExtDocNo, Loans."Loan No.",
                        Transtype::" ",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );

                    if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Deduct From Net Payable" then
                        NetLoanAmt -= LoanCharges.Amount
                    else
                        if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Add to Loan Amount" then begin
                            Desc := CopyStr(LoanCharges.Description, 1, 50);

                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                Accttype::Credit, Loans."Loan Account",
                                Desc, Balaccttype::"G/L Account", '',
                                LoanCharges.Amount,
                                ExtDocNo, Loans."Loan No.",
                                Transtype::"Loan Disbursement",
                                Dim1, Dim2, true, TChannel::Loan,
                                Loans."Dimension Set ID"
                            );
                        end;
                end;

                if (LoanCharges."Excise Duty" > 0) and (not SkipThisCharge) then begin
                    LoanCharges.TestField(Description);

                    Desc := CopyStr('Excise Duty: ' + LoanCharges.Description, 1, 510);

                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::"G/L Account", SaccoSetup."Excise Duty GL",
                        Desc, Balaccttype::"G/L Account", '',
                        LoanCharges."Excise Duty" * -1,
                        ExtDocNo, Loans."Loan No.",
                        Transtype::" ",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );

                    if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Deduct From Net Payable" then
                        NetLoanAmt -= LoanCharges."Excise Duty"
                    else
                        if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Add to Loan Amount" then begin
                            Desc := CopyStr('Excise Duty: ' + LoanCharges.Description, 1, 100);

                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                Accttype::Credit, Loans."Loan Account",
                                Desc, Balaccttype::"G/L Account", '',
                                LoanCharges."Excise Duty",
                                ExtDocNo, Loans."Loan No.",
                                Transtype::"Loan Disbursement",
                                Dim1, Dim2, true, TChannel::Loan,
                                Loans."Dimension Set ID"
                            );
                        end;
                end;

            until LoanCharges.Next() = 0;
        end;

        // ── Loan Top Ups ──────────────────────────────────────────────────────
        TopUp.Reset();
        TopUp.SetRange("Loan No.", Loans."Loan No.");
        TopUp.SetRange("Member No.", Loans."Member No.");
        if TopUp.FindFirst() then begin
            TopUpAmt := 0;
            repeat
                TopUpChanged := false;
                TopUpLoan.Reset();
                TopUpLoan.SetRange("Loan No.", TopUp."Loan Top Up");
                if TopUpLoan.FindFirst() then begin
                    TopUpLoan.SetRange(
                        "Date Filter",
                        CalcDate('<-CM>', Loans."Disbursement Date"),
                        CalcDate('<CM>', Loans."Disbursement Date"));

                    TopUpLoan.CalcFields("Insurance Due", "Interest Due", "Outstanding Interest", "Outstanding insurance");

                    TopUpProduct.Get(TopUpLoan."Loan Product Type");

                    if (TopUp."Interest Top Up" = 0) and (TopUpLoan."Outstanding Interest" > 0) then begin
                        TopUp."Interest Top Up" := TopUpLoan."Outstanding Interest";
                        TopUpChanged := true;
                    end;

                    if (TopUp."Appraisal Top Up" = 0) and (TopUpLoan."Outstanding insurance" > 0) then begin
                        TopUp."Appraisal Top Up" := TopUpLoan."Outstanding insurance";
                        TopUpChanged := true;
                    end;

                    if (TopUpLoan."Insurance Due" > 0) and (TopUp."Uncharged Insurance" <> 0) then begin
                        TopUp."Uncharged Insurance" := 0;
                        TopUpChanged := true;
                    end;

                    if (TopUpLoan."Interest Due" > 0) and (TopUp."Uncharged Interest" <> 0) then begin
                        TopUp."Uncharged Interest" := 0;
                        TopUpChanged := true;
                    end;

                    if TopUpChanged then begin
                        TopUp."Total Top Up" := TopUp."Principle Top Up" + TopUp."Interest Top Up" + TopUp."Penalty Top Up" +
                            TopUp."Appraisal Top Up" + TopUp."Uncharged Insurance" + TopUp."Uncharged Interest" +
                            TopUp.Commision + TopUp."Commision Excise";
                        TopUp.Modify();
                    end;
                end;

                if TopUp."Uncharged Insurance" > 0 then begin
                    Desc := 'Loan Insurance Due: ' + Loans."Loan No.";
                    ExtDocNo := Loans."Loan No.";
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, TopUpLoan."Loan Account",
                        Desc, Balaccttype::"G/L Account",
                        TopUpProduct."Insurance Income [G/L]",
                        TopUp."Uncharged Insurance",
                        ExtDocNo, TopUpLoan."Loan No.",
                        Transtype::"Insurance Due",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                end;

                if TopUp."Appraisal Top Up" + TopUp."Uncharged Insurance" > 0 then begin

                    Desc := 'Loan Insurance Top Up: ' + Loans."Loan No.";
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, TopUpLoan."Loan Account",
                        Desc, Balaccttype::"G/L Account", '',
                        (TopUp."Uncharged Insurance" + TopUp."Appraisal Top Up") * -1,
                        ExtDocNo, TopUpLoan."Loan No.",
                        Transtype::"Insurance Paid",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= TopUp."Appraisal Top Up" + TopUp."Uncharged Insurance";
                    TopUpAmt += TopUp."Appraisal Top Up" + TopUp."Uncharged Insurance";
                end;

                if TopUp."Penalty Top Up" > 0 then begin
                    Desc := 'Loan Penalty Top Up: ' + Loans."Loan No.";
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, TopUpLoan."Loan Account",
                        Desc, Balaccttype::"G/L Account", '',
                        TopUp."Penalty Top Up" * -1,
                        ExtDocNo, TopUpLoan."Loan No.",
                        Transtype::"Penalty Paid",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= TopUp."Penalty Top Up";
                    TopUpAmt += TopUp."Penalty Top Up";
                end;

                if TopUp."Uncharged Interest" > 0 then begin
                    Desc := 'Loan Interest Due: ' + Loans."Loan No.";
                    ExtDocNo := Loans."Loan No.";
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, TopUpLoan."Loan Account",
                        Desc, Balaccttype::"G/L Account",
                        TopUpProduct."Loan Interest Income [G/L]",
                        TopUp."Uncharged Interest",
                        ExtDocNo, TopUpLoan."Loan No.",
                        Transtype::"Interest Due",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                end;

                ExtDocNo := '';
                if TopUp."Interest Top Up" + TopUp."Uncharged Interest" > 0 then begin
                    Desc := 'Loan Interest Top Up: ' + Loans."Loan No.";
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, TopUpLoan."Loan Account",
                        Desc, Balaccttype::"G/L Account", '',
                        (TopUp."Interest Top Up" + TopUp."Uncharged Interest") * -1,
                        ExtDocNo, TopUpLoan."Loan No.",
                        Transtype::"Interest Paid",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= TopUp."Interest Top Up" + TopUp."Uncharged Interest";
                    TopUpAmt += TopUp."Interest Top Up" + TopUp."Uncharged Interest";
                end;

                if TopUp."Principle Top Up" > 0 then begin
                    Desc := 'Loan Principal Top Up: ' + Loans."Loan No.";
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, TopUpLoan."Loan Account",
                        Desc, Balaccttype::"G/L Account", '',
                        TopUp."Principle Top Up" * -1,
                        ExtDocNo, TopUpLoan."Loan No.",
                        Transtype::"Principal Repayment",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= TopUp."Principle Top Up";
                    TopUpAmt += TopUp."Principle Top Up";
                end;

                // Commission
                //PostComm := (ChargeDecision = 2);
                if (TopUp.Commision > 0) /* and PostComm */ then begin
                    TopUp.TestField("Commission GL");
                    Desc := 'Loan Top Up Commission: ' + Loans."Loan No.";
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::"G/L Account", TopUp."Commission GL",
                        Desc, Balaccttype::"G/L Account", '',
                        TopUp.Commision * -1,
                        ExtDocNo, TopUpLoan."Loan No.",
                        Transtype::"Principal Repayment",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= TopUp.Commision;
                end;

                if TopUp."Commision Excise" > 0 then begin
                    TopUp.TestField("Commission GL");
                    SaccoSetup.Get();
                    Desc := CopyStr('Excise Duty on Commission: ' + TopUp."Loan No.", 1, 50);
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::"G/L Account", SaccoSetup."Excise Duty GL",
                        Desc, Balaccttype::"G/L Account", '',
                        TopUp."Commision Excise" * -1,
                        ExtDocNo, '',
                        Transtype::" ",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= TopUp."Commision Excise";
                end;

            until TopUp.Next() = 0;
        end;

        // ── Arrears Recovery ──────────────────────────────────────────────────
        ArrearsRecovery.Reset();
        ArrearsRecovery.SetRange("Application No.", Loans."Loan No.");
        ArrearsRecovery.SetRange("Member No.", Loans."Member No.");
        if ArrearsRecovery.FindFirst() then begin
            ArrearsAmt := 0;
            repeat
                Lns.Get(ArrearsRecovery."Loan No");

                if ArrearsRecovery."Interest Arrears Recovered" > 0 then begin
                    Desc := CopyStr(ArrearsRecovery."Loan No" + ' Interest Arrears Recovery: ' + Loans."Loan No.", 1, 100);
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, Lns."Loan Account",
                        Desc, Balaccttype::"G/L Account", '',
                        ArrearsRecovery."Interest Arrears Recovered" * -1,
                        ExtDocNo, Lns."Loan No.",
                        Transtype::"Interest Paid",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= ArrearsRecovery."Interest Arrears Recovered";
                    ArrearsAmt += ArrearsRecovery."Interest Arrears Recovered";
                end;

                if ArrearsRecovery."Principal Arrears Recovered" > 0 then begin
                    Desc := CopyStr(ArrearsRecovery."Loan No" + ' Principal Arrears Recovery: ' + Loans."Loan No.", 1, 100);
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, Lns."Loan Account",
                        Desc, Balaccttype::"G/L Account", '',
                        ArrearsRecovery."Principal Arrears Recovered" * -1,
                        ExtDocNo, Lns."Loan No.",
                        Transtype::"Principal Repayment",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= ArrearsRecovery."Principal Arrears Recovered";
                    ArrearsAmt += ArrearsRecovery."Principal Arrears Recovered";
                end;
            until ArrearsRecovery.Next() = 0;
        end;

        // ── Upfront Interest ──────────────────────────────────────────────────
        if LoanType."Interest Due on Disbursement" <> LoanType."interest due on disbursement"::" " then begin

            MonthlyInterest := SmartRound(Loans."Amount To Disburse" * Loans."Annual Interest %" / 1200);
            if LoanType."Loan Type" = LoanType."Loan Type"::Mavuno then
                MonthlyInterest := (Loans."Amount To Disburse" * LoanType."Interest Rate (Max.)") / 100;

            EndMonth := CalcDate('CM', PDate);
            TDays := Date2dmy(EndMonth, 1);
            Days := TDays - Date2dmy(PDate, 1) + 1;
            CurrDay := Date2DMY(PDate, 1);

            IntDue := 0;
            if LoanType."Interest Due on Disbursement" = LoanType."interest due on disbursement"::"Total Loan Interest - Straight Line" then
                IntDue := Round(MonthlyInterest * Loans.Installments);
            if LoanType."Interest Due on Disbursement" = LoanType."interest due on disbursement"::"Full Interest" then
                IntDue := Round(MonthlyInterest);
            if LoanType."Interest Due on Disbursement" = LoanType."interest due on disbursement"::"Prorated Interest" then
                if TDays > 0 then
                    IntDue := Round(MonthlyInterest * Days / TDays);
            if LoanType."Interest Due on Disbursement" = LoanType."interest due on disbursement"::"Full Interest Before Cutoff" then begin
                LoanType.TestField("Interest Due Cutoff Day");
                if CurrDay <= LoanType."Interest Due Cutoff Day" then
                    IntDue := MonthlyInterest;
            end;
            if LoanType."Interest Due on Disbursement" = LoanType."interest due on disbursement"::"Prorated Interest After CutOff" then begin
                LoanType.TestField("Interest Due Cutoff Day");
                if CurrDay > LoanType."Interest Due Cutoff Day" then
                    IntDue := Round(MonthlyInterest * Days / TDays);
            end;

            RecoverInt := false;
            if LoanType."Interest Due on Disbursement" = LoanType."interest due on disbursement"::"Full/Prorated Interest Based on CutOff" then begin
                LoanType.TestField("Interest Due Cutoff Day");
                if CurrDay <= LoanType."Interest Due Cutoff Day" then
                    IntDue := MonthlyInterest;
                if CurrDay > LoanType."Interest Due Cutoff Day" then begin
                    IntDue := Round(MonthlyInterest * Days / TDays);
                    RecoverInt := true;
                end;
            end;

            if IntDue > 0 then begin
                BalAcctNo := LoanType."Loan Interest Income [G/L]";
                if LoanType."Pre-Earned Interest" then begin
                    BalAcctNo := '';
                    Loans."Monthly Pre-Earned Interest" := MonthlyInterest;
                end;

                LoanType.TestField("Loan Interest Income [G/L]");
                Desc := 'Interest Due on Disbursement';
                ExtDocNo := Loans."Loan No.";
                JournalInsert(
                    JTemplate, JBatch, DocNo, PDate,
                    Accttype::Credit, Loans."Loan Account",
                    Desc, Balaccttype::"G/L Account", BalAcctNo,
                    IntDue,
                    ExtDocNo, Loans."Loan No.",
                    Transtype::"Interest Due",
                    Dim1, Dim2, true, TChannel::Loan,
                    Loans."Dimension Set ID"
                );

                if LoanType."Interest Recovered Upfront" or RecoverInt then begin
                    if LoanType."Interest Recovered Upfront" then begin
                        //Loans.Validate("Disbursement Date", Today);
                        IntDue := Round(MonthlyInterest * Days / TDays);
                    end;

                    Desc := 'Interest Recovered Upfront';
                    JournalInsert(
                        JTemplate, JBatch, DocNo, PDate,
                        Accttype::Credit, Loans."Loan Account",
                        Desc, Balaccttype::"G/L Account", '',
                        IntDue * -1,
                        ExtDocNo, Loans."Loan No.",
                        Transtype::"Interest Paid",
                        Dim1, Dim2, true, TChannel::Loan,
                        Loans."Dimension Set ID"
                    );
                    NetLoanAmt -= IntDue;
                end;
            end;
        end;

        // ── Insurance Due on Disbursement ─────────────────────────────────────
        if (Loans."Total Insurance" > 0) and LoanType."Interest Recovered Upfront" then begin
            LoanType.TestField("Insurance Income [G/L]");
            Desc := 'Insurance Due on Disbursement';
            ExtDocNo := Loans."Loan No.";
            JournalInsert(
                JTemplate, JBatch, DocNo, PDate,
                Accttype::Credit, Loans."Loan Account",
                Desc, Balaccttype::"G/L Account",
                LoanType."Insurance Income [G/L]",
                Loans."Total Insurance",
                ExtDocNo, Loans."Loan No.",
                Transtype::"Insurance Due",
                Dim1, Dim2, true, TChannel::Loan,
                Loans."Dimension Set ID"
            );
        end;

        // ── Other Clearances ──────────────────────────────────────────────────
        OtherClearance.Reset();
        OtherClearance.SetRange("Loan Application No.", Loans."Loan No.");
        if OtherClearance.FindFirst() then begin
            repeat
                OtherClearance.TestField(Description);

                case OtherClearance.Type of
                    OtherClearance.Type::"Pay External Loan",
                    OtherClearance.Type::"Pay Supplier":
                        Accttype := Accttype::Vendor;
                    OtherClearance.Type::"Pay Internal Loan":
                        Accttype := Accttype::Credit;
                    OtherClearance.Type::"Pay Internal Savings":
                        Accttype := Accttype::Savings;
                    OtherClearance.Type::"Pay to G/L Account":
                        Accttype := Accttype::"G/L Account";
                end;

                if OtherClearance.Amount > 0 then begin
                    if OtherClearance.Type = OtherClearance.Type::"Pay Internal Loan" then begin
                        LRec.Get(OtherClearance."Loan No.");
                        LRec.CalcFields("Outstanding Principal", "Outstanding Interest", "Outstanding Penalty");
                        LoanRunBal := OtherClearance.Amount;

                        if LRec."Outstanding Interest" > 0 then begin
                            if LRec."Outstanding Interest" > LoanRunBal then
                                LRec."Outstanding Interest" := LoanRunBal;
                            Desc := CopyStr(Loans."Loan No." + ': ' + OtherClearance.Description, 1, 50);
                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                Accttype, LRec."Loan Account",
                                Desc, Balaccttype::"G/L Account", '',
                                LRec."Outstanding Interest" * -1,
                                ExtDocNo, OtherClearance."Loan No.",
                                Transtype::"Interest Paid",
                                Dim1, Dim2, true, TChannel::Loan,
                                Loans."Dimension Set ID"
                            );
                            LoanRunBal -= LRec."Outstanding Interest";
                        end;

                        if (LoanRunBal > 0) and (LRec."Outstanding Penalty" > 0) then begin
                            if LRec."Outstanding Penalty" > LoanRunBal then
                                LRec."Outstanding Penalty" := LoanRunBal;
                            Desc := CopyStr(Loans."Loan No." + ': ' + OtherClearance.Description, 1, 50);
                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                Accttype, LRec."Loan Account",
                                Desc, Balaccttype::"G/L Account", '',
                                LRec."Outstanding Penalty" * -1,
                                ExtDocNo, OtherClearance."Loan No.",
                                Transtype::"Penalty Paid",
                                Dim1, Dim2, true, TChannel::Loan,
                                Loans."Dimension Set ID"
                            );
                            LoanRunBal -= LRec."Outstanding Penalty";
                        end;

                        if LoanRunBal > 0 then begin
                            Desc := CopyStr(OtherClearance.Description + ': ' + Loans."Loan No.", 1, 50);
                            JournalInsert(
                                JTemplate, JBatch, DocNo, PDate,
                                Accttype, LRec."Loan Account",
                                Desc, Balaccttype::"G/L Account", '',
                                LoanRunBal * -1,
                                ExtDocNo, OtherClearance."Loan No.",
                                Transtype::"Principal Repayment",
                                Dim1, Dim2, true, TChannel::Loan,
                                Loans."Dimension Set ID"
                            );
                        end;
                    end else begin
                        Desc := CopyStr(Loans."Loan No." + ': ' + OtherClearance.Description, 1, 50);
                        JournalInsert(
                            JTemplate, JBatch, DocNo, PDate,
                            Accttype, OtherClearance."Account No.",
                            Desc, Balaccttype::"G/L Account", '',
                            OtherClearance.Amount * -1,
                            ExtDocNo, OtherClearance."Loan No.",
                            Transtype::" ",
                            Dim1, Dim2, true, TChannel::Loan,
                            Loans."Dimension Set ID"
                        );
                        NetLoanAmt -= OtherClearance.Amount;
                    end;
                end;
            until OtherClearance.Next() = 0;
        end;

        // ── Source Bank Accounts (where funds come FROM) ──────────────────────
        if not BatchPosting then
            PostSourceAccounts(Loans, JTemplate, JBatch, DocNo, PDate, NetLoanAmt, Dim1, Dim2, ExtDocNo);


        // ── Finalise ──────────────────────────────────────────────────────────
        BatchAmt := NetLoanAmt;

        if Days > 0 then
            Loans."Upfront Days" := Days;

        Loans.Posted := true;
        //Loans."Disbursement Date" := PDate;
        Loans.Modify();


        if Loans."Deposit Contribution" > 0 then begin

            MemberAccounts.Reset();
            MemberAccounts.SetRange("Member No.", Loans."Member No.");
            MemberAccounts.SetRange("Product Category", MemberAccounts."Product Category"::"Deposit Contribution");
            if MemberAccounts.FindFirst() then begin
                MemberAccounts."Monthly Contribution" := Loans."Deposit Contribution";
                MemberAccounts."Monthly Contribution Date" := today;
                MemberAccounts."Contribution Updated By" := UserId;
                MemberAccounts.Modify();
            end;
        end;


        PortalLoans.Reset();
        PortalLoans.SetRange("Loan No.", Loans."Loan No.");
        if PortalLoans.FindFirst() then begin
            PortalLoans.Status := PortalLoans.Status::Successful;
            PortalLoans.Posted := true;
            PortalLoans."Date Posted" := CurrentDateTime;
            PortalLoans.Modify();
        end;

        if not BatchPosting then begin
            JournalPost(JTemplate, JBatch);

            dWindow.Open('#1#################');
            dWindow.Update(1, 'Generating Schedule');
            GenerateRepaymentSchedule(Loans);
            Commit();

            dWindow.Update(1, 'Sending Email/SMS Notification');
            SendLoanDisbursementNotifications(Loans);

            dWindow.Update(1, 'Checking Arrears');
            RecoverSpecificMemberLoanFromSavingsAccounts(Loans."Member No.");

            ValidateFDLienSecurityOnApproval(Loans."Loan No.");

            dWindow.Close();
            Message('Loan Posted Successfully');
        end;
    end;

    //  Post source bank accounts (replaces the single BankAccNo entry)
    local procedure PostSourceAccountsPartial(Loans: Record Loans; SourceAccountLoanNo: Code[20]; JTemplate: Code[10]; JBatch: Code[10]; DocNo: Code[20]; PDate: Date; NetLoanAmt: Decimal; Dim1: Code[10]; Dim2: Code[10]; ExtDocNo: Code[20])
    var
        BankAccounts: Record "HR Employee Bank Accounts";
        Desc: Text[50];
        TotalUserAmount: Decimal;
        LineAmount: Decimal;
        RunningTotal: Decimal;
        LinesProcessed: Integer;
        TotalLines: Integer;
    begin
        BankAccounts.Reset();
        BankAccounts.SetRange("Loan No.", SourceAccountLoanNo);

        if BankAccounts.IsEmpty() then
            Error('No bank accounts defined for partial disbursement %1. Please define disbursement accounts before posting.', SourceAccountLoanNo);

        // Get total user-entered amount to calculate ratios
        BankAccounts.CalcSums("Amount to Transfer");
        TotalUserAmount := BankAccounts."Amount to Transfer";

        if TotalUserAmount = 0 then
            Error('Bank account lines have zero amounts for partial disbursement %1.', SourceAccountLoanNo);

        // Count total lines for last-line rounding handling
        TotalLines := BankAccounts.Count();
        LinesProcessed := 0;
        RunningTotal := 0;

        if BankAccounts.FindSet() then
            repeat
                LinesProcessed += 1;
                BankAccounts.TestField("Mode of Disbursement");
                BankAccounts.TestField("Disbursement Account No.");
                if BankAccounts."Mode of Disbursement" = BankAccounts."Mode of Disbursement"::Cheque then
                    BankAccounts.TestField("Cheque No.");

                Desc := CopyStr(Loans."Loan Product Type Name" + ': ' + Loans."Member No." + '-' + Loans."Member Name", 1, 50);

                // Last line gets the remainder to avoid rounding gaps
                if LinesProcessed = TotalLines then
                    LineAmount := NetLoanAmt - RunningTotal
                else begin
                    // Proportional split based on user-entered ratio
                    LineAmount := Round(NetLoanAmt * BankAccounts."Amount to Transfer" / TotalUserAmount, 0.01);
                    RunningTotal += LineAmount;
                end;

                JournalInsert(
                    JTemplate, JBatch, DocNo, PDate,
                    Accttype::"Bank Account",
                    BankAccounts."Disbursement Account No.",
                    Desc,
                    Balaccttype::"G/L Account", '',
                    -LineAmount,
                    BankAccounts."Cheque No.",
                    Loans."Loan No.",
                    Transtype::" ",
                    Dim1, Dim2, true, TChannel::Loan,
                    Loans."Dimension Set ID"
                );
            until BankAccounts.Next() = 0;
    end;


    //  Post source bank accounts (replaces the single BankAccNo entry)
    local procedure PostSourceAccounts(Loans: Record Loans; JTemplate: Code[10]; JBatch: Code[10]; DocNo: Code[20]; PDate: Date; NetLoanAmt: Decimal; Dim1: Code[10]; Dim2: Code[10]; ExtDocNo: Code[20])
    var
        BankAccounts: Record "HR Employee Bank Accounts";
        Desc: Text[50];
        TotalUserAmount: Decimal;
        LineAmount: Decimal;
        RunningTotal: Decimal;
        LinesProcessed: Integer;
        TotalLines: Integer;
    begin
        BankAccounts.Reset();
        BankAccounts.SetRange("Loan No.", Loans."Loan No.");

        if BankAccounts.IsEmpty() then
            Error('No bank accounts defined for Loan %1. Please define disbursement accounts before posting.', Loans."Loan No.");

        // Get total user-entered amount to calculate ratios
        BankAccounts.CalcSums("Amount to Transfer");
        TotalUserAmount := BankAccounts."Amount to Transfer";

        if (not Loans."Consolidated Loan") and (not Loans."Self Guarantee") then
            if TotalUserAmount = 0 then
                Error('Bank account lines have zero amounts for Loan %1.', Loans."Loan No.");

        // Count total lines for last-line rounding handling
        TotalLines := BankAccounts.Count();
        LinesProcessed := 0;
        RunningTotal := 0;

        if BankAccounts.FindSet() then
            repeat
                LinesProcessed += 1;
                Desc := CopyStr(Loans."Loan Product Type Name" + ': ' + Loans."Member No." + '-' + Loans."Member Name", 1, 50);

                // Last line gets the remainder to avoid rounding gaps
                if LinesProcessed = TotalLines then
                    LineAmount := NetLoanAmt - RunningTotal
                else begin
                    // Proportional split based on user-entered ratio
                    LineAmount := Round(NetLoanAmt * BankAccounts."Amount to Transfer" / TotalUserAmount, 0.01);
                    RunningTotal += LineAmount;
                end;

                JournalInsert(
                    JTemplate, JBatch, DocNo, PDate,
                    Accttype::"Bank Account",
                    BankAccounts."Disbursement Account No.",
                    Desc,
                    Balaccttype::"G/L Account", '',
                    -LineAmount,
                    BankAccounts."Cheque No.",
                    Loans."Loan No.",
                    Transtype::" ",
                    Dim1, Dim2, true, TChannel::Loan,
                    Loans."Dimension Set ID"
                );
            until BankAccounts.Next() = 0;
    end;

    local procedure GetAssetChargeToPost(Loans: Record Loans; LoanType: Record "Product SetUp"): Integer
    var
        LoanCharges: Record "Loan Charges";
        TopUp: Record "Loan Top Up";
        ProcFee: Decimal;
        TopUpComm: Decimal;
    begin

        if LoanType."Charge Comparison Type" = LoanType."Charge Comparison Type"::" " then
            exit(0);

        // Get Processing Fee
        LoanCharges.Reset();
        LoanCharges.SetRange("Loan No.", Loans."Loan No.");
        LoanCharges.SetRange(
            "Charge Type",
            LoanCharges."Charge Type"::"Loan Processing Fee");

        if LoanCharges.FindFirst() then
            ProcFee := LoanCharges.Amount;

        // Get Top Up Commission
        TopUp.Reset();
        TopUp.SetRange("Loan No.", Loans."Loan No.");
        if TopUp.FindSet() then begin
            TopUp.CalcSums(Commision);
            TopUpComm := TopUp.Commision;
        end;

        // Compare
        case LoanType."Charge Comparison Type" of

            LoanType."Charge Comparison Type"::Higher:
                if (ProcFee >= TopUpComm) and (ProcFee > 0) then
                    exit(1)
                else
                    if TopUpComm > 0 then
                        exit(2);

            LoanType."Charge Comparison Type"::Lower:
                if (ProcFee <= TopUpComm) and (ProcFee > 0) then
                    exit(1)
                else
                    if TopUpComm > 0 then
                        exit(2);

        end;

        exit(0);
    end;

    procedure GenerateLoanArrearsRepaymentJournals(Jtemplate: Code[20]; JBatch: Code[20]; DocNo: Code[20]; ExtDocNo: Code[20]; PDate: Date; Desc: Text[50]; DocDate: Date; Var RunBal: Decimal; MemberNo: Code[20]; LoanNo: Code[20]; BalAccountNo: Code[20]; BalAcctType: Enum "Gen. Journal Account Type")
    var
        Instructions: Record "Dividend Instructions";
        myInt: Integer;
        ProdSetup: Record "Product Setup";
        Members: Record Members;
        Loans: Record Loans;
        Loans2: Record Loans;
        Savings: Record "Savings Accounts";
        FosaAccount: Record "Savings Accounts";
        AvailAmt: Decimal;
        j: integer;
        DedAmt: Decimal;
        InterestArrears: Decimal;
        PrincipalArrears: Decimal;
        MonthlyBalance: Decimal;
        DimSetID: Integer;
        ExpectedBal: Decimal;
        CurrentBal: Decimal;
        DaysInArrear: integer;
        ArrearsDate: Date;
        LSchedule: Record "Loan Repayment Schedule";
        LoanRepaymentDates: Record "Loan Repayment Dates";
        Narration: text;
        RepayDate: Date;
        OpenBal: Decimal;
        CurrMonthRepayment: Decimal;
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        AsAt: date;
        GracePeriod: DateFormula;
        SaccoSetup: Record "Sacco Setup";
    begin
        SaccoSetup.get;

        Narration := Desc;
        DedAmt := 0;

        if RunBal > 0 then begin

            for j := 1 to 2 do begin

                Loans.Reset();
                Loans.setcurrentkey("Recovery Priority");
                Loans.SetRange("Member No.", MemberNo);
                //Loans.setRange("Mobile Loan", false);
                Loans.SetFilter("Total Outstanding Balance", '>0');
                if j = 1 then
                    Loans.SetFilter("Outstanding Interest", '>0')
                else if j = 2 then
                    Loans.SetFilter("Outstanding Principal", '>0')
                else
                    Error('Programming Error');

                if Loans.FindFirst() then begin
                    repeat
                        DedAmt := 0;
                        ExpectedBal := 0;
                        CurrentBal := 0;
                        DaysInArrear := 0;
                        ArrearsDate := 0D;

                        DimSetID := Savings."Dimension Set ID";
                        if DimSetID = 0 then
                            DimSetID := Loans."Dimension Set ID";


                        RunBal -= SaccoActivities.GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment")
                                - SaccoActivities.GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Interest Paid");


                        if j = 1 then begin
                            Loans.CalcFields("Outstanding Interest");

                            if Loans."Outstanding Interest" < 0 then
                                Loans."Outstanding Interest" := 0;

                            InterestArrears := SaccoActivities.GetInterestArrears(Loans."Loan No.", Today);
                            if InterestArrears > 0 then
                                InterestArrears -= SaccoActivities.GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Interest Paid");

                            if InterestArrears < 0 then
                                InterestArrears := 0;
                            DedAmt := InterestArrears;

                            if DedAmt > Loans."Outstanding Interest" then
                                DedAmt := Loans."Outstanding Interest";


                            Desc := 'Interest Arrears: Recovery';
                            TransType := TransType::"Interest Paid";
                        end;


                        if j = 2 then begin

                            Loans.CalcFields("Outstanding Principal");

                            if Loans."Outstanding Principal" < 0 then
                                Loans."Outstanding Principal" := 0;

                            PrincipalArrears := 0;
                            SaccoActivities.GetDefaultedAmount(Loans."Loan No.", Today, ExpectedBal, CurrentBal, PrincipalArrears, DaysInArrear, ArrearsDate, true, GracePeriod);

                            if PrincipalArrears > 0 then
                                PrincipalArrears -= SaccoActivities.GetJournalLoanCredits(Jtemplate, Jbatch, Accttype::Credit, Loans."Loan Account", Loans."Loan No.", Transtype::"Principal Repayment");

                            if PrincipalArrears < 0 then
                                PrincipalArrears := 0;
                            DedAmt := PrincipalArrears;

                            if DedAmt > Loans."Outstanding Principal" then
                                DedAmt := Loans."Outstanding Principal";


                            Desc := 'Principal Arrears: Recovery';
                            TransType := TransType::"Principal Repayment";

                        end;

                        if DedAmt > 0 then begin
                            if DedAmt > 0 then begin

                                if DedAmt > RunBal then
                                    DedAmt := RunBal;

                                SaccoActivities.JournalInsert(Jtemplate, Jbatch, DocNo, PDate, AcctType::Credit, Loans."Loan Account", CopyStr(Desc, 1, 100),
                                AcctType::"G/l Account", '', -DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                RunBal -= DedAmt;


                                if BalAccountNo <> '' then begin
                                    SaccoActivities.JournalInsert(Jtemplate, Jbatch, DocNo, PDate, BalAcctType, BalAccountNo, copystr(Loans."Loan No." + ': ' + Desc, 1, 100),
                                    AcctType::"G/l Account", '', DedAmt, ExtDocNo, Loans."Loan No.", TransType, '', '', true, TChannel, DimSetID);
                                end;
                            end;
                        end;
                    until Loans.Next = 0;
                end;
            end;
        end;
    end;

    procedure UpdateMonthlyRepayment(Loans: Record Loans; var MonthlyContrib: Decimal)
    var
        Savings: Record "Savings Accounts";
        Depositband: Record "Deposit Bands";
    begin
        Value := Loans."Approved Amount";

        Depositband.Reset;
        Depositband.SetRange("Loan Product", Loans."Loan Product Type");
        if Depositband.Find('-') then begin
            repeat
                if (Value >= Depositband.Minimum) and (Value <= Depositband.Maximum) then begin

                    if Savings.Get(Legacy.GetDepositAccounts(Loans."Member No.")) then
                        if Depositband.Amount > Savings."Monthly Contribution" then begin
                            MonthlyContrib := Depositband.Amount;
                            Savings."Monthly Contribution" := MonthlyContrib;
                            Savings.Modify();
                        end
                end;
            until Depositband.Next() = 0;
        end;
    end;

    procedure GetTheNoOfGuarantors(Loan: Record Loans) NoOfGuarantors: Integer;
    var
        LoanGuarantors: Record "Loan Guarantors";
        SmsCharges: Record "SMS Charges";
    begin
        LoanGuarantors.Reset();
        LoanGuarantors.SetRange("Loan No", Loan."Loan No.");
        LoanGuarantors.SetRange("Self Guarantee", false);
        if not LoanGuarantors.IsEmpty() then
            NoOfGuarantors := LoanGuarantors.Count();
    end;

