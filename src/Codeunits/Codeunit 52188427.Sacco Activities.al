                        '',
                        DocLine."Tax Amount" * -1,
                        DocLine."Transaction No.",
                        DocLine."Loan No.",
                        DocLine."Transaction Type",
                        DocLine."Shortcut Dimension 1 Code",
                        DocLine."Shortcut Dimension 2 Code",
                        true,
                        TChannel::PV,
                        DocLine."Dimension Set ID"
                        );


                    if Docline."Member Exit No." <> '' then begin
                        MemberExit.Get(Docline."Member Exit No.");
                        SA.Reset();
                        SA.SetRange("Member No.", MemberExit."Member No.");
                        SA.SetFilter("Product Category", '<>%1&<>%2', SA."Product Category"::"Ordinary Savings", SA."Product Category"::"Share Capital");
                        if SA.FindSet() then
                            repeat
                                SA.Status := SA.Status::Withdrawn;
                                SA.Modify();
                            until SA.Next() = 0;

                        if MemberExit.WithdrawalType = MemberExit.WithdrawalType::"Full Withdrawal" then begin
                            Member.Get(MemberExit."Member No.");
                            Member."Member Status" := Member."Member Status"::Withdrawn;
                            Member.Modify();
                        end else begin
                            Member.Get(MemberExit."Member No.");
                            Member."Member Status" := Member."Member Status"::Active;
                            Member.Modify();
                        end;
                    end;


                until DocLine.Next = 0;

                if PaymentHeader."Transaction Type" <> '' then begin
                    MemberActivities.GetGeneralChargeAmount(PaymentHeader."Transaction Type", DocLine.Amount, ChargeAmount, ChargeDuty, ChargeAcctType, ChargeAcct);

                    // post charges
                    DetailedJournalInsert(
                     JTemplate,
                     JBatch,
                     PaymentHeader."No.",
                     PaymentHeader."Payment Release Date",
                     DocLine."Account Type",
                     DocLine."Account No.",
                     'EFT Charges',
                     ChargeAcctType,
                     ChargeAcct,
                     ChargeAmount,
                     '',
                     '',
                     Transtype::" ",
                     PaymentHeader."Global Dimension 1 Code",
                     PaymentHeader."Shortcut Dimension 2 Code",
                     true,
                     DocType,
                     PaymentHeader.Date,
                     '',
                     AppliesToDocType,
                     AppliesToDocNo,
                     AppliesToID,
                     DimensionSetID
                     );

                    if ChargeDuty > 0 then begin
                        // post charges
                        SaccoSetup.GET();
                        DetailedJournalInsert(
                         JTemplate,
                         JBatch,
                         PaymentHeader."No.",
                         PaymentHeader."Payment Release Date",
                        DocLine."Account Type",
                         DocLine."Account No.",
                         'Exice Duty on EFT Charges',
                         ChargeAcctType,
                         SaccoSetup."Excise Duty GL",
                         ChargeDuty,
                         '',
                         '',
                         Transtype::" ",
                         PaymentHeader."Global Dimension 1 Code",
                         PaymentHeader."Shortcut Dimension 2 Code",
                         true,
                         DocType,
                         PaymentHeader.Date,
                         '',
                         AppliesToDocType,
                         AppliesToDocNo,
                         AppliesToID,
                         DimensionSetID
                         );
                    end

                end;



                PaymentHeader.Posted := true;
                PaymentHeader."Posted By" := UserId;
                PaymentHeader."Date Posted" := Today;
                PaymentHeader."Time Posted" := Time;
                PaymentHeader.Modify;

                JournalPost(JTemplate, JBatch);
                Message('PV Posted Successfully');

            end;
        end;
    end;

    procedure PostEFT(PVNo: Code[20])
    var
        PaymentHeader: Record "EFT Transfer";
