                    if (PaymentHeader."Payment Type" = PaymentHeader."payment type"::Staff) or (PaymentHeader."Payment Type" = PaymentHeader."payment type"::Board) or (PaymentHeader."Payment Type" = PaymentHeader."payment type"::Member) then begin
                        Message('Payment Type %1', PaymentHeader."Payment Type");


                        DetailedJournalInsert(
