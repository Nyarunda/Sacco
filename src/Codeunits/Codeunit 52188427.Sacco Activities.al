    procedure CheckMaturedJuniorAccounts()
    var
        Account: Record "Savings Accounts";
        Continue: Boolean;
    begin


        Account.Reset();
        Account.SetRange("Product Category", Account."Product Category"::"Junior Savings");
        Account.SetFilter("Child Date Of Birth", '<>%1', 0D);
        Account.SetRange(Status, Account.Status::Active);
        Account.SetRange("Child Account Status", Account."Child Account Status"::Child);
        if Account.FindFirst() then begin
            repeat
                Continue := false;
                if (Date2DMY(today, 3) - Date2DMY(Account."Child Date Of Birth", 3)) > 18 then
                    Continue := true;
                if (Date2DMY(today, 3) - Date2DMY(Account."Child Date Of Birth", 3)) = 18 then begin

                    if (Date2DMY(today, 2) > Date2DMY(Account."Child Date Of Birth", 2)) then begin
                        Continue := true;
                    end;
                end;

                if Continue then begin
                    Account."Child Account Status" := Account."Child Account Status"::"Pending Conversion";
                    Account.Modify();
                end;
            until Account.Next() = 0;
        end;
    end;


    procedure CreateStandingOrder(VAR Loans: Record Loans)
    var
        myInt: Integer;
        STOHeader: Record "Standing Order Header";
        STOLines: Record "Standing Order Lines";
        OldLoans: Record "Old System Loans";
        SavingsAccount: Record "Savings Accounts";
    begin
        Loans."Standing Order Amount" := Loans.Repayment;

        Loans.testfield("Standing Order Amount");
        STOLines.Reset();
        STOLines.setrange("Loan No.", Loans."Loan No.");
        if STOLines.FindFirst() then
            STOLines.delete();

        STOLines.Reset();
        STOLines.setrange("Loan No.", Loans."Loan No.");
        if not STOLines.Findfirst() then begin


            if Loans."Standing Order Amount" > 0 then begin
                STOHeader.init;

                STOHeader.Code := '';
                STOHeader."Source Account Type" := STOHeader."Source Account Type"::Savings;
                STOHeader.validate("Source Account No.", Loans."Disbursement Account No");
                STOHeader.Description := Loans."Loan Product Type Name";
                STOHeader.Amount := Loans."Standing Order Amount";
                STOHeader."Allow Partial Deduction" := true;
                STOHeader."Income Type" := STOHeader."Income Type"::Business;
                STOHeader."Created By" := UserID;
                STOHeader.Status := STOHeader.Status::Approved;
                STOHeader."Effective/Start Date" := Today;
                Evaluate(STOHeader."Frequency (Months)", '999M');
                Evaluate(STOHeader."Duration (Months)", '1M');
                STOHeader.Validate("Duration (Months)");
                STOHeader."Auto Process" := true;
                STOHeader.Insert(true);

                Loans."STO No." := STOHeader.Code;

                STOLines.Init();
                STOLines."Document No." := STOHeader.Code;
                STOLines."Destination Account Type" := STOLines."Destination Account Type"::Credit;
                STOLines."Destination Account No." := Loans."Loan Account";
                STOLines."Loan No." := Loans."Loan No.";
                STOLines.Amount := STOHeader.Amount;
                STOLines.Insert();

            end

        end;

    end;


    procedure PostPartialLoanDisbursement(DisbuNo: Code[20])
    var
        DisbursHeader: Record "Partial Loans Disb. Header";
        ParLines: Record "Partial Loans Disb. Lines";
        LoanCharges: Record "Loan Charges";
        USetup: Record "User Setup";
        NetLoanAmt: Decimal;
        Desc: Text[100];
        ExtDocNo: Code[20];
        Dim1: Code[10];
        Dim2: Code[10];
        DocNo: Code[20];
        PDate: date;
        Msg: Text;
        DimID: Integer;
        Member: Record Members;
        BankAccounts: Record "HR Employee Bank Accounts";
        ProductSetup: Record "Product Setup";
        LoanSource: Enum "Loan Source";
        CreditLedgerEntry: Record "Credit Ledger Entry";
        PowerEvents: Codeunit "UW Power Automate Bus. Events";
        TotalAmountDisbursed: Decimal;
    begin

        DisbursHeader.reset();
        if not DisbursHeader.Get(DisbuNo) then
            Error('Partial disbursement %1 was not found.', DisbuNo);

        if DisbursHeader.Posted then
            exit;

        CreditLedgerEntry.Reset();
        CreditLedgerEntry.SetRange("Document No.", DisbuNo);
        CreditLedgerEntry.SetRange("Loan No.", DisbursHeader."Loan No.");
        CreditLedgerEntry.SetRange("Transaction Type", CreditLedgerEntry."Transaction Type"::"Loan Disbursement");
        CreditLedgerEntry.SetRange(Reversed, false);
        if not CreditLedgerEntry.IsEmpty() then begin
            DisbursHeader.Posted := true;
            if DisbursHeader."Date Posted" = 0D then
                DisbursHeader."Date Posted" := Today;
            DisbursHeader.Modify(true);
            exit;
        end;

        begin

            SaccoSetup.Get();
            DisbursHeader.TestField("Posting Date");

            BankAccounts.Reset();
            BankAccounts.SetRange("Loan No.", DisbursHeader."No.");
            if BankAccounts.IsEmpty() then
                Error('No source bank accounts defined for partial disbursement %1. Please define source accounts before posting.', DisbursHeader."No.");

            BankAccounts.Reset();
            BankAccounts.SetRange("Loan No.", DisbursHeader."No.");
            if BankAccounts.FindFirst() then;

            ParLines.Reset();
            ParLines.SetRange("Header No.", DisbursHeader."No.");
            if not ParLines.FindSet() then
                Error('No partial disbursement lines found for partial disbursement %1.', DisbursHeader."No.");

            repeat

                Loans.get(DisbursHeader."Loan No.");
                Loans."Amount To Disburse" += ParLines."Amount to Disbuse";
                Loans.Modify();
                NetLoanAmt := 0;

                UserSetup.Get(UserId);
                UserSetup.TestField("Payment Journal Template");
                UserSetup.TestField("Payment Journal Batch");
                JTemplate := UserSetup."Payment Journal Template";
                JBatch := UserSetup."Payment Journal Batch";
                Dim1 := Loans."Global Dimension 1 Code";
                Dim2 := Loans."Booking Branch";

                JournalInit(JTemplate, JBatch);

                NetLoanAmt := ParLines."Amount to Disbuse";

                PDate := DisbursHeader."Posting Date";

                DocNo := ParLines."Header No.";
                ExtDocNo := BankAccounts."Cheque No."; //Loans."Loan No.";

                Desc := CopyStr(
                    StrSubstNo('Partial Disb. %1 - %2 %3',
                        Loans."Loan Product Type Name",
                        Loans."Member No.",
                        Loans."Member Name"),
                    1,
                    100);
                JournalInsert(
                    JTemplate,
                    JBatch,
                    DocNo,
                    PDate,
                    Accttype::Credit,
                    Loans."Loan Account",
                    Desc,
                    Balaccttype::"G/L Account",
                    '',
                    NetLoanAmt,
                    ExtDocNo,
                    ParLines."Loan No.",
                    Transtype::"Loan Disbursement",
                    Dim1,
                    Dim2,
                    true,
                    TChannel::Loan,
                    DimID
                    );


                if DisbursHeader."Exempt Charges" then
                    DisbursHeader.ResetPartialDisbursementCharges()
                else begin
                    LoanCharges.Reset;
                    LoanCharges.SetRange("Loan No.", ParLines."Header No.");
                    LoanCharges.SetRange("Loan Product Type", Loans."Loan Product Type");
                    Loancharges.SetFilter("Charge Code", '<>%1', 'INS');
                    if LoanCharges.FindFirst then begin
                        repeat

                            if LoanCharges.Amount > 0 then begin
                                LoanCharges.TestField(Description);

                                Desc := LoanCharges.Description + ' on ' + Loans."Loan Product Type Name";

                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    PDate,
                                    LoanCharges."Account Type",
                                    LoanCharges."Account No.",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    LoanCharges.Amount * -1,
                                    ExtDocNo,
                                    Loans."Loan No.",
                                    Transtype::" ",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Checkoff,
                                    DimID
                                    );

                                if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Deduct From Net Payable" then begin
                                    NetLoanAmt -= LoanCharges.Amount;

                                    if Loans."Mode of Disbursement" = Loans."mode of disbursement"::"Transfer to Fosa" then begin

                                        Desc := LoanCharges.Description + ' on ' + Loans."Loan Product Type Name";

                                        JournalInsert(
                                            JTemplate,
                                            JBatch,
                                            DocNo,
                                            PDate,
                                            Accttype::Savings,
                                            Loans."Disbursement Account No",
                                            Desc,
                                            Balaccttype::"G/L Account",
                                            '',
                                            LoanCharges.Amount,
                                            ExtDocNo,
                                            Loans."Loan No.",
                                            Transtype::" ",
                                            Dim1,
                                            Dim2,
                                            true,
                                            TChannel::Loan,
                                            DimID
                                            );
                                    end;
                                end
                                else
                                    if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Add to Loan Amount" then begin

                                        Desc := LoanCharges.Description + ' on ' + Loans."Loan Product Type Name";
                                        JournalInsert(
                                            JTemplate,
                                            JBatch,
                                            DocNo,
                                            PDate,
                                            Accttype::Credit,
                                            Loans."Loan Account",
                                            Desc,
                                            Balaccttype::"G/L Account",
                                            '',
                                            LoanCharges.Amount,
                                            ExtDocNo,
                                            Loans."Loan No.",
                                            Transtype::"Loan Disbursement",
                                            Dim1,
                                            Dim2,
                                            true,
                                            TChannel::Loan,
                                            DimID
                                            );

                                    end;
                            end;


                            if LoanCharges."Excise Duty" > 0 then begin

                                LoanCharges.TestField(Description);
                                Desc := 'Excise Duty: ' + LoanCharges.Description;
                                JournalInsert(
                                    JTemplate,
                                    JBatch,
                                    DocNo,
                                    PDate,
                                    Accttype::"G/L Account",
                                    SaccoSetup."Excise Duty GL",
                                    Desc,
                                    Balaccttype::"G/L Account",
                                    '',
                                    LoanCharges."Excise Duty" * -1,
                                    ExtDocNo,
                                    Loans."Loan No.",
                                    Transtype::" ",
                                    Dim1,
                                    Dim2,
                                    true,
                                    TChannel::Loan,
                                    DimID
                                    );


                                if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Deduct From Net Payable" then begin

                                    NetLoanAmt -= LoanCharges."Excise Duty";

                                    if Loans."Mode of Disbursement" = Loans."mode of disbursement"::"Transfer to Fosa" then begin
                                        Desc := 'Excise Duty: ' + LoanCharges.Description + ' ' + Loans."Member No." + ' ' + loans."Member Name";
                                        JournalInsert(
                                            JTemplate,
                                            JBatch,
                                            DocNo,
                                            PDate,
                                            Accttype::Savings,
                                            Loans."Disbursement Account No",
                                            Desc,
                                            Balaccttype::"G/L Account",
                                            '',
                                            LoanCharges."Excise Duty",
                                            ExtDocNo,
                                            Loans."Loan No.",
                                            Transtype::" ",
                                            Dim1,
                                            Dim2,
                                            true,
                                            TChannel::Loan,
                                            DimID
                                            );
                                    end;
                                end
                                else
                                    if LoanCharges."Posting Type" = LoanCharges."Posting Type"::"Add to Loan Amount" then begin

                                        Desc := 'Excise Duty: ' + LoanCharges.Description + ' ' + Loans."Member No." + ' ' + loans."Member Name";
                                        JournalInsert(
                                            JTemplate,
                                            JBatch,
                                            DocNo,
                                            PDate,
                                            Accttype::Credit,
                                            Loans."Loan Account",
                                            Desc,
                                            Balaccttype::"G/L Account",
                                            '',
                                            LoanCharges."Excise Duty",
                                            ExtDocNo,
                                            Loans."Loan No.",
                                            Transtype::"Loan Disbursement",
                                            Dim1,
                                            Dim2,
                                            true,
                                            TChannel::Loan,
                                            DimID
                                            );

                                    end;
                            end;
                        until LoanCharges.Next = 0;
                    end;
                end;

                Desc := CopyStr(
                    StrSubstNo('Partial Disb. %1 - %2 %3',
                        Loans."Loan Product Type Name",
                        Loans."Member No.",
                        Loans."Member Name"),
                    1,
                    MaxStrLen(Desc));

                PostSourceAccountsPartial(Loans, DisbursHeader."No.", JTemplate, JBatch, DocNo, PDate, NetLoanAmt, Dim1, Dim2, ExtDocNo);

                JournalPost(JTemplate, JBatch);

                //Send SMS/Email Notification
                dWindow.Open('#1#################');
                Member.Get(Loans."Member No.");
                ProductSetup.Get(Loans."Loan Product Type");
                dWindow.Update(1, 'Sending Email/SMS Notification');
                Msg := 'Dear ' + Member.Name + ', Your ' + ProductSetup.Description + ' balance of KES ' + Format(ParLines."Amount to Disbuse") + ' has been credited to your account.';
                // Expected monthly repayment is Ksh ' + Format(Loans.Repayment) + ' and is DUE on ' + Sky.ddMMyyyy(Loans."Repayment Start Date");
                //MemberActivities.SendSms(Smssource::"Loan Posted", Member."Mobile Phone No.", Msg, Member."No.", Loans."Disbursement Account No", true, false);
                //MESSAGE(Msg);
                Commit;
                dWindow.Update(1, 'Generating Schedule');
                PreviewRepaymentScheduleWithPartialDisbursementPosting(Loans, DisbuNo);
                dWindow.Close();
                //send disbursement email
                Commit;

            until ParLines.next() = 0;

            PostGuarantors(DisbursHeader."Loan No.");

            DisbursHeader.Posted := true;
            DisbursHeader."Date Posted" := Today;
            DisbursHeader.Modify();



        end
    end;

    local procedure PostGuarantors(LoanNo: code[20])
    var
        LoanSecurity: Record "Loan Security";
        TempLoanSecurityBuffer: Record "Loan Security Buffer" temporary;
    begin
        TempLoanSecurityBuffer.Reset();
        TempLoanSecurityBuffer.SetRange("Loan No.", LoanNo);
        if not TempLoanSecurityBuffer.FindSet() then
            exit;

        repeat
            // Block duplicates
            LoanSecurity.Reset();
            LoanSecurity.SetRange("Loan No.", TempLoanSecurityBuffer."Loan No.");
            LoanSecurity.SetRange("Account No.", TempLoanSecurityBuffer."Account No.");
            LoanSecurity.SetRange("Collateral Reg. No.", TempLoanSecurityBuffer."Collateral Reg. No.");
            if LoanSecurity.FindFirst() then
                Error('Guarantor %1 already exists on Loan %2.',
                      TempLoanSecurityBuffer."Account No.", TempLoanSecurityBuffer."Loan No.");

            LoanSecurity.Init();
            LoanSecurity."Loan No." := TempLoanSecurityBuffer."Loan No.";
            LoanSecurity."Guarantor Type" := TempLoanSecurityBuffer."Guarantor Type";
            LoanSecurity."Substituted Member" := TempLoanSecurityBuffer."Substituted Member";
            LoanSecurity.Validate("Account No.", TempLoanSecurityBuffer."Account No.");
            LoanSecurity.Validate("Collateral Reg. No.", TempLoanSecurityBuffer."Collateral Reg. No.");
            LoanSecurity.Validate("Amount Guaranteed", TempLoanSecurityBuffer."Amount Guaranteed");

            LoanSecurity."Current Committed" := TempLoanSecurityBuffer."Amount Guaranteed";
            LoanSecurity.Insert(true);

        until TempLoanSecurityBuffer.Next() = 0;

        TempLoanSecurityBuffer.DeleteAll();
    end;

