    procedure GenerateDivdends(MemberNo: Code[20]; StartDate: Date; EndDate: Date; TaxExempt: Boolean)
    var
        GrossDiv: Decimal;
        WTaxDiv: Decimal;
        NetDiv: Decimal;
        FromDate: Date;
        ToDate: Date;
        EntrNo: Integer;
        diaProgress: Dialog;
        intProgress: Integer;
        timProgress: Time;
        intProgressI: Integer;
        intProgressTotal: Integer;
        Members: Record Members;
        Savings: Record "Savings Accounts";
        Counter1: Integer;
        Counter2: Integer;
        GrossDividend: Decimal;
        i: Integer;
        DivLines: Record "Dividends Progression";
        ProductSetup: Record "Product Setup";
        DateFilter: Text;
        MAccounts: Record "Savings Accounts";
        IntPass: Integer;
        ReducedDeposits: Boolean;
    begin

        //ERROR('%1\%2',StartDate,EndDate);

        DivLines.Reset;
        //DivLines.SetRange(DivLines."End Date", CalcDate('-1D', StartDate), EndDate);
        DivLines.SetRange(DivLines."End Date", StartDate, EndDate);
        DivLines.SetRange("Member No", MemberNo);
        if DivLines.Find('-') then
            DivLines.DeleteAll;

        ProductSetup.Reset;
        ProductSetup.SetFilter(ProductSetup."Product Class", '%1', ProductSetup."product class"::Savings);
        ProductSetup.SetFilter(ProductSetup."Dividend Calc. Method", '<>%1', ProductSetup."dividend calc. method"::" ");
        if ProductSetup.Find('-') then begin
            repeat

                Savings.Reset;
                Savings.SetCurrentKey("Member No.");
                Savings.SetRange(Savings."Product Type", ProductSetup."Product ID");
                Savings.SetRange("Member No.", MemberNo);
                if Savings.Find('-') then begin

                    case ProductSetup."Dividend Calc. Method" of

                        ProductSetup."dividend calc. method"::"Flat Rate":
                            begin
                                DateFilter := '..' + Format(EndDate);
                                MAccounts.Reset;
                                MAccounts.SetRange("No.", Savings."No.");
                                MAccounts.SetFilter("Date Filter", DateFilter);
                                MAccounts.SetAutoCalcFields("Net Change (LCY)");
                                if MAccounts.FindFirst then begin
                                    if MAccounts."Net Change (LCY)" > 0 then begin

                                        GrossDiv := (ProductSetup."Interest Rate (Min.)" / 100) * MAccounts."Net Change (LCY)";
                                        WTaxDiv := GrossDiv * (ProductSetup."WithHolding Tax" / 100);
                                        if TaxExempt then
                                            WTaxDiv := 0;
                                        NetDiv := GrossDiv - WTaxDiv;
                                        //MESSAGE('%1',GrossDiv);
                                        CreateDivLines(
                                            MAccounts."No.",
                                            MAccounts.Name,
                                            Today,
                                            MAccounts."Product Type",
                                            MAccounts."Product Name",
                                            MAccounts."Member No.",
                                            MAccounts."Net Change (LCY)",
                                            MAccounts."Net Change (LCY)",
                                            GrossDiv,
                                            WTaxDiv,
                                            NetDiv,
                                            StartDate,
                                            EndDate,
                                            ProductSetup."Dividend Calc. Method"
                                            );

                                    end;

                                end;
                            end;

                        ProductSetup."dividend calc. method"::Prorated:
                            begin
                                ToDate := CalcDate('CM', StartDate);
                                FromDate := CalcDate('-CM', StartDate);

                                if ProductSetup."Product Category" = ProductSetup."product category"::"Deposit Contribution" then
                                    IntPass := 0
                                else
                                    IntPass := 1;

                                if MemberHasReducedDeposits(Savings."No.", ToDate) then
                                    ReducedDeposits := true
                                else
                                    ReducedDeposits := false;

                                CalculateProratedDividends(Savings."No.", 12, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 11, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 10, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 9, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 8, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 7, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 6, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 5, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 4, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 3, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 2, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);
                                CalculateProratedDividends(Savings."No.", 1, ProductSetup."Interest Rate (Min.)", ProductSetup."WithHolding Tax", TaxExempt, ProductSetup."Dividend Calc. Method", FromDate, ToDate, IntPass, ReducedDeposits);

                            end;
                    end;
                end;
            until ProductSetup.Next = 0;
        end;
    end;


    procedure CreateDivLines(AccountNo: Code[20]; AccountName: Text; PDate: Date; ProductID: Code[20]; ProductName: Text; MemberNo: Code[20]; QualifyingShares: Decimal; Shares: Decimal; GrossDiv: Decimal; WTax: Decimal; NetDiv: Decimal; StartDate: Date; EndDate: Date; DivMethod: Option " ","Flat Rate",Prorated)
    var
        FAcc: Record "Savings Accounts";
        Cust: Record Members;
        DivLines: Record "Dividends Progression";
    begin

        DivLines.Init;
        DivLines."Account No" := AccountNo;
        DivLines.Name := AccountName;
        DivLines."Processing Date" := PDate;
        DivLines."Product Type" := ProductID;
        DivLines."Product Name" := ProductName;
        DivLines."Member No" := MemberNo;
        DivLines."Qualifying Shares" := QualifyingShares;
        DivLines.Shares := Shares;
        DivLines."Gross Dividends" := GrossDiv;
        DivLines."Witholding Tax" := WTax;
        DivLines."Net Dividends" := NetDiv;
        DivLines."Start Date" := StartDate;
        DivLines."End Date" := EndDate;
        DivLines."Dividend Calc. Method" := DivMethod;
        DivLines.Insert;


        IF EndDate >= DMY2Date(31, 08, 2025) then begin

            FAcc.RESET;
            FAcc.SETRANGE("No.", AccountNo);
            FAcc.SETFILTER("Date Filter", '..' + FORMAT(EndDate));
            IF FAcc.FINDFIRST THEN BEGIN
                FAcc.CALCFIELDS("Balance (LCY)");
                IF FAcc."Balance (LCY)" <= 0 THEN begin
                    DivLines.RESET;
                    DivLines.SETRANGE("Account No", FAcc."No.");
                    IF DivLines.FINDFIRST THEN BEGIN
                        DivLines.MODIFYALL("Witholding Tax", 0);
                        DivLines.MODIFYALL("Gross Dividends", 0);
                        DivLines.MODIFYALL("Net Dividends", 0)
                    END;

                end;
            END;

        end;
    end;

    local procedure GetOldDividends(AccountRec: Record "Savings Accounts"; EDate: Date; var Shares: Decimal; var Qualifyingshares: Decimal; var GrossDiv: Decimal)
    var
        // OldDiv: Record " Old Dividend Progresion";

        OldDiv: Record "Old Dividend Progresion 2024";

    begin
        Shares := 0;
        Qualifyingshares := 0;
        GrossDiv := 0;
        OldDiv.reset;
        OldDiv.setrange("Account No", AccountRec."Old Account No.");
        OldDiv.SetRange("End Date", EDate);
        if (OldDiv.FindFirst()) and (AccountRec."Old Account No." <> '') then begin
            Shares := OldDiv.Shares;
            Qualifyingshares := OldDiv."Qualifying Shares";
            GrossDiv := OldDiv."Gross Dividends";
        end
        else if AccountRec."Product Category" = AccountRec."Product Category"::"Share Capital" then begin

            OldDiv.reset;
            OldDiv.SetRange("member no", AccountRec."member no.");
            OldDiv.setrange("Product", 'SHARES');
            OldDiv.SetRange("End Date", EDate);
            if OldDiv.FindFirst() then begin
                Shares := OldDiv.Shares;
                Qualifyingshares := OldDiv."Qualifying Shares";
                GrossDiv := OldDiv."Gross Dividends";
            end
        end;


    end;



    LOCAL PROCEDURE GetMaishaLoanDepositBoostAmountIfExists(MemberNo: Code[30]; DateFilter: Text[30]): Decimal;
    VAR
        Loans: Record Loans;
        SavingsAccounts: Record "Savings Accounts";
        SavingsLedgerEntry: Record "Savings Ledger Entry";
    BEGIN
        Loans.RESET;
        Loans.SETFILTER("Total Outstanding Balance", '>0');
        Loans.SETFILTER("Loan Product Type", 'L17|L18');
        Loans.SETRANGE("Member No.", MemberNo);
        IF Loans.FINDFIRST THEN BEGIN
            SavingsAccounts.RESET;
            SavingsAccounts.SETRANGE("Product Category", SavingsAccounts."Product Category"::"Deposit Contribution");
            SavingsAccounts.SETRANGE("Member No.", MemberNo);
            IF SavingsAccounts.FINDFIRST THEN BEGIN
                SavingsLedgerEntry.RESET;
                SavingsLedgerEntry.SETFILTER("Posting Date", DateFilter);
                SavingsLedgerEntry.SETRANGE("Account No.", SavingsAccounts."No.");
                SavingsLedgerEntry.SETRANGE("Document No.", Loans."Loan No.");
                SavingsLedgerEntry.SETFILTER("Credit Amount", '>0');
                IF SavingsLedgerEntry.FINDFIRST THEN
                    EXIT(SavingsLedgerEntry."Credit Amount");
            END;
        END;
        EXIT(0);
    END;

    local procedure MemberHasReducedDeposits(AccNo: Code[30]; SDate: Date): Boolean
    var
        myInt: Integer;

        SA: Record "Savings Accounts";
        SLE: Record "Savings Ledger Entry";
        Amnt: Decimal;
        OpenBalRec: Record "Savings Accounts";
        CloseBalRec: Record "Savings Accounts";
        OpeningBal: Decimal;
        ClosingBal: Decimal;
    begin

        //Zerorize for members whose deposits reduce to less than opening balance
        OpeningBal := 0;
        ClosingBal := 0;
        OpenBalRec.RESET;
        OpenBalRec.SETRANGE("No.", AccNo);
        OpenBalRec.SETFILTER("Date Filter", '..%1', SDate);
        IF OpenBalRec.FIND('-') THEN BEGIN
            CloseBalRec.RESET;
            CloseBalRec.SETRANGE("No.", AccNo);
            CloseBalRec.SETFILTER("Date Filter", '..%1', CALCDATE('1Y+CY', SDate));
            IF CloseBalRec.FIND('-') THEN BEGIN
                OpenBalRec.CALCFIELDS("Balance (LCY)");
                CloseBalRec.CALCFIELDS("Balance (LCY)");
                OpeningBal := OpenBalRec."Balance (LCY)";
                ClosingBal := CloseBalRec."Balance (LCY)";
                IF ClosingBal < OpeningBal THEN BEGIN
                    exit(true);
                END;
            END;
        END;
        exit(false);

    end;

    local procedure CalculateProratedDividends(AccNo: Code[20]; i: Integer; divRate: Decimal; taxRate: Decimal; TaxExempt: Boolean; DivMethod: Option " ","Flat Rate",Prorated; var FromDate: Date; var ToDate: Date; ipass: Integer; ReducedDeposits: Boolean)
    var
        MAccounts: Record "Savings Accounts";
        DateFilter: Text;
        GrossDiv: Decimal;
        WTaxDiv: Decimal;
        NetDiv: Decimal;
        QualShares: Decimal;
        GrossDividends: Decimal;
        Shares: Decimal;
        MemberBalances: Record "Member Balances";
        MLedger: Record "Member Ledger Entry";
        SaccoSetup: Record "Sacco Setup";
        SavAcc: record "Savings Accounts";
    begin


        if i = 12 then
            DateFilter := '..' + Format(ToDate)
        else
            DateFilter := Format(FromDate) + '..' + Format(ToDate);

        IF ToDate <= DMY2Date(31, 08, 2025) then begin
            MAccounts.Get(AccNo);
            Shares := 0;
            QualShares := 0;
            GrossDividends := 0;
            GrossDiv := 0;

            GetOldDividends(MAccounts, ToDate, Shares, QualShares, GrossDividends);
            // QualShares := Shares * i / 12;
            if GrossDividends > 0 then
                GrossDiv := (divRate / 100) * QualShares;

            IF ToDate = DMY2Date(31, 08, 2025) then begin
                SaccoSetup.get;
                MAccounts.Reset;
                MAccounts.SetRange("No.", AccNo);
                //MAccounts.SetFilter("Date Filter", DateFilter);
                MAccounts.setrange("Date Filter", SaccoSetup."Go Live Date" + 1, Todate);
                MAccounts.SetAutoCalcFields("Net Change (LCY)");
                if MAccounts.FindFirst then begin


                    Shares += MAccounts."Net Change (LCY)";

                    if MAccounts."Product Category" = MAccounts."Product Category"::"Deposit Contribution" then
                        Shares -= GetMaishaLoanDepositBoostAmountIfExists(MAccounts."Member No.", format(calcdate('-CM', Todate)) + '..' + format(Todate));


                    QualShares := Shares * i / 12;
                    GrossDiv := (divRate / 100) * QualShares;

                end;
            end;


            if ReducedDeposits then
                GrossDiv := 0;

            WTaxDiv := GrossDiv * (taxRate / 100);
            if TaxExempt then
                WTaxDiv := 0;
            NetDiv := GrossDiv - WTaxDiv;




            //if GrossDiv <> 0 then
            CreateDivLines(
                MAccounts."No.",
                MAccounts.Name,
                Today,
                MAccounts."Product Type",
                MAccounts."Product Name",
                MAccounts."Member No.",
                QualShares,
                Shares,
                GrossDiv,
                WTaxDiv,
                NetDiv,
                FromDate,
                ToDate,
                DivMethod
                );



        end
        else begin

            MAccounts.Reset;
            MAccounts.SetRange("No.", AccNo);
            MAccounts.SetFilter("Date Filter", DateFilter);
            MAccounts.SetAutoCalcFields("Net Change (LCY)");
            if MAccounts.FindFirst then begin


                Shares := MAccounts."Net Change (LCY)";
                if MAccounts."Product Category" = MAccounts."Product Category"::"Deposit Contribution" then
                    Shares -= GetMaishaLoanDepositBoostAmountIfExists(MAccounts."Member No.", format(calcdate('-CM', Todate)) + '..' + format(Todate));

                QualShares := Shares * i / 12;


                GrossDiv := (divRate / 100) * QualShares;



                if ReducedDeposits then
                    GrossDiv := 0;


                WTaxDiv := GrossDiv * (taxRate / 100);
                if TaxExempt then
                    WTaxDiv := 0;
                NetDiv := GrossDiv - WTaxDiv;

                //if GrossDiv <> 0 then
                CreateDivLines(
                    MAccounts."No.",
                    MAccounts.Name,
                    Today,
                    MAccounts."Product Type",
                    MAccounts."Product Name",
                    MAccounts."Member No.",
                    QualShares,
                    Shares,
                    GrossDiv,
                    WTaxDiv,
                    NetDiv,
                    FromDate,
                    ToDate,
                    DivMethod
                    );



            end;

        end;


        FromDate := CalcDate('1M-CM', ToDate);
        ToDate := CalcDate('CM', FromDate);
    end;

    local procedure OldCalculateProratedDividends(AccNo: Code[20]; i: Integer; divRate: Decimal; taxRate: Decimal; TaxExempt: Boolean; DivMethod: Option " ","Flat Rate",Prorated; var FromDate: Date; var ToDate: Date; ipass: Integer)
    var
        MAccounts: Record "Savings Accounts";
        DateFilter: Text;
        GrossDiv: Decimal;
        WTaxDiv: Decimal;
        NetDiv: Decimal;
        QualShares: Decimal;
        Shares: Decimal;
        MemberBalances: Record "Member Balances";
        MLedger: Record "Member Ledger Entry";
    begin

        if i = 12 then
            DateFilter := '..' + Format(ToDate)
        else
            DateFilter := Format(FromDate) + '..' + Format(ToDate);

        IF ToDate <= DMY2Date(31, 08, 2024) then begin
            MAccounts.Get(AccNo);
            Shares := 0;
            if MAccounts."Product Category" = MAccounts."Product Category"::"Deposit Contribution" then begin
                if Todate = DMY2Date(31, 12, 2023) then
                    Shares := GetOldContribution(MAccounts."No.", 'DEC23');
                if Todate = DMY2Date(31, 1, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'JAN');
                if Todate = DMY2Date(29, 2, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'FEB');
                if Todate = DMY2Date(31, 3, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'MAR');
                if Todate = DMY2Date(30, 4, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'APR');
                if Todate = DMY2Date(31, 5, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'MAY');
                if Todate = DMY2Date(30, 6, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'JUN');
                if Todate = DMY2Date(31, 7, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'JUL');
                if Todate = DMY2Date(31, 8, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'AUG');
            end;
            if MAccounts."Product Category" = MAccounts."Product Category"::"Share Capital" then begin
                if Todate = DMY2Date(31, 12, 2023) then
                    Shares := GetOldContribution(MAccounts."No.", 'DEC23');
                if Todate = DMY2Date(31, 1, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'JAN');
                if Todate = DMY2Date(29, 2, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'FEB');
                if Todate = DMY2Date(31, 3, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'MAR');
                if Todate = DMY2Date(30, 4, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'APR');
                if Todate = DMY2Date(31, 5, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'MAY');
                if Todate = DMY2Date(30, 6, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'JUN');
                if Todate = DMY2Date(31, 7, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'JUL');
                if Todate = DMY2Date(31, 8, 2024) then
                    Shares := GetOldContribution(MAccounts."No.", 'AUG');
            end;




            QualShares := Shares * i / 12;

            GrossDiv := (divRate / 100) * QualShares;
            WTaxDiv := GrossDiv * (taxRate / 100);
            if TaxExempt then
                WTaxDiv := 0;
            NetDiv := GrossDiv - WTaxDiv;

            if GrossDiv <> 0 then
                CreateDivLines(
                    MAccounts."No.",
                    MAccounts.Name,
                    Today,
                    MAccounts."Product Type",
                    MAccounts."Product Name",
                    MAccounts."Member No.",
                    QualShares,
                    Shares,
                    GrossDiv,
                    WTaxDiv,
                    NetDiv,
                    FromDate,
                    ToDate,
                    DivMethod
                    );



        end
        else begin

            MAccounts.Reset;
            MAccounts.SetRange("No.", AccNo);
            MAccounts.SetFilter("Date Filter", DateFilter);
            MAccounts.SetAutoCalcFields("Net Change (LCY)");
            if MAccounts.FindFirst then begin
                if MAccounts."Net Change (LCY)" <> 0 then begin

                    Shares := MAccounts."Net Change (LCY)";

                    QualShares := Shares * i / 12;

                    GrossDiv := (divRate / 100) * QualShares;
                    WTaxDiv := GrossDiv * (taxRate / 100);
                    if TaxExempt then
                        WTaxDiv := 0;
                    NetDiv := GrossDiv - WTaxDiv;

                    if GrossDiv <> 0 then
                        CreateDivLines(
                            MAccounts."No.",
                            MAccounts.Name,
                            Today,
                            MAccounts."Product Type",
                            MAccounts."Product Name",
                            MAccounts."Member No.",
                            QualShares,
                            Shares,
                            GrossDiv,
                            WTaxDiv,
                            NetDiv,
                            FromDate,
                            ToDate,
                            DivMethod
                            );

                end;

            end;

        end;


        FromDate := CalcDate('1M-CM', ToDate);
        ToDate := CalcDate('CM', FromDate);
    end;

    local procedure GetOldContribution(MemberNo: Code[20]; Month: Text) Value: Decimal;
    var
        myInt: Integer;
        OldDep: REcord "Old Monthly Deposits";
    begin
        Value := 0;
        OldDep.Reset();
        OldDep.SetRange("Account No.", MemberNo);
        if OldDep.findfirst then begin
            case month of
                'DEC23':
                    value := OldDep."Dec 2023";
                'JAN':
                    value := OldDep.Jan;
                'FEB':
                    value := OldDep.Feb;
                'MAR':
                    value := OldDep.March;
                'APR':
                    value := OldDep.April;
                'MAY':
                    value := OldDep.May;
                'JUN':
                    value := OldDep.June;
                'JUL':
                    value := OldDep.July;
                'AUG':
                    value := OldDep.Aug;
                'SEP':
                    value := OldDep.Sept;
                'OCT':
                    value := OldDep.Oct;
                'NOV':
                    value := OldDep.Nov;
                'DEC':
                    value := OldDep.Dec;
            end;

        end;
    end;

    procedure GenerateDividendPostingBuffer(MemberNo: Code[20]; DivYear: Integer; DivAcc: Code[20]; GlobalDim1: Code[10]; GlobalDim2: Code[10]; PDate: Date)
    var
        DivLines: Record "Dividends Progression";
        Instructions: Record "Dividend Instructions";
        DedAmt: Decimal;
        Savings: Record "Savings Accounts";
        RunBal: Decimal;
        DivProduct: Record "Product Setup";
        DividendLoan: Record "Product Setup";
        SCapitalDiff: Decimal;
        TopupShares: label 'Topup Share Capital :-';
        DividendEarned: label 'Dividend Earned :-';
        DividendDeductions: label 'Dividend Deductions :-';
        LoanInterest: label 'Loan Interest :-';
        LoanBills: label 'Loan Bill :-';
        LoanPrincipal: label 'Loan Principal :-';
        Loans: Record Loans;
        InterestonLoan: Decimal;
        PrincipalonLoan: Decimal;
        Defaulter: Boolean;
        DividendInstructionsExists: Boolean;
        DivPosting: Record "Dividend Posting";
        EntrNo: Integer;
        Members: Record Members;
        TransactionCharge: label 'Transaction Charge :-';
        ExciseDuty: label 'Excise Duty :-';
        diaProgress: Dialog;
        intProgress: Integer;
        timProgress: Time;
        intProgressI: Integer;
        intProgressTotal: Integer;
        GeneratepostLines: label 'Create Posting Lines :';
        TotalNetAmount: Decimal;
        SavAccts: Record "Savings Accounts";
        Year: Integer;
        DocNo: Code[20];
        WTax: Decimal;
        NetAmt: Decimal;
        j: Integer;
        LnDefAmt: Decimal;
        DivCap: Decimal;
        TGross: Decimal;
        DividendSMSCharge: Decimal;
        ProductSetup: Record "Product Setup";
        GrossAmount: Decimal;
        SaccoSetup: Record "Sacco Setup";
        TCharge: Record "Transaction Charges";
        SMSCharges: Record "SMS Charges";
        ExpectedAmt: Decimal;
        AmtPaid: Decimal;
        DefAmount: Decimal;
        DaysInArrear: Integer;
        ArrearsDate: Date;
        GracePeriod: DateFormula;
        Narration: Text[100];
        SLedger: Record "Savings Ledger Entry";
        Days: Integer;
        Years: Decimal;
        Desc: Text[50];
    begin

        DivPosting.Reset;
        DivPosting.SetRange("Member No.", MemberNo);
        DivPosting.SetRange(Posted, false);
        if DivPosting.Find('-') then
            DivPosting.DeleteAll;


        DivPosting.Reset;
        if DivPosting.FindLast then
            EntrNo := DivPosting."Entry No.";


        Members.Reset;
        Members.SetFilter(Members."No.", MemberNo);
        if Members.FindFirst then begin

            /*
            if Members.Blocked <> Members.Blocked::" " then begin
                Members.Blocked := Members.Blocked::" ";
                Members.Modify;
            end;
            */

            RunBal := 0;
            DocNo := '';
            TGross := 0;


            ProductSetup.Reset;
            ProductSetup.SetFilter("Dividend Calc. Method", '<>%1', ProductSetup."dividend calc. method"::" ");
            if ProductSetup.FindFirst then begin
                //MESSAGE('RUnBal %1',RunBal);
                repeat


                    DivLines.Reset;
                    DivLines.SetRange(DivLines."Member No", Members."No.");
                    DivLines.SetRange("Product Type", ProductSetup."Product ID");
                    if DivLines.Find('-') then begin

                        DocNo := 'DIV ' + Format(DivYear);

                        if ProductSetup."Product Category" = ProductSetup."Product Category"::"Deposit Contribution" then
                            Desc := 'Rebates ' + Format(DivYear);
                        if ProductSetup."Product Category" = ProductSetup."Product Category"::"Share Capital" then
                            Desc := 'Dividends ' + Format(DivYear);

                        DivLines.CalcSums(DivLines."Net Dividends", DivLines."Gross Dividends", DivLines."Witholding Tax");
                        DivLines."Dividend Account" := DivAcc;

                        if DivAcc = '' then
                            Error('Dividend Account not found for Member No. %1', MemberNo);

                        GrossAmount := ROUND(DivLines."Gross Dividends", 0.01, '=');

                        if GrossAmount < 0 then
                            GrossAmount := 0;

                        TGross += GrossAmount;
                        WTax := ROUND(DivLines."Witholding Tax", 0.01, '=');

                        if WTax < 0 then
                            WTax := 0;

                        NetAmt := ROUND(DivLines."Net Dividends", 0.01, '=');

                        if NetAmt < 0 then
                            NetAmt := 0;


                        ProductSetup.TestField("Interest Payable Account");
                        ProductSetup.TestField("Withholding Tax Account");

                        //+++++++++++++++++++++++++++++++++++++++++++++++++++PAYABLE DIV--

                        EntrNo += 1;
                        DivPosting.Init;
                        DivPosting."Entry No." := EntrNo;
                        DivPosting."Posting Date" := PDate;
                        DivPosting."Document No." := DocNo;
                        DivPosting."Account Type" := DivPosting."account type"::Savings;
                        DivPosting."Account No." := DivLines."Dividend Account";
                        DivPosting.Description := CopyStr(Desc, 1, 50); //*
                        DivPosting."Member No." := Members."No.";
                        DivPosting.Amount := -GrossAmount;
                        DivPosting."Debit Amount" := 0;
                        DivPosting."Credit Amount" := GrossAmount;
                        DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                        DivPosting."Bal. Account No." := ProductSetup."Interest Payable Account";
                        DivPosting."Product Type" := ProductSetup."product id";
                        DivPosting."Product Type Name" := ProductSetup.Description;
                        DivPosting.Transaction := DivPosting.Transaction::Gross;
                        DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                        DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                        if DivPosting.Amount <> 0 then
                            DivPosting.Insert;
                        RunBal += DivPosting.Amount * -1;
                        //MESSAGE('RUnBal %1\AmtDed_Add %2',RunBal,DivPosting.Amount);

                        EntrNo += 1;
                        DivPosting.Init;
                        DivPosting."Entry No." := EntrNo;
                        DivPosting."Posting Date" := PDate;
                        DivPosting."Document No." := DocNo;
                        DivPosting."Account Type" := DivPosting."account type"::Savings;
                        DivPosting."Account No." := DivLines."Dividend Account";
                        DivPosting.Description := CopyStr('WTax: ' + Desc, 1, 50); //*
                        DivPosting."Member No." := Members."No.";
                        DivPosting.Amount := WTax;
                        DivPosting."Debit Amount" := WTax;
                        DivPosting."Credit Amount" := 0;
                        DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                        DivPosting."Bal. Account No." := ProductSetup."Withholding Tax Account";
                        DivPosting."Product Type" := ProductSetup."product id";
                        DivPosting."Product Type Name" := ProductSetup.Description;
                        DivPosting.Transaction := DivPosting.Transaction::Tax;
                        DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                        DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                        if DivPosting.Amount <> 0 then
                            DivPosting.Insert;
                        RunBal -= DivPosting.Amount;
                        //MESSAGE('RUnBal %1\AmtDed_Add %2',RunBal,DivPosting.Amount);

                    end;


                until ProductSetup.Next = 0;
            end;


            if RunBal > 0 then begin

                SaccoSetup.Get;
                if SaccoSetup."Dividend Charge" = SaccoSetup."dividend charge"::"Use General Charge" then begin

                    TCharge.Reset;
                    TCharge.SetRange(Code, SaccoSetup."Dividend Processing Charge");
                    if TCharge.Find('-') then begin
                        Value := TGross;
                        ChargeAmt := 0;
                        ChargeDuty := 0;
                        ChargeAcctType := Chargeaccttype::"G/L Account";
                        ChargeAcct := '';
                        SharingAmt := 0;
                        SharingChargeAcct := '';
                        SharingChargeAcctType := Sharingchargeaccttype::"G/L Account";
                        SharingDuty := 0;
                        MemberActivities.GetGeneral_SharingChargeAmount(TCharge.Code, Value, ChargeAmt, ChargeDuty, ChargeAcctType, ChargeAcct, SharingAmt, SharingDuty, SharingChargeAcctType, SharingChargeAcct);
                        TotalCharge := ChargeAmt + SharingAmt;
                        TotalDuty := ChargeDuty + SharingDuty;


                        if (RunBal > (TotalCharge + TotalDuty)) and (TotalCharge > 0) then begin

                            EntrNo += 1;
                            DivPosting.Init;
                            DivPosting."Entry No." := EntrNo;
                            DivPosting."Posting Date" := PDate;
                            DivPosting."Document No." := DocNo;
                            DivPosting."Account Type" := DivPosting."account type"::Savings;
                            DivPosting."Account No." := DivAcc;
                            DivPosting.Description := 'Dividend Processing Charges';
                            DivPosting."Member No." := Members."No.";
                            DivPosting.Amount := TotalCharge;
                            DivPosting."Debit Amount" := TotalCharge;
                            DivPosting."Credit Amount" := 0;
                            DivPosting."Bal. Account Type" := ChargeAcctType;
                            DivPosting."Bal. Account No." := ChargeAcct;
                            DivPosting."Product Type Name" := 'Processing Fee';
                            DivPosting.Transaction := DivPosting.Transaction::"Processing Fee";
                            DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                            DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                            if DivPosting.Amount <> 0 then
                                DivPosting.Insert;
                            RunBal -= DivPosting.Amount;
                            if RunBal < 0 then RunBal := 0;
                            //MESSAGE('RUnBal %1\AmtDed_Add %2',RunBal,DivPosting.Amount);


                            if TotalDuty > 0 then begin
                                EntrNo += 1;
                                DivPosting.Init;
                                DivPosting."Entry No." := EntrNo;
                                DivPosting."Posting Date" := PDate;
                                DivPosting."Document No." := DocNo;
                                DivPosting."Account Type" := DivPosting."account type"::Savings;
                                DivPosting."Account No." := DivAcc;
                                DivPosting.Description := 'Dividend Processing Charge Excise Duty';
                                DivPosting."Member No." := Members."No.";
                                DivPosting.Amount := TotalDuty;
                                DivPosting."Debit Amount" := TotalDuty;
                                DivPosting."Credit Amount" := 0;
                                DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                                DivPosting."Bal. Account No." := SaccoSetup."Excise Duty GL";
                                DivPosting."Product Type Name" := 'Duty';
                                DivPosting.Transaction := DivPosting.Transaction::"Duty on Processing Fee";
                                DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                                DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                                if DivPosting.Amount <> 0 then
                                    DivPosting.Insert;
                                RunBal -= DivPosting.Amount;
                                if RunBal < 0 then RunBal := 0;
                                //MESSAGE('RUnBal %1\AmtDed_Add %2',RunBal,DivPosting.Amount);

                            end;
                        end;
                    end;
                end;
            end;

            IF (RunBal > 0) and (SaccoSetup."Dividend Reverse Document" <> '') then begin

                SLedger.reset();
                Sledger.SetRange("Account No.", DivAcc);
                SLedger.SetRange("Posting Date", SaccoSetup."Dividend Reverse Date");
                SLedger.SetRange("Document No.", SaccoSetup."Dividend Reverse Document");
                SLedger.SetRange(Reversed, false);
                SLedger.SetFilter("Credit Amount (LCY)", '>0');
                if SLedger.FindFirst() then begin

                    DefAmount := SLedger."Credit Amount (LCY)";
                    DividendLoan.Get('L43');

                    EntrNo += 1;
                    DivPosting.Init;
                    DivPosting."Entry No." := EntrNo;
                    DivPosting."Posting Date" := PDate;
                    DivPosting."Document No." := DocNo;
                    DivPosting."Account Type" := DivPosting."account type"::Savings;
                    DivPosting."Account No." := DivLines."Dividend Account";
                    DivPosting.Description := CopyStr('Dividend Advance-REF', 1, 50); //*
                    DivPosting."Member No." := Members."No.";
                    DivPosting.Amount := DefAmount;
                    DivPosting."Debit Amount" := DefAmount;
                    DivPosting."Credit Amount" := 0;
                    DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                    DivPosting."Bal. Account No." := '';
                    DivPosting."Product Type" := SLedger."Product Type";
                    DivPosting."Product Type Name" := '';
                    DivPosting.Transaction := DivPosting.Transaction::Capitalized;
                    DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                    DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                    if DivPosting.Amount <> 0 then
                        DivPosting.Insert;

                    //RunBal -= DivPosting.Amount;


                    EntrNo += 1;
                    DivPosting.Init;
                    DivPosting."Entry No." := EntrNo;
                    DivPosting."Posting Date" := PDate;
                    DivPosting."Document No." := DocNo;
                    DivPosting."Account Type" := DivPosting."account type"::"G/L Account";
                    DivPosting."Account No." := DividendLoan."Loan Account [G/L]";
                    DivPosting.Description := CopyStr('Dividend Advance-REF', 1, 50); //*
                    DivPosting."Member No." := Members."No.";
                    DivPosting.Amount := -DefAmount;
                    DivPosting."Debit Amount" := 0;
                    DivPosting."Credit Amount" := DefAmount;
                    DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                    DivPosting."Bal. Account No." := '';
                    DivPosting."Product Type" := SLedger."Product Type";
                    DivPosting."Product Type Name" := '';
                    DivPosting.Transaction := DivPosting.Transaction::Capitalized;
                    DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                    DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                    if DivPosting.Amount <> 0 then
                        DivPosting.Insert;

                end;

            end;

            if RunBal > 0 then begin

                DividendSMSCharge := 0;
                SMSCharges.Reset;
                SMSCharges.SetRange(Source, SMSCharges.Source::Dividend);
                if SMSCharges.FindFirst then begin
                    DividendSMSCharge := SMSCharges."Charge Amount";
                end;

                if (Members."Mobile Phone No." <> '') and (DividendSMSCharge > 0) and (RunBal >= DividendSMSCharge) then begin
                    EntrNo += 1;
                    DivPosting.Init;
                    DivPosting."Entry No." := EntrNo;
                    DivPosting."Posting Date" := PDate;
                    DivPosting."Document No." := DocNo;
                    DivPosting."Account Type" := DivPosting."account type"::Savings;
                    DivPosting."Account No." := DivAcc;
                    DivPosting.Description := 'Dividend SMS';
                    DivPosting."Member No." := Members."No.";
                    DivPosting.Amount := DividendSMSCharge;
                    DivPosting."Debit Amount" := DividendSMSCharge;
                    DivPosting."Credit Amount" := 0;
                    DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                    DivPosting."Bal. Account No." := SMSCharges."Charge G/L Account";
                    DivPosting."Product Type" := 'SMS';
                    DivPosting."Product Type Name" := 'SMS';
                    DivPosting.Transaction := DivPosting.Transaction::SMS;
                    DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                    DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                    if DivPosting.Amount <> 0 then
                        DivPosting.Insert;
                    RunBal -= DivPosting.Amount;
                    if RunBal < 0 then RunBal := 0;

                end;
            end;


            //Dividend Capitalization
            if (RunBal > 0) and (ProductSetup."Dividend Capitalization %" > 0) then begin

                DivCap := Round(RunBal * ProductSetup."Dividend Capitalization %" / 100);


                if (DivCap > 0) then begin
                    EntrNo += 1;
                    DivPosting.Init;
                    DivPosting."Entry No." := EntrNo;
                    DivPosting."Posting Date" := PDate;
                    DivPosting."Document No." := DocNo;
                    DivPosting."Account Type" := DivPosting."account type"::Savings;
                    DivPosting."Account No." := DivAcc;
                    DivPosting.Description := 'Dividend Capitalized';
                    DivPosting."Member No." := Members."No.";
                    DivPosting.Amount := DivCap;
                    DivPosting."Debit Amount" := DivCap;
                    DivPosting."Credit Amount" := 0;
                    DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                    DivPosting."Bal. Account No." := '';
                    DivPosting."Product Type" := ProductSetup."Product ID";
                    DivPosting."Product Type Name" := ProductSetup."Product ID";
                    DivPosting.Transaction := DivPosting.Transaction::Capitalized;
                    DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                    DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                    if DivPosting.Amount <> 0 then
                        DivPosting.Insert;
                    RunBal -= DivPosting.Amount;
                    if RunBal < 0 then RunBal := 0;


                    SavAccts.Reset();
                    SavAccts.SetRange("Member No.", Members."No.");
                    SavAccts.SetRange("Product Type", ProductSetup."Product ID");
                    if SavAccts.FindFirst() then begin

                        EntrNo += 1;
                        DivPosting.Init;
                        DivPosting."Entry No." := EntrNo;
                        DivPosting."Posting Date" := PDate;
                        DivPosting."Document No." := DocNo;
                        DivPosting."Account Type" := DivPosting."account type"::Savings;
                        DivPosting."Account No." := SavAccts."No.";
                        DivPosting.Description := 'Dividend Capitalized';
                        DivPosting."Member No." := Members."No.";
                        DivPosting.Amount := -DivCap;
                        DivPosting."Debit Amount" := 0;
                        DivPosting."Credit Amount" := DivCap;
                        DivPosting."Bal. Account Type" := DivPosting."bal. account type"::"G/L Account";
                        DivPosting."Bal. Account No." := '';
                        DivPosting."Product Type" := ProductSetup."Product ID";
                        DivPosting."Product Type Name" := ProductSetup."Product ID";
                        DivPosting.Transaction := DivPosting.Transaction::Capitalized;
                        DivPosting."Shortcut Dimension 1 Code" := GlobalDim1;
                        DivPosting."Shortcut Dimension 2 Code" := GlobalDim2;
                        if DivPosting.Amount <> 0 then
                            DivPosting.Insert;
                    end;
                end;

            end;

            if RunBal > 0 then begin
                //Recover Dividend Advance
                DivProduct.Reset();
                DivProduct.SetRange("Repay Mode", DivProduct."Repay Mode"::Dividends);
                if DivProduct.FindFirst() then
                    for j := 1 to 4 do begin


                        Loans.Reset;
                        Loans.SetRange(Loans."Member No.", Members."No.");
                        Loans.Setrange("Loan Product Type", DivProduct."Product ID");

                        if j = 1 then
                            Loans.SetFilter("Outstanding Penalty", '>0')
                        else
                            if j = 2 then
                                Loans.SetFilter("Outstanding Appraisal", '>0')
                            else
                                if j = 3 then
                                    Loans.SetFilter("Outstanding Interest", '>0')
                                else
                                    if j = 4 then
                                        Loans.SetFilter("Outstanding Principal", '>0')
                                    else
                                        Error('Invalid Code - Programming Error');

                        if Loans.Find('-') then begin
                            repeat
                                LnDefAmt := 0;
                                if RunBal > 0 then begin
                                    TransType := Transtype::" ";

                                    if j = 1 then begin
                                        Loans.CalcFields("Outstanding Penalty");
                                        LnDefAmt := Loans."Outstanding Penalty";
                                        TransType := Transtype::"Penalty Paid";
                                        if LnDefAmt > RunBal then
                                            LnDefAmt := RunBal;

                                    end
                                    else
                                        if j = 2 then begin
                                            Loans.CalcFields("Outstanding Appraisal");
                                            LnDefAmt := Loans."Outstanding Appraisal";

                                            if LnDefAmt > RunBal then
                                                LnDefAmt := RunBal;
                                            TransType := Transtype::"Appraisal Paid";
                                        end
                                        else
                                            if j = 3 then begin
