        CurrentRecordNo := 0;
        NoOfRecords := 0;

        Loans.Reset;
        Loans.SetRange("Employer Code", SalHeaD."Employer Code");
        Loans.SetFilter("Outstanding Principal", '>0');
        if Loans.FindSet() then begin


            NoOfRecords := Loans.Count;



            dWindow.Open('Updating Schedules Lines:      #1#########\'
                                + 'Accounts:             #2#########\'
                                + 'Counter:              #3#########\'
                                + 'Progress:             @4@@@@@@@@@\'
                                + 'Press Esc to abort');

            dWindow.Update(2, NoOfRecords);

            repeat


                CurrentRecordNo += 1;
                dWindow.Update(1, Loans."Loan No." + ': ' + Loans."Member Name");

                LSchedule.Reset();
                LSchedule.SetRange("Loan No.", Loans."Loan No.");
                LSchedule.setrange("Repayment Date", CalcDate('-CM', SalHeaD."Posting date"), CalcDate('CM', SalHeaD."Posting date"));
