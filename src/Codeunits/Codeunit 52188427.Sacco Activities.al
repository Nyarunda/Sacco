    local procedure SendReceiptNotifications(ReceiptHeader: Record "Receipt Header")
    var
        DocLine: Record "Document Line";
        LoanLines: Record "Document Line";
        Loan: Record Loans;
        Member: Record Members;
        Savings: Record "Savings Accounts";
        SavingsLine: Record "Document Line";
        Body: Text;
        FirstName: Text;
        MessageText: Text;
        MemberNo: Code[20];
        SaccoName: Text;
        PDate: Date;
        TotalLoanAmount: Decimal;
        TotalSavingsAmount: Decimal;
        SavingsAccountName: Text;
        EmailSubject: Text;
        EmailBody: Text;
        NotifiedLoans: Dictionary of [Code[20], Boolean];
    begin
        SaccoName := GetCompanyNameForNotifications();
        DocLine.Reset();
        DocLine.SetRange("Header No.", ReceiptHeader."No.");
        DocLine.SetRange("Account Type", DocLine."Account Type"::Credit);
        DocLine.SetFilter("Loan No.", '<>%1', '');
        if DocLine.FindSet() then begin
            repeat
                if not NotifiedLoans.ContainsKey(DocLine."Loan No.") then begin
                    NotifiedLoans.Add(DocLine."Loan No.", true);
                    TotalLoanAmount := 0;

                    LoanLines.Reset();
                    LoanLines.SetRange("Header No.", ReceiptHeader."No.");
                    LoanLines.SetRange("Member No.", DocLine."Member No.");
                    //LoanLines.SetRange("Loan No.", DocLine."Loan No.");
                    if LoanLines.FindSet() then
                        repeat
                            TotalLoanAmount += LoanLines.Amount;
                        until LoanLines.Next() = 0;

                    MemberNo := DocLine."Member No.";
                    PDate := DocLine."Posting Date";
                    if PDate = 0D then
                        PDate := ReceiptHeader."Posting Date";
                    if Loan.Get(DocLine."Loan No.") then
                        MemberNo := Loan."Member No.";
                    if MemberNo = '' then
                        MemberNo := ReceiptHeader."Customer No.";

                    if Member.Get(MemberNo) then begin
                        FirstName := MemberActivities.FirstName(Member.Name);
                        if FirstName = '' then
                            FirstName := Member.Name;

                        Body := StrSubstNo(
                            'We confirm receipt of KES %1 on %2. Your loan %3 has been updated. Thank you for your continued support. - %4',
                            FormatNotificationAmount(TotalLoanAmount), Format(PDate), DocLine."Loan No.", SaccoName);
                        MessageText := 'Dear ' + FirstName + ', ' + Body;

                        TrySendTransactionSms(
                            Smssource::"Deposit Confirmation", Member."Mobile Phone No.", MessageText,
                            ReceiptHeader."No.", '');

                        if ValidEmailAddress(Member."E-Mail") then begin
                            EmailSubject := StrSubstNo('Receipt Confirmation - %1', ReceiptHeader."No.");
                            EmailBody := Body;
                            SendFinanceEmail(Member."E-Mail", '', '', EmailSubject, 'Dear ' + FirstName + ',', EmailBody);
                        end;
                    end;
                end;
            until DocLine.Next() = 0;

            exit;
        end;

        SavingsLine.Reset();
        SavingsLine.SetRange("Header No.", ReceiptHeader."No.");
        SavingsLine.SetRange("Account Type", SavingsLine."Account Type"::Savings);
        if not SavingsLine.FindSet() then
            exit;

        TotalSavingsAmount := 0;
        MemberNo := '';
        PDate := 0D;
        SavingsAccountName := 'deposit account';

        repeat
            TotalSavingsAmount += SavingsLine.Amount;

            if MemberNo = '' then
                MemberNo := SavingsLine."Member No.";
            if PDate = 0D then
                PDate := SavingsLine."Posting Date";

            if Savings.Get(SavingsLine."Account No.") then begin
                if MemberNo = '' then
                    MemberNo := Savings."Member No.";
                if Savings."Product Name" <> '' then
                    SavingsAccountName := Savings."Product Name"
                else
                    SavingsAccountName := Savings."No.";
            end;
        until SavingsLine.Next() = 0;

        if PDate = 0D then
            PDate := ReceiptHeader."Posting Date";
        if MemberNo = '' then
            MemberNo := ReceiptHeader."Customer No.";

        if Member.Get(MemberNo) then begin
            FirstName := MemberActivities.FirstName(Member.Name);
            if FirstName = '' then
                FirstName := Member.Name;

            Body := StrSubstNo(
                'We confirm receipt of KES %1 on %2. Your %3 has been updated. Thank you for your continued support. - %4',
                FormatNotificationAmount(TotalSavingsAmount), Format(PDate), SavingsAccountName, SaccoName);
            MessageText := 'Dear ' + FirstName + ', ' + Body;

            TrySendTransactionSms(
                Smssource::"Deposit Confirmation", Member."Mobile Phone No.", MessageText,
                ReceiptHeader."No.", '');

            if ValidEmailAddress(Member."E-Mail") then begin
                EmailSubject := StrSubstNo('Receipt Confirmation - %1', ReceiptHeader."No.");
                EmailBody := Body;
                SendFinanceEmail(Member."E-Mail", '', '', EmailSubject, 'Dear ' + FirstName + ',', EmailBody);
            end;
        end;
    end;

    local procedure SendDividendNotification(Member: Record Members; Amount: Decimal; PostingDate: Date; Reference: Code[20])
    var
        Body: Text;
        FirstName: Text;
        MessageText: Text;
        SaccoName: Text;
