    procedure MarkReceiptAsPosted(ReceiptNo: Code[20])
    begin
        if ReceiptNo = '' then
            exit;

        if not TryMarkReceiptAsPosted(ReceiptNo) then begin
        end;
    end;

    [TryFunction]
    local procedure TryMarkReceiptAsPosted(ReceiptNo: Code[20])
    var
        BankLedger: Record "Bank Account Ledger Entry";
        Receipt: Record "Receipt Header";
    begin
        BankLedger.Reset();
        BankLedger.SetRange("Document No.", ReceiptNo);
        if not BankLedger.FindFirst() then
            message('Receipt %1 cannot be marked as posted because no bank ledger entry was found.', ReceiptNo);

        Receipt.Reset();
        Receipt.SetRange("No.", ReceiptNo);
        Receipt.SetRange(Posted, false);

        if not Receipt.FindFirst() then
            Error('Receipt %1 was not found or is already posted.', ReceiptNo);

        Receipt.Posted := true;
        Receipt."Posted By" := UserId;
        Receipt.Modify(true);
    end;

